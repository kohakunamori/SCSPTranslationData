{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kohakunamori/SCSPTranslationData/qa/schemas/agent-batch-record.schema.json",
  "title": "SCSP Agent Translation Batch Record",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source",
    "classification",
    "occurrences",
    "existing_translations",
    "relevant_terms",
    "relevant_names",
    "preserve_terms"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "source": {"type": "string"},
    "classification": {
      "type": "string",
      "enum": ["needs_translation", "translation_memory_candidate", "needs_review"]
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "identity", "provenance"],
        "properties": {
          "surface": {"type": "string", "enum": ["localify", "local2", "lyrics", "scenario"]},
          "identity": {"type": "string"},
          "provenance": {"type": "string"},
          "source_authority": {"type": "string", "enum": ["current-key", "verified-dump"]},
          "requires_source_verification": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "existing_translations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "relevant_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "preferred"],
        "properties": {
          "source": {"type": "string"},
          "preferred": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "relevant_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "translation"],
        "properties": {
          "source": {"type": "string"},
          "translation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "preserve_terms": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
