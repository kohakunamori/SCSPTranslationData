[{"key":"SCENARIO_s02_01090000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_01090000_02_0010","text":"～♪"},{"key":"SCENARIO_s02_01090000_02_0020","text":"哦，果穗\n看起来心情很好啊"},{"key":"SCENARIO_s02_01090000_02_0030","text":"嘿嘿\n我刚才向小千代前辈请教了巧克力咖喱的做法！"},{"key":"SCENARIO_s02_01090000_02_0040","text":"以后在家也能做千代前辈的咖喱了！"},{"key":"SCENARIO_s02_01090000_02_0050","text":"是吗，太好了！\n果穗在家也经常帮忙做家务吗？"},{"key":"SCENARIO_s02_01090000_02_0060","text":"妈妈总是对我说“谢谢你一直帮忙”！"},{"key":"SCENARIO_s02_01090000_02_0070","text":"虽然我没办法像大家那样做那么多事……！"},{"key":"SCENARIO_s02_01090000_02_0080","text":"听说智代子特别厉害啊"},{"key":"SCENARIO_s02_01090000_02_0090","text":"是的！\n像妈妈一样干脆利落，真的好厉害！"},{"key":"SCENARIO_s02_01090000_02_0100","text":"我也想变得像小千代前辈那样会做饭！"},{"key":"SCENARIO_s02_01090000_02_0110","text":"果穗又乖巧又踏实\n一定能做到的"},{"key":"SCENARIO_s02_01090000_02_0120","text":"……！\n谢谢您！"},{"key":"SCENARIO_s02_01090000_02_0130","text":"下次帮忙做家务的时候\n我会比平时更努力的！"}]
