[{"key":"SCENARIO_s02_01130000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_01130000_01_0010","text":"制作人！\n怎么样啊！"},{"key":"SCENARIO_s02_01130000_01_0020","text":"写得挺漂亮的哦！\n保持那个状态写下一个字！"},{"key":"SCENARIO_s02_01130000_01_0021","text":"Motion"},{"key":"SCENARIO_s02_01130000_01_0030","text":"呼……"},{"key":"SCENARIO_s02_01130000_01_0031","text":"Motion"},{"key":"SCENARIO_s02_01130000_01_0040","text":"辛苦了！"},{"key":"SCENARIO_s02_01130000_01_0050","text":"剩下的写得怎么样啊？"},{"key":"SCENARIO_s02_01130000_01_0060","text":"你自己看看\n比较好哦！"},{"key":"SCENARIO_s02_01130000_01_0070","text":"……\n说得也是！　我这就去看！"},{"key":"SCENARIO_s02_01130000_01_0080","text":"哈……哈……"},{"key":"SCENARIO_s02_01130000_01_0090","text":"哦，不愧是夏叶\n又快又轻松的样子"},{"key":"SCENARIO_s02_01130000_01_0100","text":"呵呵，当然啦\n就是为了这种时候才锻炼的嘛"},{"key":"SCENARIO_s02_01130000_01_0110","text":"那么，关键的文字是……"},{"key":"SCENARIO_s02_01130000_01_0111","text":"Motion"},{"key":"SCENARIO_s02_01130000_01_0120","text":"哎呀！感觉很不错嘛！"},{"key":"SCENARIO_s02_01130000_01_0130","text":"Producer！\n这个，让果穗帮我们拍下来吧！"},{"key":"SCENARIO_s02_01130000_01_0140","text":"啊，说得也是——\n等等，也不用拉得这么用力吧……"},{"key":"SCENARIO_s02_01130000_01_0150","text":"你在说什么呀！说不定会被风吹散的呢！\n快，赶紧走啦！"}]
