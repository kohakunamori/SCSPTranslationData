[{"key":"SCENARIO_s02_03090000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_03090000_01_0010","text":"…………唔咕"},{"key":"SCENARIO_s02_03090000_01_0020","text":"哈哈，不用着急\n慢慢吃吧，果穗"},{"key":"SCENARIO_s02_03090000_01_0030","text":"…………\n好的！"},{"key":"SCENARIO_s02_03090000_01_0031","text":"Motion"},{"key":"SCENARIO_s02_03090000_01_0040","text":"但是……太好吃了，\n就忍不住想多吃点嘛！"},{"key":"SCENARIO_s02_03090000_01_0050","text":"虽然想一直吃下去，\n但一吃就会没有了……——"},{"key":"SCENARIO_s02_03090000_01_0060","text":"嗯……\n下次去买点炸肉饼当大家的零食吧"},{"key":"SCENARIO_s02_03090000_01_0070","text":"！！\n可以吗！？"},{"key":"SCENARIO_s02_03090000_01_0080","text":"当然\n也算是给当地居民们的一点谢礼嘛"},{"key":"SCENARIO_s02_03090000_01_0090","text":"太好了！"},{"key":"SCENARIO_s02_03090000_01_0091","text":"Motion"},{"key":"SCENARIO_s02_03090000_01_0100","text":"…………"},{"key":"SCENARIO_s02_03090000_01_0110","text":"果穗，你期待这个活动吗？"},{"key":"SCENARIO_s02_03090000_01_0111","text":"Motion"},{"key":"SCENARIO_s02_03090000_01_0120","text":"…………\n好的！"},{"key":"SCENARIO_s02_03090000_01_0130","text":"给我寿喜烧炸肉饼的阿姨、\n会长先生、照相馆的大叔————"},{"key":"SCENARIO_s02_03090000_01_0140","text":"大家都是超级好的人，\n而且我家离得近，还有人记得我呢！"},{"key":"SCENARIO_s02_03090000_01_0150","text":"能跟商店街的大家一起办活动，\n超级厉害，也超级开心！"},{"key":"SCENARIO_s02_03090000_01_0160","text":"所以，为了让活动成功，\n我会加油的！"},{"key":"SCENARIO_s02_03090000_01_0170","text":"哦！\n一起加油吧"},{"key":"SCENARIO_s02_03090000_01_0171","text":"Motion"},{"key":"SCENARIO_s02_03090000_01_0180","text":"……唔咕\n————嗯，真的很好吃啊"}]
