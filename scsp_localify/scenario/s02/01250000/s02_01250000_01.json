[{"key":"SCENARIO_s02_01250000_01_1001","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0010","text":"留下来加练是好事\n但好好休息不是更好吗？"},{"key":"SCENARIO_s02_01250000_01_0020","text":"……嗯\n是啊……谢谢"},{"key":"SCENARIO_s02_01250000_01_0030","text":"别把自己逼得太紧"},{"key":"SCENARIO_s02_01250000_01_0040","text":"……但是\n我不想妥协"},{"key":"SCENARIO_s02_01250000_01_0041","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0050","text":"……"},{"key":"SCENARIO_s02_01250000_01_0060","text":"……？\n怎么了？"},{"key":"SCENARIO_s02_01250000_01_0070","text":"没事"},{"key":"SCENARIO_s02_01250000_01_0080","text":"这次伴舞也会加入\n我觉得可以增加一些变化"},{"key":"SCENARIO_s02_01250000_01_0090","text":"是吗……其他伴舞们也说\n能跟美琴一起合作很高兴呢"},{"key":"SCENARIO_s02_01250000_01_0100","text":"而且\n美琴你看起来也比以前更有活力了"},{"key":"SCENARIO_s02_01250000_01_0110","text":"……嗯\n也许是吧"},{"key":"SCENARIO_s02_01250000_01_0120","text":"看起来会是一场很棒的演出——"},{"key":"SCENARIO_s02_01250000_01_0121","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0130","text":"为了让美琴站上最好的舞台\n我也会努力的"},{"key":"SCENARIO_s02_01250000_01_0140","text":"……\n谢谢"},{"key":"SCENARIO_s02_01250000_01_0150","text":"有什么在意的事，随时跟我说\n我会尽量支持你的"},{"key":"SCENARIO_s02_01250000_01_0160","text":"在意的事……"},{"key":"SCENARIO_s02_01250000_01_0161","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0162","text":"Motion"},{"key":"SCENARIO_s02_01250000_01_0170","text":"没事\n目前，没什么特别的"}]
