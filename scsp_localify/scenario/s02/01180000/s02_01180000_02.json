[{"key":"SCENARIO_s02_01180000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_01180000_02_0010","text":"…………"},{"key":"SCENARIO_s02_01180000_02_0020","text":"（搞什么啊……\n　一个个的，都这样……！）"},{"key":"SCENARIO_s02_01180000_02_0030","text":"（那种事，我没听到）"},{"key":"SCENARIO_s02_01180000_02_0040","text":"（那么堂堂正正地站在舞台上，\n　那么吸引观众的目光）"},{"key":"SCENARIO_s02_01180000_02_0050","text":"（那么地，让那些人────……）"},{"key":"SCENARIO_s02_01180000_02_0051","text":"Motion"},{"key":"SCENARIO_s02_01180000_02_0060","text":"（…………冬优，居然差点被吞没）"},{"key":"SCENARIO_s02_01180000_02_0070","text":"…………！"},{"key":"SCENARIO_s02_01180000_02_0080","text":"！"},{"key":"SCENARIO_s02_01180000_02_0081","text":"Motion"},{"key":"SCENARIO_s02_01180000_02_0090","text":"诶，冬优子……？"},{"key":"SCENARIO_s02_01180000_02_0100","text":"………………糟透了"},{"key":"SCENARIO_s02_01180000_02_0110","text":"那个──"},{"key":"SCENARIO_s02_01180000_02_0120","text":"什么事？\n你来得不巧，冬优要换衣服了"},{"key":"SCENARIO_s02_01180000_02_0130","text":"这、这样啊……！\n抱歉，那我马上出去──不过"},{"key":"SCENARIO_s02_01180000_02_0140","text":"──别说了"},{"key":"SCENARIO_s02_01180000_02_0150","text":"……！"},{"key":"SCENARIO_s02_01180000_02_0160","text":"……什么都不用说\n这只是冬优被吓到了而已"},{"key":"SCENARIO_s02_01180000_02_0170","text":"……所以，不需要你来说什么"}]
