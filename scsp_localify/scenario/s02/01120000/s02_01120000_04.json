[{"key":"SCENARIO_s02_01120000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_01120000_04_0010","text":"那，凛世\n换完水之后到外面来"},{"key":"SCENARIO_s02_01120000_04_0020","text":"嗯……"},{"key":"SCENARIO_s02_01120000_04_0030","text":"……"},{"key":"SCENARIO_s02_01120000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_01120000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_01120000_04_0040","text":"呵呵……"},{"key":"SCENARIO_s02_01120000_04_0050","text":"（真的……\n　留下了……美好的回忆……）"},{"key":"SCENARIO_s02_01120000_04_0060","text":"（等回到家中……）"},{"key":"SCENARIO_s02_01120000_04_0070","text":"（写写日记……\n　记录下来吧……）"},{"key":"SCENARIO_s02_01120000_04_0080","text":"（……要从哪一件……\n　开始写起呢……）"},{"key":"SCENARIO_s02_01120000_04_0090","text":"（无论哪一件事……\n　想必都会……美好地留存下来）"},{"key":"SCENARIO_s02_01120000_04_0100","text":"……"},{"key":"SCENARIO_s02_01120000_04_0110","text":"（然后……）"},{"key":"SCENARIO_s02_01120000_04_0120","text":"（与您一同\n　度过的时光……也是……）"},{"key":"SCENARIO_s02_01120000_04_0130","text":"呵呵……"},{"key":"SCENARIO_s02_01120000_04_0003","text":"Motion"},{"key":"SCENARIO_s02_01120000_04_0140","text":"（制作人大人……）"},{"key":"SCENARIO_s02_01120000_04_0004","text":"Motion"},{"key":"SCENARIO_s02_01120000_04_0150","text":"非常感谢……"}]
