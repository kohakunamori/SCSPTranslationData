[{"key":"SCENARIO_s02_01120000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_01120000_03_0010","text":"……"},{"key":"SCENARIO_s02_01120000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_01120000_03_0020","text":"？"},{"key":"SCENARIO_s02_01120000_03_0030","text":"哇……！"},{"key":"SCENARIO_s02_01120000_03_0040","text":"！\n哦……凛世啊……"},{"key":"SCENARIO_s02_01120000_03_0050","text":"呵呵……\n成功了……"},{"key":"SCENARIO_s02_01120000_03_0060","text":"看这样子\n你是迷上试胆大会了吧？"},{"key":"SCENARIO_s02_01120000_03_0070","text":"能让大家……玩得开心……我十分高兴……"},{"key":"SCENARIO_s02_01120000_03_0080","text":"制作人大人……\n觉得……如何……？"},{"key":"SCENARIO_s02_01120000_03_0090","text":"当然很有趣啊\n这种活动真好"},{"key":"SCENARIO_s02_01120000_03_0100","text":"……！"},{"key":"SCENARIO_s02_01120000_03_0110","text":"那么……\n为了给这份心情……锦上添花……"},{"key":"SCENARIO_s02_01120000_03_0120","text":"请容我……献上一个……怪谈……"}]
