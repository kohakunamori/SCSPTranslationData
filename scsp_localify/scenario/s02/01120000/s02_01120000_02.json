[{"key":"SCENARIO_s02_01120000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0010","text":"……"},{"key":"SCENARIO_s02_01120000_02_0020","text":"请！"},{"key":"SCENARIO_s02_01120000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0030","text":"制作人大人……\n能占用您……一点时间吗……？"},{"key":"SCENARIO_s02_01120000_02_0040","text":"嗯？　好啊，怎么了？"},{"key":"SCENARIO_s02_01120000_02_0050","text":"想请您……到外面……"},{"key":"SCENARIO_s02_01120000_02_0002","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0060","text":"哦哦……星星好漂亮啊！\n原来能看得这么清楚"},{"key":"SCENARIO_s02_01120000_02_0070","text":"……好的"},{"key":"SCENARIO_s02_01120000_02_0080","text":"制作人阁下……"},{"key":"SCENARIO_s02_01120000_02_0090","text":"嗯？"},{"key":"SCENARIO_s02_01120000_02_0100","text":"……集训……\n非常开心……"},{"key":"SCENARIO_s02_01120000_02_0110","text":"……是吗\n凛世不是第一次参加这种了吧？"},{"key":"SCENARIO_s02_01120000_02_0120","text":"虽然……有过几次……"},{"key":"SCENARIO_s02_01120000_02_0130","text":"但是……"},{"key":"SCENARIO_s02_01120000_02_0003","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0004","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0005","text":"Motion"},{"key":"SCENARIO_s02_01120000_02_0140","text":"但与大家一同的集训……\n格外……美好……"}]
