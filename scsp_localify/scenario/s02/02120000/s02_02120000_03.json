[{"key":"SCENARIO_s02_02120000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02120000_03_0010","text":"……景色真不错啊"},{"key":"SCENARIO_s02_02120000_03_0020","text":"嗯……"},{"key":"SCENARIO_s02_02120000_03_0030","text":"街道被晚霞染红了"},{"key":"SCENARIO_s02_02120000_03_0040","text":"……呵呵……"},{"key":"SCENARIO_s02_02120000_03_0050","text":"……？"},{"key":"SCENARIO_s02_02120000_03_0060","text":"前几日……\n智代子小姐……也说了相似的话……"},{"key":"SCENARIO_s02_02120000_03_0070","text":"哦，真巧啊\n你跟智代子来过这附近吗？"},{"key":"SCENARIO_s02_02120000_03_0080","text":"不……"},{"key":"SCENARIO_s02_02120000_03_0090","text":"与智代子小姐……还有树里小姐一起……"},{"key":"SCENARIO_s02_02120000_03_0100","text":"去了坡道上的……面包店……"},{"key":"SCENARIO_s02_02120000_03_0110","text":"坡道上的面包店，是吗……"},{"key":"SCENARIO_s02_02120000_03_0120","text":"特意爬坡去买的话，\n那里一定卖着好吃的面包吧"},{"key":"SCENARIO_s02_02120000_03_0130","text":"是的……\n非常好吃……"},{"key":"SCENARIO_s02_02120000_03_0140","text":"然后……\n买完面包……走出店门时……"},{"key":"SCENARIO_s02_02120000_03_0150","text":"眼前……\n是美丽的夕阳……与绝佳的景色……"},{"key":"SCENARIO_s02_02120000_03_0160","text":"原来如此\n所以你们大家一起看了那片景色啊"},{"key":"SCENARIO_s02_02120000_03_0170","text":"嗯……"},{"key":"SCENARIO_s02_02120000_03_0180","text":"大家一起……爬上坡后看到的夕阳……\n格外美丽……"}]
