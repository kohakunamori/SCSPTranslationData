[{"key":"SCENARIO_s02_01200000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_01200000_04_0010","text":"辛苦了，透"},{"key":"SCENARIO_s02_01200000_04_0020","text":"————辛苦了"},{"key":"SCENARIO_s02_01200000_04_0030","text":"很棒的舞台"},{"key":"SCENARIO_s02_01200000_04_0040","text":"嗯，谢谢"},{"key":"SCENARIO_s02_01200000_04_0050","text":"观众们\n光顾着看烟花了"},{"key":"SCENARIO_s02_01200000_04_0060","text":"……是啊\n不过，我觉得大家是最闪耀的"},{"key":"SCENARIO_s02_01200000_04_0070","text":"……呵呵"},{"key":"SCENARIO_s02_01200000_04_0080","text":"很开心\n超级开心"},{"key":"SCENARIO_s02_01200000_04_0090","text":"嗯\n那就好"},{"key":"SCENARIO_s02_01200000_04_0091","text":"Motion"},{"key":"SCENARIO_s02_01200000_04_0100","text":"嗯——"}]
