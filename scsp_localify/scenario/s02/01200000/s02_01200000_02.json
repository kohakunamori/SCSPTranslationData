[{"key":"SCENARIO_s02_01200000_02_0051","text":"Motion"},{"key":"SCENARIO_s02_01200000_02_0010","text":"──有吗\n什么规定之类的"},{"key":"SCENARIO_s02_01200000_02_0020","text":"……诶？"},{"key":"SCENARIO_s02_01200000_02_0030","text":"好像说\n没有觉悟就不行，当偶像"},{"key":"SCENARIO_s02_01200000_02_0040","text":"这种事……\n是谁跟你说的？"},{"key":"SCENARIO_s02_01200000_02_0050","text":"诶？　网上？"},{"key":"SCENARIO_s02_01200000_02_0060","text":"有规定之类的吗\n当偶像"},{"key":"SCENARIO_s02_01200000_02_0070","text":"……不，那种事不用在意"},{"key":"SCENARIO_s02_01200000_02_0080","text":"诶？"},{"key":"SCENARIO_s02_01200000_02_0090","text":"怎么说呢……\n透，就是透啊"},{"key":"SCENARIO_s02_01200000_02_0100","text":"……哦"}]
