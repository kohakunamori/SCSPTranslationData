[{"key":"SCENARIO_s02_01200000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_01200000_03_0010","text":"花火大会的事，你们商量过了？"},{"key":"SCENARIO_s02_01200000_03_0020","text":"啊\n小糸告诉你的？"},{"key":"SCENARIO_s02_01200000_03_0030","text":"嗯，她看起来特别开心"},{"key":"SCENARIO_s02_01200000_03_0040","text":"呵呵"},{"key":"SCENARIO_s02_01200000_03_0050","text":"毕竟是海边嘛"},{"key":"SCENARIO_s02_01200000_03_0060","text":"……大家认真商量过了啊"},{"key":"SCENARIO_s02_01200000_03_0070","text":"啊——……嗯"},{"key":"SCENARIO_s02_01200000_03_0080","text":"因为想去，所以想去"},{"key":"SCENARIO_s02_01200000_03_0090","text":"……谢谢\n当天就拜托你们了"},{"key":"SCENARIO_s02_01200000_03_0100","text":"嗯"}]
