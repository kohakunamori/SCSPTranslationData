[{"key":"SCENARIO_s02_03040000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_03040000_03_0000","text":"导演"},{"key":"SCENARIO_s02_03040000_03_0010","text":"辛苦了～！"},{"key":"SCENARIO_s02_03040000_03_0002","text":"摄影师"},{"key":"SCENARIO_s02_03040000_03_0020","text":"拍摄时间拖了这么久，非常抱歉\n感谢您的配合！"},{"key":"SCENARIO_s02_03040000_03_0030","text":"嘿嘿～，没关系的\n是很愉快的拍摄！"},{"key":"SCENARIO_s02_03040000_03_0040","text":"大家也辛苦了～！\n如果能拍出好的广告就太好了～"},{"key":"SCENARIO_s02_03040000_03_0041","text":"Motion"},{"key":"SCENARIO_s02_03040000_03_0003","text":"广告公司职员"},{"key":"SCENARIO_s02_03040000_03_0050","text":"哎呀，多亏了L'Antica的各位，\n感觉能做出很棒的宣传呢……！"},{"key":"SCENARIO_s02_03040000_03_0004","text":"化妆品公司职员"},{"key":"SCENARIO_s02_03040000_03_0060","text":"是的，我觉得已经捕捉到了──"},{"key":"SCENARIO_s02_03040000_03_0070","text":"“Magia L'Antica”\n那些向往游刃有余的小恶魔的女孩们的心，牢牢抓住了！"},{"key":"SCENARIO_s02_03040000_03_0080","text":"嘿嘿～，太好了\n因为有这么多人为我们付出……"},{"key":"SCENARIO_s02_03040000_03_0090","text":"我觉得不把自己能做的事\n全～部做出来就太可惜了"},{"key":"SCENARIO_s02_03040000_03_0100","text":"是的，对L'Antica来说\n也是一次很好的经验，非常感谢"},{"key":"SCENARIO_s02_03040000_03_0005","text":"广告公司职员"},{"key":"SCENARIO_s02_03040000_03_0110","text":"呵呵，您这么说我们也很开心"},{"key":"SCENARIO_s02_03040000_03_0120","text":"花絮视频等后续还有很多需要麻烦各位的地方\n今后也请多多关照"},{"key":"SCENARIO_s02_03040000_03_0121","text":"Motion"},{"key":"SCENARIO_s02_03040000_03_0130","text":"制作人，\n加长轿车的拍摄，超～级厉害呢～！"},{"key":"SCENARIO_s02_03040000_03_0140","text":"那么多人为L'Antica\n闪闪发光而努力……"},{"key":"SCENARIO_s02_03040000_03_0150","text":"我啊，一回想起来，\n现在还是会热泪盈眶呢～……"},{"key":"SCENARIO_s02_03040000_03_0151","text":"Motion"},{"key":"SCENARIO_s02_03040000_03_0160","text":"哈哈，我懂"},{"key":"SCENARIO_s02_03040000_03_0170","text":"其他公司的人夸L'Antica的时候，\n我也真的很开心"},{"key":"SCENARIO_s02_03040000_03_0180","text":"真的～？那我更要努力，\n让制作人变得更～加开心才行呢～！"},{"key":"SCENARIO_s02_03040000_03_0181","text":"Motion"}]
