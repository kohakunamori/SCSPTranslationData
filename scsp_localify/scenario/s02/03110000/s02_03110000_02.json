[{"key":"SCENARIO_s02_03110000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0002","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0010","text":"……"},{"key":"SCENARIO_s02_03110000_02_0011","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0020","text":"好——，请进—！"},{"key":"SCENARIO_s02_03110000_02_0021","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0030","text":"辛苦了，树里"},{"key":"SCENARIO_s02_03110000_02_0040","text":"啊，是制作人啊\n怎么了？"},{"key":"SCENARIO_s02_03110000_02_0050","text":"导演给了我一些饮品慰问品"},{"key":"SCENARIO_s02_03110000_02_0060","text":"说是焙茶拿铁和蕨饼饮品"},{"key":"SCENARIO_s02_03110000_02_0070","text":"树里要哪个？\n据说是最近很火的那家店哦"},{"key":"SCENARIO_s02_03110000_02_0071","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0072","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0080","text":"……不好意思，现在先不了\n回头我会好好跟导演道谢的"},{"key":"SCENARIO_s02_03110000_02_0090","text":"这样啊"},{"key":"SCENARIO_s02_03110000_02_0100","text":"那个，树里\n关于会长的事────"},{"key":"SCENARIO_s02_03110000_02_0110","text":"……啊，抱歉！\n我肯定不是平时的我了"},{"key":"SCENARIO_s02_03110000_02_0120","text":"树里……"},{"key":"SCENARIO_s02_03110000_02_0130","text":"不过……\n马上就要正式演出了，我会好好打起精神的"},{"key":"SCENARIO_s02_03110000_02_0131","text":"Motion"},{"key":"SCENARIO_s02_03110000_02_0140","text":"有什么我能帮上忙的，尽管说\n我就是为此而存在的"},{"key":"SCENARIO_s02_03110000_02_0150","text":"……谢谢你，制作人"},{"key":"SCENARIO_s02_03110000_02_0160","text":"──正说着，\n差不多该去待机了吧"},{"key":"SCENARIO_s02_03110000_02_0170","text":"……是啊\n今天我也会好好看着你的，树里"},{"key":"SCENARIO_s02_03110000_02_0180","text":"嗯\n那我出发了！"}]
