[{"key":"SCENARIO_s02_02080000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0010","text":"啊……！"},{"key":"SCENARIO_s02_02080000_03_0020","text":"（又写坏了……）"},{"key":"SCENARIO_s02_02080000_03_0030","text":"……"},{"key":"SCENARIO_s02_02080000_03_0040","text":"（……不行啊……\n　不集中精神……）"},{"key":"SCENARIO_s02_02080000_03_0050","text":"……\n制作人……"},{"key":"SCENARIO_s02_02080000_03_0055","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0056","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0060","text":"啊，抱歉\n纸的声音吵到你了吧"},{"key":"SCENARIO_s02_02080000_03_0065","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0070","text":"扑通……扑通……\n心脏的声音……"},{"key":"SCENARIO_s02_02080000_03_0080","text":"……\n那个————"},{"key":"SCENARIO_s02_02080000_03_0090","text":"那个……\n一定……"},{"key":"SCENARIO_s02_02080000_03_0100","text":"纸……还有笔……\n文字……都在听着————"},{"key":"SCENARIO_s02_02080000_03_0110","text":"制作人的……\n心脏的声音……"},{"key":"SCENARIO_s02_02080000_03_0120","text":"……雾子"},{"key":"SCENARIO_s02_02080000_03_0125","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0130","text":"扑通扑通……好快……\n还有点……硬邦邦的……"},{"key":"SCENARIO_s02_02080000_03_0140","text":"……嗯"},{"key":"SCENARIO_s02_02080000_03_0150","text":"可能……有点被吓到了……"},{"key":"SCENARIO_s02_02080000_03_0160","text":"……哈哈，嗯\n我自己也知道……有点烦躁了————"},{"key":"SCENARIO_s02_02080000_03_0170","text":"————吓到你了……不好意思\n纸和笔，还有字……"},{"key":"SCENARIO_s02_02080000_03_0175","text":"Motion"},{"key":"SCENARIO_s02_02080000_03_0180","text":"……雾子的心脏也是"},{"key":"SCENARIO_s02_02080000_03_0185","text":"Motion"}]
