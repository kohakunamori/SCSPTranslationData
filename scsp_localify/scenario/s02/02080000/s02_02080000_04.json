[{"key":"SCENARIO_s02_02080000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_02080000_04_0010","text":"啊……\n窗户……"},{"key":"SCENARIO_s02_02080000_04_0020","text":"哦，灯亮着\n可能有人回来了"},{"key":"SCENARIO_s02_02080000_04_0030","text":"哇……\n呵呵……"},{"key":"SCENARIO_s02_02080000_04_0040","text":"（……难得\n　既然有人在……）"},{"key":"SCENARIO_s02_02080000_04_0050","text":"雾子，回事务所之前\n能顺路去一下便利店吗？"},{"key":"SCENARIO_s02_02080000_04_0060","text":"……？"},{"key":"SCENARIO_s02_02080000_04_0070","text":"想买点茶点回去"},{"key":"SCENARIO_s02_02080000_04_0080","text":"哇……"},{"key":"SCENARIO_s02_02080000_04_0090","text":"呵呵……\n那个……我也……"},{"key":"SCENARIO_s02_02080000_04_0095","text":"Motion"},{"key":"SCENARIO_s02_02080000_04_0100","text":"哈哈，买了不少啊"},{"key":"SCENARIO_s02_02080000_04_0110","text":"呵呵……\n沙沙……沙沙……"},{"key":"SCENARIO_s02_02080000_04_0120","text":"晃荡……晃荡……"},{"key":"SCENARIO_s02_02080000_04_0130","text":"好开心……\n好温暖的声音……"},{"key":"SCENARIO_s02_02080000_04_0140","text":"……嗯"},{"key":"SCENARIO_s02_02080000_04_0150","text":"（为了守护那份温暖）"},{"key":"SCENARIO_s02_02080000_04_0160","text":"（我得变得更能\n　支撑大家才行）"},{"key":"SCENARIO_s02_02080000_04_0165","text":"Motion"},{"key":"SCENARIO_s02_02080000_04_0170","text":"辛苦了\n我回来了"},{"key":"SCENARIO_s02_02080000_04_0180","text":"呵呵……\n我回来了……"}]
