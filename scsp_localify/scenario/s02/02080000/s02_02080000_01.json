[{"key":"SCENARIO_s02_02080000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_02080000_01_0010","text":"啊……"},{"key":"SCENARIO_s02_02080000_01_0020","text":"快没了……"},{"key":"SCENARIO_s02_02080000_01_0025","text":"Motion"},{"key":"SCENARIO_s02_02080000_01_0030","text":"……"},{"key":"SCENARIO_s02_02080000_01_0035","text":"Motion"},{"key":"SCENARIO_s02_02080000_01_0040","text":"咦，满了"},{"key":"SCENARIO_s02_02080000_01_0050","text":"（正想着差不多该加了\n　有人帮我加了吗）"},{"key":"SCENARIO_s02_02080000_01_0060","text":"早上好……\n水……好喝吗……"},{"key":"SCENARIO_s02_02080000_01_0065","text":"Motion"},{"key":"SCENARIO_s02_02080000_01_0070","text":"辛苦了"},{"key":"SCENARIO_s02_02080000_01_0080","text":"哇……制作人……\n早上好……"},{"key":"SCENARIO_s02_02080000_01_0090","text":"早上好，雾子总是来得很早呢"},{"key":"SCENARIO_s02_02080000_01_0100","text":"呵呵……\n因为……你在等我……"},{"key":"SCENARIO_s02_02080000_01_0110","text":"……哈哈\n今天也很有精神呢"},{"key":"SCENARIO_s02_02080000_01_0120","text":"嗯……"},{"key":"SCENARIO_s02_02080000_01_0130","text":"话说回来，雾子真厉害\n日程再紧也从不落下日常的功课"},{"key":"SCENARIO_s02_02080000_01_0140","text":"我啊，一忙起来吃饭就随便对付\n起床也越来越晚"},{"key":"SCENARIO_s02_02080000_01_0150","text":"……？"},{"key":"SCENARIO_s02_02080000_01_0155","text":"Motion"},{"key":"SCENARIO_s02_02080000_01_0160","text":"但是……\n呵呵……"},{"key":"SCENARIO_s02_02080000_01_0170","text":"嗯？"},{"key":"SCENARIO_s02_02080000_01_0180","text":"像这样……不会忘记……\n对我微笑……"}]
