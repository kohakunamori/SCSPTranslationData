[{"key":"SCENARIO_s02_02080000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02080000_02_0010","text":"这一期……\n是恋钟酱……"},{"key":"SCENARIO_s02_02080000_02_0020","text":"下一期……\n是摩美美酱……"},{"key":"SCENARIO_s02_02080000_02_0030","text":"然后，这边的时尚杂志\n有咲耶"},{"key":"SCENARIO_s02_02080000_02_0040","text":"偶像专门志上是结华"},{"key":"SCENARIO_s02_02080000_02_0050","text":"最新一期"},{"key":"SCENARIO_s02_02080000_02_0060","text":"雾子"},{"key":"SCENARIO_s02_02080000_02_0070","text":"哇……\n呵呵……"},{"key":"SCENARIO_s02_02080000_02_0080","text":"这样摆在一起真壮观啊"},{"key":"SCENARIO_s02_02080000_02_0090","text":"大家……大家……\n都在笑……"},{"key":"SCENARIO_s02_02080000_02_0100","text":"大家……大家……"},{"key":"SCENARIO_s02_02080000_02_0110","text":"都是……最喜欢的人……"},{"key":"SCENARIO_s02_02080000_02_0120","text":"……嗯"},{"key":"SCENARIO_s02_02080000_02_0130","text":"呵呵……\n能为我……祈祷吗……"},{"key":"SCENARIO_s02_02080000_02_0140","text":"当然\n我也一起祈祷"},{"key":"SCENARIO_s02_02080000_02_0150","text":"愿大家的今天……\n是美好的一天……"},{"key":"SCENARIO_s02_02080000_02_0160","text":"愿大家所在的……这个世界……\n是美好的地方……"},{"key":"SCENARIO_s02_02080000_02_0170","text":"愿大家……永远……"},{"key":"SCENARIO_s02_02080000_02_0180","text":"永远都是……这样的大家——————"},{"key":"SCENARIO_s02_02080000_02_0185","text":"Motion"}]
