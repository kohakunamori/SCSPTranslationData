[{"key":"SCENARIO_s02_01210000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0010","text":"辛苦了，圆香"},{"key":"SCENARIO_s02_01210000_04_0020","text":"……辛苦了"},{"key":"SCENARIO_s02_01210000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0007","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0030","text":"怎么样，舞台"},{"key":"SCENARIO_s02_01210000_04_0040","text":"……"},{"key":"SCENARIO_s02_01210000_04_0050","text":"嗯，确实那个……\n观众光顾着看烟花了"},{"key":"SCENARIO_s02_01210000_04_0060","text":"不过，如果有什么收获的话──"},{"key":"SCENARIO_s02_01210000_04_0070","text":"…………收获？"},{"key":"SCENARIO_s02_01210000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0008","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0004","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0080","text":"谁知道呢"},{"key":"SCENARIO_s02_01210000_04_0003","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0005","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0090","text":"圆香……"},{"key":"SCENARIO_s02_01210000_04_0006","text":"Motion"},{"key":"SCENARIO_s02_01210000_04_0100","text":"…………"}]
