[{"key":"SCENARIO_s02_01210000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_01210000_02_0010","text":"──圆香……！"},{"key":"SCENARIO_s02_01210000_02_0020","text":"……我正要回去"},{"key":"SCENARIO_s02_01210000_02_0030","text":"抱歉，节目的事……\n最后还是像圆香担心的那样──"},{"key":"SCENARIO_s02_01210000_02_0040","text":"…………\n是啊"},{"key":"SCENARIO_s02_01210000_02_0050","text":"嗯，所以────"},{"key":"SCENARIO_s02_01210000_02_0060","text":"所以？\n……什么事"},{"key":"SCENARIO_s02_01210000_02_0070","text":"……下次我一定会争取到让你满意的工作"},{"key":"SCENARIO_s02_01210000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_01210000_02_0080","text":"辛苦了"},{"key":"SCENARIO_s02_01210000_02_0090","text":"啊，嗯\n抱歉，耽误你时间了"},{"key":"SCENARIO_s02_01210000_02_0002","text":"Motion"},{"key":"SCENARIO_s02_01210000_02_0003","text":"Motion"},{"key":"SCENARIO_s02_01210000_02_0100","text":"…………"}]
