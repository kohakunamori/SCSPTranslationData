[{"key":"SCENARIO_s02_01210000_03_0003","text":"Motion"},{"key":"SCENARIO_s02_01210000_03_0010","text":"谢谢你，花火大会的事"},{"key":"SCENARIO_s02_01210000_03_0020","text":"──您在说什么"},{"key":"SCENARIO_s02_01210000_03_0030","text":"圆香也决定要去了吧？\n谢谢"},{"key":"SCENARIO_s02_01210000_03_0040","text":"又不是为了您才去的\n没有必要感谢"},{"key":"SCENARIO_s02_01210000_03_0050","text":"啊不，说得也是\n我也觉得是这样……"},{"key":"SCENARIO_s02_01210000_03_0060","text":"……只是有点意外"},{"key":"SCENARIO_s02_01210000_03_0070","text":"…………"},{"key":"SCENARIO_s02_01210000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_01210000_03_0002","text":"Motion"},{"key":"SCENARIO_s02_01210000_03_0080","text":"……没什么，去的理由"},{"key":"SCENARIO_s02_01210000_03_0090","text":"只是──────"},{"key":"SCENARIO_s02_01210000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_01210000_03_0100","text":"不，没什么"}]
