[{"key":"SCENARIO_s02_02250000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_02250000_04_0010","text":"……"},{"key":"SCENARIO_s02_02250000_04_0020","text":"好的"},{"key":"SCENARIO_s02_02250000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_02250000_04_0030","text":"辛苦了，美琴"},{"key":"SCENARIO_s02_02250000_04_0040","text":"辛苦了"},{"key":"SCENARIO_s02_02250000_04_0050","text":"我带了果冻饮料和水\n不介意的话要不要来点？"},{"key":"SCENARIO_s02_02250000_04_0060","text":"嗯\n那我就不客气了"},{"key":"SCENARIO_s02_02250000_04_0070","text":"……刚才在确认动作吗？"},{"key":"SCENARIO_s02_02250000_04_0080","text":"你怎么知道的？"},{"key":"SCENARIO_s02_02250000_04_0090","text":"不，就是感觉\n……哈哈，果然猜中了"},{"key":"SCENARIO_s02_02250000_04_0100","text":"该做的我都做了，但是……\n不到最后一刻都不能松懈"},{"key":"SCENARIO_s02_02250000_04_0110","text":"我觉得你很了不起，美琴的这种地方"},{"key":"SCENARIO_s02_02250000_04_0120","text":"发自内心地敬佩你"},{"key":"SCENARIO_s02_02250000_04_0130","text":"这是我一直以来都在做的事\n不是什么特别的事"},{"key":"SCENARIO_s02_02250000_04_0140","text":"是吗……嗯，也是啊\n今天的舞台我也很期待"},{"key":"SCENARIO_s02_02250000_04_0150","text":"……那么，待会儿见"},{"key":"SCENARIO_s02_02250000_04_0160","text":"嗯，待会儿见"},{"key":"SCENARIO_s02_02250000_04_0170","text":"美琴……\n美琴心中的SHHis，是为了表达什么而────"},{"key":"SCENARIO_s02_02250000_04_0180","text":"……"}]
