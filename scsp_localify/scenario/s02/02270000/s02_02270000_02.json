[{"key":"SCENARIO_s02_02270000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02270000_02_0010","text":"辛苦了——"},{"key":"SCENARIO_s02_02270000_02_0020","text":"诶——，制作人──！\n怎么了？"},{"key":"SCENARIO_s02_02270000_02_0030","text":"没什么……刚好有点空闲\n就来看看羽那的情况"},{"key":"SCENARIO_s02_02270000_02_0040","text":"呵呵，这样啊\n好开心～"},{"key":"SCENARIO_s02_02270000_02_0050","text":"──啊，不过\n不好意思，我正在休息中？"},{"key":"SCENARIO_s02_02270000_02_0060","text":"不不，能看到羽那好好休息的样子\n我也很高兴"},{"key":"SCENARIO_s02_02270000_02_0070","text":"啊哈、那是什么话——"},{"key":"SCENARIO_s02_02270000_02_0080","text":"不过，等休息结束后\n我会让制作人看到更好的表现的哦？"},{"key":"SCENARIO_s02_02270000_02_0090","text":"哈哈，嗯\n我很期待！"},{"key":"SCENARIO_s02_02270000_02_0095","text":"舞蹈教练"},{"key":"SCENARIO_s02_02270000_02_0100","text":"──好！那休息结束！\n羽那酱，继续吧！"},{"key":"SCENARIO_s02_02270000_02_0110","text":"好——"},{"key":"SCENARIO_s02_02270000_02_0111","text":"Motion"},{"key":"SCENARIO_s02_02270000_02_0120","text":"……？"},{"key":"SCENARIO_s02_02270000_02_0130","text":"呵呵\n我去加油了哦？"},{"key":"SCENARIO_s02_02270000_02_0140","text":"──噢！"},{"key":"SCENARIO_s02_02270000_02_0141","text":"Motion"},{"key":"SCENARIO_s02_02270000_02_0150","text":"…………"},{"key":"SCENARIO_s02_02270000_02_0160","text":"（羽那，比以前\n　更会展现舞蹈了）"},{"key":"SCENARIO_s02_02270000_02_0170","text":"（应该是托了\n　作为CoMETIK那场演唱会的福吧……）"},{"key":"SCENARIO_s02_02270000_02_0180","text":"…………"}]
