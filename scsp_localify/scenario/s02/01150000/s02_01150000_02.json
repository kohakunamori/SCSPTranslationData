[{"key":"SCENARIO_s02_01150000_02_0010","text":"──呜哇……！"},{"key":"SCENARIO_s02_01150000_02_0020","text":"Producer先生……\n重新装填……"},{"key":"SCENARIO_s02_01150000_02_0030","text":"……这是……\n第３次说了……"},{"key":"SCENARIO_s02_01150000_02_0031","text":"Motion"},{"key":"SCENARIO_s02_01150000_02_0040","text":"……哎呀，抱歉……"},{"key":"SCENARIO_s02_01150000_02_0050","text":"没事……\n第一次的话，没办法的……"},{"key":"SCENARIO_s02_01150000_02_0060","text":"…………不过\n千雪小姐，更……厉害……"},{"key":"SCENARIO_s02_01150000_02_0070","text":"唔……\n真、真是惭愧……"},{"key":"SCENARIO_s02_01150000_02_0080","text":"嗯……"},{"key":"SCENARIO_s02_01150000_02_0090","text":"………"},{"key":"SCENARIO_s02_01150000_02_0100","text":"对我来说有点难，不过\n看到你和千雪玩得开心就好了"},{"key":"SCENARIO_s02_01150000_02_0101","text":"Motion"},{"key":"SCENARIO_s02_01150000_02_0110","text":"嘿嘿……\n嗯……！"},{"key":"SCENARIO_s02_01150000_02_0120","text":"千雪小姐……\n很有打游戏的天赋……！"},{"key":"SCENARIO_s02_01150000_02_0130","text":"以后……\n会变得……更强……！"},{"key":"SCENARIO_s02_01150000_02_0140","text":"哈哈，是吗\n那可真厉害啊……！"},{"key":"SCENARIO_s02_01150000_02_0151","text":"Motion"},{"key":"SCENARIO_s02_01150000_02_0150","text":"──甜花\n能跟千雪成为好朋友，真好"},{"key":"SCENARIO_s02_01150000_02_0160","text":"……！"},{"key":"SCENARIO_s02_01150000_02_0170","text":"嗯、嗯……"},{"key":"SCENARIO_s02_01150000_02_0180","text":"……诶嘿嘿……"}]
