[{"key":"SCENARIO_s02_01150000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0010","text":"…………"},{"key":"SCENARIO_s02_01150000_01_0020","text":"甜花\n关于下次的报道────"},{"key":"SCENARIO_s02_01150000_01_0030","text":"──哦，在打游戏吗……？"},{"key":"SCENARIO_s02_01150000_01_0040","text":"抱歉，不是什么急事\n等你玩到告一段落再说吧"},{"key":"SCENARIO_s02_01150000_01_0050","text":"……啊，那个……\n不、不是的……！"},{"key":"SCENARIO_s02_01150000_01_0051","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0052","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0060","text":"现在……\n不是在打……游戏……"},{"key":"SCENARIO_s02_01150000_01_0070","text":"是在……查东西……！"},{"key":"SCENARIO_s02_01150000_01_0071","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0080","text":"想在报道里介绍一个推荐的地方……\n想介绍书咖……！"},{"key":"SCENARIO_s02_01150000_01_0090","text":"哦……！\n书咖──就是能看书的地方对吧？"},{"key":"SCENARIO_s02_01150000_01_0100","text":"嗯、嗯……！\n……奇、奇怪……吗……？"},{"key":"SCENARIO_s02_01150000_01_0110","text":"不，一点都不奇怪哦"},{"key":"SCENARIO_s02_01150000_01_0120","text":"只是……没想到甜花会喜欢那种地方\n觉得有点意外"},{"key":"SCENARIO_s02_01150000_01_0121","text":"Motion"},{"key":"SCENARIO_s02_01150000_01_0130","text":"啊……\n果、果然……？"},{"key":"SCENARIO_s02_01150000_01_0140","text":"……？"},{"key":"SCENARIO_s02_01150000_01_0150","text":"──啊\n那、那个……"},{"key":"SCENARIO_s02_01150000_01_0160","text":"但、但是……\n甜花也喜欢哦……！那种地方……！！"}]
