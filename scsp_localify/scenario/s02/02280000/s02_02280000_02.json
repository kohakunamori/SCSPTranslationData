[{"key":"SCENARIO_s02_02280000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0009","text":"训练师"},{"key":"SCENARIO_s02_02280000_02_0010","text":"────斑鸠小姐……没有来呢"},{"key":"SCENARIO_s02_02280000_02_0020","text":"是、是的……是不是前面的行程\n延误了呢……"},{"key":"SCENARIO_s02_02280000_02_0030","text":"是啊，她好像很忙呢\n──那我们先开始练习吧"},{"key":"SCENARIO_s02_02280000_02_0031","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0032","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0040","text":"『是吗……路加\n　到最后还是没有来啊』"},{"key":"SCENARIO_s02_02280000_02_0050","text":"是的──……"},{"key":"SCENARIO_s02_02280000_02_0060","text":"好不容易，制作人\n特意安排了和路加酱的练习──"},{"key":"SCENARIO_s02_02280000_02_0070","text":"路加酱……\nCoMETIK已经……"},{"key":"SCENARIO_s02_02280000_02_0080","text":"『阳希──……』"},{"key":"SCENARIO_s02_02280000_02_0090","text":"『不不，不是那样的\n　是我联络的方式不对』"},{"key":"SCENARIO_s02_02280000_02_0100","text":"…………"},{"key":"SCENARIO_s02_02280000_02_0110","text":"路加酱……在CoMETIK的演唱会之后──"},{"key":"SCENARIO_s02_02280000_02_0111","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0112","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0113","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0114","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0115","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0116","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0120","text":"没有……和我握手────"},{"key":"SCENARIO_s02_02280000_02_0130","text":"对路加酱来说，\n也许那就是结束了吧"},{"key":"SCENARIO_s02_02280000_02_0140","text":"如果是那样……那也没办法了"},{"key":"SCENARIO_s02_02280000_02_0150","text":"『…………』"},{"key":"SCENARIO_s02_02280000_02_0151","text":"Motion"},{"key":"SCENARIO_s02_02280000_02_0160","text":"────我……\n不再去想『希望别人怎么做』了"},{"key":"SCENARIO_s02_02280000_02_0170","text":"从今以后\n我要想『我自己想怎么做』"},{"key":"SCENARIO_s02_02280000_02_0180","text":"不这样的话，就无法前进"}]
