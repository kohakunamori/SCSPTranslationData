[{"key":"SCENARIO_s02_02150000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0002","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0010","text":"…………\n……唔嗯…………"},{"key":"SCENARIO_s02_02150000_01_0011","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0020","text":"……嘿嘿……\n…………吃得好饱……"},{"key":"SCENARIO_s02_02150000_01_0030","text":"──喂—……\n……甜花—……"},{"key":"SCENARIO_s02_02150000_01_0031","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0040","text":"……嗯嗯……咦\n……制作人……？"},{"key":"SCENARIO_s02_02150000_01_0050","text":"嗯\n哈哈，醒了吗。早上好"},{"key":"SCENARIO_s02_02150000_01_0060","text":"……嗯—……\n……蛋糕呢……？"},{"key":"SCENARIO_s02_02150000_01_0070","text":"蛋糕？"},{"key":"SCENARIO_s02_02150000_01_0080","text":"…………啊呜……\n……可能，是梦……"},{"key":"SCENARIO_s02_02150000_01_0081","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0090","text":"……不过\n好像有股好闻的味道……？"},{"key":"SCENARIO_s02_02150000_01_0100","text":"啊，是这个华夫饼的味道吗？\n我买来当伴手礼的"},{"key":"SCENARIO_s02_02150000_01_0110","text":"虽然不太好意思把甜花叫醒……\n但毕竟是刚烤好的，想着趁热给你吃"},{"key":"SCENARIO_s02_02150000_01_0120","text":"……！\n刚烤好的……华夫饼……！"},{"key":"SCENARIO_s02_02150000_01_0130","text":"啊，谢谢……\n我要吃……！！"},{"key":"SCENARIO_s02_02150000_01_0140","text":"哈哈，太好了\n那我去厨房准备喝的"},{"key":"SCENARIO_s02_02150000_01_0141","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0150","text":"我开动了──……\n……！好好吃……！"},{"key":"SCENARIO_s02_02150000_01_0160","text":"哈哈，甜花能开心就太好了"},{"key":"SCENARIO_s02_02150000_01_0170","text":"嗯……！……蛋糕，虽然是梦……\n但不是梦……！"},{"key":"SCENARIO_s02_02150000_01_0171","text":"Motion"},{"key":"SCENARIO_s02_02150000_01_0180","text":"嘿嘿……\n皆大欢喜，皆大欢喜……"}]
