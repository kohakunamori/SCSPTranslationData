[{"key":"SCENARIO_s02_02150000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02150000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_02150000_02_0010","text":"甜花，辛苦了\n那个……你还好吗……？"},{"key":"SCENARIO_s02_02150000_02_0011","text":"Motion"},{"key":"SCENARIO_s02_02150000_02_0020","text":"啊呜……\n一点都不好……！"},{"key":"SCENARIO_s02_02150000_02_0030","text":"舞步太快了，好难……\n好累……好辛苦……"},{"key":"SCENARIO_s02_02150000_02_0040","text":"是，是吗……"},{"key":"SCENARIO_s02_02150000_02_0050","text":"但即使这样，甜花\n也一直坚持到了现在呢"},{"key":"SCENARIO_s02_02150000_02_0060","text":"嗯、嗯……"},{"key":"SCENARIO_s02_02150000_02_0070","text":"甜花，很努力了……\n所以……今天就到此为止……！"},{"key":"SCENARIO_s02_02150000_02_0080","text":"不行……吗？"},{"key":"SCENARIO_s02_02150000_02_0090","text":"嗯—\n我倒是很想让你休息……"},{"key":"SCENARIO_s02_02150000_02_0100","text":"但明天是休息日啊。为了明天能好好休息，\n再稍微坚持一下好不好？"},{"key":"SCENARIO_s02_02150000_02_0110","text":"啊呜……"},{"key":"SCENARIO_s02_02150000_02_0111","text":"Motion"},{"key":"SCENARIO_s02_02150000_02_0120","text":"可、可是……\n这样啊……明天，是休息……！"},{"key":"SCENARIO_s02_02150000_02_0130","text":"那，甜花……\n再稍微……努力一下……"},{"key":"SCENARIO_s02_02150000_02_0140","text":"哦，真棒啊甜花！"},{"key":"SCENARIO_s02_02150000_02_0150","text":"嗯……！　明天……不能练习的话……\n今天，得加油才行……"},{"key":"SCENARIO_s02_02150000_02_0151","text":"Motion"},{"key":"SCENARIO_s02_02150000_02_0160","text":"甜花……\n想办一场……好的单元演唱会……"},{"key":"SCENARIO_s02_02150000_02_0170","text":"嗯\n就是这股劲头，甜花……！"},{"key":"SCENARIO_s02_02150000_02_0180","text":"不过……明天，是休息日……\n所以我要好好睡午觉……然后滚来滚去……！"}]
