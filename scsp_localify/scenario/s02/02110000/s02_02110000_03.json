[{"key":"SCENARIO_s02_02110000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02110000_03_0009","text":"店员"},{"key":"SCENARIO_s02_02110000_03_0010","text":"让您久等了\n请问要点什么？"},{"key":"SCENARIO_s02_02110000_03_0020","text":"要一份特制咖喱"},{"key":"SCENARIO_s02_02110000_03_0030","text":"啊，再来一份一样的"},{"key":"SCENARIO_s02_02110000_03_0039","text":"店员"},{"key":"SCENARIO_s02_02110000_03_0040","text":"好的\n请稍等片刻"},{"key":"SCENARIO_s02_02110000_03_0050","text":"树里，你喜欢吃咖喱来着吧"},{"key":"SCENARIO_s02_02110000_03_0060","text":"嗯？怎么说呢……\n犹豫的时候选咖喱的情况可能比较多"},{"key":"SCENARIO_s02_02110000_03_0070","text":"在宿舍也经常点"},{"key":"SCENARIO_s02_02110000_03_0080","text":"不过，咖喱也算是\n很少有人会讨厌的菜单吧"},{"key":"SCENARIO_s02_02110000_03_0090","text":"啊哈哈\n那倒也是"},{"key":"SCENARIO_s02_02110000_03_0095","text":"Motion"},{"key":"SCENARIO_s02_02110000_03_0100","text":"哦，说到宿舍的咖喱想起来了\n制作人，下次聚餐有什么想吃的吗？"},{"key":"SCENARIO_s02_02110000_03_0110","text":"……\n嗯……。只要能跟大家吃的话——"},{"key":"SCENARIO_s02_02110000_03_0120","text":"——只要能跟大家吃什么都行。这话可不行！"},{"key":"SCENARIO_s02_02110000_03_0130","text":"哈哈，知道了知道了\n……那就，汉堡排吧"},{"key":"SCENARIO_s02_02110000_03_0140","text":"哦！不错啊！"},{"key":"SCENARIO_s02_02110000_03_0150","text":"我也喜欢\n大家一起做也很有意思"},{"key":"SCENARIO_s02_02110000_03_0160","text":"那不如……汉堡排咖喱怎么样？\n不是最强组合吗？"},{"key":"SCENARIO_s02_02110000_03_0170","text":"……！\n制作人……你这提案太可怕了……"},{"key":"SCENARIO_s02_02110000_03_0180","text":"那个绝对会让人停不下来啊！"}]
