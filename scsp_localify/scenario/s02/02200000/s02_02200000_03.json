[{"key":"SCENARIO_s02_02200000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02200000_03_0010","text":"————透"},{"key":"SCENARIO_s02_02200000_03_0020","text":"嗯——"},{"key":"SCENARIO_s02_02200000_03_0030","text":"你不是有事吗？"},{"key":"SCENARIO_s02_02200000_03_0040","text":"诶"},{"key":"SCENARIO_s02_02200000_03_0050","text":"啊，不……你突然过来\n我想总不会只是来闲坐的吧"},{"key":"SCENARIO_s02_02200000_03_0060","text":"啊——"},{"key":"SCENARIO_s02_02200000_03_0070","text":"…………"},{"key":"SCENARIO_s02_02200000_03_0080","text":"回去？\n现在"},{"key":"SCENARIO_s02_02200000_03_0090","text":"只是问问而已\n你想待多久都行"},{"key":"SCENARIO_s02_02200000_03_0100","text":"直到想起有什么事为止"},{"key":"SCENARIO_s02_02200000_03_0110","text":"呵呵"},{"key":"SCENARIO_s02_02200000_03_0120","text":"————啊"},{"key":"SCENARIO_s02_02200000_03_0130","text":"嗯？"},{"key":"SCENARIO_s02_02200000_03_0140","text":"就是这样"},{"key":"SCENARIO_s02_02200000_03_0150","text":"好\n请"},{"key":"SCENARIO_s02_02200000_03_0160","text":"……笔记本？"},{"key":"SCENARIO_s02_02200000_03_0170","text":"耶——"},{"key":"SCENARIO_s02_02200000_03_0180","text":"……咦，这个笔记本……"}]
