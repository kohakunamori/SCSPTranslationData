[{"key":"SCENARIO_s02_02200000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_02200000_01_0010","text":"…………"},{"key":"SCENARIO_s02_02200000_01_0020","text":"我也得努力\n好好支持她们才行啊……"},{"key":"SCENARIO_s02_02200000_01_0030","text":"呵呵\n加油"},{"key":"SCENARIO_s02_02200000_01_0040","text":"……透也是，拜托你了"},{"key":"SCENARIO_s02_02200000_01_0050","text":"诶——"},{"key":"SCENARIO_s02_02200000_01_0060","text":"嘛\n嗯"},{"key":"SCENARIO_s02_02200000_01_0070","text":"这是能听取大家意见的，\n难得的机会……"},{"key":"SCENARIO_s02_02200000_01_0080","text":"也想让透好好享受"},{"key":"SCENARIO_s02_02200000_01_0090","text":"是啊——"},{"key":"SCENARIO_s02_02200000_01_0100","text":"如果有什么想法的话\n跟我说吧"},{"key":"SCENARIO_s02_02200000_01_0110","text":"啊——"},{"key":"SCENARIO_s02_02200000_01_0120","text":"…………"},{"key":"SCENARIO_s02_02200000_01_0130","text":"哈哈，不用现在就说"},{"key":"SCENARIO_s02_02200000_01_0140","text":"这是大家的Live\n一起把它做好吧"},{"key":"SCENARIO_s02_02200000_01_0150","text":"嗯——"},{"key":"SCENARIO_s02_02200000_01_0151","text":"Motion"},{"key":"SCENARIO_s02_02200000_01_0160","text":"…………"},{"key":"SCENARIO_s02_02200000_01_0170","text":"——嗯……"},{"key":"SCENARIO_s02_02200000_01_0180","text":"呼"}]
