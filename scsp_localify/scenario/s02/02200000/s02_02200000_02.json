[{"key":"SCENARIO_s02_02200000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02200000_02_0010","text":"……咦，透\n你怎么了，在这种地方"},{"key":"SCENARIO_s02_02200000_02_0020","text":"啊—\n嗯"},{"key":"SCENARIO_s02_02200000_02_0030","text":"松了\n鞋带"},{"key":"SCENARIO_s02_02200000_02_0040","text":"这样啊……"},{"key":"SCENARIO_s02_02200000_02_0041","text":"Motion"},{"key":"SCENARIO_s02_02200000_02_0050","text":"……好了"},{"key":"SCENARIO_s02_02200000_02_0060","text":"舞蹈，练得怎么样"},{"key":"SCENARIO_s02_02200000_02_0070","text":"诶"},{"key":"SCENARIO_s02_02200000_02_0080","text":"想着离『Unit Live』\n也快到了"},{"key":"SCENARIO_s02_02200000_02_0090","text":"啊——……"},{"key":"SCENARIO_s02_02200000_02_0100","text":"能赶上的话就好"},{"key":"SCENARIO_s02_02200000_02_0110","text":"说是还不齐"},{"key":"SCENARIO_s02_02200000_02_0120","text":"诶？"},{"key":"SCENARIO_s02_02200000_02_0130","text":"舞蹈\n老师说的"},{"key":"SCENARIO_s02_02200000_02_0140","text":"这样啊\n能赶上吗？"},{"key":"SCENARIO_s02_02200000_02_0150","text":"嗯—\n怎么说呢"},{"key":"SCENARIO_s02_02200000_02_0160","text":"赶不上的话\n那也挺麻烦的"},{"key":"SCENARIO_s02_02200000_02_0170","text":"呵呵\n嗯—"},{"key":"SCENARIO_s02_02200000_02_0180","text":"能赶上的\n一定"}]
