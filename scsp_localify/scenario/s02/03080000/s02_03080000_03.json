[{"key":"SCENARIO_s02_03080000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_03080000_03_0010","text":"…………"},{"key":"SCENARIO_s02_03080000_03_0020","text":"雾子，摩美美教你要找的东西找到了吗？"},{"key":"SCENARIO_s02_03080000_03_0030","text":"对不起……\n太多了……不知道选哪个……"},{"key":"SCENARIO_s02_03080000_03_0040","text":"光是护发相关的就有这么多商品啊……嗯，慢慢挑吧"},{"key":"SCENARIO_s02_03080000_03_0041","text":"Motion"},{"key":"SCENARIO_s02_03080000_03_0050","text":"——话说回来，真期待啊"},{"key":"SCENARIO_s02_03080000_03_0060","text":"雾子她们参与的商品\n说不定不久之后也会摆到这里来呢"},{"key":"SCENARIO_s02_03080000_03_0070","text":"哇……嗯……"},{"key":"SCENARIO_s02_03080000_03_0071","text":"Motion"},{"key":"SCENARIO_s02_03080000_03_0080","text":"“从根源舒缓疲劳”……\n“亚热带水果的恩惠”……"},{"key":"SCENARIO_s02_03080000_03_0090","text":"“给头皮来一记维C暴击”……"},{"key":"SCENARIO_s02_03080000_03_0100","text":"“对头发温柔，对心灵也温柔”……\n“极致放松时光”…………"},{"key":"SCENARIO_s02_03080000_03_0110","text":"好多……呢……\n各种各样的……心意……"},{"key":"SCENARIO_s02_03080000_03_0120","text":"呵呵……大家……\n都在努力呢……"},{"key":"SCENARIO_s02_03080000_03_0130","text":"是啊……！"},{"key":"SCENARIO_s02_03080000_03_0140","text":"“梦想之发”……“魔法般的恋爱香气”……"},{"key":"SCENARIO_s02_03080000_03_0150","text":"我们的……话语……\n也会……在这里……？"},{"key":"SCENARIO_s02_03080000_03_0160","text":"啊，会哦"},{"key":"SCENARIO_s02_03080000_03_0170","text":"呵呵……\n会怎样……飞向远方呢……"},{"key":"SCENARIO_s02_03080000_03_0180","text":"希望能……飞到……\n好多好多人的……身边……"}]
