[{"key":"SCENARIO_s02_01260000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0009","text":"街头大屏"},{"key":"SCENARIO_s02_01260000_04_0010","text":"『一颗彗星即将到来————』"},{"key":"SCENARIO_s02_01260000_04_0020","text":"『据说在古代曾被人们视为不祥之兆而恐惧』"},{"key":"SCENARIO_s02_01260000_04_0030","text":"『另一方面，也有传说称彗星出现时气温会升高，\n　能酿出优质的葡萄酒』"},{"key":"SCENARIO_s02_01260000_04_0040","text":"『这次，从地球上能观测到的时间很短————』"},{"key":"SCENARIO_s02_01260000_04_0050","text":"…………"},{"key":"SCENARIO_s02_01260000_04_0051","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0060","text":"为了消失————"},{"key":"SCENARIO_s02_01260000_04_0061","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0070","text":"啧————……"},{"key":"SCENARIO_s02_01260000_04_0071","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0072","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0080","text":"消失吧…………"},{"key":"SCENARIO_s02_01260000_04_0082","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0081","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0090","text":"我认为…………"},{"key":"SCENARIO_s02_01260000_04_0100","text":"那种东西，骗不了我……"},{"key":"SCENARIO_s02_01260000_04_0101","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0110","text":"又不是闪耀————"},{"key":"SCENARIO_s02_01260000_04_0111","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0120","text":"吵死了……"},{"key":"SCENARIO_s02_01260000_04_0121","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0130","text":"『下次再来到地球是数百年之后了』"},{"key":"SCENARIO_s02_01260000_04_0140","text":"………………"},{"key":"SCENARIO_s02_01260000_04_0150","text":"『这颗彗星』"},{"key":"SCENARIO_s02_01260000_04_0160","text":"『将会是一生一次的瞬间————』"},{"key":"SCENARIO_s02_01260000_04_0161","text":"Motion"},{"key":"SCENARIO_s02_01260000_04_0170","text":"…………那种东西"},{"key":"SCENARIO_s02_01260000_04_0180","text":"…………不需要"}]
