[{"key":"SCENARIO_s02_01260000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_01260000_02_0010","text":"…………"},{"key":"SCENARIO_s02_01260000_02_0020","text":"…………"},{"key":"SCENARIO_s02_01260000_02_0030","text":"有话就直说"},{"key":"SCENARIO_s02_01260000_02_0040","text":"是啊……"},{"key":"SCENARIO_s02_01260000_02_0050","text":"路加——\n我希望你能更珍惜自己……珍惜你自己"},{"key":"SCENARIO_s02_01260000_02_0051","text":"Motion"},{"key":"SCENARIO_s02_01260000_02_0060","text":"…………"},{"key":"SCENARIO_s02_01260000_02_0070","text":"路加自己自然不用说"},{"key":"SCENARIO_s02_01260000_02_0080","text":"路加受伤的话\n家人和粉丝们……大家都会伤心的"},{"key":"SCENARIO_s02_01260000_02_0090","text":"而且\n我和伙伴们也是——"},{"key":"SCENARIO_s02_01260000_02_0100","text":"哈……\n那种东西我才不管"},{"key":"SCENARIO_s02_01260000_02_0110","text":"但是————"},{"key":"SCENARIO_s02_01260000_02_0120","text":"不需要"},{"key":"SCENARIO_s02_01260000_02_0130","text":"…………"},{"key":"SCENARIO_s02_01260000_02_0140","text":"那些东西，反正————"},{"key":"SCENARIO_s02_01260000_02_0150","text":"反正…………"},{"key":"SCENARIO_s02_01260000_02_0160","text":"啊哈…………"},{"key":"SCENARIO_s02_01260000_02_0170","text":"真傻……"},{"key":"SCENARIO_s02_01260000_02_0171","text":"Motion"}]
