[{"key":"SCENARIO_s02_01260000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0010","text":"…………"},{"key":"SCENARIO_s02_01260000_03_0011","text":"伴舞1"},{"key":"SCENARIO_s02_01260000_03_0020","text":"啊，对不起！\n轮到我们了吧？"},{"key":"SCENARIO_s02_01260000_03_0030","text":"…………是"},{"key":"SCENARIO_s02_01260000_03_0039","text":"伴舞2"},{"key":"SCENARIO_s02_01260000_03_0040","text":"马上就让出来……！"},{"key":"SCENARIO_s02_01260000_03_0049","text":"伴舞1"},{"key":"SCENARIO_s02_01260000_03_0050","text":"失礼了……！"},{"key":"SCENARIO_s02_01260000_03_0059","text":"伴舞2"},{"key":"SCENARIO_s02_01260000_03_0060","text":"怎么办……\n明明还完全跳不好……"},{"key":"SCENARIO_s02_01260000_03_0069","text":"伴舞1"},{"key":"SCENARIO_s02_01260000_03_0070","text":"没关系的\n你自己可能没注意到，但你在进步"},{"key":"SCENARIO_s02_01260000_03_0080","text":"…………"},{"key":"SCENARIO_s02_01260000_03_0081","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0082","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0090","text":"──────……"},{"key":"SCENARIO_s02_01260000_03_0091","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0100","text":"我────\n即便如此，还是觉得它很美"},{"key":"SCENARIO_s02_01260000_03_0101","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0110","text":"唔…………！"},{"key":"SCENARIO_s02_01260000_03_0111","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0120","text":"啊————……"},{"key":"SCENARIO_s02_01260000_03_0130","text":"哈……哈……哈————……！"},{"key":"SCENARIO_s02_01260000_03_0140","text":"路加…………？路加……！！"},{"key":"SCENARIO_s02_01260000_03_0150","text":"难道…………\n工作结束后，一直……？"},{"key":"SCENARIO_s02_01260000_03_0160","text":"关你屁事……跟你没关系吧……"},{"key":"SCENARIO_s02_01260000_03_0161","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0162","text":"Motion"},{"key":"SCENARIO_s02_01260000_03_0170","text":"等等————"},{"key":"SCENARIO_s02_01260000_03_0180","text":"路加……\n让我跟你说说话……！"},{"key":"SCENARIO_s02_01260000_03_0190","text":"说过了吧……\n刚才……！"},{"key":"SCENARIO_s02_01260000_03_0191","text":"Motion"}]
