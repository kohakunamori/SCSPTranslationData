[{"key":"SCENARIO_s02_01140000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_01140000_02_0010","text":"……"},{"key":"SCENARIO_s02_01140000_02_0020","text":"哦，这次在读什么书呢？"},{"key":"SCENARIO_s02_01140000_02_0030","text":"是推理短篇小说集哦～\n这也是在书咖里发现的有意思的书"},{"key":"SCENARIO_s02_01140000_02_0040","text":"看起来挺有意思的\n我下次也读读看吧"},{"key":"SCENARIO_s02_01140000_02_0050","text":"等我看完了借给你？"},{"key":"SCENARIO_s02_01140000_02_0060","text":"谢谢，那就拜托了\n话说回来，你最近读了不少书啊"},{"key":"SCENARIO_s02_01140000_02_0070","text":"嗯。因为千雪小姐\n跟我说了一句非常美好的话"},{"key":"SCENARIO_s02_01140000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_01140000_02_0080","text":"“甘奈酱，你是在和书一起\n遇见作者呢……”"},{"key":"SCENARIO_s02_01140000_02_0002","text":"Motion"},{"key":"SCENARIO_s02_01140000_02_0090","text":"甘奈，想要读更多的书\n更多的"},{"key":"SCENARIO_s02_01140000_02_0100","text":"为了遇见各种各样的人"},{"key":"SCENARIO_s02_01140000_02_0110","text":"“和书一起遇见作者”……吗"},{"key":"SCENARIO_s02_01140000_02_0120","text":"听你这么说\n我也突然想多读点书了"},{"key":"SCENARIO_s02_01140000_02_0130","text":"嘿嘿，我觉得挺好的！"},{"key":"SCENARIO_s02_01140000_02_0003","text":"Motion"},{"key":"SCENARIO_s02_01140000_02_0140","text":"啊，抱歉\n打扰到你宝贵的读书时间了"},{"key":"SCENARIO_s02_01140000_02_0150","text":"不会！\n别在意！"},{"key":"SCENARIO_s02_01140000_02_0160","text":"和Producer先生聊天的时间\n对我来说也是很宝贵的呀"}]
