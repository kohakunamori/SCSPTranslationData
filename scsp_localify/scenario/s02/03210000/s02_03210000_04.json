[{"key":"SCENARIO_s02_03210000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0010","text":"…………"},{"key":"SCENARIO_s02_03210000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0003","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0020","text":"……"},{"key":"SCENARIO_s02_03210000_04_0004","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0030","text":"……咦，圆香？"},{"key":"SCENARIO_s02_03210000_04_0040","text":"您在这里啊"},{"key":"SCENARIO_s02_03210000_04_0050","text":"抱歉，我去了一趟厕所\n怎么了？"},{"key":"SCENARIO_s02_03210000_04_0060","text":"我来还练习室的钥匙"},{"key":"SCENARIO_s02_03210000_04_0070","text":"这样啊，那我先收着吧\n谢谢"},{"key":"SCENARIO_s02_03210000_04_0005","text":"Motion"},{"key":"SCENARIO_s02_03210000_04_0080","text":"怎么样？\n练习的进展"},{"key":"SCENARIO_s02_03210000_04_0090","text":"要是差不多能找到感觉了就好了"},{"key":"SCENARIO_s02_03210000_04_0100","text":"谁知道呢，不好说\n虽然已经能稳定地搭好骑马的阵型了"},{"key":"SCENARIO_s02_03210000_04_0110","text":"但骑马战不是一组就能完成的\n有没有感觉，不实际比试一下是不知道的"},{"key":"SCENARIO_s02_03210000_04_0120","text":"那倒也是\n现在能做的事是有限的"},{"key":"SCENARIO_s02_03210000_04_0130","text":"但正式比赛只有一次机会\n要求你们拿冠军，确实挺不讲理的吧"},{"key":"SCENARIO_s02_03210000_04_0140","text":"您自己也知道啊"},{"key":"SCENARIO_s02_03210000_04_0150","text":"哈哈，但即便如此，我还是觉得你们没问题的"},{"key":"SCENARIO_s02_03210000_04_0160","text":"……"},{"key":"SCENARIO_s02_03210000_04_0170","text":"该做的事，我们会做到最后"},{"key":"SCENARIO_s02_03210000_04_0180","text":"之后就只能顺其自然了"}]
