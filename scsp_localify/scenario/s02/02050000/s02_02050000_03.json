[{"key":"SCENARIO_s02_02050000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0010","text":"……"},{"key":"SCENARIO_s02_02050000_03_0020","text":"……"},{"key":"SCENARIO_s02_02050000_03_0030","text":"──！"},{"key":"SCENARIO_s02_02050000_03_0031","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0040","text":"…………"},{"key":"SCENARIO_s02_02050000_03_0041","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0050","text":"（……）"},{"key":"SCENARIO_s02_02050000_03_0051","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0060","text":"……！"},{"key":"SCENARIO_s02_02050000_03_0061","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0070","text":"……邮件杂志啊"},{"key":"SCENARIO_s02_02050000_03_0080","text":"（……）"},{"key":"SCENARIO_s02_02050000_03_0081","text":"Motion"},{"key":"SCENARIO_s02_02050000_03_0090","text":"……光是等着\n也挺难受的呢"},{"key":"SCENARIO_s02_02050000_03_0100","text":"……\n您在说什么呢？"},{"key":"SCENARIO_s02_02050000_03_0110","text":"不，也没什么特别的\n就是……泛泛而谈啦"},{"key":"SCENARIO_s02_02050000_03_0120","text":"嗯——\n嘛，也许是吧"},{"key":"SCENARIO_s02_02050000_03_0130","text":"……那制作人会怎么做呢？\n那种时候——"},{"key":"SCENARIO_s02_02050000_03_0140","text":"……我吗\n我的话——"},{"key":"SCENARIO_s02_02050000_03_0150","text":"——啊，还是算了\n感觉会得到一堆热血沸腾的回答"},{"key":"SCENARIO_s02_02050000_03_0160","text":"不会啊，需要的话\n我也可以冷静回答的哦？"},{"key":"SCENARIO_s02_02050000_03_0170","text":"呵呵——\n做得到吗？"},{"key":"SCENARIO_s02_02050000_03_0180","text":"…………唉"}]
