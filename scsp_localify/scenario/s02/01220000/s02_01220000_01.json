[{"key":"SCENARIO_s02_01220000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_01220000_01_0010","text":"……呼……呼…………"},{"key":"SCENARIO_s02_01220000_01_0020","text":"咦，小糸……？\n在这种地方……"},{"key":"SCENARIO_s02_01220000_01_0030","text":"喂\n小──"},{"key":"SCENARIO_s02_01220000_01_0040","text":"…………\n大家，都好厉害啊……"},{"key":"SCENARIO_s02_01220000_01_0050","text":"……\n我也…………"},{"key":"SCENARIO_s02_01220000_01_0060","text":"……\n必须加油…………"},{"key":"SCENARIO_s02_01220000_01_0070","text":"一、二、三、四\n哒哒哒，哒哒哒……────"},{"key":"SCENARIO_s02_01220000_01_0080","text":"……在努力啊，小糸"},{"key":"SCENARIO_s02_01220000_01_0085","text":"Motion"},{"key":"SCENARIO_s02_01220000_01_0090","text":"刚才的感觉……再来一遍……！\n……哒哒哒，哒哒哒────"},{"key":"SCENARIO_s02_01220000_01_0100","text":"我也──\n得为了大家努力才行"}]
