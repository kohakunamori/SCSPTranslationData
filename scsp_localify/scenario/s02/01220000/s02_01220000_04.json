[{"key":"SCENARIO_s02_01220000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_01220000_04_0010","text":"……制作人！\n辛苦了……！"},{"key":"SCENARIO_s02_01220000_04_0020","text":"嗯，辛苦了\n你努力了"},{"key":"SCENARIO_s02_01220000_04_0030","text":"……是、是吗……"},{"key":"SCENARIO_s02_01220000_04_0040","text":"…………不努力的话，我\n觉得又会变成孤零零一个人……"},{"key":"SCENARIO_s02_01220000_04_0050","text":"…………"},{"key":"SCENARIO_s02_01220000_04_0060","text":"你看，大家都在那边"},{"key":"SCENARIO_s02_01220000_04_0070","text":"……？"},{"key":"SCENARIO_s02_01220000_04_0080","text":"而且，小糸也在"},{"key":"SCENARIO_s02_01220000_04_0090","text":"…………！\n是、是啊……！"},{"key":"SCENARIO_s02_01220000_04_0100","text":"我去大家那边了……！"},{"key":"SCENARIO_s02_01220000_04_0001","text":"Motion"}]
