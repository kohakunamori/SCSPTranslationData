[{"key":"SCENARIO_s02_01220000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_01220000_03_0010","text":"那、那个……\n制作人……！"},{"key":"SCENARIO_s02_01220000_03_0020","text":"嗯，小糸\n──那张纸……"},{"key":"SCENARIO_s02_01220000_03_0030","text":"花火大会……我想和大家一起去……！"},{"key":"SCENARIO_s02_01220000_03_0040","text":"──这样啊\n你们好好商量过了？"},{"key":"SCENARIO_s02_01220000_03_0050","text":"好、好的……！"},{"key":"SCENARIO_s02_01220000_03_0060","text":"明白了\n那就没问题"},{"key":"SCENARIO_s02_01220000_03_0070","text":"……真的可以，和大家一起去吗！？"},{"key":"SCENARIO_s02_01220000_03_0080","text":"嗯，当然可以"},{"key":"SCENARIO_s02_01220000_03_0090","text":"哇……！"},{"key":"SCENARIO_s02_01220000_03_0100","text":"哈哈\n一起加油吧，小糸"},{"key":"SCENARIO_s02_01220000_03_0002","text":"Motion"}]
