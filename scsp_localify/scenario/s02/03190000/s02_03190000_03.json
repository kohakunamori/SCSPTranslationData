[{"key":"SCENARIO_s02_03190000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_0010","text":"…………"},{"key":"SCENARIO_s02_03190000_03_0020","text":"（还……还有什么……\n　一定还有的……！）"},{"key":"SCENARIO_s02_03190000_03_0030","text":"……想想啊……我……！"},{"key":"SCENARIO_s02_03190000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_0040","text":"嗯。我想用这个来研究一下\n大家都是怎么推销自己的！"},{"key":"SCENARIO_s02_03190000_03_0002","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_0050","text":"……！\n那本杂志……！"},{"key":"SCENARIO_s02_03190000_03_0003","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_0004","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_1000","text":"杂志"},{"key":"SCENARIO_s02_03190000_03_0060","text":"『我认为表演中最重要的就是舞台表现\n　在舞台上全力展现，才有意义』"},{"key":"SCENARIO_s02_03190000_03_0070","text":"（说得是挺好……\n　但这不是我要的……！）"},{"key":"SCENARIO_s02_03190000_03_0080","text":"『练习时拍的视频什么的，播放量还挺容易涨的\n　感觉大家都挺感兴趣的』"},{"key":"SCENARIO_s02_03190000_03_0090","text":"……！\n练习视频……"},{"key":"SCENARIO_s02_03190000_03_0100","text":"找到了……！"},{"key":"SCENARIO_s02_03190000_03_0110","text":"（那时候的朝日酱\n　真的超厉害的）"},{"key":"SCENARIO_s02_03190000_03_0120","text":"（……要是看到这个\n　大家绝对会惊呆的！）"},{"key":"SCENARIO_s02_03190000_03_0130","text":"（然后……再找找冬优子酱\n　状态好的片段……）"},{"key":"SCENARIO_s02_03190000_03_0140","text":"哈……哈……"},{"key":"SCENARIO_s02_03190000_03_0005","text":"Motion"},{"key":"SCENARIO_s02_03190000_03_0150","text":"制作人！\n在吗！？"},{"key":"SCENARIO_s02_03190000_03_0160","text":"嗯，在啊"},{"key":"SCENARIO_s02_03190000_03_0170","text":"看你这架势，是有急事吧\n跟我说说怎么了"},{"key":"SCENARIO_s02_03190000_03_0180","text":"嗯！\n其实，我有想做的事──"}]
