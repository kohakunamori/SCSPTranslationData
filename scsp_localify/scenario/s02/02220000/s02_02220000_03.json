[{"key":"SCENARIO_s02_02220000_03_0010","text":"制，制作人……！"},{"key":"SCENARIO_s02_02220000_03_0011","text":"Motion"},{"key":"SCENARIO_s02_02220000_03_0020","text":"哦，小糸……\n已经练完自主练习了吗？"},{"key":"SCENARIO_s02_02220000_03_0030","text":"好、好的……！"},{"key":"SCENARIO_s02_02220000_03_0031","text":"Motion"},{"key":"SCENARIO_s02_02220000_03_0040","text":"那个……！\n刚才，透酱和圆香酱……"},{"key":"SCENARIO_s02_02220000_03_0050","text":"嗯……？\n透和圆香怎么了？"},{"key":"SCENARIO_s02_02220000_03_0060","text":"那，那个……！"},{"key":"SCENARIO_s02_02220000_03_0061","text":"Motion"},{"key":"SCENARIO_s02_02220000_03_0070","text":"舞蹈…………夸我了……！"},{"key":"SCENARIO_s02_02220000_03_0080","text":"哦哦，是吗\n那太好了！"},{"key":"SCENARIO_s02_02220000_03_0090","text":"诶嘿嘿……"},{"key":"SCENARIO_s02_02220000_03_0100","text":"说我陪她们一起自主练习，\n好厉害什么的……"},{"key":"SCENARIO_s02_02220000_03_0110","text":"稍微放心了一点"},{"key":"SCENARIO_s02_02220000_03_0111","text":"Motion"},{"key":"SCENARIO_s02_02220000_03_0120","text":"诶？"},{"key":"SCENARIO_s02_02220000_03_0130","text":"啊，是啊……因为我听说舞蹈老师\n说你们跳得不太整齐"},{"key":"SCENARIO_s02_02220000_03_0140","text":"啊……那个……"},{"key":"SCENARIO_s02_02220000_03_0150","text":"不过，照这个势头应该没问题了"},{"key":"SCENARIO_s02_02220000_03_0160","text":"……！"},{"key":"SCENARIO_s02_02220000_03_0170","text":"下次一定要让老师\n看到你们整齐划一的样子"},{"key":"SCENARIO_s02_02220000_03_0171","text":"Motion"},{"key":"SCENARIO_s02_02220000_03_0180","text":"……是！"}]
