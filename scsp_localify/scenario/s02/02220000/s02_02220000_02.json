[{"key":"SCENARIO_s02_02220000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0010","text":"…………唉"},{"key":"SCENARIO_s02_02220000_02_0020","text":"好不容易把编舞推进了……"},{"key":"SCENARIO_s02_02220000_02_0030","text":"…………"},{"key":"SCENARIO_s02_02220000_02_0031","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0000","text":"训练师"},{"key":"SCENARIO_s02_02220000_02_0040","text":"『以现在的状态，还远远达不到能让粉丝开心的水平』"},{"key":"SCENARIO_s02_02220000_02_0041","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0050","text":"……是啊"},{"key":"SCENARIO_s02_02220000_02_0060","text":"哪还有空想什么演出────"},{"key":"SCENARIO_s02_02220000_02_0061","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0070","text":"小糸，辛苦了"},{"key":"SCENARIO_s02_02220000_02_0080","text":"呀……！？"},{"key":"SCENARIO_s02_02220000_02_0081","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0090","text":"辛，辛苦了……！"},{"key":"SCENARIO_s02_02220000_02_0100","text":"？\n你掉了什么东西"},{"key":"SCENARIO_s02_02220000_02_0110","text":"……！"},{"key":"SCENARIO_s02_02220000_02_0120","text":"────信？"},{"key":"SCENARIO_s02_02220000_02_0131","text":"Motion"},{"key":"SCENARIO_s02_02220000_02_0130","text":"非，非常感谢……！"},{"key":"SCENARIO_s02_02220000_02_0140","text":"诶，那个……────"},{"key":"SCENARIO_s02_02220000_02_0150","text":"……啊，对了\n今天的会议……"},{"key":"SCENARIO_s02_02220000_02_0160","text":"我接下来有点事要处理\n你先去事务所吧……我会抓紧时间赶过去的"},{"key":"SCENARIO_s02_02220000_02_0170","text":"好、好的……！\n明白了……"},{"key":"SCENARIO_s02_02220000_02_0180","text":"…………"}]
