[{"key":"SCENARIO_s02_02020000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02020000_02_9999","text":"提示板"},{"key":"SCENARIO_s02_02020000_02_0010","text":"哈啊……哈啊……"},{"key":"SCENARIO_s02_02020000_02_0020","text":"等，先等一下！"},{"key":"SCENARIO_s02_02020000_02_0030","text":"被巡抓了也会离队是吗……！？"},{"key":"SCENARIO_s02_02020000_02_0040","text":"“巡小姐也是鬼，所以是的！”"},{"key":"SCENARIO_s02_02020000_02_0050","text":"……"},{"key":"SCENARIO_s02_02020000_02_0060","text":"（灯织……）"},{"key":"SCENARIO_s02_02020000_02_0070","text":"………………………"},{"key":"SCENARIO_s02_02020000_02_0080","text":"…………"},{"key":"SCENARIO_s02_02020000_02_0090","text":"（哪怕能跟她说上一句话也好……）"},{"key":"SCENARIO_s02_02020000_02_0100","text":"（……用无线电……哪怕只有一点点────）"},{"key":"SCENARIO_s02_02020000_02_0110","text":"阳──……\n不行……！"},{"key":"SCENARIO_s02_02020000_02_0120","text":"不行……！"},{"key":"SCENARIO_s02_02020000_02_0130","text":"现在只想着怎么从鬼手里逃跑吧……\n但是，巡我一定要夺回来……！"},{"key":"SCENARIO_s02_02020000_02_0140","text":"但是，巡我一定要夺回来……！"},{"key":"SCENARIO_s02_02020000_02_0150","text":"………………"},{"key":"SCENARIO_s02_02020000_02_0160","text":"嗯，加油\n灯织……"}]
