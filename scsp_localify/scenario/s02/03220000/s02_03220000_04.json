[{"key":"SCENARIO_s02_03220000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_03220000_04_0010","text":"…………"},{"key":"SCENARIO_s02_03220000_04_0020","text":"我来当骑手……怎、怎么办……"},{"key":"SCENARIO_s02_03220000_04_0030","text":"…………"},{"key":"SCENARIO_s02_03220000_04_0040","text":"小糸"},{"key":"SCENARIO_s02_03220000_04_0050","text":"呀……！？\n制、制作人……"},{"key":"SCENARIO_s02_03220000_04_0060","text":"在烦恼吗？"},{"key":"SCENARIO_s02_03220000_04_0070","text":"是、是的……因为，让我当骑手什么的……"},{"key":"SCENARIO_s02_03220000_04_0080","text":"万一因为我的原因\n输了的话……"},{"key":"SCENARIO_s02_03220000_04_0090","text":"……\n非、非得……拿冠军……才行吗……？"},{"key":"SCENARIO_s02_03220000_04_0100","text":"…………\n嗯"},{"key":"SCENARIO_s02_03220000_04_0110","text":"……"},{"key":"SCENARIO_s02_03220000_04_0120","text":"…………制作人是"},{"key":"SCENARIO_s02_03220000_04_0130","text":"制作人觉得\n我们能拿冠军吗？"},{"key":"SCENARIO_s02_03220000_04_0140","text":"当然了"},{"key":"SCENARIO_s02_03220000_04_0150","text":"小糸的话──\n不，小糸你们的话一定能拿冠军"},{"key":"SCENARIO_s02_03220000_04_0160","text":"我是这么相信的"},{"key":"SCENARIO_s02_03220000_04_0170","text":"……！\n……那、那么……"},{"key":"SCENARIO_s02_03220000_04_0180","text":"冠军什么的，轻轻松松拿给你们看……！"}]
