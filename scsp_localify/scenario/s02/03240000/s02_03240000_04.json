[{"key":"SCENARIO_s02_03240000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0005","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0010","text":"…………"},{"key":"SCENARIO_s02_03240000_04_0020","text":"──日花，你果然还在啊\n一直在自己加练吗？"},{"key":"SCENARIO_s02_03240000_04_0021","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0025","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0030","text":"……我给你带了点东西\n水和果冻都有"},{"key":"SCENARIO_s02_03240000_04_0040","text":"…………\n水……给我吧"},{"key":"SCENARIO_s02_03240000_04_0041","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0042","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0050","text":"──怎么样？　自己加练的成果"},{"key":"SCENARIO_s02_03240000_04_0060","text":"…………\n不知道"},{"key":"SCENARIO_s02_03240000_04_0070","text":"……嗯？"},{"key":"SCENARIO_s02_03240000_04_0080","text":"不知道，什么都不知道……"},{"key":"SCENARIO_s02_03240000_04_0090","text":"………………"},{"key":"SCENARIO_s02_03240000_04_0100","text":"到底有没有用，该说什么才好……"},{"key":"SCENARIO_s02_03240000_04_0110","text":"……是说特别训练的事吗"},{"key":"SCENARIO_s02_03240000_04_0120","text":"………………"},{"key":"SCENARIO_s02_03240000_04_0121","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0125","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0130","text":"……我回去了"},{"key":"SCENARIO_s02_03240000_04_0140","text":"我送你"},{"key":"SCENARIO_s02_03240000_04_0150","text":"我一个人能回去"},{"key":"SCENARIO_s02_03240000_04_0160","text":"但是"},{"key":"SCENARIO_s02_03240000_04_0161","text":"Motion"},{"key":"SCENARIO_s02_03240000_04_0170","text":"我想一个人想想"},{"key":"SCENARIO_s02_03240000_04_0171","text":"Motion"}]
