[{"key":"SCENARIO_s02_03230000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_0010","text":"今天拍的发到Twista上吧～"},{"key":"SCENARIO_s02_03230000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_1001","text":"消息1"},{"key":"SCENARIO_s02_03230000_02_0020","text":"『雏菜酱，新年快乐！\n　看起来好好吃啊』"},{"key":"SCENARIO_s02_03230000_02_1002","text":"消息2"},{"key":"SCENARIO_s02_03230000_02_0030","text":"『雏菜酱可爱的笑容，新年一开始就被治愈了！』"},{"key":"SCENARIO_s02_03230000_02_1003","text":"消息3"},{"key":"SCENARIO_s02_03230000_02_0040","text":"『旅行的分享，太感谢了……』"},{"key":"SCENARIO_s02_03230000_02_0041","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_0050","text":"……分你一份"},{"key":"SCENARIO_s02_03230000_02_0060","text":"对了"},{"key":"SCENARIO_s02_03230000_02_0041","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_0070","text":"『今天也超开心的！』"},{"key":"SCENARIO_s02_03230000_02_0080","text":"『吃了好多好吃的』"},{"key":"SCENARIO_s02_03230000_02_0081","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_0090","text":"『拍得真好看啊！\n　雏菜看起来很开心，我也跟着高兴起来了』"},{"key":"SCENARIO_s02_03230000_02_0100","text":"……啊哈～"},{"key":"SCENARIO_s02_03230000_02_0110","text":"…………\n新年快乐～！"},{"key":"SCENARIO_s02_03230000_02_0111","text":"Motion"},{"key":"SCENARIO_s02_03230000_02_0120","text":"……啊，喂，制作人？\n新年快乐～！"},{"key":"SCENARIO_s02_03230000_02_0130","text":"『啊啊，新年快乐\n　今年也请多关照了』"},{"key":"SCENARIO_s02_03230000_02_0140","text":"嗯～！\n对了，制作人刚才在做什么呀～？"},{"key":"SCENARIO_s02_03230000_02_0150","text":"『难得地，稍微放松了一下』"},{"key":"SCENARIO_s02_03230000_02_0160","text":"嘿～\n这样啊～"},{"key":"SCENARIO_s02_03230000_02_0170","text":"那，雏菜的推文你记得看哦～♡\n还会发好多好多呢～"},{"key":"SCENARIO_s02_03230000_02_0180","text":"『啊啊，知道了\n　我会好好看的』"}]
