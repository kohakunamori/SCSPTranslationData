[{"key":"SCENARIO_s02_03130000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_03130000_03_0010","text":"制作人？"},{"key":"SCENARIO_s02_03130000_03_0020","text":"夏叶……！\n来事务所办事吗？"},{"key":"SCENARIO_s02_03130000_03_0030","text":"不是\n算是来踩点吧"},{"key":"SCENARIO_s02_03130000_03_0040","text":"下次要和大家一起慢跑，\n所以我在想路线"},{"key":"SCENARIO_s02_03130000_03_0050","text":"原来是来踩点啊"},{"key":"SCENARIO_s02_03130000_03_0051","text":"Motion"},{"key":"SCENARIO_s02_03130000_03_0052","text":"Motion"},{"key":"SCENARIO_s02_03130000_03_0060","text":"────这里也打算纳入路线哦"},{"key":"SCENARIO_s02_03130000_03_0070","text":"是吗\n终点是哪里？"},{"key":"SCENARIO_s02_03130000_03_0080","text":"嗯……那座神社不错"},{"key":"SCENARIO_s02_03130000_03_0090","text":"是要爬上那段台阶吗……"},{"key":"SCENARIO_s02_03130000_03_0100","text":"你要不要也一起？"},{"key":"SCENARIO_s02_03130000_03_0110","text":"是、是吗……我考虑一下吧"},{"key":"SCENARIO_s02_03130000_03_0120","text":"呵呵，开玩笑的"},{"key":"SCENARIO_s02_03130000_03_0130","text":"你总是那么忙\n不想让你勉强"},{"key":"SCENARIO_s02_03130000_03_0140","text":"而且……"},{"key":"SCENARIO_s02_03130000_03_0150","text":"像这样一起慢慢走走\n不也挺好的吗？"},{"key":"SCENARIO_s02_03130000_03_0160","text":"是啊\n转换了一下心情"},{"key":"SCENARIO_s02_03130000_03_0170","text":"……那我回事务所了，夏叶呢？"},{"key":"SCENARIO_s02_03130000_03_0180","text":"我再走一会儿\n难得来了，走到神社吧"}]
