[{"key":"SCENARIO_s02_02230000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_02230000_03_0010","text":"…………"},{"key":"SCENARIO_s02_02230000_03_0011","text":"Motion"},{"key":"SCENARIO_s02_02230000_03_0020","text":"咦？"},{"key":"SCENARIO_s02_02230000_03_0030","text":"嗯～……"},{"key":"SCENARIO_s02_02230000_03_0040","text":"……雏菜，怎么了？"},{"key":"SCENARIO_s02_02230000_03_0041","text":"Motion"},{"key":"SCENARIO_s02_02230000_03_0050","text":"啊～，制作人……"},{"key":"SCENARIO_s02_02230000_03_0060","text":"呐，有没有看到我的笔记本～？"},{"key":"SCENARIO_s02_02230000_03_0070","text":"笔记本？\n什么样的？"},{"key":"SCENARIO_s02_02230000_03_0080","text":"嗯～，粉色的笔记本～"},{"key":"SCENARIO_s02_02230000_03_0090","text":"啊……\n是之前你在写东西的那本吧"},{"key":"SCENARIO_s02_02230000_03_0100","text":"对～\n不见了～"},{"key":"SCENARIO_s02_02230000_03_0110","text":"嗯……\n我没看到"},{"key":"SCENARIO_s02_02230000_03_0111","text":"Motion"},{"key":"SCENARIO_s02_02230000_03_0120","text":"……啊哈～"},{"key":"SCENARIO_s02_02230000_03_0130","text":"嘛，算了～"},{"key":"SCENARIO_s02_02230000_03_0140","text":"诶……\n不要紧吗？"},{"key":"SCENARIO_s02_02230000_03_0150","text":"嗯～\n雏菜大概都记得"},{"key":"SCENARIO_s02_02230000_03_0160","text":"重要的是内容对吧～？"},{"key":"SCENARIO_s02_02230000_03_0170","text":"嗯，话是这么说……"},{"key":"SCENARIO_s02_02230000_03_0180","text":"再买一本新的就好啦～"}]
