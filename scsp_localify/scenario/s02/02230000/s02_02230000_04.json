[{"key":"SCENARIO_s02_02230000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_02230000_04_0010","text":"呐，制作人！"},{"key":"SCENARIO_s02_02230000_04_0020","text":"雏菜的演出怎么样～？"},{"key":"SCENARIO_s02_02230000_04_0030","text":"观众们都非常开心"},{"key":"SCENARIO_s02_02230000_04_0040","text":"那个我知道啦～？\n雏菜当时也在场嘛"},{"key":"SCENARIO_s02_02230000_04_0050","text":"……\n哈哈，也是"},{"key":"SCENARIO_s02_02230000_04_0060","text":"制作人的感想呢～？"},{"key":"SCENARIO_s02_02230000_04_0070","text":"嗯……\n我觉得每个都很好……"},{"key":"SCENARIO_s02_02230000_04_0080","text":"比如把彩纸剪成糖果形状的那段────"},{"key":"SCENARIO_s02_02230000_04_0090","text":"那个，雏菜也很喜欢！"},{"key":"SCENARIO_s02_02230000_04_0100","text":"还有……用气球的演出\n那里也很有雏菜的风格，很棒"},{"key":"SCENARIO_s02_02230000_04_0110","text":"嗯～！很可爱对吧～？"},{"key":"SCENARIO_s02_02230000_04_0120","text":"嗯，是啊"},{"key":"SCENARIO_s02_02230000_04_0130","text":"多亏了雏菜积极提出想法\n舞台变得非常华丽"},{"key":"SCENARIO_s02_02230000_04_0140","text":"最重要的是，这份心意\n确实传达给了观众"},{"key":"SCENARIO_s02_02230000_04_0150","text":"呀哈～！"},{"key":"SCENARIO_s02_02230000_04_0160","text":"雏菜说不定\n很适合做这种事呢"},{"key":"SCENARIO_s02_02230000_04_0170","text":"嗯～～～！\n雏菜也这么觉得"},{"key":"SCENARIO_s02_02230000_04_0180","text":"雏菜还想再做一次这样的！"}]
