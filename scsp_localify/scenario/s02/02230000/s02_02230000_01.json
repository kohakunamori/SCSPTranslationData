[{"key":"SCENARIO_s02_02230000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_02230000_01_0010","text":"嗯～……\n那个啊～"},{"key":"SCENARIO_s02_02230000_01_0011","text":"Motion"},{"key":"SCENARIO_s02_02230000_01_0020","text":"……啊哈～"},{"key":"SCENARIO_s02_02230000_01_0021","text":"Motion"},{"key":"SCENARIO_s02_02230000_01_0030","text":"咦，雏菜……？\n还没回去吗"},{"key":"SCENARIO_s02_02230000_01_0040","text":"…………"},{"key":"SCENARIO_s02_02230000_01_0050","text":"……在写什么呢？"},{"key":"SCENARIO_s02_02230000_01_0051","text":"Motion"},{"key":"SCENARIO_s02_02230000_01_0060","text":"啊～\n不许看～！"},{"key":"SCENARIO_s02_02230000_01_0070","text":"……！\n对、对不起……"},{"key":"SCENARIO_s02_02230000_01_0080","text":"不过其实也无所谓啦～？"},{"key":"SCENARIO_s02_02230000_01_0090","text":"只是觉得要是提前知道了就没意思了嘛～"},{"key":"SCENARIO_s02_02230000_01_0100","text":"哈哈……\n那我就不看了"},{"key":"SCENARIO_s02_02230000_01_0110","text":"雏菜，时间上没问题吗？"},{"key":"SCENARIO_s02_02230000_01_0120","text":"诶～？"},{"key":"SCENARIO_s02_02230000_01_0130","text":"如果还要很久的话，我送你回家"},{"key":"SCENARIO_s02_02230000_01_0131","text":"Motion"},{"key":"SCENARIO_s02_02230000_01_0140","text":"嗯～……"},{"key":"SCENARIO_s02_02230000_01_0150","text":"不用啦～\n我自己回去～"},{"key":"SCENARIO_s02_02230000_01_0160","text":"因为雏菜还有事情要做"},{"key":"SCENARIO_s02_02230000_01_0170","text":"这样啊……\n路上小心"},{"key":"SCENARIO_s02_02230000_01_0180","text":"嗯～！\n拜拜，制作人"},{"key":"SCENARIO_s02_02230000_01_0181","text":"Motion"}]
