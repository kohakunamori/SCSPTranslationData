[{"key":"SCENARIO_s02_03120000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_03120000_02_0010","text":"…………"},{"key":"SCENARIO_s02_03120000_02_0020","text":"就像树里小姐说的那样……\n凛世也……总有一天……──"},{"key":"SCENARIO_s02_03120000_02_0021","text":"Motion"},{"key":"SCENARIO_s02_03120000_02_0030","text":"……！\n制作人大人……！"},{"key":"SCENARIO_s02_03120000_02_0040","text":"是、是的……"},{"key":"SCENARIO_s02_03120000_02_0041","text":"Motion"},{"key":"SCENARIO_s02_03120000_02_0050","text":"『啊，凛世。辛苦了\n　现在方便吗？』"},{"key":"SCENARIO_s02_03120000_02_0060","text":"嗯……"},{"key":"SCENARIO_s02_03120000_02_0070","text":"『后天那个拍摄，\n　对方那边好像临时有事……』"},{"key":"SCENARIO_s02_03120000_02_0080","text":"『可能要改到下星期了\n　这么突然不好意思啊』"},{"key":"SCENARIO_s02_03120000_02_0090","text":"不会……凛世……\n没有问题……"},{"key":"SCENARIO_s02_03120000_02_0100","text":"『是吗，那就好』"},{"key":"SCENARIO_s02_03120000_02_0110","text":"是的……\n…………"},{"key":"SCENARIO_s02_03120000_02_0111","text":"Motion"},{"key":"SCENARIO_s02_03120000_02_0120","text":"──那个……\n制作人大人……"},{"key":"SCENARIO_s02_03120000_02_0130","text":"“嗯？”"},{"key":"SCENARIO_s02_03120000_02_0140","text":"──凛世也……\n总有一天……会改变的吧……"},{"key":"SCENARIO_s02_03120000_02_0150","text":"『…………\n　是啊……』"},{"key":"SCENARIO_s02_03120000_02_0160","text":"『活着的话，总有不得不改变的时候\n　但我──』"},{"key":"SCENARIO_s02_03120000_02_0170","text":"『今后也会作为凛世的制作人\n　一直支持你的。这一点不会变』"},{"key":"SCENARIO_s02_03120000_02_0180","text":"……！　制作人大人……\n好的……"},{"key":"SCENARIO_s02_03120000_02_0181","text":"Motion"}]
