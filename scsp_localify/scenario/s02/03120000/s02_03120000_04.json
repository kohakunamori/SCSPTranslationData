[{"key":"SCENARIO_s02_03120000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_03120000_04_0010","text":"──咦……\n凛世？"},{"key":"SCENARIO_s02_03120000_04_0020","text":"……！"},{"key":"SCENARIO_s02_03120000_04_0021","text":"Motion"},{"key":"SCENARIO_s02_03120000_04_0030","text":"制作人阁下……"},{"key":"SCENARIO_s02_03120000_04_0040","text":"哈哈，真巧啊"},{"key":"SCENARIO_s02_03120000_04_0041","text":"Motion"},{"key":"SCENARIO_s02_03120000_04_0050","text":"是、是的……"},{"key":"SCENARIO_s02_03120000_04_0060","text":"是出门去哪里吗？"},{"key":"SCENARIO_s02_03120000_04_0070","text":"嗯……"},{"key":"SCENARIO_s02_03120000_04_0080","text":"因为……活动快到了……"},{"key":"SCENARIO_s02_03120000_04_0090","text":"想祈愿成功……\n去神社……"},{"key":"SCENARIO_s02_03120000_04_0100","text":"啊，原来如此\n那我也一起去可以吗？"},{"key":"SCENARIO_s02_03120000_04_0110","text":"……！\n制作人大人也……？"},{"key":"SCENARIO_s02_03120000_04_0120","text":"啊，如果你想一个人去的话\n不用勉──"},{"key":"SCENARIO_s02_03120000_04_0130","text":"没，没有……"},{"key":"SCENARIO_s02_03120000_04_0140","text":"那个……\n很开心……"},{"key":"SCENARIO_s02_03120000_04_0150","text":"请务必……一起……"},{"key":"SCENARIO_s02_03120000_04_0160","text":"太好了\n那我们去祈愿吧"},{"key":"SCENARIO_s02_03120000_04_0170","text":"祈愿活动成功，还有……\n凛世能更进一步地成长"},{"key":"SCENARIO_s02_03120000_04_0180","text":"……！\n制作人大人…………好的……"},{"key":"SCENARIO_s02_03120000_04_0181","text":"Motion"}]
