[{"key":"SCENARIO_s02_03010000_01_0001","text":"Motion"},{"key":"SCENARIO_s02_03010000_01_0010","text":"…………"},{"key":"SCENARIO_s02_03010000_01_0020","text":"粉丝来信\n第一封是什么时候收到的呢"},{"key":"SCENARIO_s02_03010000_01_0030","text":"……不知不觉间\n已经积累了这么多……"},{"key":"SCENARIO_s02_03010000_01_0040","text":"是啊\n我也花了不少时间才看完"},{"key":"SCENARIO_s02_03010000_01_0050","text":"……\n信纸上，贴着可爱的贴纸……"},{"key":"SCENARIO_s02_03010000_01_0060","text":"那些残留的草稿线……一定是……\n对方一笔一画认真写下的痕迹……"},{"key":"SCENARIO_s02_03010000_01_0070","text":"……"},{"key":"SCENARIO_s02_03010000_01_0080","text":"已经有这么多的人……\n在支持我们了呢……"},{"key":"SCENARIO_s02_03010000_01_0090","text":"是啊\n真乃你们的努力传达到了粉丝们心中"},{"key":"SCENARIO_s02_03010000_01_0100","text":"能这样实实在在地感受到\n真的很开心呢"},{"key":"SCENARIO_s02_03010000_01_0101","text":"Motion"},{"key":"SCENARIO_s02_03010000_01_0110","text":"是……"},{"key":"SCENARIO_s02_03010000_01_0120","text":"……这份满溢在心中的情感\n我想立刻回报给大家……"},{"key":"SCENARIO_s02_03010000_01_0130","text":"喜欢、感谢，还有……\n希望自己能永远在你们仰望的天空中闪耀……"},{"key":"SCENARIO_s02_03010000_01_0140","text":"我想把这些心意\n通过演唱会传达出去……"},{"key":"SCENARIO_s02_03010000_01_0150","text":"嗯\n为了让真乃的心意传达出去"},{"key":"SCENARIO_s02_03010000_01_0160","text":"我也会全力协助的"},{"key":"SCENARIO_s02_03010000_01_0161","text":"Motion"},{"key":"SCENARIO_s02_03010000_01_0170","text":"制作人……"},{"key":"SCENARIO_s02_03010000_01_0180","text":"感谢您给了我这么宝贵的机会\n……我会努力呈现一场精彩的演唱会的……！"}]
