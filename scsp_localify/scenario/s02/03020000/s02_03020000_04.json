[{"key":"SCENARIO_s02_03020000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_03020000_04_0010","text":"──……！"},{"key":"SCENARIO_s02_03020000_04_0020","text":"好大的欢呼声……！"},{"key":"SCENARIO_s02_03020000_04_0030","text":"制作人……！"},{"key":"SCENARIO_s02_03020000_04_0040","text":"好好地，传达到了呢"},{"key":"SCENARIO_s02_03020000_04_0050","text":"……真的，太好了……"},{"key":"SCENARIO_s02_03020000_04_0060","text":"因为相信了……因为相信了……\n才能看到这片景色呢……！"},{"key":"SCENARIO_s02_03020000_04_0070","text":"嗯……！\n正因为是灯织你们，我才会想要相信"},{"key":"SCENARIO_s02_03020000_04_0080","text":"你们为了成为更闪耀的偶像而不断努力的样子\n让我有了这样的想法"},{"key":"SCENARIO_s02_03020000_04_0090","text":"制作人……"},{"key":"SCENARIO_s02_03020000_04_0100","text":"──看，粉丝们在呼唤\n安可，去吧！"},{"key":"SCENARIO_s02_03020000_04_0110","text":"好的……！"},{"key":"SCENARIO_s02_03020000_04_0120","text":"──我们想要尽可能\n……回应每一位支持我们的人"},{"key":"SCENARIO_s02_03020000_04_0130","text":"──因为收到了光芒──勇气、梦想、幸福……\n收到了太多太多，所以想要回报"},{"key":"SCENARIO_s02_03020000_04_0140","text":"我们能做的事情也许很少……\n也没办法承诺说能做到什么程度──"},{"key":"SCENARIO_s02_03020000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_03020000_04_0150","text":"──……但是……！\n大家一定会相信我们的……！"},{"key":"SCENARIO_s02_03020000_04_0160","text":"因为大家一定会相信我们还能做得更好……\n所以我们才能想要更加努力"},{"key":"SCENARIO_s02_03020000_04_0002","text":"Motion"},{"key":"SCENARIO_s02_03020000_04_0170","text":"──不\n请让我们，更加努力吧──！"},{"key":"SCENARIO_s02_03020000_04_0180","text":"（啊……是啊……！\n　为了灯织们的心意能够传达出去，我也要更加努力才行）"}]
