[{"key":"SCENARIO_s02_01230000_03_0010","text":"雏菜……已经准备好了吗？\n花火大会的准备"},{"key":"SCENARIO_s02_01230000_03_0020","text":"嗯～！\n好期待呢～？"},{"key":"SCENARIO_s02_01230000_03_0030","text":"是吗，真厉害"},{"key":"SCENARIO_s02_01230000_03_0040","text":"诶～？"},{"key":"SCENARIO_s02_01230000_03_0050","text":"制作人还没准备好吗～？\n准备"},{"key":"SCENARIO_s02_01230000_03_0060","text":"……不，我也准备好了"},{"key":"SCENARIO_s02_01230000_03_0070","text":"这样啊～！\n就是嘛～"},{"key":"SCENARIO_s02_01230000_03_0080","text":"当天，尽情享受吧"},{"key":"SCENARIO_s02_01230000_03_0090","text":"啊哈～\n是啊～"},{"key":"SCENARIO_s02_01230000_03_0100","text":"要开心又幸福～，好吗？"}]
