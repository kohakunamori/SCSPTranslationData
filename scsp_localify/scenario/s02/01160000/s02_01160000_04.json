[{"key":"SCENARIO_s02_01160000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_01160000_04_0010","text":"……"},{"key":"SCENARIO_s02_01160000_04_0020","text":"……！"},{"key":"SCENARIO_s02_01160000_04_0021","text":"Motion"},{"key":"SCENARIO_s02_01160000_04_0030","text":"……嗯，感觉不错……吧？"},{"key":"SCENARIO_s02_01160000_04_0040","text":"Producer先生\n能稍微看一下吗？"},{"key":"SCENARIO_s02_01160000_04_0050","text":"嗯，是要看照片拍得怎么样对吧？"},{"key":"SCENARIO_s02_01160000_04_0060","text":"呵呵……是的"},{"key":"SCENARIO_s02_01160000_04_0070","text":"…………哦哦，这张不错啊\n挥手的那张"},{"key":"SCENARIO_s02_01160000_04_0080","text":"哇，我也最喜欢那张"},{"key":"SCENARIO_s02_01160000_04_0090","text":"话说回来，千雪会自拍\n还挺稀奇的，总觉得──"},{"key":"SCENARIO_s02_01160000_04_0100","text":"──呵呵，其实呢，是甘奈酱教了我\n自拍的好方法"},{"key":"SCENARIO_s02_01160000_04_0110","text":"“庙会那天，我要拍超可爱的照片！\n　千雪小姐也要记住诀窍哦！”"},{"key":"SCENARIO_s02_01160000_04_0120","text":"哈哈，原来如此\n挺好的嘛"},{"key":"SCENARIO_s02_01160000_04_0130","text":"甜花酱也教了我怎么用枪……\n射击也要加油才行……！"},{"key":"SCENARIO_s02_01160000_04_0140","text":"看来千雪要大显身手了啊"},{"key":"SCENARIO_s02_01160000_04_0150","text":"我会让您看到好表现的"},{"key":"SCENARIO_s02_01160000_04_0160","text":"和她们两个一起"}]
