[{"key":"SCENARIO_s02_01160000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0010","text":"两个……"},{"key":"SCENARIO_s02_01160000_01_0020","text":"？"},{"key":"SCENARIO_s02_01160000_01_0021","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0030","text":"要是能有两个名额就好了……"},{"key":"SCENARIO_s02_01160000_01_0040","text":"是在说下次采访的事吗？"},{"key":"SCENARIO_s02_01160000_01_0050","text":"啊，Producer先生\n是的，没错"},{"key":"SCENARIO_s02_01160000_01_0051","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0052","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0053","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0060","text":"甘奈酱想去的游戏厅\n甜花酱推荐的书咖"},{"key":"SCENARIO_s02_01160000_01_0070","text":"要是两个都能去就好了"},{"key":"SCENARIO_s02_01160000_01_0080","text":"嗯？不是甘奈去书咖\n甜花去游戏厅吗？"},{"key":"SCENARIO_s02_01160000_01_0090","text":"是的，您说得没错♪"},{"key":"SCENARIO_s02_01160000_01_0100","text":"…………\n……啊，原来如此"},{"key":"SCENARIO_s02_01160000_01_0110","text":"呵呵，答对了"},{"key":"SCENARIO_s02_01160000_01_0120","text":"甘奈酱想看到甜花酱的\n笑容……"},{"key":"SCENARIO_s02_01160000_01_0130","text":"甜花想看到甘奈的\n笑容"},{"key":"SCENARIO_s02_01160000_01_0140","text":"……非常美好呢"},{"key":"SCENARIO_s02_01160000_01_0141","text":"Motion"},{"key":"SCENARIO_s02_01160000_01_0150","text":"所以\n想让两个人都露出笑容……"},{"key":"SCENARIO_s02_01160000_01_0160","text":"……"}]
