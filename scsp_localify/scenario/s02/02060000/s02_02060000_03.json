[{"key":"SCENARIO_s02_02060000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02060000_03_0001","text":"导演"},{"key":"SCENARIO_s02_02060000_03_0010","text":"——L'Antica酱，\n最近真的超努力的呢！"},{"key":"SCENARIO_s02_02060000_03_0020","text":"之前跟三峰酱合作过\n明明那么忙，事前准备却做得超充分"},{"key":"SCENARIO_s02_02060000_03_0030","text":"是这样啊……！"},{"key":"SCENARIO_s02_02060000_03_0040","text":"让人特别安心\n麻烦你跟制作人也转告三峰酱一声！"},{"key":"SCENARIO_s02_02060000_03_0050","text":"谢谢您\n她本人听到也会很高兴的……！"},{"key":"SCENARIO_s02_02060000_03_0051","text":"工作人员"},{"key":"SCENARIO_s02_02060000_03_0060","text":"最近在电视上到处都能看到她们呢\n之前看了摩美美酱上节目的那期！"},{"key":"SCENARIO_s02_02060000_03_0070","text":"真的吗，谢谢您——！"},{"key":"SCENARIO_s02_02060000_03_0071","text":"导演"},{"key":"SCENARIO_s02_02060000_03_0080","text":"还有恋钟酱也——————"},{"key":"SCENARIO_s02_02060000_03_0081","text":"工作人员"},{"key":"SCENARIO_s02_02060000_03_0090","text":"雾子酱也——————"},{"key":"SCENARIO_s02_02060000_03_0100","text":"………………"},{"key":"SCENARIO_s02_02060000_03_0110","text":"（大家都在被夸奖，我很开心）"},{"key":"SCENARIO_s02_02060000_03_0120","text":"（大家都在闪耀，我很开心）"},{"key":"SCENARIO_s02_02060000_03_0130","text":"（————可是）"},{"key":"SCENARIO_s02_02060000_03_0131","text":"Motion"},{"key":"SCENARIO_s02_02060000_03_0140","text":"（————……觉得寂寞什么的，不可以……）"},{"key":"SCENARIO_s02_02060000_03_0141","text":"导演"},{"key":"SCENARIO_s02_02060000_03_0150","text":"——L'Antica酱真是全员实力派啊！"},{"key":"SCENARIO_s02_02060000_03_0160","text":"……——是啊"},{"key":"SCENARIO_s02_02060000_03_0170","text":"是我引以为傲的成员"},{"key":"SCENARIO_s02_02060000_03_0180","text":"……"}]
