[{"key":"SCENARIO_s02_03170000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0010","text":"………………"},{"key":"SCENARIO_s02_03170000_03_0011","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0020","text":"──朝日\n原来你在这里"},{"key":"SCENARIO_s02_03170000_03_0021","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0022","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0030","text":"……啊，制作人"},{"key":"SCENARIO_s02_03170000_03_0040","text":"感觉，提不起劲"},{"key":"SCENARIO_s02_03170000_03_0050","text":"────嗯……也是啊"},{"key":"SCENARIO_s02_03170000_03_0051","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0060","text":"………………"},{"key":"SCENARIO_s02_03170000_03_0070","text":"……但是，还没结束呢\n朝日，你也明白的吧？"},{"key":"SCENARIO_s02_03170000_03_0080","text":"偶像祭的正式演出……"},{"key":"SCENARIO_s02_03170000_03_0090","text":"就算投票输了，在舞台上还能再战一次"},{"key":"SCENARIO_s02_03170000_03_0100","text":"……！"},{"key":"SCENARIO_s02_03170000_03_0110","text":"到那时候，去让他们见识一下吧\nStraylight的，芹泽朝日"},{"key":"SCENARIO_s02_03170000_03_0120","text":"……是的说"},{"key":"SCENARIO_s02_03170000_03_0121","text":"Motion"},{"key":"SCENARIO_s02_03170000_03_0130","text":"在舞台上的话，我就是最厉害的"},{"key":"SCENARIO_s02_03170000_03_0140","text":"──噢！"},{"key":"SCENARIO_s02_03170000_03_0150","text":"要让观众，大吃一惊的话──"},{"key":"SCENARIO_s02_03170000_03_0160","text":"把舞蹈的力度再加强一些，\n大家会不会吓一跳呢"},{"key":"SCENARIO_s02_03170000_03_0170","text":"还有……除了舞蹈之外……！\n制作人，跟我一起想想吧！"},{"key":"SCENARIO_s02_03170000_03_0180","text":"好，是啊……！\n能做的，什么都做……！"}]
