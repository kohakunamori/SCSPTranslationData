[{"key":"SCENARIO_s02_02260000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_02260000_04_0001","text":"哥哥"},{"key":"SCENARIO_s02_02260000_04_0010","text":"哈哈哈！\n你根本飞不起来嘛！"},{"key":"SCENARIO_s02_02260000_04_0002","text":"弟弟"},{"key":"SCENARIO_s02_02260000_04_0020","text":"再来一次！\n我还要再来一次！"},{"key":"SCENARIO_s02_02260000_04_0003","text":"哥哥"},{"key":"SCENARIO_s02_02260000_04_0030","text":"算了吧\n不管试多少次结果都一样哦～"},{"key":"SCENARIO_s02_02260000_04_0004","text":"弟弟"},{"key":"SCENARIO_s02_02260000_04_0040","text":"我还能飞得更高！"},{"key":"SCENARIO_s02_02260000_04_0050","text":"罐装咖啡可以吗？"},{"key":"SCENARIO_s02_02260000_04_0060","text":"偶尔在公园里悠闲地休息一下\n感觉也挺好的"},{"key":"SCENARIO_s02_02260000_04_0070","text":"我也想让路加稍微休息一下\n她一直以来都太拼命了"},{"key":"SCENARIO_s02_02260000_04_0080","text":"所以……\n希望你能来事务所"},{"key":"SCENARIO_s02_02260000_04_0090","text":"其实，CoMETIK收到了大量的演出邀请"},{"key":"SCENARIO_s02_02260000_04_0100","text":"这次，我会好好控制工作量，同时……"},{"key":"SCENARIO_s02_02260000_04_0110","text":"路加————————"},{"key":"SCENARIO_s02_02260000_04_0120","text":"────────大家，都在等你"},{"key":"SCENARIO_s02_02260000_04_0005","text":"哥哥"},{"key":"SCENARIO_s02_02260000_04_0130","text":"反正只会再受伤而已～"},{"key":"SCENARIO_s02_02260000_04_0140","text":"…………"},{"key":"SCENARIO_s02_02260000_04_0150","text":"来，咖啡\n我们等着你"},{"key":"SCENARIO_s02_02260000_04_0160","text":"────────"},{"key":"SCENARIO_s02_02260000_04_0170","text":"反正不管试多少次都不行的！"},{"key":"SCENARIO_s02_02260000_04_0180","text":"快别练了！"}]
