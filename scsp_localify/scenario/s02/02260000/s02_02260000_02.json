[{"key":"SCENARIO_s02_02260000_02_0000","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0010","text":"（为什么）"},{"key":"SCENARIO_s02_02260000_02_0001","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0020","text":"我希望你们三个人组成组合"},{"key":"SCENARIO_s02_02260000_02_0002","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0030","text":"（为什么────）"},{"key":"SCENARIO_s02_02260000_02_0003","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0040","text":"──────"},{"key":"SCENARIO_s02_02260000_02_0050","text":"唔──────！"},{"key":"SCENARIO_s02_02260000_02_0004","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0005","text":"Motion"},{"key":"SCENARIO_s02_02260000_02_0060","text":"说了别过来"},{"key":"SCENARIO_s02_02260000_02_0070","text":"虽然现在是关键时期，希望你不要勉强自己……"},{"key":"SCENARIO_s02_02260000_02_0080","text":"但我也想做我能做的事"},{"key":"SCENARIO_s02_02260000_02_0090","text":"啊……？"},{"key":"SCENARIO_s02_02260000_02_0100","text":"那个麦克风，好像出问题了"},{"key":"SCENARIO_s02_02260000_02_0110","text":"他们说会准备备用的，\n你等一下"},{"key":"SCENARIO_s02_02260000_02_0120","text":"不需要\n滚远点"},{"key":"SCENARIO_s02_02260000_02_0130","text":"可是，那样的话────"},{"key":"SCENARIO_s02_02260000_02_0140","text":"滚远点──────！"},{"key":"SCENARIO_s02_02260000_02_0150","text":"别勉强自己"},{"key":"SCENARIO_s02_02260000_02_0160","text":"什么都不需要……"},{"key":"SCENARIO_s02_02260000_02_0170","text":"我，我──────"},{"key":"SCENARIO_s02_02260000_02_0180","text":"我———"}]
