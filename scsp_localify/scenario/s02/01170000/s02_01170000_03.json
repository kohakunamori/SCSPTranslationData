[{"key":"SCENARIO_s02_01170000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0010","text":"——噗"},{"key":"SCENARIO_s02_01170000_03_0002","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0020","text":"哈……哈……\nProducer先生"},{"key":"SCENARIO_s02_01170000_03_0003","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0030","text":"哈哈……\n朝日，干劲十足啊"},{"key":"SCENARIO_s02_01170000_03_0040","text":"而且，看起来很开心。突然说要对战\n我还以为你会紧张呢……"},{"key":"SCENARIO_s02_01170000_03_0007","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0050","text":"是吗？\n对战听起来很有趣啊！"},{"key":"SCENARIO_s02_01170000_03_0004","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0060","text":"……Producer先生，我没有错对吧？"},{"key":"SCENARIO_s02_01170000_03_0070","text":"做开心的事"},{"key":"SCENARIO_s02_01170000_03_0005","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0006","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0080","text":"────我，不懂什么复杂的事情\n不开心的话就做不下去"},{"key":"SCENARIO_s02_01170000_03_0090","text":"……你是在说冬优子的事吗？"},{"key":"SCENARIO_s02_01170000_03_0100","text":"…………"},{"key":"SCENARIO_s02_01170000_03_0110","text":"我觉得冬优子并不是因为讨厌才那么做的"},{"key":"SCENARIO_s02_01170000_03_0008","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0120","text":"她是在认真思考\n用她自己的方式选择最好的做法"},{"key":"SCENARIO_s02_01170000_03_0130","text":"那个过程在朝日看来可能并不开心……\n但如果是真的不想做的事，冬优子也不会做的"},{"key":"SCENARIO_s02_01170000_03_0140","text":"不过，没关系\n朝日做朝日自己就好"},{"key":"SCENARIO_s02_01170000_03_0009","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0150","text":"──我，只要把舞蹈练到完美\n就一定能赢对吧"},{"key":"SCENARIO_s02_01170000_03_0160","text":"好好练习……做到完美，绝对不输！"},{"key":"SCENARIO_s02_01170000_03_0170","text":"不然的话，就不好玩了嘛"},{"key":"SCENARIO_s02_01170000_03_0011","text":"Motion"},{"key":"SCENARIO_s02_01170000_03_0180","text":"————啊啊"}]
