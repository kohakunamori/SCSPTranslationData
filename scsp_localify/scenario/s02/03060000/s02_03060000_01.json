[{"key":"SCENARIO_s02_03060000_01_0000","text":"Motion"},{"key":"SCENARIO_s02_03060000_01_0010","text":"…………"},{"key":"SCENARIO_s02_03060000_01_0020","text":"咲耶，工作人员说\n换场景需要花些时间"},{"key":"SCENARIO_s02_03060000_01_0030","text":"休息时间可能会延长，\n说可以暂时回休息室"},{"key":"SCENARIO_s02_03060000_01_0040","text":"了解\n那我先回去一趟吧"},{"key":"SCENARIO_s02_03060000_01_0050","text":"嗯"},{"key":"SCENARIO_s02_03060000_01_0060","text":"既然有时间了，\n不介意的话，一起喝杯茶怎么样？"},{"key":"SCENARIO_s02_03060000_01_0070","text":"哦，好啊\n那我也一起回去"},{"key":"SCENARIO_s02_03060000_01_0071","text":"Motion"},{"key":"SCENARIO_s02_03060000_01_0072","text":"Motion"},{"key":"SCENARIO_s02_03060000_01_0080","text":"来，咖啡"},{"key":"SCENARIO_s02_03060000_01_0090","text":"谢谢"},{"key":"SCENARIO_s02_03060000_01_0100","text":"……咲耶\n发生什么事了吗？"},{"key":"SCENARIO_s02_03060000_01_0110","text":"诶？"},{"key":"SCENARIO_s02_03060000_01_0120","text":"不，如果是我多想了就抱歉\n刚才你看起来有点闷闷不乐的"},{"key":"SCENARIO_s02_03060000_01_0130","text":"……啊────\n你果然还是那么善于观察"},{"key":"SCENARIO_s02_03060000_01_0140","text":"我在想前几天拍摄的独唱版广告，\n客户那边的评价怎么样……"},{"key":"SCENARIO_s02_03060000_01_0150","text":"原来如此……那就不用担心了\n客户也说拍得非常棒"},{"key":"SCENARIO_s02_03060000_01_0160","text":"评价很好"},{"key":"SCENARIO_s02_03060000_01_0170","text":"……太好了"},{"key":"SCENARIO_s02_03060000_01_0180","text":"那接下来的拍摄，也要加油才行呢"},{"key":"SCENARIO_s02_03060000_01_0181","text":"Motion"}]
