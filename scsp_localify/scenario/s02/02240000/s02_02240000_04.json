[{"key":"SCENARIO_s02_02240000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_02240000_04_0010","text":"……"},{"key":"SCENARIO_s02_02240000_04_0020","text":"我在集中精神"},{"key":"SCENARIO_s02_02240000_04_0030","text":"……是吗，抱歉"},{"key":"SCENARIO_s02_02240000_04_0001","text":"Motion"},{"key":"SCENARIO_s02_02240000_04_0040","text":"要是觉得抱歉的话……\n────……唔"},{"key":"SCENARIO_s02_02240000_04_0050","text":"……"},{"key":"SCENARIO_s02_02240000_04_0060","text":"我也没有什么特别的事"},{"key":"SCENARIO_s02_02240000_04_0070","text":"……哈哈，是那个吗？\n是来问演出前的决心的吗？"},{"key":"SCENARIO_s02_02240000_04_0080","text":"那种事……\n────那种事……"},{"key":"SCENARIO_s02_02240000_04_0090","text":"抱歉"},{"key":"SCENARIO_s02_02240000_04_0100","text":"想集中精神，对吧……\n打扰了，抱歉"},{"key":"SCENARIO_s02_02240000_04_0110","text":"不过，只有一句话让我说"},{"key":"SCENARIO_s02_02240000_04_0120","text":"……别受伤了"},{"key":"SCENARIO_s02_02240000_04_0130","text":"……"},{"key":"SCENARIO_s02_02240000_04_0140","text":"（我没有……所以，我）"},{"key":"SCENARIO_s02_02240000_04_0150","text":"（没有，武器什么的\n　从一开始就没有）"},{"key":"SCENARIO_s02_02240000_04_0160","text":"（为了让美琴小姐能飞翔…………\n　…………为了能被允许站在美琴小姐身边）"},{"key":"SCENARIO_s02_02240000_04_0170","text":"（只是当个台座而已）"},{"key":"SCENARIO_s02_02240000_04_0180","text":"除此之外的价值……什么的────"}]
