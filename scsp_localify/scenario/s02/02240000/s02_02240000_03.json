[{"key":"SCENARIO_s02_02240000_03_0000","text":"Motion"},{"key":"SCENARIO_s02_02240000_03_0001","text":"Motion"},{"key":"SCENARIO_s02_02240000_03_0002","text":"Motion"},{"key":"SCENARIO_s02_02240000_03_0010","text":"……"},{"key":"SCENARIO_s02_02240000_03_0020","text":"我送你吧"},{"key":"SCENARIO_s02_02240000_03_0030","text":"────该不会，是在埋伏等我吧？"},{"key":"SCENARIO_s02_02240000_03_0040","text":"不是\n我是去打完招呼，正好回来"},{"key":"SCENARIO_s02_02240000_03_0050","text":"啊——原来是这样啊——！\n辛苦了，一直以来多谢关照——"},{"key":"SCENARIO_s02_02240000_03_0060","text":"……现代舞的\n训练也不用上了"},{"key":"SCENARIO_s02_02240000_03_0070","text":"排日程什么的\n也比以前轻松多了吧——"},{"key":"SCENARIO_s02_02240000_03_0080","text":"日花……"},{"key":"SCENARIO_s02_02240000_03_0090","text":"──────……\n“只要做能做的表演就行了”……"},{"key":"SCENARIO_s02_02240000_03_0100","text":"────什么意思"},{"key":"SCENARIO_s02_02240000_03_0110","text":"……"},{"key":"SCENARIO_s02_02240000_03_0120","text":"明明都是我的错……"},{"key":"SCENARIO_s02_02240000_03_0130","text":"因为我的错，\n美琴小姐想做的事情都做不了了……"},{"key":"SCENARIO_s02_02240000_03_0140","text":"不是那样的"},{"key":"SCENARIO_s02_02240000_03_0150","text":"────哈\n哪里不一样啊……"},{"key":"SCENARIO_s02_02240000_03_0160","text":"我，我……────"},{"key":"SCENARIO_s02_02240000_03_0170","text":"即便如此，日花还是SHHis的一员"},{"key":"SCENARIO_s02_02240000_03_0180","text":"两个人要一起站上舞台"}]
