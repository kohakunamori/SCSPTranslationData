[{"key":"SCENARIO_s02_03200000_04_0000","text":"Motion"},{"key":"SCENARIO_s02_03200000_04_0010","text":"哦——……"},{"key":"SCENARIO_s02_03200000_04_0020","text":"透，你刚才一直在看什么？"},{"key":"SCENARIO_s02_03200000_04_0030","text":"诶？\n啊—，马"},{"key":"SCENARIO_s02_03200000_04_0040","text":"马……？"},{"key":"SCENARIO_s02_03200000_04_0050","text":"嗯，视频\n就是那种，骑马的"},{"key":"SCENARIO_s02_03200000_04_0060","text":"是骑马视频吗？\n怎么看起那个来了？"},{"key":"SCENARIO_s02_03200000_04_0070","text":"诶，因为要用的嘛\n骑马战"},{"key":"SCENARIO_s02_03200000_04_0080","text":"所以"},{"key":"SCENARIO_s02_03200000_04_0090","text":"啊……诶？\n你是说看这个来参考骑马战？"},{"key":"SCENARIO_s02_03200000_04_0100","text":"……不行吗？\n参考"},{"key":"SCENARIO_s02_03200000_04_0110","text":"嗯……\n骑马和骑马战感觉不太一样……"},{"key":"SCENARIO_s02_03200000_04_0120","text":"这样啊"},{"key":"SCENARIO_s02_03200000_04_0130","text":"没有骑马战的视频吗？\n那种总结了取胜技巧的……"},{"key":"SCENARIO_s02_03200000_04_0140","text":"──啊，虽然不是视频\n但有个总结了必胜法的网站"},{"key":"SCENARIO_s02_03200000_04_0150","text":"这个应该能当参考\n我现在把URL发给你"},{"key":"SCENARIO_s02_03200000_04_0160","text":"感谢"},{"key":"SCENARIO_s02_03200000_04_0170","text":"──制作人\n我们会拿冠军的，我们"},{"key":"SCENARIO_s02_03200000_04_0180","text":"看看这个"}]
