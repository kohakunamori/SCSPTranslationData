[{"key":"SCENARIO_s20_30500400_03_0000","text":"Motion"},{"key":"SCENARIO_s20_30500400_03_0009","text":"布偶装"},{"key":"SCENARIO_s20_30500400_03_0010","text":"纸巾请用～！\n那边已经开业了，欢迎光临～！"},{"key":"SCENARIO_s20_30500400_03_0020","text":"啊……\n好的……"},{"key":"SCENARIO_s20_30500400_03_0029","text":"布偶装"},{"key":"SCENARIO_s20_30500400_03_0030","text":"谢谢您！\n欢迎来店里看看哦～！"},{"key":"SCENARIO_s20_30500400_03_0032","text":"Motion"},{"key":"SCENARIO_s20_30500400_03_0031","text":"Motion"},{"key":"SCENARIO_s20_30500400_03_0040","text":"房产中介……\n房子的户型图……画在上面……"},{"key":"SCENARIO_s20_30500400_03_0050","text":"“采光良好、近车站、带空调”……\n这……是相当不错的房源哦"},{"key":"SCENARIO_s20_30500400_03_0060","text":"都拍胸脯保证了嘛～\n……嗯，不过这里是不是有点窄？"},{"key":"SCENARIO_s20_30500400_03_0070","text":"感觉只能放下蒙德他们的鱼缸和冰箱……"},{"key":"SCENARIO_s20_30500400_03_0080","text":"哎呀哎呀，麻美美\n你这是对搬家感兴趣了？"},{"key":"SCENARIO_s20_30500400_03_0090","text":"倒也不是那样啦\n但看户型图不是挺有意思的嘛？"},{"key":"SCENARIO_s20_30500400_03_0100","text":"呵呵……嗯……\n想象一下……很开心呢……"},{"key":"SCENARIO_s20_30500400_03_0101","text":"Motion"}]
