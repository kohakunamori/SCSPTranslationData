[{"key":"SCENARIO_s20_32600300_03_0000","text":"Motion"},{"key":"SCENARIO_s20_32600300_03_0010","text":"哇……雨下得挺大的……！"},{"key":"SCENARIO_s20_32600300_03_0020","text":"────────"},{"key":"SCENARIO_s20_32600300_03_0021","text":"Motion"},{"key":"SCENARIO_s20_32600300_03_0030","text":"路、路加酱……！？\n等等等等……！"},{"key":"SCENARIO_s20_32600300_03_0040","text":"路加酱，\n你没带伞吗？"},{"key":"SCENARIO_s20_32600300_03_0050","text":"没什么"},{"key":"SCENARIO_s20_32600300_03_0060","text":"我带了折叠伞呢。"},{"key":"SCENARIO_s20_32600300_03_0070","text":"可能会有点挤……\n一起撑吧……！"},{"key":"SCENARIO_s20_32600300_03_0071","text":"Motion"},{"key":"SCENARIO_s20_32600300_03_0080","text":"——怎么样？"},{"key":"SCENARIO_s20_32600300_03_0081","text":"Motion"},{"key":"SCENARIO_s20_32600300_03_0090","text":"……"},{"key":"SCENARIO_s20_32600300_03_0100","text":"呵呵……"}]
