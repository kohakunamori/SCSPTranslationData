[{"key":"SCENARIO_s20_20300100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_20300100_02_0010","text":"──……司康饼，马上就好……！"},{"key":"SCENARIO_s20_20300100_02_0020","text":"好的！"},{"key":"SCENARIO_s20_20300100_02_0030","text":"真乃真乃！\n来尝尝果酱的味道！"},{"key":"SCENARIO_s20_20300100_02_0040","text":"嗯……"},{"key":"SCENARIO_s20_20300100_02_0050","text":"好，啊──"},{"key":"SCENARIO_s20_20300100_02_0060","text":"啊——……"},{"key":"SCENARIO_s20_20300100_02_0070","text":"嗯！"},{"key":"SCENARIO_s20_20300100_02_0080","text":"怎么样……！？"},{"key":"SCENARIO_s20_20300100_02_0090","text":"──嗯，好吃……！"},{"key":"SCENARIO_s20_20300100_02_0100","text":"好想让灯织也快点尝尝呢……！"},{"key":"SCENARIO_s20_20300100_02_0101","text":"Motion"}]
