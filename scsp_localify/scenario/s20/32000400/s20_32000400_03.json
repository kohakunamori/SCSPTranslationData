[{"key":"SCENARIO_s20_32000400_03_0000","text":"Motion"},{"key":"SCENARIO_s20_32000400_03_0010","text":"啊～，下雨了～……"},{"key":"SCENARIO_s20_32000400_03_0020","text":"啊——……"},{"key":"SCENARIO_s20_32000400_03_0030","text":"买把伞～？\n刚才那家店有卖哦～"},{"key":"SCENARIO_s20_32000400_03_0040","text":"嗯"},{"key":"SCENARIO_s20_32000400_03_0050","text":"透前辈，要哪把伞～？"},{"key":"SCENARIO_s20_32000400_03_0060","text":"嗯——，你选吧"},{"key":"SCENARIO_s20_32000400_03_0070","text":"那……\n雏菜要这把黄色的伞～"},{"key":"SCENARIO_s20_32000400_03_0080","text":"超有雏菜的感觉"},{"key":"SCENARIO_s20_32000400_03_0090","text":"啊哈～\n用这把伞一起撑吧～"},{"key":"SCENARIO_s20_32000400_03_0100","text":"OK——"}]
