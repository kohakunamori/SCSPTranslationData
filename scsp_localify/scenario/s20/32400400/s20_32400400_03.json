[{"key":"SCENARIO_s20_32400400_03_0001","text":"Motion"},{"key":"SCENARIO_s20_32400400_03_0010","text":"『第25次…………』"},{"key":"SCENARIO_s20_32400400_03_0020","text":"『────啪啪、哒哒！　定格……！』"},{"key":"SCENARIO_s20_32400400_03_0030","text":"哇，台阶晃来晃去的……\n……阿嚏！"},{"key":"SCENARIO_s20_32400400_03_0040","text":"好冷──────\n算了…………回家吧…………"},{"key":"SCENARIO_s20_32400400_03_0041","text":"Motion"},{"key":"SCENARIO_s20_32400400_03_0050","text":"『拍摄结束了』"},{"key":"SCENARIO_s20_32400400_03_0060","text":"美、美琴小姐────！？"},{"key":"SCENARIO_s20_32400400_03_0070","text":"『还在练习室吗？』"},{"key":"SCENARIO_s20_32400400_03_0080","text":"『可以过去吗？』"},{"key":"SCENARIO_s20_32400400_03_0081","text":"Motion"},{"key":"SCENARIO_s20_32400400_03_0090","text":"『好的！　等您过来！\n　请注意别着凉了！』"},{"key":"SCENARIO_s20_32400400_03_0100","text":"好，上吧————……！\n────啪嗒啪嗒……咚咚…………！"}]
