[{"key":"SCENARIO_s20_30900400_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30900400_04_0010","text":"…………"},{"key":"SCENARIO_s20_30900400_04_0011","text":"电视实况转播"},{"key":"SCENARIO_s20_30900400_04_0020","text":"『打出去了————！！』\n『在这个关键时刻打出去了！满垒本垒打！』"},{"key":"SCENARIO_s20_30900400_04_0030","text":"……！／……唔"},{"key":"SCENARIO_s20_30900400_04_0031","text":"电视实况转播"},{"key":"SCENARIO_s20_30900400_04_0040","text":"『不愧是王牌，该出手时就出手！』"},{"key":"SCENARIO_s20_30900400_04_0050","text":"凛世小姐！这样就是得了4分对吧！？"},{"key":"SCENARIO_s20_30900400_04_0060","text":"嗯……"},{"key":"SCENARIO_s20_30900400_04_0070","text":"太精彩了……\n本垒打……"},{"key":"SCENARIO_s20_30900400_04_0080","text":"～～～～～～～！！"},{"key":"SCENARIO_s20_30900400_04_0090","text":"好厉害！\n好帅气！"},{"key":"SCENARIO_s20_30900400_04_0100","text":"呵呵……\n简直……就像英雄一样……"}]
