[{"key":"SCENARIO_s20_31400600_03_0001","text":"Motion"},{"key":"SCENARIO_s20_31400600_03_0010","text":"～♪"},{"key":"SCENARIO_s20_31400600_03_0020","text":"（大热天浇水，好开心啊……！）"},{"key":"SCENARIO_s20_31400600_03_0030","text":"（朝上喷，让水花溅到身上…………\n　好凉快……）"},{"key":"SCENARIO_s20_31400600_03_0040","text":"──…………"},{"key":"SCENARIO_s20_31400600_03_0050","text":"（好大的彩虹……好像能抓住…………）"},{"key":"SCENARIO_s20_31400600_03_0060","text":"……诶嘿嘿"},{"key":"SCENARIO_s20_31400600_03_0061","text":"Motion"},{"key":"SCENARIO_s20_31400600_03_0070","text":"甜花酱——！\n快来快来！"},{"key":"SCENARIO_s20_31400600_03_0080","text":"小甜……？\n外面……好热……"},{"key":"SCENARIO_s20_31400600_03_0090","text":"没关系！\n又凉快……而且超——漂亮的！"},{"key":"SCENARIO_s20_31400600_03_0100","text":"热到让你忘掉的那种！"}]
