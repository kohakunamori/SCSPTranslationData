[{"key":"SCENARIO_s20_32200300_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32200300_02_0009","text":"手机游戏"},{"key":"SCENARIO_s20_32200300_02_0010","text":"『问题。向日葵的学名是？』"},{"key":"SCENARIO_s20_32200300_02_0020","text":"诶～，是什么呢～……\n透前辈，你知道吗～？"},{"key":"SCENARIO_s20_32200300_02_0030","text":"嗯，唔──……\n跳过，樋口"},{"key":"SCENARIO_s20_32200300_02_0031","text":"Motion"},{"key":"SCENARIO_s20_32200300_02_0040","text":"跳过，小糸"},{"key":"SCENARIO_s20_32200300_02_0050","text":"诶，那个，Helianthus？"},{"key":"SCENARIO_s20_32200300_02_0051","text":"Motion"},{"key":"SCENARIO_s20_32200300_02_0060","text":"哦——／答对了～"},{"key":"SCENARIO_s20_32200300_02_0070","text":"挺行的嘛"},{"key":"SCENARIO_s20_32200300_02_0080","text":"啊哈～\n小糸酱，好厉害～～～"},{"key":"SCENARIO_s20_32200300_02_0081","text":"Motion"},{"key":"SCENARIO_s20_32200300_02_0090","text":"这样就通关了吗？"},{"key":"SCENARIO_s20_32200300_02_0100","text":"还、还没有……好像还有\n下、下一题是──"}]
