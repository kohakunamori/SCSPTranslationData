[{"key":"SCENARIO_s20_32200300_04_0001","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0010","text":"…………"},{"key":"SCENARIO_s20_32200300_04_0020","text":"小糸酱，该不会是在紧张吧～？"},{"key":"SCENARIO_s20_32200300_04_0021","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0030","text":"…………！\n才、才没有，完全没事……！"},{"key":"SCENARIO_s20_32200300_04_0040","text":"这样啊～……"},{"key":"SCENARIO_s20_32200300_04_0050","text":"雏菜酱，不、不会紧张……吗？"},{"key":"SCENARIO_s20_32200300_04_0060","text":"不会～！\n今天的拍摄也超期待的～！"},{"key":"SCENARIO_s20_32200300_04_0061","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0062","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0069","text":"摄影师"},{"key":"SCENARIO_s20_32200300_04_0070","text":"不好意思——！\n差不多可以开始了吗？"},{"key":"SCENARIO_s20_32200300_04_0071","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0080","text":"好的，拜托了\n……走吧"},{"key":"SCENARIO_s20_32200300_04_0090","text":"是——"},{"key":"SCENARIO_s20_32200300_04_0091","text":"Motion"},{"key":"SCENARIO_s20_32200300_04_0100","text":"好，那要拍了哦——\n３、２、１──"}]
