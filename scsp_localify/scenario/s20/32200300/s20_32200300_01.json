[{"key":"SCENARIO_s20_32200300_01_0001","text":"Motion"},{"key":"SCENARIO_s20_32200300_01_0010","text":"噢"},{"key":"SCENARIO_s20_32200300_01_0020","text":"透酱……！\n终、终于找到你了！　一个人跑哪去了──"},{"key":"SCENARIO_s20_32200300_01_0030","text":"来得正好"},{"key":"SCENARIO_s20_32200300_01_0040","text":"…………诶？"},{"key":"SCENARIO_s20_32200300_01_0050","text":"咦～？\n两个人在这里喝饮料呀～？"},{"key":"SCENARIO_s20_32200300_01_0051","text":"Motion"},{"key":"SCENARIO_s20_32200300_01_0060","text":"透酱给我的\n好像中奖了……！"},{"key":"SCENARIO_s20_32200300_01_0070","text":"太好了呢"},{"key":"SCENARIO_s20_32200300_01_0080","text":"我请客，你们俩的也"},{"key":"SCENARIO_s20_32200300_01_0081","text":"Motion"},{"key":"SCENARIO_s20_32200300_01_0082","text":"Motion"},{"key":"SCENARIO_s20_32200300_01_0090","text":"……啊哈～\n没中呢～"},{"key":"SCENARIO_s20_32200300_01_0100","text":"……不用了，我自己付\n自己来"}]
