[{"key":"SCENARIO_s20_39000200_02_0001","text":"Motion"},{"key":"SCENARIO_s20_39000200_02_0002","text":"Motion"},{"key":"SCENARIO_s20_39000200_02_0010","text":"……啊\n辛苦了～"},{"key":"SCENARIO_s20_39000200_02_0020","text":"──摩美美小姐\n辛苦了～"},{"key":"SCENARIO_s20_39000200_02_0021","text":"Motion"},{"key":"SCENARIO_s20_39000200_02_0030","text":"……那个\n这个—"},{"key":"SCENARIO_s20_39000200_02_0040","text":"今天在现场拿到的\n慰问品来着—"},{"key":"SCENARIO_s20_39000200_02_0050","text":"……多出来了\n不嫌弃的话—"},{"key":"SCENARIO_s20_39000200_02_0051","text":"Motion"},{"key":"SCENARIO_s20_39000200_02_0060","text":"……！\n呵呵，谢谢您～"},{"key":"SCENARIO_s20_39000200_02_0070","text":"制作人也差不多要回来了\n我会好好享用的～"},{"key":"SCENARIO_s20_39000200_02_0071","text":"Motion"},{"key":"SCENARIO_s20_39000200_02_0080","text":"──还有，我会好好转达\n说是摩美美小姐送来的"},{"key":"SCENARIO_s20_39000200_02_0090","text":"……呀\n那种事，就不用特意说了—"},{"key":"SCENARIO_s20_39000200_02_0100","text":"……呵呵"}]
