[{"key":"SCENARIO_s20_39000200_01_0001","text":"Motion"},{"key":"SCENARIO_s20_39000200_01_0010","text":"──忙死了～～～～！"},{"key":"SCENARIO_s20_39000200_01_0020","text":"恋钟小姐\n资料我放进包里了哦～"},{"key":"SCENARIO_s20_39000200_01_0030","text":"叶月～！\n帮大忙了～……！！"},{"key":"SCENARIO_s20_39000200_01_0040","text":"呵呵，哪里哪里～"},{"key":"SCENARIO_s20_39000200_01_0041","text":"Motion"},{"key":"SCENARIO_s20_39000200_01_0050","text":"──小恋钟，制作人在等着呢\n三峰我们先去车上啦……！"},{"key":"SCENARIO_s20_39000200_01_0060","text":"抱歉～！\n我马上就去……！"},{"key":"SCENARIO_s20_39000200_01_0070","text":"……恋钟说的“马上”\n我可信不过呢"},{"key":"SCENARIO_s20_39000200_01_0080","text":"诶……\n哪有这种事～！"},{"key":"SCENARIO_s20_39000200_01_0081","text":"Motion"},{"key":"SCENARIO_s20_39000200_01_0082","text":"Motion"},{"key":"SCENARIO_s20_39000200_01_0090","text":"叶月，各种事情都谢谢你啦～……！\n那就，我们出发了～！"},{"key":"SCENARIO_s20_39000200_01_0091","text":"Motion"},{"key":"SCENARIO_s20_39000200_01_0100","text":"──呵呵，好的\n路上小心哦～"}]
