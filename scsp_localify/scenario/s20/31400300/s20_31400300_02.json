[{"key":"SCENARIO_s20_31400300_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31400300_02_0010","text":"……好！"},{"key":"SCENARIO_s20_31400300_02_0020","text":"？\n那是在做什么呢？"},{"key":"SCENARIO_s20_31400300_02_0030","text":"甘奈流的零碎时间利用术哦～"},{"key":"SCENARIO_s20_31400300_02_0040","text":"像这样把教科书\n拍下来存着的话……"},{"key":"SCENARIO_s20_31400300_02_0050","text":"就算在移动中\n也能轻松学习呢～"},{"key":"SCENARIO_s20_31400300_02_0060","text":"原来如此……！\n这办法真聪明啊"},{"key":"SCENARIO_s20_31400300_02_0061","text":"Motion"},{"key":"SCENARIO_s20_31400300_02_0070","text":"今天有好几门课\n都需要复习"},{"key":"SCENARIO_s20_31400300_02_0080","text":"而且还有不用带好几本书\n到处跑的优点哦！"},{"key":"SCENARIO_s20_31400300_02_0090","text":"甘奈真是有计划性啊\n我也得向你学习了"},{"key":"SCENARIO_s20_31400300_02_0100","text":"嘿嘿\n请便请便～☆"}]
