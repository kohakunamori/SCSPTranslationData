[{"key":"SCENARIO_s20_31600300_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31600300_02_0010","text":"……决定了\n我要点牛肉烩饭"},{"key":"SCENARIO_s20_31600300_02_0020","text":"甜花也……！\n正想……点那个……！"},{"key":"SCENARIO_s20_31600300_02_0021","text":"Motion"},{"key":"SCENARIO_s20_31600300_02_0029","text":"店员"},{"key":"SCENARIO_s20_31600300_02_0030","text":"──汉堡肉套餐来了"},{"key":"SCENARIO_s20_31600300_02_0039","text":"邻座的客人"},{"key":"SCENARIO_s20_31600300_02_0040","text":"非常感谢"},{"key":"SCENARIO_s20_31600300_02_0050","text":"（……怎么办，好香……\n　有点动摇了）"},{"key":"SCENARIO_s20_31600300_02_0051","text":"Motion"},{"key":"SCENARIO_s20_31600300_02_0059","text":"店员"},{"key":"SCENARIO_s20_31600300_02_0060","text":"请问您要点什么？"},{"key":"SCENARIO_s20_31600300_02_0070","text":"啊，那个……\n……汉堡肉套餐，一份……"},{"key":"SCENARIO_s20_31600300_02_0080","text":"……！\n那个……我也要一样的"},{"key":"SCENARIO_s20_31600300_02_0089","text":"店员"},{"key":"SCENARIO_s20_31600300_02_0090","text":"汉堡肉套餐两份\n好的"},{"key":"SCENARIO_s20_31600300_02_0091","text":"Motion"},{"key":"SCENARIO_s20_31600300_02_0100","text":"……呵呵／……嘿嘿……"}]
