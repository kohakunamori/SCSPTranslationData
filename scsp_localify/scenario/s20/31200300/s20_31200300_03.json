[{"key":"SCENARIO_s20_31200300_03_0000","text":"Motion"},{"key":"SCENARIO_s20_31200300_03_0001","text":"Motion"},{"key":"SCENARIO_s20_31200300_03_0010","text":"是制作人发来的\n好像会晚一点到"},{"key":"SCENARIO_s20_31200300_03_0020","text":"太阳也很晒，\n我们找家附近的店进去等吧"},{"key":"SCENARIO_s20_31200300_03_0030","text":"好的！／好的……"},{"key":"SCENARIO_s20_31200300_03_0003","text":"Motion"},{"key":"SCENARIO_s20_31200300_03_0040","text":"……！"},{"key":"SCENARIO_s20_31200300_03_0050","text":"凛世小姐，夏叶小姐……！\n你们看！"},{"key":"SCENARIO_s20_31200300_03_0004","text":"Motion"},{"key":"SCENARIO_s20_31200300_03_0060","text":"是喷雾淋浴呢"},{"key":"SCENARIO_s20_31200300_03_0070","text":"是的！\n要不要稍微冲一下……！"},{"key":"SCENARIO_s20_31200300_03_0080","text":"呵呵，好啊！"},{"key":"SCENARIO_s20_31200300_03_0090","text":"好……\n冲一下吧……"},{"key":"SCENARIO_s20_31200300_03_0100","text":"诶嘿嘿，好！"}]
