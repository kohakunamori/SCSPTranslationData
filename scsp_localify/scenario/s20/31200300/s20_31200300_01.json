[{"key":"SCENARIO_s20_31200300_01_0000","text":"Motion"},{"key":"SCENARIO_s20_31200300_01_0010","text":"今天也好热啊～……！"},{"key":"SCENARIO_s20_31200300_01_0020","text":"嗯……"},{"key":"SCENARIO_s20_31200300_01_0030","text":"早知道带点什么能降温的东西来了……！"},{"key":"SCENARIO_s20_31200300_01_0040","text":"嗯……"},{"key":"SCENARIO_s20_31200300_01_9999","text":"家电店的广播"},{"key":"SCENARIO_s20_31200300_01_0050","text":"『——有了这个，房间也清凉舒爽！\n　欢迎前来选购！』"},{"key":"SCENARIO_s20_31200300_01_0060","text":"凛世酱……！\n你看……！"},{"key":"SCENARIO_s20_31200300_01_0001","text":"Motion"},{"key":"SCENARIO_s20_31200300_01_0070","text":"电风扇……"},{"key":"SCENARIO_s20_31200300_01_0080","text":"要不要……稍微去逛逛……？"},{"key":"SCENARIO_s20_31200300_01_0090","text":"嗯……"},{"key":"SCENARIO_s20_31200300_01_0002","text":"Motion"},{"key":"SCENARIO_s20_31200300_01_0100","text":"呼……／呵呵……"}]
