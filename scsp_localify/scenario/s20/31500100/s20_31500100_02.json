[{"key":"SCENARIO_s20_31500100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31500100_02_0010","text":"啊……"},{"key":"SCENARIO_s20_31500100_02_0020","text":"（那个音游……）"},{"key":"SCENARIO_s20_31500100_02_0030","text":"（出新曲了……！\n　看起来好好玩……！）"},{"key":"SCENARIO_s20_31500100_02_0040","text":"（好久没……\n　打僵尸了，也好想打……）"},{"key":"SCENARIO_s20_31500100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_31500100_02_0050","text":"（──不、不对……）"},{"key":"SCENARIO_s20_31500100_02_0002","text":"Motion"},{"key":"SCENARIO_s20_31500100_02_0060","text":"……！"},{"key":"SCENARIO_s20_31500100_02_0070","text":"（找到了……！\n　恶魔太郎……！）"},{"key":"SCENARIO_s20_31500100_02_0080","text":"（啊呜……\n　这么、窄的地方……挤得满满的……！）"},{"key":"SCENARIO_s20_31500100_02_0090","text":"…………"},{"key":"SCENARIO_s20_31500100_02_0100","text":"（甜花，现在……\n　就来救你……！）"}]
