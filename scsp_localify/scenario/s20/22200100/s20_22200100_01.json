[{"key":"SCENARIO_s20_22200100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_22200100_01_0010","text":"啊……！"},{"key":"SCENARIO_s20_22200100_01_0020","text":"站台\n电车已经来了……！"},{"key":"SCENARIO_s20_22200100_01_0030","text":"真的呢～\n要坐那趟吗～？"},{"key":"SCENARIO_s20_22200100_01_0040","text":"嗯——……"},{"key":"SCENARIO_s20_22200100_01_0050","text":"下一趟，12分钟后"},{"key":"SCENARIO_s20_22200100_01_0060","text":"啊哈～\n好尴尬～"},{"key":"SCENARIO_s20_22200100_01_0070","text":"跑、跑的话说不定能赶上……！"},{"key":"SCENARIO_s20_22200100_01_0080","text":"那，走吧"},{"key":"SCENARIO_s20_22200100_01_0090","text":"…………！"},{"key":"SCENARIO_s20_22200100_01_0100","text":"嗯、嗯……！"}]
