[{"key":"SCENARIO_s20_22200100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_22200100_02_0010","text":"啊……！"},{"key":"SCENARIO_s20_22200100_02_0020","text":"跑、跑掉了……"},{"key":"SCENARIO_s20_22200100_02_0030","text":"啊哈～\n真的呢～"},{"key":"SCENARIO_s20_22200100_02_0040","text":"好不容易跑了～……"},{"key":"SCENARIO_s20_22200100_02_0050","text":"…………"},{"key":"SCENARIO_s20_22200100_02_0060","text":"口渴了\n等下一趟电车来之前买点什么喝吧～"},{"key":"SCENARIO_s20_22200100_02_0070","text":"哦——"},{"key":"SCENARIO_s20_22200100_02_0080","text":"圆香前辈和小糸酱呢～？"},{"key":"SCENARIO_s20_22200100_02_0090","text":"喝"},{"key":"SCENARIO_s20_22200100_02_0100","text":"嗯、嗯……！\n喝……！"}]
