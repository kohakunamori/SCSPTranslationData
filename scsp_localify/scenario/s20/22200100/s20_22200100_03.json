[{"key":"SCENARIO_s20_22200100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_22200100_03_0010","text":"啊……！"},{"key":"SCENARIO_s20_22200100_03_0020","text":"怎么了～？\n小糸酱，买到了吗？"},{"key":"SCENARIO_s20_22200100_03_0030","text":"没、没有……\n如果有10日元零钱的话就刚好够了……"},{"key":"SCENARIO_s20_22200100_03_0040","text":"有哦\n10日元"},{"key":"SCENARIO_s20_22200100_03_0050","text":"真、真的……？\n可以借我吗？"},{"key":"SCENARIO_s20_22200100_03_0060","text":"嗯"},{"key":"SCENARIO_s20_22200100_03_0061","text":"Motion"},{"key":"SCENARIO_s20_22200100_03_0070","text":"…………"},{"key":"SCENARIO_s20_22200100_03_0080","text":"……有吗？"},{"key":"SCENARIO_s20_22200100_03_0090","text":"呵呵"},{"key":"SCENARIO_s20_22200100_03_0100","text":"可能没有"}]
