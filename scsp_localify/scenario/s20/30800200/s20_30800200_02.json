[{"key":"SCENARIO_s20_30800200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_30800200_02_0010","text":"哇……\n独木舟……好大……"},{"key":"SCENARIO_s20_30800200_02_0020","text":"呀——……！好漂亮……！"},{"key":"SCENARIO_s20_30800200_02_0030","text":"闪闪发亮……\n在发光……"},{"key":"SCENARIO_s20_30800200_02_0040","text":"真的呢\n感觉心灵都被洗涤了"},{"key":"SCENARIO_s20_30800200_02_0050","text":"寒冷什么的全都忘掉了……！"},{"key":"SCENARIO_s20_30800200_02_0060","text":"——雾子，低下头好吗？\n那根树枝看起来有点危险"},{"key":"SCENARIO_s20_30800200_02_0070","text":"啊……\n嗯……！"},{"key":"SCENARIO_s20_30800200_02_0080","text":"……OK通过！\n可以抬头了哦～"},{"key":"SCENARIO_s20_30800200_02_0090","text":"呵呵……总觉得……\n像是在鞠躬一样……"},{"key":"SCENARIO_s20_30800200_02_0100","text":"对着森林……对着湖泊……\n说着“打扰了”……"}]
