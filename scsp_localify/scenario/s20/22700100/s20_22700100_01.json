[{"key":"SCENARIO_s20_22700100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_22700100_01_0010","text":"羽那酱，好认真啊……！"},{"key":"SCENARIO_s20_22700100_01_0020","text":"嗯\n为了避免受伤，要仔细做拉伸──"},{"key":"SCENARIO_s20_22700100_01_0030","text":"这个，好像是路加酱"},{"key":"SCENARIO_s20_22700100_01_0040","text":"诶……"},{"key":"SCENARIO_s20_22700100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_22700100_01_0050","text":"在采访里说过的──"},{"key":"SCENARIO_s20_22700100_01_0060","text":"啊……这样啊\n我还以为你是直接问她的呢～……"},{"key":"SCENARIO_s20_22700100_01_0070","text":"啊哈，抱歉啦"},{"key":"SCENARIO_s20_22700100_01_0080","text":"──想问问路加酱的事情，有好多好多呢"},{"key":"SCENARIO_s20_22700100_01_0090","text":"嗯……！\n所以，为了那个──"},{"key":"SCENARIO_s20_22700100_01_0100","text":"呵呵\n现在先好好练习吧──！"}]
