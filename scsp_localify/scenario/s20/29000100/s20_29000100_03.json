[{"key":"SCENARIO_s20_29000100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_29000100_03_0010","text":"……好香的味道呢～"},{"key":"SCENARIO_s20_29000100_03_0020","text":"啊，叶月小姐！\n正好在泡咖啡……"},{"key":"SCENARIO_s20_29000100_03_0030","text":"叶月小姐也来一杯怎么样？"},{"key":"SCENARIO_s20_29000100_03_0040","text":"可以吗？\n那我就不客气了～"},{"key":"SCENARIO_s20_29000100_03_0050","text":"好的，请稍等一下"},{"key":"SCENARIO_s20_29000100_03_0060","text":"一大早就喝到制作人特制的咖啡，\n今天真是个好日子呢～"},{"key":"SCENARIO_s20_29000100_03_0070","text":"哈哈，是吗？"},{"key":"SCENARIO_s20_29000100_03_0002","text":"Motion"},{"key":"SCENARIO_s20_29000100_03_0080","text":"——给，请收下"},{"key":"SCENARIO_s20_29000100_03_0090","text":"让今天也成为美好的一天吧"},{"key":"SCENARIO_s20_29000100_03_0100","text":"呵呵\n是啊～"}]
