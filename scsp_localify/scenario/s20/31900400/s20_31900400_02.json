[{"key":"SCENARIO_s20_31900400_02_0001","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0010","text":"……呼"},{"key":"SCENARIO_s20_31900400_02_0011","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0020","text":"哇～……！"},{"key":"SCENARIO_s20_31900400_02_0021","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0030","text":"爱依，去散步吗？"},{"key":"SCENARIO_s20_31900400_02_0040","text":"是啊！\n朝日也去吗？"},{"key":"SCENARIO_s20_31900400_02_0041","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0050","text":"嗯\n反正闲着没事"},{"key":"SCENARIO_s20_31900400_02_0060","text":"啊哈哈～\n这样啊～"},{"key":"SCENARIO_s20_31900400_02_0061","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0062","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0070","text":"呐，朝日\n你觉得今晚的星空哪里最漂亮？"},{"key":"SCENARIO_s20_31900400_02_0071","text":"Motion"},{"key":"SCENARIO_s20_31900400_02_0080","text":"嗯……\n那边吧"},{"key":"SCENARIO_s20_31900400_02_0090","text":"对吧～\n那……"},{"key":"SCENARIO_s20_31900400_02_0100","text":"哦，拍得不错！\n待会儿给冬优子看看～"}]
