[{"key":"SCENARIO_s20_31100200_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31100200_04_0010","text":"早上好"},{"key":"SCENARIO_s20_31100200_04_0020","text":"一个人都没有呢\n开一下窗可以吗？"},{"key":"SCENARIO_s20_31100200_04_0030","text":"今天气温很舒服嘛"},{"key":"SCENARIO_s20_31100200_04_0040","text":"好的！当然可以！"},{"key":"SCENARIO_s20_31100200_04_0041","text":"Motion"},{"key":"SCENARIO_s20_31100200_04_0050","text":"啊────……"},{"key":"SCENARIO_s20_31100200_04_0051","text":"Motion"},{"key":"SCENARIO_s20_31100200_04_0060","text":"哇，花瓣────"},{"key":"SCENARIO_s20_31100200_04_0070","text":"好厉害！\n是从附近的樱花树上飘过来的吗……？"},{"key":"SCENARIO_s20_31100200_04_0080","text":"──嘿\n抓住了"},{"key":"SCENARIO_s20_31100200_04_0090","text":"来，果穗\n给你，春天"},{"key":"SCENARIO_s20_31100200_04_0100","text":"嘿嘿，好的！\n春天，我收下了！"}]
