[{"key":"SCENARIO_s20_31100200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31100200_02_0010","text":"呼……\n呼……"},{"key":"SCENARIO_s20_31100200_02_0020","text":"哦—……\n樱花，开了啊……"},{"key":"SCENARIO_s20_31100200_02_0030","text":"放慢点速度\n慢慢欣赏吧"},{"key":"SCENARIO_s20_31100200_02_0040","text":"呵呵"},{"key":"SCENARIO_s20_31100200_02_0050","text":"……咦？\n难道说，改变路线是因为……"},{"key":"SCENARIO_s20_31100200_02_0060","text":"是啊\n想让你看看这里的樱花"},{"key":"SCENARIO_s20_31100200_02_0070","text":"美丽的风景\n可是在外面跑步的乐趣呢！"},{"key":"SCENARIO_s20_31100200_02_0080","text":"确实，说得对"},{"key":"SCENARIO_s20_31100200_02_0081","text":"Motion"},{"key":"SCENARIO_s20_31100200_02_0090","text":"好，那我也知道几个好地方\n给你带路吧"},{"key":"SCENARIO_s20_31100200_02_0100","text":"哦？\n那就拜托你了！"}]
