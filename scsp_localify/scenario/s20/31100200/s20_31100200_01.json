[{"key":"SCENARIO_s20_31100200_01_0000","text":"Motion"},{"key":"SCENARIO_s20_31100200_01_0001","text":"Motion"},{"key":"SCENARIO_s20_31100200_01_0010","text":"在这种地方────……"},{"key":"SCENARIO_s20_31100200_01_0011","text":"Motion"},{"key":"SCENARIO_s20_31100200_01_0020","text":"树里酱—？"},{"key":"SCENARIO_s20_31100200_01_0030","text":"抱歉……！\n马上过去—！"},{"key":"SCENARIO_s20_31100200_01_0031","text":"Motion"},{"key":"SCENARIO_s20_31100200_01_0040","text":"盛开的樱花，配上三色团子……\n还有比这更完美的组合吗"},{"key":"SCENARIO_s20_31100200_01_0050","text":"没有了！／没有了……"},{"key":"SCENARIO_s20_31100200_01_0060","text":"好好吃呢，树里酱！"},{"key":"SCENARIO_s20_31100200_01_0070","text":"…………"},{"key":"SCENARIO_s20_31100200_01_0080","text":"……树里酱？\n怎么了？"},{"key":"SCENARIO_s20_31100200_01_0090","text":"啊……嗯────"},{"key":"SCENARIO_s20_31100200_01_0100","text":"觉得好漂亮啊"}]
