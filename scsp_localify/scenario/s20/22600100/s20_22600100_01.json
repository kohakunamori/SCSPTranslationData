[{"key":"SCENARIO_s20_22600100_01_0010","text":"（……………………没有）"},{"key":"SCENARIO_s20_22600100_01_0020","text":"（为什么──────）"},{"key":"SCENARIO_s20_22600100_01_0030","text":"（哪里──────？）"},{"key":"SCENARIO_s20_22600100_01_0040","text":"（为什么？\n　为什么为什么为什么为什么？）"},{"key":"SCENARIO_s20_22600100_01_0051","text":"Motion"},{"key":"SCENARIO_s20_22600100_01_0060","text":"路加──？\n喂，路加！？"},{"key":"SCENARIO_s20_22600100_01_0070","text":"嗯……………──────"},{"key":"SCENARIO_s20_22600100_01_0080","text":"路加，你没事吧？\n你刚才看起来很痛苦…………"},{"key":"SCENARIO_s20_22600100_01_0090","text":"没什么──────…………\n只是…………"},{"key":"SCENARIO_s20_22600100_01_0100","text":"好像…………\n丢了一只…………"}]
