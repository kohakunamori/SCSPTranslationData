[{"key":"SCENARIO_s20_20600100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_20600100_02_0010","text":"────恋钟"},{"key":"SCENARIO_s20_20600100_02_0020","text":"嗯～？　怎么了……？"},{"key":"SCENARIO_s20_20600100_02_0030","text":"手给我\n沙滩上脚下不太稳"},{"key":"SCENARIO_s20_20600100_02_0040","text":"……嘻嘻～\n好～"},{"key":"SCENARIO_s20_20600100_02_0050","text":"…………"},{"key":"SCENARIO_s20_20600100_02_0060","text":"……──\n你现在，在想什么呢？"},{"key":"SCENARIO_s20_20600100_02_0061","text":"Motion"},{"key":"SCENARIO_s20_20600100_02_0070","text":"嗯～？　那个啊～……\n就是在想，一切都好美啊～"},{"key":"SCENARIO_s20_20600100_02_0080","text":"咲耶呢～？"},{"key":"SCENARIO_s20_20600100_02_0090","text":"……是啊\n和恋钟想的一样哦"},{"key":"SCENARIO_s20_20600100_02_0100","text":"……想把现在映入眼帘的一切\n都烙印在心里，这样想着"}]
