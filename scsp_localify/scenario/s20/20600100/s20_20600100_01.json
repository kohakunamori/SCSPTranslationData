[{"key":"SCENARIO_s20_20600100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_20600100_01_0010","text":"…………"},{"key":"SCENARIO_s20_20600100_01_0020","text":"……恋钟？"},{"key":"SCENARIO_s20_20600100_01_0030","text":"嘻嘻～……\n总～感觉……好害羞呀～"},{"key":"SCENARIO_s20_20600100_01_0040","text":"这种拍摄，很少见吧～？\n一直只有我和咲耶两个人"},{"key":"SCENARIO_s20_20600100_01_0050","text":"……是啊，简直就像──\n约会一样"},{"key":"SCENARIO_s20_20600100_01_0060","text":"呼诶……"},{"key":"SCENARIO_s20_20600100_01_0070","text":"……真是的～～咲耶……！\n你又在逗我玩吧～……！？"},{"key":"SCENARIO_s20_20600100_01_0080","text":"哎呀，真让人伤心\n我明明一直都是认真的"},{"key":"SCENARIO_s20_20600100_01_0090","text":"──好了，接下来移动到海边吧\n走吧"},{"key":"SCENARIO_s20_20600100_01_0100","text":"嗯～！"}]
