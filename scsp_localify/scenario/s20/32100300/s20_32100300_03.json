[{"key":"SCENARIO_s20_32100300_03_0000","text":"Motion"},{"key":"SCENARIO_s20_32100300_03_0010","text":"……"},{"key":"SCENARIO_s20_32100300_03_0020","text":"……小糸────"},{"key":"SCENARIO_s20_32100300_03_0030","text":"──！\n啊，圆香……停！"},{"key":"SCENARIO_s20_32100300_03_0040","text":"诶……？"},{"key":"SCENARIO_s20_32100300_03_0041","text":"Motion"},{"key":"SCENARIO_s20_32100300_03_0050","text":"……找到了，自动铅笔……！\n太好了……"},{"key":"SCENARIO_s20_32100300_03_0060","text":"……捡到了？\n我要把脚放下了"},{"key":"SCENARIO_s20_32100300_03_0070","text":"啊，嗯……！"},{"key":"SCENARIO_s20_32100300_03_0080","text":"太好了呢\n找到了"},{"key":"SCENARIO_s20_32100300_03_0090","text":"嗯\n谢谢你，圆香"},{"key":"SCENARIO_s20_32100300_03_0100","text":"没什么\n我也没做什么"}]
