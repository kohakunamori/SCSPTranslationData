[{"key":"SCENARIO_s20_39000100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_39000100_02_0010","text":"叶月小姐\n复印机可以稍微借我用一下吗……？"},{"key":"SCENARIO_s20_39000100_02_0020","text":"好的，没问题哦～\n怎么了呢？"},{"key":"SCENARIO_s20_39000100_02_0030","text":"甜花酱好像把打印的资料弄丢了\n而且马上就需要用到"},{"key":"SCENARIO_s20_39000100_02_0040","text":"甘奈那里有一样的\n所以想帮她复印一份"},{"key":"SCENARIO_s20_39000100_02_0050","text":"原来是这样～\n那就马上打印出来吧"},{"key":"SCENARIO_s20_39000100_02_0051","text":"Motion"},{"key":"SCENARIO_s20_39000100_02_0060","text":"……好的\n这样可以了吗～？"},{"key":"SCENARIO_s20_39000100_02_0070","text":"嗯！\n谢谢您！"},{"key":"SCENARIO_s20_39000100_02_0080","text":"呵呵，不客气。"},{"key":"SCENARIO_s20_39000100_02_0090","text":"请帮我转告甜花小姐\n让她别再弄丢了哦～"},{"key":"SCENARIO_s20_39000100_02_0100","text":"好的！\n甘奈会好好说她的！"}]
