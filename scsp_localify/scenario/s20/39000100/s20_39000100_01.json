[{"key":"SCENARIO_s20_39000100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_39000100_01_0010","text":"啊，咦……？\n……叶月小姐……？"},{"key":"SCENARIO_s20_39000100_01_0020","text":"……？\n啊，甜花小姐"},{"key":"SCENARIO_s20_39000100_01_0030","text":"是放学回来吗？\n辛苦了～"},{"key":"SCENARIO_s20_39000100_01_0040","text":"辛、辛苦您了……\n叶月小姐……在这里排队……？"},{"key":"SCENARIO_s20_39000100_01_0050","text":"是的～\n制作人托我带些伴手礼的烤点心回去"},{"key":"SCENARIO_s20_39000100_01_0060","text":"烤点心……"},{"key":"SCENARIO_s20_39000100_01_0070","text":"听说这家的费南雪很有名哦～"},{"key":"SCENARIO_s20_39000100_01_0080","text":"费南雪……！\n好、好想要……"},{"key":"SCENARIO_s20_39000100_01_0090","text":"呵呵\n那这样的话，事务所也需要带伴手礼回去呢～"},{"key":"SCENARIO_s20_39000100_01_0100","text":"太、太好了……！\n嘿嘿……"}]
