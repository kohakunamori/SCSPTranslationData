[{"key":"SCENARIO_s20_20800100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_20800100_02_0010","text":"啊～！"},{"key":"SCENARIO_s20_20800100_02_0020","text":"快看快看～！\n蒲公英开花了～！"},{"key":"SCENARIO_s20_20800100_02_0030","text":"哇……\n嗯……"},{"key":"SCENARIO_s20_20800100_02_0031","text":"Motion"},{"key":"SCENARIO_s20_20800100_02_0040","text":"这个是什么呢～？\n这个……这边的花～"},{"key":"SCENARIO_s20_20800100_02_0050","text":"啊……\n那、那个……"},{"key":"SCENARIO_s20_20800100_02_0060","text":"呵呵……\n要给它……取什么名字呢……"},{"key":"SCENARIO_s20_20800100_02_0070","text":"诶\n可以让我来取名字吗～？"},{"key":"SCENARIO_s20_20800100_02_0071","text":"Motion"},{"key":"SCENARIO_s20_20800100_02_0080","text":"不管……\n怎么叫它……"},{"key":"SCENARIO_s20_20800100_02_0090","text":"那朵花……\n就是那朵花……"},{"key":"SCENARIO_s20_20800100_02_0100","text":"嘻嘻～\n那就────"}]
