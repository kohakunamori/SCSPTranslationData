[{"key":"SCENARIO_s20_20800100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_20800100_01_0010","text":"那么，\n蒲公英～！"},{"key":"SCENARIO_s20_20800100_01_0020","text":"『公英』……\n一品红……"},{"key":"SCENARIO_s20_20800100_01_0030","text":"诶，『英』～？\n────啊～……啊～……"},{"key":"SCENARIO_s20_20800100_01_0031","text":"Motion"},{"key":"SCENARIO_s20_20800100_01_0040","text":"啊～！\nALSTROEMERIA～！"},{"key":"SCENARIO_s20_20800100_01_0050","text":"呵呵……那么……\n紫……"},{"key":"SCENARIO_s20_20800100_01_0060","text":"『紫』～！？\n嗯～……可以看图鉴吗～？"},{"key":"SCENARIO_s20_20800100_01_0061","text":"Motion"},{"key":"SCENARIO_s20_20800100_01_0070","text":"……那么，这个～！\n芍药～！"},{"key":"SCENARIO_s20_20800100_01_0080","text":"『药』……\n铁线莲·维埃内塔……"},{"key":"SCENARIO_s20_20800100_01_0090","text":"什、什么啊那是～！？\n────蒲～……蒲～……"},{"key":"SCENARIO_s20_20800100_01_0100","text":"蒲公英～！"}]
