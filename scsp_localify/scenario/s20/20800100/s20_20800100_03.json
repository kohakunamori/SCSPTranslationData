[{"key":"SCENARIO_s20_20800100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_20800100_03_0010","text":"————啊……"},{"key":"SCENARIO_s20_20800100_03_0020","text":"呵呵……\n开花了……"},{"key":"SCENARIO_s20_20800100_03_0030","text":"你好……\n让我……拍一张哦……"},{"key":"SCENARIO_s20_20800100_03_0031","text":"Motion"},{"key":"SCENARIO_s20_20800100_03_0040","text":"────诶，连锁……"},{"key":"SCENARIO_s20_20800100_03_0050","text":"『一起拍了照哦＾＾』"},{"key":"SCENARIO_s20_20800100_03_0060","text":"……啊～！"},{"key":"SCENARIO_s20_20800100_03_0070","text":"嘻嘻～\n我的花～！"},{"key":"SCENARIO_s20_20800100_03_0080","text":"『恋钟酱取名的白花』"},{"key":"SCENARIO_s20_20800100_03_0081","text":"Motion"},{"key":"SCENARIO_s20_20800100_03_0090","text":"呵呵……"},{"key":"SCENARIO_s20_20800100_03_0100","text":"雾子花小姐……"}]
