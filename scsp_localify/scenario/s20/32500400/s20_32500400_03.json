[{"key":"SCENARIO_s20_32500400_03_0001","text":"Motion"},{"key":"SCENARIO_s20_32500400_03_0010","text":"早上好，制作人"},{"key":"SCENARIO_s20_32500400_03_0020","text":"哦\n早啊，美琴"},{"key":"SCENARIO_s20_32500400_03_0030","text":"……那是？"},{"key":"SCENARIO_s20_32500400_03_0040","text":"这个？杂志的样刊\n不介意的话美琴也看看？"},{"key":"SCENARIO_s20_32500400_03_0041","text":"Motion"},{"key":"SCENARIO_s20_32500400_03_0050","text":"……嗯"},{"key":"SCENARIO_s20_32500400_03_0051","text":"Motion"},{"key":"SCENARIO_s20_32500400_03_0052","text":"Motion"},{"key":"SCENARIO_s20_32500400_03_0060","text":"之前拍的照片，\n出来是这个效果"},{"key":"SCENARIO_s20_32500400_03_0070","text":"啊\n拍得不错嘛"},{"key":"SCENARIO_s20_32500400_03_0080","text":"……是吗？"},{"key":"SCENARIO_s20_32500400_03_0090","text":"嗯。粉丝们应该也会喜欢的吧"},{"key":"SCENARIO_s20_32500400_03_0091","text":"Motion"},{"key":"SCENARIO_s20_32500400_03_0100","text":"……是吗\n那就好"}]
