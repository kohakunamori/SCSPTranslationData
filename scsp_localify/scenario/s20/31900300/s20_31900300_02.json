[{"key":"SCENARIO_s20_31900300_02_0001","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0010","text":"哎呀……今天好热啊～……"},{"key":"SCENARIO_s20_31900300_02_0020","text":"是的……"},{"key":"SCENARIO_s20_31900300_02_0030","text":"太阳也好毒……"},{"key":"SCENARIO_s20_31900300_02_0040","text":"啊！　对了！\n我带了遮阳伞！"},{"key":"SCENARIO_s20_31900300_02_0041","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0050","text":"来，朝日也！\n进来进来～"},{"key":"SCENARIO_s20_31900300_02_0060","text":"两个人太挤了啦"},{"key":"SCENARIO_s20_31900300_02_0070","text":"诶—\n会晒黑的哦～？"},{"key":"SCENARIO_s20_31900300_02_0080","text":"晒黑……"},{"key":"SCENARIO_s20_31900300_02_0081","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0082","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0085","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0090","text":"嗯，说得也是……\n那我进来了！"},{"key":"SCENARIO_s20_31900300_02_0091","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0092","text":"Motion"},{"key":"SCENARIO_s20_31900300_02_0100","text":"……\n阿嚏！"}]
