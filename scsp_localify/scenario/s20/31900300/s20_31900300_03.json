[{"key":"SCENARIO_s20_31900300_03_0001","text":"Motion"},{"key":"SCENARIO_s20_31900300_03_0009","text":"电视的声音\n "},{"key":"SCENARIO_s20_31900300_03_0010","text":"“本次的新商品\n　UV阻隔率进一步提升！”"},{"key":"SCENARIO_s20_31900300_03_0020","text":"这个啊～\nUV到底是什么呢～"},{"key":"SCENARIO_s20_31900300_03_0029","text":"爱依的姐姐"},{"key":"SCENARIO_s20_31900300_03_0030","text":"Ultraviolet～\n就是紫外线的意思哦～"},{"key":"SCENARIO_s20_31900300_03_0040","text":"哦～\n懂得真多～"},{"key":"SCENARIO_s20_31900300_03_0049","text":"爱依的弟弟"},{"key":"SCENARIO_s20_31900300_03_0050","text":"感觉像恐龙的名字一样\n听起来很厉害"},{"key":"SCENARIO_s20_31900300_03_0060","text":"啊～，说的是啊～"},{"key":"SCENARIO_s20_31900300_03_0061","text":"Motion"},{"key":"SCENARIO_s20_31900300_03_0062","text":"Motion"},{"key":"SCENARIO_s20_31900300_03_0070","text":"嗷呜！\n我是Ultraviolet～！"},{"key":"SCENARIO_s20_31900300_03_0079","text":"爱依的妹妹"},{"key":"SCENARIO_s20_31900300_03_0080","text":"哇—！"},{"key":"SCENARIO_s20_31900300_03_0089","text":"爱依的弟弟"},{"key":"SCENARIO_s20_31900300_03_0090","text":"我可不是那种\n玩这个就会高兴的小孩子了啦"},{"key":"SCENARIO_s20_31900300_03_0100","text":"切，真不可爱～"}]
