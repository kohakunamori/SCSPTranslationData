[{"key":"SCENARIO_s20_32200500_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32200500_02_0010","text":"……好、好美呢\n樱花……"},{"key":"SCENARIO_s20_32200500_02_0011","text":"Motion"},{"key":"SCENARIO_s20_32200500_02_0020","text":"——啊……"},{"key":"SCENARIO_s20_32200500_02_0021","text":"Motion"},{"key":"SCENARIO_s20_32200500_02_0030","text":"！　透、透酱……！\n花瓣要飞进嘴里了……！"},{"key":"SCENARIO_s20_32200500_02_0040","text":"嗯\n啊——…………没事"},{"key":"SCENARIO_s20_32200500_02_0050","text":"能吃的，果实"},{"key":"SCENARIO_s20_32200500_02_0060","text":"果……？"},{"key":"SCENARIO_s20_32200500_02_0070","text":"有的嘛\n樱桃"},{"key":"SCENARIO_s20_32200500_02_0080","text":"啊──\n是有啦，但那个，树种不一样所以……"},{"key":"SCENARIO_s20_32200500_02_0090","text":"……对、对了\n吃糖吗？　樱桃味的……！"},{"key":"SCENARIO_s20_32200500_02_0100","text":"哦—\n好主意"}]
