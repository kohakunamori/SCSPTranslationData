[{"key":"SCENARIO_s20_32500500_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32500500_01_0010","text":"…………"},{"key":"SCENARIO_s20_32500500_01_0020","text":"美琴小姐？\n那家花店，怎么了吗？"},{"key":"SCENARIO_s20_32500500_01_0030","text":"总觉得，闻到了相似的味道\n和上次拍摄的时候"},{"key":"SCENARIO_s20_32500500_01_0031","text":"Motion"},{"key":"SCENARIO_s20_32500500_01_0040","text":"啊——……！\n那时候的……！"},{"key":"SCENARIO_s20_32500500_01_0050","text":"那个空间真的好棒啊……！\n摄影棚也好，美琴小姐也好，都好美……"},{"key":"SCENARIO_s20_32500500_01_0060","text":"说起来，好像有说法是气味和记忆很容易联系在一起……"},{"key":"SCENARIO_s20_32500500_01_0070","text":"这样啊"},{"key":"SCENARIO_s20_32500500_01_0080","text":"说不定每次经过这里，\n都会想起那天的拍摄──"},{"key":"SCENARIO_s20_32500500_01_0090","text":"──什么的……"},{"key":"SCENARIO_s20_32500500_01_0092","text":"Motion"},{"key":"SCENARIO_s20_32500500_01_0091","text":"Motion"},{"key":"SCENARIO_s20_32500500_01_0100","text":"是啊"},{"key":"SCENARIO_s20_32500500_01_0101","text":"Motion"}]
