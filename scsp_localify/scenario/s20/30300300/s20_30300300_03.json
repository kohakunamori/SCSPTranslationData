[{"key":"SCENARIO_s20_30300300_03_0001","text":"Motion"},{"key":"SCENARIO_s20_30300300_03_0010","text":"…………"},{"key":"SCENARIO_s20_30300300_03_0011","text":"Motion"},{"key":"SCENARIO_s20_30300300_03_0020","text":"有什么有趣的画吗？"},{"key":"SCENARIO_s20_30300300_03_0030","text":"有趣……倒也不是，\n有几幅让我在意的画……"},{"key":"SCENARIO_s20_30300300_03_0040","text":"比如这幅画的构图\n很精致，有种被吸引的感觉"},{"key":"SCENARIO_s20_30300300_03_0050","text":"哦——\n确实有那种感觉……！"},{"key":"SCENARIO_s20_30300300_03_0060","text":"……我也只是“有那种感觉”而已啦"},{"key":"SCENARIO_s20_30300300_03_0070","text":"……呼"},{"key":"SCENARIO_s20_30300300_03_0080","text":"……嗯\n我们去那边休息一下吧"},{"key":"SCENARIO_s20_30300300_03_0090","text":"……！\n好啊……"},{"key":"SCENARIO_s20_30300300_03_0091","text":"Motion"},{"key":"SCENARIO_s20_30300300_03_0095","text":"Motion"},{"key":"SCENARIO_s20_30300300_03_0100","text":"真乃——\n要不要休息一下？"},{"key":"SCENARIO_s20_30300300_03_0101","text":"Motion"}]
