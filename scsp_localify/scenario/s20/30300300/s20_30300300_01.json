[{"key":"SCENARIO_s20_30300300_01_0001","text":"Motion"},{"key":"SCENARIO_s20_30300300_01_0002","text":"Motion"},{"key":"SCENARIO_s20_30300300_01_0010","text":"真乃！　灯织！\n快看快看……！"},{"key":"SCENARIO_s20_30300300_01_0011","text":"Motion"},{"key":"SCENARIO_s20_30300300_01_0020","text":"你们看，那边有雕塑！"},{"key":"SCENARIO_s20_30300300_01_0030","text":"哦……室外也有啊\n美术馆的展品"},{"key":"SCENARIO_s20_30300300_01_0040","text":"“可以自由拍照”\n……上面写着"},{"key":"SCENARIO_s20_30300300_01_0050","text":"！\n大家一起拍吧！"},{"key":"SCENARIO_s20_30300300_01_0060","text":"诶……\n怎么拍呀？"},{"key":"SCENARIO_s20_30300300_01_0070","text":"像这个雕塑一样\n大家一起摆个姿势"},{"key":"SCENARIO_s20_30300300_01_0080","text":"嗯……"},{"key":"SCENARIO_s20_30300300_01_0090","text":"好——的，那我拍了哦——？"},{"key":"SCENARIO_s20_30300300_01_0100","text":"嗯！\n感觉不错！"}]
