[{"key":"SCENARIO_s20_32700400_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0010","text":"──对了\n月亮好美呢？"},{"key":"SCENARIO_s20_32700400_01_0020","text":"好，卡～"},{"key":"SCENARIO_s20_32700400_01_0021","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0030","text":"羽那，拍得超棒的哦～"},{"key":"SCENARIO_s20_32700400_01_0040","text":"赶紧发到Twister上，\n让粉丝们也看看……！"},{"key":"SCENARIO_s20_32700400_01_0050","text":"嗯，不过在那之前\n先拍阳希的视频吧──！"},{"key":"SCENARIO_s20_32700400_01_0051","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0060","text":"……呵呵\n月色真美呢"},{"key":"SCENARIO_s20_32700400_01_0061","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0070","text":"卡──！"},{"key":"SCENARIO_s20_32700400_01_0071","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0080","text":"快看快看，\n拍得超可爱的哦～"},{"key":"SCENARIO_s20_32700400_01_0081","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0090","text":"……啊\n路加的话──"},{"key":"SCENARIO_s20_32700400_01_0100","text":"不拍"},{"key":"SCENARIO_s20_32700400_01_0101","text":"Motion"},{"key":"SCENARIO_s20_32700400_01_0102","text":"Motion"}]
