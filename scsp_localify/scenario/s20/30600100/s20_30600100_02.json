[{"key":"SCENARIO_s20_30600100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_30600100_02_0010","text":"结华也一起怎么样？\n这把伞，很大的"},{"key":"SCENARIO_s20_30600100_02_0020","text":"诶—\n三峰可以挤进那么好的位置吗"},{"key":"SCENARIO_s20_30600100_02_0030","text":"──那就，打扰啦！"},{"key":"SCENARIO_s20_30600100_02_0040","text":"呵呵，请进"},{"key":"SCENARIO_s20_30600100_02_0050","text":"啊真的耶\n两个人进来也完全没问题！"},{"key":"SCENARIO_s20_30600100_02_0060","text":"之前工作碰到的时候\n麻美美给我的"},{"key":"SCENARIO_s20_30600100_02_0070","text":"哦？\n怎么突然"},{"key":"SCENARIO_s20_30600100_02_0080","text":"说是来的时候买的\n但回去的时候雨已经停了"},{"key":"SCENARIO_s20_30600100_02_0090","text":"就说放宿舍当公用伞吧──这样"},{"key":"SCENARIO_s20_30600100_02_0100","text":"啊哈哈\n麻美美真是的……！"}]
