[{"key":"SCENARIO_s20_30600100_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30600100_04_0010","text":"…………"},{"key":"SCENARIO_s20_30600100_04_0001","text":"电视的声音\n "},{"key":"SCENARIO_s20_30600100_04_0020","text":"“──接下来是周间天气预报”"},{"key":"SCENARIO_s20_30600100_04_0030","text":"“本周全国范围内\n　将持续舒适宜人的天气────”"},{"key":"SCENARIO_s20_30600100_04_0031","text":"Motion"},{"key":"SCENARIO_s20_30600100_04_0040","text":"……呵呵"},{"key":"SCENARIO_s20_30600100_04_0050","text":"──伞可以稍微休息一下了，是吧"},{"key":"SCENARIO_s20_30600100_04_0051","text":"Motion"},{"key":"SCENARIO_s20_30600100_04_0060","text":"咲耶～～！"},{"key":"SCENARIO_s20_30600100_04_0070","text":"快看快看～\n外面，晴得不得了呢～！"},{"key":"SCENARIO_s20_30600100_04_0080","text":"嗯\n预报也说，接下来一段时间都会是晴天"},{"key":"SCENARIO_s20_30600100_04_0090","text":"嘻嘻～，太好了呢～！\n──咲耶，准备好了吗～？"},{"key":"SCENARIO_s20_30600100_04_0100","text":"让你久等了，这就来────"}]
