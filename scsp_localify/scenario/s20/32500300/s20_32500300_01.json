[{"key":"SCENARIO_s20_32500300_01_0001","text":"Motion"},{"key":"SCENARIO_s20_32500300_01_0010","text":"左，左────"},{"key":"SCENARIO_s20_32500300_01_0020","text":"哒、哒、当！"},{"key":"SCENARIO_s20_32500300_01_0021","text":"Motion"},{"key":"SCENARIO_s20_32500300_01_0030","text":"刚才那个，还挺……齐的吧……？"},{"key":"SCENARIO_s20_32500300_01_0031","text":"Motion"},{"key":"SCENARIO_s20_32500300_01_0040","text":"……"},{"key":"SCENARIO_s20_32500300_01_0041","text":"Motion"},{"key":"SCENARIO_s20_32500300_01_0050","text":"……！\n啊，那个……不好意思……"},{"key":"SCENARIO_s20_32500300_01_0060","text":"…………只是“还挺”的话\n完全不够啊……"},{"key":"SCENARIO_s20_32500300_01_0070","text":"……\n那好，刚才那段再来一遍"},{"key":"SCENARIO_s20_32500300_01_0071","text":"Motion"},{"key":"SCENARIO_s20_32500300_01_0080","text":"……！\n是的……！"},{"key":"SCENARIO_s20_32500300_01_0090","text":"继续吧"},{"key":"SCENARIO_s20_32500300_01_0100","text":"好的……！"}]
