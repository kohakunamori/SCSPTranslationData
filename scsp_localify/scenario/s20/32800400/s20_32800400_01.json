[{"key":"SCENARIO_s20_32800400_01_0001","text":"Motion"},{"key":"SCENARIO_s20_32800400_01_0010","text":"阿嚏……"},{"key":"SCENARIO_s20_32800400_01_0020","text":"有点冷啊，阳希你没事吧？"},{"key":"SCENARIO_s20_32800400_01_0021","text":"Motion"},{"key":"SCENARIO_s20_32800400_01_0030","text":"呵呵……！\n完全没事，谢谢您关心"},{"key":"SCENARIO_s20_32800400_01_0031","text":"Motion"},{"key":"SCENARIO_s20_32800400_01_0032","text":"Motion"},{"key":"SCENARIO_s20_32800400_01_0040","text":"因为，这片景色——"},{"key":"SCENARIO_s20_32800400_01_0050","text":"充满力量……"},{"key":"SCENARIO_s20_32800400_01_0060","text":"凛冽严酷……"},{"key":"SCENARIO_s20_32800400_01_0070","text":"洁白……"},{"key":"SCENARIO_s20_32800400_01_0080","text":"又漆黑……"},{"key":"SCENARIO_s20_32800400_01_0090","text":"…………"},{"key":"SCENARIO_s20_32800400_01_0100","text":"啊，多么……\n…………该怎么形容才好呢……——"}]
