[{"key":"SCENARIO_s20_32300100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32300100_01_0010","text":"────啊哈～\n透前辈睡着了～"},{"key":"SCENARIO_s20_32300100_01_0020","text":"她、她说了要去事务所的吧……"},{"key":"SCENARIO_s20_32300100_01_0030","text":"──────……"},{"key":"SCENARIO_s20_32300100_01_0040","text":"先走不就好了"},{"key":"SCENARIO_s20_32300100_01_0050","text":"诶……\n可、可以吗……"},{"key":"SCENARIO_s20_32300100_01_0060","text":"嗯——……──────"},{"key":"SCENARIO_s20_32300100_01_0070","text":"……／……！／……"},{"key":"SCENARIO_s20_32300100_01_0080","text":"可以的"},{"key":"SCENARIO_s20_32300100_01_0090","text":"是、是“可以”的意思吗……！？"},{"key":"SCENARIO_s20_32300100_01_0100","text":"啊哈～"}]
