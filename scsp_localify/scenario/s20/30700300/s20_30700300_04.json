[{"key":"SCENARIO_s20_30700300_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30700300_04_0010","text":"…………"},{"key":"SCENARIO_s20_30700300_04_0020","text":"！\n你看咲耶！彩虹～！"},{"key":"SCENARIO_s20_30700300_04_0030","text":"——哦呀，真的呢"},{"key":"SCENARIO_s20_30700300_04_0040","text":"（……彩虹啊……——）"},{"key":"SCENARIO_s20_30700300_04_0050","text":"好漂亮"},{"key":"SCENARIO_s20_30700300_04_0060","text":"嗯～！\n结华你看到了吗～？……啊……！"},{"key":"SCENARIO_s20_30700300_04_0070","text":"结华，睡着了……！\n这么漂亮的彩虹，好想让她也看看啊……"},{"key":"SCENARIO_s20_30700300_04_0080","text":"……那就拍下来吧\n这样之后也能分享给她"},{"key":"SCENARIO_s20_30700300_04_0090","text":"！\n好主意！结华～，就交给我吧～！"},{"key":"SCENARIO_s20_30700300_04_0091","text":"Motion"},{"key":"SCENARIO_s20_30700300_04_0100","text":"……"}]
