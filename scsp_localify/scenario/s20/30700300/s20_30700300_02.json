[{"key":"SCENARIO_s20_30700300_02_0000","text":"Motion"},{"key":"SCENARIO_s20_30700300_02_0010","text":"能不能下点雨啊～……！"},{"key":"SCENARIO_s20_30700300_02_0011","text":"Motion"},{"key":"SCENARIO_s20_30700300_02_0020","text":"……"},{"key":"SCENARIO_s20_30700300_02_0030","text":"接下来不是要出门吗——？"},{"key":"SCENARIO_s20_30700300_02_0040","text":"可是嘛～。三峰今天带的不是折叠伞\n是长柄伞嘛"},{"key":"SCENARIO_s20_30700300_02_0050","text":"不想白带啊……！"},{"key":"SCENARIO_s20_30700300_02_0060","text":"是这样啊……"},{"key":"SCENARIO_s20_30700300_02_0070","text":"我投晴天一票——"},{"key":"SCENARIO_s20_30700300_02_0080","text":"啊——真坏心眼～！"},{"key":"SCENARIO_s20_30700300_02_0090","text":"大晴天啊～～～～！"},{"key":"SCENARIO_s20_30700300_02_0100","text":"呵呵——／……"}]
