[{"key":"SCENARIO_s20_30900100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_30900100_03_0010","text":"喂喂果穗"},{"key":"SCENARIO_s20_30900100_03_0020","text":"看这儿——！"},{"key":"SCENARIO_s20_30900100_03_0021","text":"Motion"},{"key":"SCENARIO_s20_30900100_03_0030","text":"哇……"},{"key":"SCENARIO_s20_30900100_03_0040","text":"叶子变成画了～！！"},{"key":"SCENARIO_s20_30900100_03_0050","text":"好厉害！！"},{"key":"SCENARIO_s20_30900100_03_0051","text":"Motion"},{"key":"SCENARIO_s20_30900100_03_0060","text":"嘿嘿，太好了……！"},{"key":"SCENARIO_s20_30900100_03_0070","text":"虽然最后还是要收进袋子里\n但这样也挺好的吧！"},{"key":"SCENARIO_s20_30900100_03_0080","text":"算是打扫卫生才有的特权吧……！"},{"key":"SCENARIO_s20_30900100_03_0090","text":"好！\n我也可以做吗！？"},{"key":"SCENARIO_s20_30900100_03_0100","text":"当然可以！\n啊，我先把自己的叶子装进袋子里哦──"}]
