[{"key":"SCENARIO_s20_31700200_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31700200_04_0010","text":"…………"},{"key":"SCENARIO_s20_31700200_04_0020","text":"喂，我去找一下自动贩卖机可以吗？\n我连你的份一起买"},{"key":"SCENARIO_s20_31700200_04_0021","text":"Motion"},{"key":"SCENARIO_s20_31700200_04_0025","text":"Motion"},{"key":"SCENARIO_s20_31700200_04_0030","text":"来，按你喜欢的"},{"key":"SCENARIO_s20_31700200_04_0040","text":"嗯……\n那就选这个吧"},{"key":"SCENARIO_s20_31700200_04_0050","text":"……！\n好烫！"},{"key":"SCENARIO_s20_31700200_04_0060","text":"诶！？\n补货出问题了吗……真是的，饶了我吧"},{"key":"SCENARIO_s20_31700200_04_0070","text":"啊，好像\n中奖了"},{"key":"SCENARIO_s20_31700200_04_0080","text":"那，那挺好的嘛\n那这次就用那个再买一瓶冰的——"},{"key":"SCENARIO_s20_31700200_04_0081","text":"Motion"},{"key":"SCENARIO_s20_31700200_04_0090","text":"哇……\n这个也是烫的～！"},{"key":"SCENARIO_s20_31700200_04_0100","text":"哈啊——！？\n……什么啊，这台贩卖机"},{"key":"SCENARIO_s20_31700200_04_0101","text":"Motion"}]
