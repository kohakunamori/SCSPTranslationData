[{"key":"SCENARIO_s20_31700200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31700200_02_0010","text":"…………"},{"key":"SCENARIO_s20_31700200_02_0019","text":"摄影师"},{"key":"SCENARIO_s20_31700200_02_0020","text":"芹泽小姐，请保持那个感觉再一会儿哦～\n马上就结束了～"},{"key":"SCENARIO_s20_31700200_02_0030","text":"…………"},{"key":"SCENARIO_s20_31700200_02_0040","text":"朝日酱\n感觉和平常不太一样呢"},{"key":"SCENARIO_s20_31700200_02_0050","text":"嗯\n怎么回事呢"},{"key":"SCENARIO_s20_31700200_02_0060","text":"……\n唉……"},{"key":"SCENARIO_s20_31700200_02_0070","text":"辛苦了～\n朝日酱你没事……吧？"},{"key":"SCENARIO_s20_31700200_02_0080","text":"没事才怪……"},{"key":"SCENARIO_s20_31700200_02_0090","text":"像那样安安静静不说话的话\n你也能显得挺可爱的嘛"},{"key":"SCENARIO_s20_31700200_02_0100","text":"……\n不想再穿了～"}]
