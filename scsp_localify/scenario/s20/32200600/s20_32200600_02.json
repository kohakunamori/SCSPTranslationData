[{"key":"SCENARIO_s20_32200600_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32200600_02_0010","text":"好热啊"},{"key":"SCENARIO_s20_32200600_02_0020","text":"嗯……"},{"key":"SCENARIO_s20_32200600_02_0030","text":"浴、浴衣看起来挺凉快的……\n但穿起来意外地很热呢……"},{"key":"SCENARIO_s20_32200600_02_0040","text":"嗯——"},{"key":"SCENARIO_s20_32200600_02_0050","text":"啊……"},{"key":"SCENARIO_s20_32200600_02_0060","text":"声音……听起来很凉快……！"},{"key":"SCENARIO_s20_32200600_02_0070","text":"嗯——"},{"key":"SCENARIO_s20_32200600_02_0080","text":"但是，果然还是很热呢……"},{"key":"SCENARIO_s20_32200600_02_0090","text":"刚、刚才外景拍摄时走过的小河边也是……\n看起来挺凉快的，但湿气很重……"},{"key":"SCENARIO_s20_32200600_02_0100","text":"是啊～……\n好热啊"}]
