[{"key":"SCENARIO_s20_31900100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_31900100_03_0010","text":"……"},{"key":"SCENARIO_s20_31900100_03_0020","text":"……冬优子你的爆米花\n看起来好好吃"},{"key":"SCENARIO_s20_31900100_03_0021","text":"Motion"},{"key":"SCENARIO_s20_31900100_03_0030","text":"？\n跟你一样是焦糖味的"},{"key":"SCENARIO_s20_31900100_03_0040","text":"总觉得你那边的颜色更深！"},{"key":"SCENARIO_s20_31900100_03_0050","text":"啊，就是那种“别人碗里的饭看起来更好吃”的感觉嘛？"},{"key":"SCENARIO_s20_31900100_03_0051","text":"Motion"},{"key":"SCENARIO_s20_31900100_03_0060","text":"…………\n……想吃的话就吃呗？"},{"key":"SCENARIO_s20_31900100_03_0070","text":"好耶～！"},{"key":"SCENARIO_s20_31900100_03_0080","text":"朝日，要不要也吃我的？\n我这边味道不一样哦！"},{"key":"SCENARIO_s20_31900100_03_0081","text":"Motion"},{"key":"SCENARIO_s20_31900100_03_0090","text":"那我吃了！"},{"key":"SCENARIO_s20_31900100_03_0100","text":"好好好\n来，那，张嘴～"}]
