[{"key":"SCENARIO_s20_32100500_01_0001","text":"Motion"},{"key":"SCENARIO_s20_32100500_01_0002","text":"Motion"},{"key":"SCENARIO_s20_32100500_01_0005","text":"Motion"},{"key":"SCENARIO_s20_32100500_01_0010","text":"没有车来呢～\n趁现在过去吧～！"},{"key":"SCENARIO_s20_32100500_01_0020","text":"GO"},{"key":"SCENARIO_s20_32100500_01_0021","text":"Motion"},{"key":"SCENARIO_s20_32100500_01_0030","text":"好，出局"},{"key":"SCENARIO_s20_32100500_01_0040","text":"斜穿机动车道，是禁止的！即使是行人\n也可能被处以罚款，请注意！"},{"key":"SCENARIO_s20_32100500_01_0050","text":"好～！"},{"key":"SCENARIO_s20_32100500_01_0060","text":"……那边那个人呢？"},{"key":"SCENARIO_s20_32100500_01_0070","text":"我会注意的"},{"key":"SCENARIO_s20_32100500_01_0080","text":"……那么，接下来也是常见的交通违规\n这次也由这两位来演示"},{"key":"SCENARIO_s20_32100500_01_0081","text":"Motion"},{"key":"SCENARIO_s20_32100500_01_0090","text":"好\n包在我身上"},{"key":"SCENARIO_s20_32100500_01_0100","text":"啊哈～\n明明是要违规的人，还挺得意的～"}]
