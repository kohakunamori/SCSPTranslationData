[{"key":"SCENARIO_s20_32100500_04_0001","text":"Motion"},{"key":"SCENARIO_s20_32100500_04_0002","text":"Motion"},{"key":"SCENARIO_s20_32100500_04_0010","text":"噼呀……！"},{"key":"SCENARIO_s20_32100500_04_0020","text":"……我们走吧"},{"key":"SCENARIO_s20_32100500_04_0021","text":"Motion"},{"key":"SCENARIO_s20_32100500_04_0025","text":"Motion"},{"key":"SCENARIO_s20_32100500_04_0030","text":"对、对不起\n突然停下来……"},{"key":"SCENARIO_s20_32100500_04_0040","text":"像那样，车子一拐过来……\n就忍不住……"},{"key":"SCENARIO_s20_32100500_04_0050","text":"行人优先嘛，直接走就好了"},{"key":"SCENARIO_s20_32100500_04_0060","text":"话、话是这么说啦……\n但被靠那么近的话……会吓一跳……"},{"key":"SCENARIO_s20_32100500_04_0070","text":"……嘛，刚才那辆也是突然冲过来的嘛"},{"key":"SCENARIO_s20_32100500_04_0080","text":"嗯、嗯……"},{"key":"SCENARIO_s20_32100500_04_0081","text":"Motion"},{"key":"SCENARIO_s20_32100500_04_0090","text":"噼呀……！"},{"key":"SCENARIO_s20_32100500_04_0100","text":"…………那个，也不用在意"}]
