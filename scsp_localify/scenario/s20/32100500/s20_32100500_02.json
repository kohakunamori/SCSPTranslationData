[{"key":"SCENARIO_s20_32100500_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32100500_02_0010","text":"噢"},{"key":"SCENARIO_s20_32100500_02_0020","text":"是鸽子\n咕咕——"},{"key":"SCENARIO_s20_32100500_02_0030","text":"……信号灯的声音？"},{"key":"SCENARIO_s20_32100500_02_0040","text":"嗯\n咕咕——，咕咕——"},{"key":"SCENARIO_s20_32100500_02_0041","text":"Motion"},{"key":"SCENARIO_s20_32100500_02_0042","text":"Motion"},{"key":"SCENARIO_s20_32100500_02_0050","text":"──那个，是布谷鸟"},{"key":"SCENARIO_s20_32100500_02_0060","text":"不是鸽子，是布谷鸟的叫声"},{"key":"SCENARIO_s20_32100500_02_0070","text":"诶\n布谷鸟……"},{"key":"SCENARIO_s20_32100500_02_0071","text":"Motion"},{"key":"SCENARIO_s20_32100500_02_0080","text":"……说实话更像‘po’的音\n不太像‘ka’行的发音"},{"key":"SCENARIO_s20_32100500_02_0090","text":"哦\n那我站“咕咕”派。樋口也是"},{"key":"SCENARIO_s20_32100500_02_0100","text":"是吧"}]
