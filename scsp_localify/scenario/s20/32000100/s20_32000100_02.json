[{"key":"SCENARIO_s20_32000100_02_0000","text":"便利店工作人员"},{"key":"SCENARIO_s20_32000100_02_0010","text":"欢迎光临——"},{"key":"SCENARIO_s20_32000100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32000100_02_0020","text":"────糟了……"},{"key":"SCENARIO_s20_32000100_02_0030","text":"嘿～？\n────啊～……"},{"key":"SCENARIO_s20_32000100_02_0040","text":"噼诶……"},{"key":"SCENARIO_s20_32000100_02_0050","text":"最后一份\n限定豆沙包"},{"key":"SCENARIO_s20_32000100_02_0060","text":"好、好像是这样呢……\n我吃别的也行────"},{"key":"SCENARIO_s20_32000100_02_0002","text":"Motion"},{"key":"SCENARIO_s20_32000100_02_0070","text":"那就比胜负吧"},{"key":"SCENARIO_s20_32000100_02_0080","text":"嗯"},{"key":"SCENARIO_s20_32000100_02_0090","text":"啊哈～\n那就来咯～"},{"key":"SCENARIO_s20_32000100_02_0003","text":"Motion"},{"key":"SCENARIO_s20_32000100_02_0100","text":"最—初—是—拳头────／最初是拳头────／\n最初是，拳头────！／最初是拳头────！"}]
