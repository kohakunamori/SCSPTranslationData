[{"key":"SCENARIO_s20_31400100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31400100_02_0010","text":"……"},{"key":"SCENARIO_s20_31400100_02_0020","text":"甘奈酱，怎么了？"},{"key":"SCENARIO_s20_31400100_02_0030","text":"嘿嘿……\n我在想，雪会不会下呢～"},{"key":"SCENARIO_s20_31400100_02_0040","text":"这样啊。\n天气预报说有些地方会下呢……"},{"key":"SCENARIO_s20_31400100_02_0050","text":"呵呵，雪的气息，\n总觉得让人好兴奋呢。"},{"key":"SCENARIO_s20_31400100_02_0060","text":"对对，想着会不会积起来啊～\n或者呆呆地望着白色的天空。"},{"key":"SCENARIO_s20_31400100_02_0070","text":"光是那样就很有趣呢。"},{"key":"SCENARIO_s20_31400100_02_0080","text":"……雪人，\n还有打雪仗。"},{"key":"SCENARIO_s20_31400100_02_0090","text":"雪洞……\n还有雪兔子。"},{"key":"SCENARIO_s20_31400100_02_0100","text":"……嘿嘿／……呵呵"}]
