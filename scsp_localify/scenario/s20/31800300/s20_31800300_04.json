[{"key":"SCENARIO_s20_31800300_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31800300_04_0010","text":"…………哈——"},{"key":"SCENARIO_s20_31800300_04_0020","text":"人好多啊"},{"key":"SCENARIO_s20_31800300_04_0030","text":"这么多人\n有点累人呢"},{"key":"SCENARIO_s20_31800300_04_0040","text":"何止是有点……\n连买吃的都要费一番功夫"},{"key":"SCENARIO_s20_31800300_04_0050","text":"哈哈，说得没错"},{"key":"SCENARIO_s20_31800300_04_0060","text":"……嘛，热闹是好事嘛"},{"key":"SCENARIO_s20_31800300_04_0070","text":"没事吧？\n如果觉得难受的话，跟我说一声就────"},{"key":"SCENARIO_s20_31800300_04_0080","text":"多谢关心……"},{"key":"SCENARIO_s20_31800300_04_0090","text":"不过没事的\n我不会说那么扫兴的话"},{"key":"SCENARIO_s20_31800300_04_0100","text":"好不容易来了\n不好好享受一下怎么行"},{"key":"SCENARIO_s20_31800300_04_0101","text":"Motion"}]
