[{"key":"SCENARIO_s20_31800300_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31800300_02_0010","text":"冬优子酱许了什么愿？"},{"key":"SCENARIO_s20_31800300_02_0020","text":"秘密"},{"key":"SCENARIO_s20_31800300_02_0030","text":"诶——"},{"key":"SCENARIO_s20_31800300_02_0040","text":"我……"},{"key":"SCENARIO_s20_31800300_02_0050","text":"可以吗？许愿这种事\n跟别人说了就不灵了哦"},{"key":"SCENARIO_s20_31800300_02_0060","text":"诶……\n我跟制作人说了呀"},{"key":"SCENARIO_s20_31800300_02_0070","text":"啊——啊"},{"key":"SCENARIO_s20_31800300_02_0080","text":"────……"},{"key":"SCENARIO_s20_31800300_02_0090","text":"那我去重新写一张！"},{"key":"SCENARIO_s20_31800300_02_0091","text":"Motion"},{"key":"SCENARIO_s20_31800300_02_0100","text":"……开玩笑的啦"}]
