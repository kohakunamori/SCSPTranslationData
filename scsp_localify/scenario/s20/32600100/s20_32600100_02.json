[{"key":"SCENARIO_s20_32600100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32600100_02_0010","text":"…………"},{"key":"SCENARIO_s20_32600100_02_0001","text":"？？？"},{"key":"SCENARIO_s20_32600100_02_0020","text":"……\n路加酱？"},{"key":"SCENARIO_s20_32600100_02_0021","text":"Motion"},{"key":"SCENARIO_s20_32600100_02_0030","text":"好巧啊……！\n路加酱也是来找东西的吗？"},{"key":"SCENARIO_s20_32600100_02_0040","text":"…………是"},{"key":"SCENARIO_s20_32600100_02_0050","text":"我是来找一些可以参考的\n服饰类书籍的～"},{"key":"SCENARIO_s20_32600100_02_0060","text":"不过，这家店好像超级大\n到底在哪里呢……"},{"key":"SCENARIO_s20_32600100_02_0061","text":"Motion"},{"key":"SCENARIO_s20_32600100_02_0070","text":"不知道……\n不过应该在里面吧？"},{"key":"SCENARIO_s20_32600100_02_0080","text":"真的吗？　谢谢……！\n那我去找找看……！"},{"key":"SCENARIO_s20_32600100_02_0090","text":"打扰了……！"},{"key":"SCENARIO_s20_32600100_02_0100","text":"里面……？\n不对吗……"}]
