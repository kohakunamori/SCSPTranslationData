[{"key":"SCENARIO_s20_32700200_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32700200_01_0010","text":"──对了，路加"},{"key":"SCENARIO_s20_32700200_01_0020","text":"路加平时都在哪里买衣服呀？"},{"key":"SCENARIO_s20_32700200_01_0030","text":"…………"},{"key":"SCENARIO_s20_32700200_01_0031","text":"Motion"},{"key":"SCENARIO_s20_32700200_01_0040","text":"问这个干嘛"},{"key":"SCENARIO_s20_32700200_01_0050","text":"诶──！\n……嗯"},{"key":"SCENARIO_s20_32700200_01_0060","text":"啊哈，怎么办好呢\n就是“哦——这样啊”那种感觉？"},{"key":"SCENARIO_s20_32700200_01_0070","text":"…………"},{"key":"SCENARIO_s20_32700200_01_0080","text":"……不告诉你"},{"key":"SCENARIO_s20_32700200_01_0090","text":"诶～\n这样啊～"},{"key":"SCENARIO_s20_32700200_01_0100","text":"那下次有空的时候再告诉我吧？"}]
