[{"key":"SCENARIO_s20_32500200_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32500200_01_0010","text":"────────"},{"key":"SCENARIO_s20_32500200_01_0019","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_01_0020","text":"……客人，车站停前面这边可以吗？\n对面那个入口也能停就是了"},{"key":"SCENARIO_s20_32500200_01_0030","text":"────……\n……诶"},{"key":"SCENARIO_s20_32500200_01_0040","text":"啊……！\n对、对不起，我打瞌睡了……"},{"key":"SCENARIO_s20_32500200_01_0049","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_01_0050","text":"哈哈哈，看起来是挺累的吧？\n这大热天的也够呛"},{"key":"SCENARIO_s20_32500200_01_0060","text":"不、不是……不好意思……"},{"key":"SCENARIO_s20_32500200_01_0069","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_01_0070","text":"而且这广播啊\n刚才开始就聊得可好听了"},{"key":"SCENARIO_s20_32500200_01_0080","text":"啊，是啊……\n──────啊"},{"key":"SCENARIO_s20_32500200_01_0089","text":"MC"},{"key":"SCENARIO_s20_32500200_01_0090","text":"『好了，演播室里也洒进了柔和的夕阳』"},{"key":"SCENARIO_s20_32500200_01_0099","text":"MC"},{"key":"SCENARIO_s20_32500200_01_0100","text":"『这个时间点放首歌吧』"},{"key":"SCENARIO_s20_32500200_01_0110","text":"『好的』"},{"key":"SCENARIO_s20_32500200_01_0120","text":"『────那么，请欣赏一曲』"},{"key":"SCENARIO_s20_32500200_01_0121","text":"Motion"},{"key":"SCENARIO_s20_32500200_01_0130","text":"──────呵呵\n是啊……"}]
