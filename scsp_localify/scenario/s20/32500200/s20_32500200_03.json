[{"key":"SCENARIO_s20_32500200_03_0000","text":"Motion"},{"key":"SCENARIO_s20_32500200_03_0010","text":"────────"},{"key":"SCENARIO_s20_32500200_03_0019","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_03_0020","text":"……不好意思，请问前面是……"},{"key":"SCENARIO_s20_32500200_03_0029","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_03_0030","text":"上高速也没关系吗？"},{"key":"SCENARIO_s20_32500200_03_0039","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_03_0040","text":"……客人？"},{"key":"SCENARIO_s20_32500200_03_0050","text":"……\n对不起────"},{"key":"SCENARIO_s20_32500200_03_0060","text":"────嗯，高速……\n没关系"},{"key":"SCENARIO_s20_32500200_03_0069","text":"出租车司机"},{"key":"SCENARIO_s20_32500200_03_0070","text":"啊，抱歉\n把您吵醒了吧……"},{"key":"SCENARIO_s20_32500200_03_0080","text":"……\n没有────"},{"key":"SCENARIO_s20_32500200_03_0089","text":"MC"},{"key":"SCENARIO_s20_32500200_03_0090","text":"『────啊哈哈』"},{"key":"SCENARIO_s20_32500200_03_0091","text":"MC"},{"key":"SCENARIO_s20_32500200_03_0100","text":"『不行了，今天七草状态也太炸了！』"},{"key":"SCENARIO_s20_32500200_03_0101","text":"MC"},{"key":"SCENARIO_s20_32500200_03_0110","text":"『那——就这个感觉，MC就交给你啦？』"},{"key":"SCENARIO_s20_32500200_03_0120","text":"『好——那么今天也给困意来一记右勾拳！\n　一首撑过下午的歌，这就重磅送上────』"},{"key":"SCENARIO_s20_32500200_03_0121","text":"Motion"},{"key":"SCENARIO_s20_32500200_03_0130","text":"────正好，似乎是该醒来的时间了"}]
