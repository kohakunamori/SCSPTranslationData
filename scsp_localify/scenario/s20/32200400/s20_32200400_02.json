[{"key":"SCENARIO_s20_32200400_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32200400_02_0010","text":"今、今天的训练，\n内容好充实啊……！"},{"key":"SCENARIO_s20_32200400_02_0020","text":"嗯～\n雏菜，都累坏了～"},{"key":"SCENARIO_s20_32200400_02_0030","text":"浅仓？"},{"key":"SCENARIO_s20_32200400_02_0040","text":"透酱？\n怎么了？"},{"key":"SCENARIO_s20_32200400_02_0050","text":"嗯，便利店"},{"key":"SCENARIO_s20_32200400_02_0060","text":"便利店怎么了～？"},{"key":"SCENARIO_s20_32200400_02_0070","text":"肚子，饿了"},{"key":"SCENARIO_s20_32200400_02_0080","text":"…………"},{"key":"SCENARIO_s20_32200400_02_0090","text":"要、要去趟便利店吗？"},{"key":"SCENARIO_s20_32200400_02_0100","text":"赞成／嗯／同意～！"}]
