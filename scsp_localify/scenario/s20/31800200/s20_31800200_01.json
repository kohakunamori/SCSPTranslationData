[{"key":"SCENARIO_s20_31800200_01_0000","text":"Motion"},{"key":"SCENARIO_s20_31800200_01_0010","text":"…………"},{"key":"SCENARIO_s20_31800200_01_0020","text":"那么，按照预定，由黛小姐的开场白开始\n拜托了"},{"key":"SCENARIO_s20_31800200_01_0030","text":"……好的！"},{"key":"SCENARIO_s20_31800200_01_0040","text":"朝日酱、爱依酱\n要上了哦？"},{"key":"SCENARIO_s20_31800200_01_0050","text":"好！／嗯"},{"key":"SCENARIO_s20_31800200_01_0060","text":"好——\n那就正式开始了！"},{"key":"SCENARIO_s20_31800200_01_0070","text":"预备──────"},{"key":"SCENARIO_s20_31800200_01_0080","text":"我的心意……\n传达到了吗？"},{"key":"SCENARIO_s20_31800200_01_0090","text":"美好的回礼……谢谢你"},{"key":"SCENARIO_s20_31800200_01_0100","text":"白色情人节快乐"}]
