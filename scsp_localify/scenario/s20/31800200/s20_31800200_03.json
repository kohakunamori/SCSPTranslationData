[{"key":"SCENARIO_s20_31800200_03_0000","text":"Motion"},{"key":"SCENARIO_s20_31800200_03_0010","text":"爱依，久等了"},{"key":"SCENARIO_s20_31800200_03_0020","text":"……爱依？"},{"key":"SCENARIO_s20_31800200_03_0030","text":"………………"},{"key":"SCENARIO_s20_31800200_03_0040","text":"…………"},{"key":"SCENARIO_s20_31800200_03_0050","text":"……嗯\n放哪儿来着……"},{"key":"SCENARIO_s20_31800200_03_0051","text":"Motion"},{"key":"SCENARIO_s20_31800200_03_0060","text":"…………哈啊\n……唔"},{"key":"SCENARIO_s20_31800200_03_0070","text":"……对不起冬优子酱！\n我，睡着了……"},{"key":"SCENARIO_s20_31800200_03_0080","text":"……看来是的呢"},{"key":"SCENARIO_s20_31800200_03_0090","text":"……咦？\n这条毯子……"},{"key":"SCENARIO_s20_31800200_03_0100","text":"……好了\n既然醒了就走吧"}]
