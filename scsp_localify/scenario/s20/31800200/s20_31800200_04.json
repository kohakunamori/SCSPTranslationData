[{"key":"SCENARIO_s20_31800200_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31800200_04_0010","text":"…………\n……哈……啊……"},{"key":"SCENARIO_s20_31800200_04_0020","text":"…………"},{"key":"SCENARIO_s20_31800200_04_0030","text":"…………呼……"},{"key":"SCENARIO_s20_31800200_04_0040","text":"喂……\n打哈欠也太多了吧？"},{"key":"SCENARIO_s20_31800200_04_0050","text":"……唔\n啊、啊啊……"},{"key":"SCENARIO_s20_31800200_04_0060","text":"抱歉……\n我会好好安全驾驶的"},{"key":"SCENARIO_s20_31800200_04_0070","text":"…………\n你，最近是不是没好好休息"},{"key":"SCENARIO_s20_31800200_04_0080","text":"……啊——\n嗯，也许吧"},{"key":"SCENARIO_s20_31800200_04_0090","text":"自我管理也要做好啊\n冬优的制作人可是你"},{"key":"SCENARIO_s20_31800200_04_0100","text":"啊……说得对\n我会注意的"},{"key":"SCENARIO_s20_31800200_04_0101","text":"Motion"}]
