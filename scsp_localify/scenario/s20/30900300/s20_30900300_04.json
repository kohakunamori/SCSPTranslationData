[{"key":"SCENARIO_s20_30900300_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30900300_04_0001","text":"Motion"},{"key":"SCENARIO_s20_30900300_04_0010","text":"……凛世酱"},{"key":"SCENARIO_s20_30900300_04_0020","text":"嗯……"},{"key":"SCENARIO_s20_30900300_04_0021","text":"Motion"},{"key":"SCENARIO_s20_30900300_04_0030","text":"果穗～／果穗小姐……"},{"key":"SCENARIO_s20_30900300_04_0040","text":"千雪前辈，凛世小姐！"},{"key":"SCENARIO_s20_30900300_04_0050","text":"你们在看什么？"},{"key":"SCENARIO_s20_30900300_04_0060","text":"啊，没有！没什么……\n只是明天体育课我不太擅长，想着能不能下雨就好了……！"},{"key":"SCENARIO_s20_30900300_04_0070","text":"那么……\n做个晴天娃娃……"},{"key":"SCENARIO_s20_30900300_04_0080","text":"倒着挂起来的话……\n一定能……"},{"key":"SCENARIO_s20_30900300_04_0090","text":"嗯！果穗一直是个好孩子嘛，\n偶尔做做这种小魔法也不错哦！"},{"key":"SCENARIO_s20_30900300_04_0100","text":"──果穗，我们来做晴天娃娃吧？"},{"key":"SCENARIO_s20_30900300_04_0101","text":"Motion"}]
