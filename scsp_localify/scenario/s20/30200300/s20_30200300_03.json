[{"key":"SCENARIO_s20_30200300_03_0000","text":"Motion"},{"key":"SCENARIO_s20_30200300_03_0010","text":"（拍了好多啊……）"},{"key":"SCENARIO_s20_30200300_03_0011","text":"Motion"},{"key":"SCENARIO_s20_30200300_03_0020","text":"（……啊，这张）"},{"key":"SCENARIO_s20_30200300_03_0030","text":"…………好香"},{"key":"SCENARIO_s20_30200300_03_0040","text":"……嗯！\n就算站着不动，也能闻到好香的味道……"},{"key":"SCENARIO_s20_30200300_03_0050","text":"…………"},{"key":"SCENARIO_s20_30200300_03_0060","text":"哇……／…………！"},{"key":"SCENARIO_s20_30200300_03_0070","text":"呵呵……／呵呵"},{"key":"SCENARIO_s20_30200300_03_0080","text":"啊——！\n你们俩在卿卿我我！"},{"key":"SCENARIO_s20_30200300_03_0090","text":"也让我加入嘛——！"},{"key":"SCENARIO_s20_30200300_03_0100","text":"呵呵／真是的……！"}]
