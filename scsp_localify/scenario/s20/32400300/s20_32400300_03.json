[{"key":"SCENARIO_s20_32400300_03_0000","text":"Motion"},{"key":"SCENARIO_s20_32400300_03_0010","text":"诶……"},{"key":"SCENARIO_s20_32400300_03_0020","text":"啊……\n免费的冰刚好没有了吗"},{"key":"SCENARIO_s20_32400300_03_0030","text":"今天太热了嘛"},{"key":"SCENARIO_s20_32400300_03_0040","text":"──啊，不过\n干冰也有啊"},{"key":"SCENARIO_s20_32400300_03_0050","text":"……干冰是要收费的"},{"key":"SCENARIO_s20_32400300_03_0060","text":"这样啊……\n那我买点冰淇淋回来。可以当保冷剂用"},{"key":"SCENARIO_s20_32400300_03_0070","text":"那……\n那部分钱，我来付"},{"key":"SCENARIO_s20_32400300_03_0080","text":"不用，买的冰淇淋\n等送日花回去之后我会带去事务所"},{"key":"SCENARIO_s20_32400300_03_0090","text":"是给大家的慰问品，日花不用出钱"},{"key":"SCENARIO_s20_32400300_03_0100","text":"……是吗\n那就赶紧去买回来不就好了吗～"}]
