[{"key":"SCENARIO_s20_32400300_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32400300_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32400300_02_0010","text":"……啊"},{"key":"SCENARIO_s20_32400300_02_0020","text":"美琴────……"},{"key":"SCENARIO_s20_32400300_02_0030","text":"怎么了？"},{"key":"SCENARIO_s20_32400300_02_0040","text":"啊，那个……\n拍摄的准备好像稍微推迟了"},{"key":"SCENARIO_s20_32400300_02_0050","text":"听说要30分钟后再开始"},{"key":"SCENARIO_s20_32400300_02_0060","text":"30分钟……"},{"key":"SCENARIO_s20_32400300_02_0070","text":"那个……\n你刚才在听音乐吗？"},{"key":"SCENARIO_s20_32400300_02_0080","text":"……音乐？\n嗯，很动听的声音呢"},{"key":"SCENARIO_s20_32400300_02_0081","text":"Motion"},{"key":"SCENARIO_s20_32400300_02_0090","text":"感觉好像稍微……\n凉快了一些"},{"key":"SCENARIO_s20_32400300_02_0100","text":"嗯\n是啊"},{"key":"SCENARIO_s20_32400300_02_0101","text":"Motion"}]
