[{"key":"SCENARIO_s20_30200100_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30200100_04_0001","text":"Motion"},{"key":"SCENARIO_s20_30200100_04_0010","text":"诶嘿嘿……\n肚子有点饿了"},{"key":"SCENARIO_s20_30200100_04_0020","text":"呵呵\n是啊"},{"key":"SCENARIO_s20_30200100_04_0030","text":"晚饭，怎么办……？"},{"key":"SCENARIO_s20_30200100_04_0040","text":"找家店进去吃，应该是最稳妥的吧\n今天也没做便当"},{"key":"SCENARIO_s20_30200100_04_0050","text":"就算我来做，回事务所再做的话也要花时间"},{"key":"SCENARIO_s20_30200100_04_0060","text":"啊！\n有了！有了！"},{"key":"SCENARIO_s20_30200100_04_0070","text":"去小吃摊怎么样！\n难得来广场玩一趟嘛！"},{"key":"SCENARIO_s20_30200100_04_0080","text":"我觉得不错……呢\n炒面、章鱼烧什么的，感觉好开心……"},{"key":"SCENARIO_s20_30200100_04_0090","text":"好啊，那就这么办\n那我们就去找找小吃摊吧"},{"key":"SCENARIO_s20_30200100_04_0100","text":"好！／好——！"}]
