[{"key":"SCENARIO_s20_20200100_11_0001","text":"Motion"},{"key":"SCENARIO_s20_20200100_11_0002","text":"Motion"},{"key":"SCENARIO_s20_20200100_11_0003","text":"Motion"},{"key":"SCENARIO_s20_20200100_11_0010","text":"灯织，你在干什么呀？"},{"key":"SCENARIO_s20_20200100_11_0020","text":"练习"},{"key":"SCENARIO_s20_20200100_11_0030","text":"练习……？"},{"key":"SCENARIO_s20_20200100_11_0031","text":"Motion"},{"key":"SCENARIO_s20_20200100_11_0040","text":"啊，签名……！"},{"key":"SCENARIO_s20_20200100_11_0050","text":"哦哦——！真有偶像范儿！"},{"key":"SCENARIO_s20_20200100_11_0060","text":"什么叫真有偶像范儿……"},{"key":"SCENARIO_s20_20200100_11_0061","text":"Motion"},{"key":"SCENARIO_s20_20200100_11_0070","text":"不过也是，签名平时确实不怎么写……"},{"key":"SCENARIO_s20_20200100_11_0080","text":"对吧对吧"},{"key":"SCENARIO_s20_20200100_11_0090","text":"我也一起练练好了！\n真乃要不要也来？"},{"key":"SCENARIO_s20_20200100_11_0100","text":"嗯\n我也一起可以吗，灯织……！"},{"key":"SCENARIO_s20_20200100_11_0101","text":"Motion"}]
