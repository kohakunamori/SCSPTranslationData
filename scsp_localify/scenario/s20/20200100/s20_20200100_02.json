[{"key":"SCENARIO_s20_20200100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_20200100_02_0010","text":"…………"},{"key":"SCENARIO_s20_20200100_02_0020","text":"呼哇……"},{"key":"SCENARIO_s20_20200100_02_0030","text":"灯织，你还好吗？"},{"key":"SCENARIO_s20_20200100_02_0040","text":"还……还好……"},{"key":"SCENARIO_s20_20200100_02_0050","text":"…………"},{"key":"SCENARIO_s20_20200100_02_0060","text":"看起来不太好啊……"},{"key":"SCENARIO_s20_20200100_02_0070","text":"签名，确实会紧张呢……"},{"key":"SCENARIO_s20_20200100_02_0080","text":"灯织，灯织\n要不要先在别的地方练一下？"},{"key":"SCENARIO_s20_20200100_02_0090","text":"可以的话，我去给你拿张纸来……！"},{"key":"SCENARIO_s20_20200100_02_0100","text":"不用了，没关系\n我要一次就写好……！"}]
