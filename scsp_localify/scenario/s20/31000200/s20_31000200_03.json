[{"key":"SCENARIO_s20_31000200_03_0001","text":"Motion"},{"key":"SCENARIO_s20_31000200_03_0010","text":"看了杂志哦～\n小千子，戴眼镜的时候反差感好厉害啊！"},{"key":"SCENARIO_s20_31000200_03_0020","text":"有让大家看到好的反差感吗……！？"},{"key":"SCENARIO_s20_31000200_03_0030","text":"有哦有哦！"},{"key":"SCENARIO_s20_31000200_03_0040","text":"呵呵，谢谢大家"},{"key":"SCENARIO_s20_31000200_03_0041","text":"Motion"},{"key":"SCENARIO_s20_31000200_03_0050","text":"…………"},{"key":"SCENARIO_s20_31000200_03_0060","text":"被说了呢，“反差感”……！"},{"key":"SCENARIO_s20_31000200_03_0070","text":"被说了呢，“反差感”……！"},{"key":"SCENARIO_s20_31000200_03_0080","text":"要让世人知道那种拍摄也完全不在话下的作战——"},{"key":"SCENARIO_s20_31000200_03_0090","text":"还得继续努力坚持下去才行啊……！"},{"key":"SCENARIO_s20_31000200_03_0091","text":"Motion"},{"key":"SCENARIO_s20_31000200_03_0100","text":"哈哈哈／呵呵呵"}]
