[{"key":"SCENARIO_s20_31200400_04_0001","text":"Motion"},{"key":"SCENARIO_s20_31200400_04_0010","text":"………………"},{"key":"SCENARIO_s20_31200400_04_0020","text":"……我开动了……"},{"key":"SCENARIO_s20_31200400_04_0030","text":"────………………"},{"key":"SCENARIO_s20_31200400_04_0040","text":"……虽然不是……\n初音……"},{"key":"SCENARIO_s20_31200400_04_0050","text":"…………\n惬意的……新春……午后……"},{"key":"SCENARIO_s20_31200400_04_0060","text":"呵呵……\n今年……第一份……书置……"},{"key":"SCENARIO_s20_31200400_04_0070","text":"凛世，差不多到时间了\n去开会吧"},{"key":"SCENARIO_s20_31200400_04_0080","text":"好……\n马上来……"},{"key":"SCENARIO_s20_31200400_04_0081","text":"Motion"},{"key":"SCENARIO_s20_31200400_04_0090","text":"哦……『请慢用』……\n这字是凛世写的吧"},{"key":"SCENARIO_s20_31200400_04_0100","text":"嗯，很漂亮的字……\n一眼就能认出来"},{"key":"SCENARIO_s20_31200400_04_0101","text":"Motion"}]
