[{"key":"SCENARIO_s20_22000100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_22000100_01_0010","text":"炸鸡便当"},{"key":"SCENARIO_s20_22000100_01_0020","text":"雏菜要可乐饼便当～"},{"key":"SCENARIO_s20_22000100_01_0030","text":"要油淋鸡的"},{"key":"SCENARIO_s20_22000100_01_0040","text":"我、我要……\n────嗯，要炸鱼排的……！"},{"key":"SCENARIO_s20_22000100_01_0050","text":"还有，蜜瓜苏打"},{"key":"SCENARIO_s20_22000100_01_0051","text":"Motion"},{"key":"SCENARIO_s20_22000100_01_0052","text":"Motion"},{"key":"SCENARIO_s20_22000100_01_0060","text":"啊哈～\n那雏菜也要橙汁～"},{"key":"SCENARIO_s20_22000100_01_0070","text":"柠檬茶"},{"key":"SCENARIO_s20_22000100_01_0080","text":"这、这样会拿很多东西呢……！\n────我要茶吧……！"},{"key":"SCENARIO_s20_22000100_01_0081","text":"Motion"},{"key":"SCENARIO_s20_22000100_01_0082","text":"Motion"},{"key":"SCENARIO_s20_22000100_01_0090","text":"那，走吧"},{"key":"SCENARIO_s20_22000100_01_0100","text":"剪刀石头布──────"}]
