[{"key":"SCENARIO_s20_22000100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_22000100_02_0010","text":"────……"},{"key":"SCENARIO_s20_22000100_02_0020","text":"啊——……"},{"key":"SCENARIO_s20_22000100_02_0030","text":"透前辈，好慢呢～"},{"key":"SCENARIO_s20_22000100_02_0040","text":"我、我拜托了好多便当，\n是不是太重了……"},{"key":"SCENARIO_s20_22000100_02_0041","text":"Motion"},{"key":"SCENARIO_s20_22000100_02_0050","text":"嗯——……"},{"key":"SCENARIO_s20_22000100_02_0060","text":"是在休息吧"},{"key":"SCENARIO_s20_22000100_02_0070","text":"是、是吗……！\n可能是肚子太饿了吧……"},{"key":"SCENARIO_s20_22000100_02_0080","text":"啊哈～\n那就把便当吃了再过来就好啦～"},{"key":"SCENARIO_s20_22000100_02_0081","text":"Motion"},{"key":"SCENARIO_s20_22000100_02_0090","text":"哈——……"},{"key":"SCENARIO_s20_22000100_02_0091","text":"Motion"},{"key":"SCENARIO_s20_22000100_02_0100","text":"吃吧，炸鸡……"},{"key":"SCENARIO_s20_22000100_02_0101","text":"Motion"},{"key":"SCENARIO_s20_22000100_02_0102","text":"Motion"}]
