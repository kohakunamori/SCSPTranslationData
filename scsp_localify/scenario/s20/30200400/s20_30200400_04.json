[{"key":"SCENARIO_s20_30200400_04_0001","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0002","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0010","text":"“下次休假我们三个人好像都有空！\n　如果没什么安排的话，要不要一起出去走走？”"},{"key":"SCENARIO_s20_30200400_04_0020","text":"“我这边没问题哦\n　灯织酱呢？”"},{"key":"SCENARIO_s20_30200400_04_0030","text":"“我有空\n　想去哪里呢？”"},{"key":"SCENARIO_s20_30200400_04_0040","text":"“绝赞征集中\n　很棒的外出计划！”"},{"key":"SCENARIO_s20_30200400_04_0041","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0042","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0050","text":"啊……"},{"key":"SCENARIO_s20_30200400_04_0059","text":"咖啡店的招牌"},{"key":"SCENARIO_s20_30200400_04_0060","text":"“期间限定·星空挞\n　将夏日夜空封存其中的新品，敬请品尝！”"},{"key":"SCENARIO_s20_30200400_04_0070","text":"“我刚发现的……”"},{"key":"SCENARIO_s20_30200400_04_0080","text":"“有星星浮在上面\n　好漂亮”"},{"key":"SCENARIO_s20_30200400_04_0090","text":"“就是啊！\n　这种灯饰效果必须得去吃啊！”"},{"key":"SCENARIO_s20_30200400_04_0091","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0092","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0093","text":"Motion"},{"key":"SCENARIO_s20_30200400_04_0100","text":"……不好意思，可以预约吗？\n……好的，三个人……"}]
