[{"key":"SCENARIO_s20_12300100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_12300100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_12300100_01_0010","text":"呐，透前辈\n圆香前辈不一起来吗～？"},{"key":"SCENARIO_s20_12300100_01_0020","text":"诶？啊—\n她被叫走了，好像有什么事"},{"key":"SCENARIO_s20_12300100_01_0021","text":"Motion"},{"key":"SCENARIO_s20_12300100_01_0030","text":"——透、透酱……！\n雏菜酱……！"},{"key":"SCENARIO_s20_12300100_01_0031","text":"Motion"},{"key":"SCENARIO_s20_12300100_01_0040","text":"嗯～？\n怎么了，小糸酱"},{"key":"SCENARIO_s20_12300100_01_0050","text":"那、那个！\n刚才，在那里……！圆、圆……！"},{"key":"SCENARIO_s20_12300100_01_0060","text":"圆、圆香酱她……！\n和、和男生……！"},{"key":"SCENARIO_s20_12300100_01_0070","text":"诶～～～！？\n圆香前辈怎么了怎么了～～～！？"},{"key":"SCENARIO_s20_12300100_01_0080","text":"就、就是……在没什么人的，走廊深处……！\n好像在……说着什么……"},{"key":"SCENARIO_s20_12300100_01_0081","text":"Motion"},{"key":"SCENARIO_s20_12300100_01_0090","text":"那该不会是……\n告白～～～！？"},{"key":"SCENARIO_s20_12300100_01_0100","text":"不对"}]
