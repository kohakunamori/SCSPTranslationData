[{"key":"SCENARIO_s20_32600400_04_0000","text":"Motion"},{"key":"SCENARIO_s20_32600400_04_0009","text":"路人1"},{"key":"SCENARIO_s20_32600400_04_0010","text":"下起来了啊。"},{"key":"SCENARIO_s20_32600400_04_0019","text":"路人1"},{"key":"SCENARIO_s20_32600400_04_0020","text":"你带伞了吗？\n我忘带了。"},{"key":"SCENARIO_s20_32600400_04_0029","text":"路人2"},{"key":"SCENARIO_s20_32600400_04_0030","text":"我带了折叠伞来。\n冬天的雨没伞可太难熬了。"},{"key":"SCENARIO_s20_32600400_04_0040","text":"…………"},{"key":"SCENARIO_s20_32600400_04_0049","text":"路人1"},{"key":"SCENARIO_s20_32600400_04_0050","text":"我去便利店买一把吧……\n能让我搭到那边吗？"},{"key":"SCENARIO_s20_32600400_04_0059","text":"路人2"},{"key":"SCENARIO_s20_32600400_04_0060","text":"嗯，OK"},{"key":"SCENARIO_s20_32600400_04_0069","text":"路人2"},{"key":"SCENARIO_s20_32600400_04_0070","text":"看来一时半会儿停不下来呢──────"},{"key":"SCENARIO_s20_32600400_04_0080","text":"────────……"},{"key":"SCENARIO_s20_32600400_04_0090","text":"一直……都不停吗────────"},{"key":"SCENARIO_s20_32600400_04_0100","text":"好冷……"}]
