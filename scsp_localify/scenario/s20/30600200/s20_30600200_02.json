[{"key":"SCENARIO_s20_30600200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_30600200_02_0010","text":"我说——"},{"key":"SCENARIO_s20_30600200_02_0020","text":"嗯？"},{"key":"SCENARIO_s20_30600200_02_0030","text":"熊？\n还是熊？"},{"key":"SCENARIO_s20_30600200_02_0040","text":"嗯～～？　什么话题～？"},{"key":"SCENARIO_s20_30600200_02_0050","text":"所以说\n熊？还是熊？"},{"key":"SCENARIO_s20_30600200_02_0060","text":"那是……嗯\n木雕的那种嘴里叼着鱼的？"},{"key":"SCENARIO_s20_30600200_02_0070","text":"对—\n你平时怎么叫的？"},{"key":"SCENARIO_s20_30600200_02_0080","text":"熊……熊……"},{"key":"SCENARIO_s20_30600200_02_0090","text":"啊等等搞混了\n话说怎么突然问这个？"},{"key":"SCENARIO_s20_30600200_02_0100","text":"诶—\n打发时间的突击测试"},{"key":"SCENARIO_s20_30600200_02_0101","text":"Motion"}]
