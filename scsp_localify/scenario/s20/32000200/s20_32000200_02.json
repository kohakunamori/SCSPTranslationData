[{"key":"SCENARIO_s20_32000200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32000200_02_0010","text":"早上好"},{"key":"SCENARIO_s20_32000200_02_0020","text":"………………"},{"key":"SCENARIO_s20_32000200_02_0021","text":"Motion"},{"key":"SCENARIO_s20_32000200_02_0030","text":"啊、咦……透酱……！"},{"key":"SCENARIO_s20_32000200_02_0040","text":"啊，小糸酱\n早上好"},{"key":"SCENARIO_s20_32000200_02_0050","text":"早、早上好……！你好早啊……\n还、还没人来的……"},{"key":"SCENARIO_s20_32000200_02_0060","text":"嗯\n……咦，你嘴里是不是在动来动去的？"},{"key":"SCENARIO_s20_32000200_02_0070","text":"啊……\n我在吃糖……西瓜味的……"},{"key":"SCENARIO_s20_32000200_02_0080","text":"哦——"},{"key":"SCENARIO_s20_32000200_02_0090","text":"抢先一步了呢\n夏天"},{"key":"SCENARIO_s20_32000200_02_0100","text":"诶、嘿嘿……\n是啊！"}]
