[{"key":"SCENARIO_s20_32000200_03_0010","text":"雏菜，去看看甜点吧～\n "},{"key":"SCENARIO_s20_32000200_03_0020","text":"啊、我、我……\n去买颗糖……！\n "},{"key":"SCENARIO_s20_32000200_03_0030","text":"耶——"},{"key":"SCENARIO_s20_32000200_03_0040","text":"………………"},{"key":"SCENARIO_s20_32000200_03_0050","text":"今天带了\n钱包"},{"key":"SCENARIO_s20_32000200_03_0060","text":"我又没问你"},{"key":"SCENARIO_s20_32000200_03_0070","text":"不过……算了，今天\n什么都不买也行"},{"key":"SCENARIO_s20_32000200_03_0080","text":"………………"},{"key":"SCENARIO_s20_32000200_03_0090","text":"透酱、圆香酱……久等了！\n回家吧……！"},{"key":"SCENARIO_s20_32000200_03_0100","text":"去透前辈家，吃冰淇淋吧～"},{"key":"SCENARIO_s20_32000200_03_0101","text":"Motion"}]
