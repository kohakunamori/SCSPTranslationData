[{"key":"SCENARIO_s20_31400400_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31400400_02_0010","text":"……！\n这个，好棒……！"},{"key":"SCENARIO_s20_31400400_02_0020","text":"……？\n怎么了～？"},{"key":"SCENARIO_s20_31400400_02_0021","text":"Motion"},{"key":"SCENARIO_s20_31400400_02_0030","text":"你看……！"},{"key":"SCENARIO_s20_31400400_02_0040","text":"电竞……灯……？"},{"key":"SCENARIO_s20_31400400_02_0050","text":"嘿嘿……\n不错，吧……？"},{"key":"SCENARIO_s20_31400400_02_0060","text":"会跟着音乐……\n闪好多好多光的那种……"},{"key":"SCENARIO_s20_31400400_02_0070","text":"肯定……\n超好玩……！"},{"key":"SCENARIO_s20_31400400_02_0080","text":"呃……\n画面会不会反而看不清了……？"},{"key":"SCENARIO_s20_31400400_02_0090","text":"……\n诶……！？"},{"key":"SCENARIO_s20_31400400_02_0100","text":"……？"}]
