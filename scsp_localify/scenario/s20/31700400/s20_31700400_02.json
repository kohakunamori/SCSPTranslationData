[{"key":"SCENARIO_s20_31700400_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31700400_02_0010","text":"爱依酱，你在看什么呀"},{"key":"SCENARIO_s20_31700400_02_0020","text":"露营的杂志～\n不知道谁放在这里的～"},{"key":"SCENARIO_s20_31700400_02_0030","text":"朝日也要看吗？"},{"key":"SCENARIO_s20_31700400_02_0040","text":"《篝火料理特辑》！\n看起来超好吃的说～"},{"key":"SCENARIO_s20_31700400_02_0050","text":"诶，好像挺有意思的嘛！\n给我看看！"},{"key":"SCENARIO_s20_31700400_02_0051","text":"Motion"},{"key":"SCENARIO_s20_31700400_02_0060","text":"这个这个，这一页\n烤红薯、烤棉花糖串、烤鸡……"},{"key":"SCENARIO_s20_31700400_02_0070","text":"好厉害，好想试试看！"},{"key":"SCENARIO_s20_31700400_02_0080","text":"啊哈哈～，要不要挑战一下？\n在事务所的话，烤棉花糖应该能做！"},{"key":"SCENARIO_s20_31700400_02_0090","text":"是这个吗？\n看起来好好吃！"},{"key":"SCENARIO_s20_31700400_02_0100","text":"好嘞，去厨房吧！"},{"key":"SCENARIO_s20_31700400_02_0101","text":"Motion"}]
