[{"key":"SCENARIO_s20_31700400_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31700400_04_0010","text":"……呼——哈——"},{"key":"SCENARIO_s20_31700400_04_0020","text":"喂，我说你啊……\n差不多该看到极限了吧？"},{"key":"SCENARIO_s20_31700400_04_0030","text":"极限……"},{"key":"SCENARIO_s20_31700400_04_0040","text":"极限……？\n什么意思啊？"},{"key":"SCENARIO_s20_31700400_04_0050","text":"……没\n冬优也……还……呼——……绰绰有余呢"},{"key":"SCENARIO_s20_31700400_04_0060","text":"我也是……\n完、完全……没问题…………"},{"key":"SCENARIO_s20_31700400_04_0070","text":"爱依酱！？／爱依！？"},{"key":"SCENARIO_s20_31700400_04_0071","text":"Motion"},{"key":"SCENARIO_s20_31700400_04_0080","text":"哈——、哈——……\n咳、冬优也，已经…………"},{"key":"SCENARIO_s20_31700400_04_0090","text":"哎呀……不是……没问题……的吗～？"},{"key":"SCENARIO_s20_31700400_04_0100","text":"没、没问题啦……"},{"key":"SCENARIO_s20_31700400_04_0101","text":"Motion"}]
