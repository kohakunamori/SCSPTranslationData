[{"key":"SCENARIO_s20_31600100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_31600100_02_0002","text":"Motion"},{"key":"SCENARIO_s20_31600100_02_0010","text":"…………唔，……"},{"key":"SCENARIO_s20_31600100_02_0019","text":"摄影师"},{"key":"SCENARIO_s20_31600100_02_0020","text":"咦？甜花酱、千雪姐，\n你们的笑容有点僵硬哦？怎么了？"},{"key":"SCENARIO_s20_31600100_02_0030","text":"啊，那个…………"},{"key":"SCENARIO_s20_31600100_02_0031","text":"Motion"},{"key":"SCENARIO_s20_31600100_02_0040","text":"抱歉，这双高跟鞋实在太漂亮了……\n单脚重心姿势的时候，我可能有点紧张……"},{"key":"SCENARIO_s20_31600100_02_0050","text":"能给我一点时间，\n让我和这双鞋熟悉一下吗？"},{"key":"SCENARIO_s20_31600100_02_0060","text":"一点点时间就够了吗……？"},{"key":"SCENARIO_s20_31600100_02_0070","text":"因为现在还在小心翼翼地试探，\n看看做到什么程度会摔倒……"},{"key":"SCENARIO_s20_31600100_02_0080","text":"走几步试试，或者互相看看对方的姿势，\n应该就没问题了……你觉得呢，甜花酱？"},{"key":"SCENARIO_s20_31600100_02_0081","text":"Motion"},{"key":"SCENARIO_s20_31600100_02_0090","text":"啊……嗯……\n甜花也……那样……没问题……"},{"key":"SCENARIO_s20_31600100_02_0100","text":"那我趁这时间去买点喝的吧\n你们俩就趁这时间和鞋子熟悉一下……？"},{"key":"SCENARIO_s20_31600100_02_0101","text":"Motion"}]
