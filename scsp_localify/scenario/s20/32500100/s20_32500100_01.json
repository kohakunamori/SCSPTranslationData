[{"key":"SCENARIO_s20_32500100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_32500100_01_0010","text":"哇……！"},{"key":"SCENARIO_s20_32500100_01_0020","text":"怎么了？"},{"key":"SCENARIO_s20_32500100_01_0021","text":"Motion"},{"key":"SCENARIO_s20_32500100_01_0030","text":"啊，不好意思\n我声音太大了……！"},{"key":"SCENARIO_s20_32500100_01_0040","text":"下次演唱会的门票，\n今天好像是一般发售日"},{"key":"SCENARIO_s20_32500100_01_0050","text":"好像已经售罄了！\n之前有抽选什么的，所以今天是先到先得……"},{"key":"SCENARIO_s20_32500100_01_0060","text":"这样啊\n……太好了"},{"key":"SCENARIO_s20_32500100_01_0061","text":"Motion"},{"key":"SCENARIO_s20_32500100_01_0070","text":"不过看Twista上面，也有人说着没抢到呢～"},{"key":"SCENARIO_s20_32500100_01_0080","text":"……这样啊"},{"key":"SCENARIO_s20_32500100_01_0081","text":"Motion"},{"key":"SCENARIO_s20_32500100_01_0090","text":"…………"},{"key":"SCENARIO_s20_32500100_01_0100","text":"还得，更加努力才行"}]
