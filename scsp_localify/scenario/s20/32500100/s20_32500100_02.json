[{"key":"SCENARIO_s20_32500100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32500100_02_0010","text":"──准备好了吗？"},{"key":"SCENARIO_s20_32500100_02_0011","text":"Motion"},{"key":"SCENARIO_s20_32500100_02_0020","text":"是、是的……！\n随时都可以……！"},{"key":"SCENARIO_s20_32500100_02_0030","text":"这样\n那就好"},{"key":"SCENARIO_s20_32500100_02_0031","text":"Motion"},{"key":"SCENARIO_s20_32500100_02_0040","text":"那，虽然有点早\n我们先去侧台吧"},{"key":"SCENARIO_s20_32500100_02_0050","text":"观众席的情况\n从那边也能看到"},{"key":"SCENARIO_s20_32500100_02_0060","text":"是、是啊……！\n那就这样吧……！"},{"key":"SCENARIO_s20_32500100_02_0061","text":"Motion"},{"key":"SCENARIO_s20_32500100_02_0070","text":"…………"},{"key":"SCENARIO_s20_32500100_02_0080","text":"…………今天\n办一场精彩的演出吧"},{"key":"SCENARIO_s20_32500100_02_0090","text":"……！\n好、好的……！"}]
