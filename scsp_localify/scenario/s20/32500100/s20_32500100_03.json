[{"key":"SCENARIO_s20_32500100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0010","text":"……发生什么事了吗"},{"key":"SCENARIO_s20_32500100_03_0020","text":"好像是\n……我去问问"},{"key":"SCENARIO_s20_32500100_03_0021","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0030","text":"诶……！\n美琴小姐……！"},{"key":"SCENARIO_s20_32500100_03_0031","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0040","text":"…………"},{"key":"SCENARIO_s20_32500100_03_0042","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0041","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0050","text":"……好像是设备出了问题"},{"key":"SCENARIO_s20_32500100_03_0060","text":"看这情况\n开演可能会稍微推迟"},{"key":"SCENARIO_s20_32500100_03_0061","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0070","text":"原、原来是这样啊"},{"key":"SCENARIO_s20_32500100_03_0080","text":"…………\n能看到观众席吗？"},{"key":"SCENARIO_s20_32500100_03_0081","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0090","text":"啊……能！\n大家已经都点亮应援棒了……！"},{"key":"SCENARIO_s20_32500100_03_0091","text":"Motion"},{"key":"SCENARIO_s20_32500100_03_0100","text":"……嗯\n大家都在等着……好想快点上台啊"}]
