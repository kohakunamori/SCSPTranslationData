[{"key":"SCENARIO_s20_31300200_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31300200_04_0010","text":"风真舒服呢"},{"key":"SCENARIO_s20_31300200_04_0020","text":"是的……\n非常……舒服……"},{"key":"SCENARIO_s20_31300200_04_0030","text":"这个季节的天气，\n怎么就这么舒服呢……"},{"key":"SCENARIO_s20_31300200_04_0040","text":"…………"},{"key":"SCENARIO_s20_31300200_04_0050","text":"呵呵\n一不小心就待久了"},{"key":"SCENARIO_s20_31300200_04_0060","text":"明明我们是来帮忙的"},{"key":"SCENARIO_s20_31300200_04_0070","text":"他们说……\n希望我们好好享受牧场……"},{"key":"SCENARIO_s20_31300200_04_0080","text":"这样的时光……\n一定也……"},{"key":"SCENARIO_s20_31300200_04_0090","text":"……！\n确实，说得对……！"},{"key":"SCENARIO_s20_31300200_04_0100","text":"那，再陪我待一会儿？\n凛世"},{"key":"SCENARIO_s20_31300200_04_0101","text":"Motion"}]
