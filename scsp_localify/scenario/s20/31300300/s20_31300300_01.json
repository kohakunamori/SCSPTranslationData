[{"key":"SCENARIO_s20_31300300_01_0001","text":"Motion"},{"key":"SCENARIO_s20_31300300_01_0002","text":"Motion"},{"key":"SCENARIO_s20_31300300_01_0010","text":"辛苦了\n凛世也是被制作人叫来的？"},{"key":"SCENARIO_s20_31300300_01_0020","text":"是的……\n制作人……"},{"key":"SCENARIO_s20_31300300_01_0030","text":"他说马上就到了\n我们一起等吧"},{"key":"SCENARIO_s20_31300300_01_0031","text":"Motion"},{"key":"SCENARIO_s20_31300300_01_0035","text":"Motion"},{"key":"SCENARIO_s20_31300300_01_0040","text":"夏叶小姐……你那个是……？"},{"key":"SCENARIO_s20_31300300_01_0050","text":"呵呵，这个？\n这是之前练习接力赛那天的视频"},{"key":"SCENARIO_s20_31300300_01_0060","text":"很热闹吧"},{"key":"SCENARIO_s20_31300300_01_0070","text":"嗯……"},{"key":"SCENARIO_s20_31300300_01_0071","text":"Motion"},{"key":"SCENARIO_s20_31300300_01_0080","text":"下次练习……\n也拍下来吧……"},{"key":"SCENARIO_s20_31300300_01_0090","text":"！真不错呢\n感觉像是成长记录一样"},{"key":"SCENARIO_s20_31300300_01_0100","text":"是的……\n希望能像这样……随时回顾……"},{"key":"SCENARIO_s20_31300300_01_0101","text":"Motion"}]
