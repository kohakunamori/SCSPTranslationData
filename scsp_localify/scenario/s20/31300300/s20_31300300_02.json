[{"key":"SCENARIO_s20_31300300_02_0001","text":"Motion"},{"key":"SCENARIO_s20_31300300_02_0010","text":"１、２……１、２……！"},{"key":"SCENARIO_s20_31300300_02_0020","text":"呼……呼……\n做到了——……！"},{"key":"SCENARIO_s20_31300300_02_0030","text":"嗯，坚持到底了呢……！\n辛苦了……！"},{"key":"SCENARIO_s20_31300300_02_0031","text":"Motion"},{"key":"SCENARIO_s20_31300300_02_0040","text":"超级开心的\n秘密修行！"},{"key":"SCENARIO_s20_31300300_02_0050","text":"呵呵呵\n我也因为果穗的关系，非常开心哦"},{"key":"SCENARIO_s20_31300300_02_0060","text":"大概是因为叫“秘密修行”吧"},{"key":"SCENARIO_s20_31300300_02_0070","text":"那种偷偷摸摸的感觉让人好兴奋呢……！"},{"key":"SCENARIO_s20_31300300_02_0080","text":"嗯！\n突然变强了，还能展现出帅气的一面！"},{"key":"SCENARIO_s20_31300300_02_0090","text":"想让大家惊讶地说『什么时候……！』"},{"key":"SCENARIO_s20_31300300_02_0100","text":"那就继续秘密修行，\n让周围的对手们刮目相看吧！"}]
