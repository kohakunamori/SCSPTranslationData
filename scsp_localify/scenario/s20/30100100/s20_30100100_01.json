[{"key":"SCENARIO_s20_30100100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_30100100_01_0010","text":"哇……"},{"key":"SCENARIO_s20_30100100_01_0020","text":"……小鸟形状的饼干\n好可爱……"},{"key":"SCENARIO_s20_30100100_01_0025","text":"Motion"},{"key":"SCENARIO_s20_30100100_01_0030","text":"（难道……\n　是灯织酱亲手做的吗……）"},{"key":"SCENARIO_s20_30100100_01_0040","text":"……白色的鸟儿\n是小皮吧……"},{"key":"SCENARIO_s20_30100100_01_0050","text":"（…………巡酱给我的是……）"},{"key":"SCENARIO_s20_30100100_01_0055","text":"Motion"},{"key":"SCENARIO_s20_30100100_01_0060","text":"……润唇膏\n还附了卡片……"},{"key":"SCENARIO_s20_30100100_01_0070","text":"『因为很好吃所以也给真乃！』……"},{"key":"SCENARIO_s20_30100100_01_0080","text":"呵呵……草莓味……"},{"key":"SCENARIO_s20_30100100_01_0090","text":"（……道谢，得好好再说一次才行……）"},{"key":"SCENARIO_s20_30100100_01_0095","text":"Motion"},{"key":"SCENARIO_s20_30100100_01_0100","text":"那个……\n『谢谢你们的礼物，我刚打开了』……────"}]
