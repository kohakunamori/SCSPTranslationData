[{"key":"SCENARIO_s20_30100100_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30100100_04_0010","text":"圣……"},{"key":"SCENARIO_s20_30100100_04_0020","text":"……圣……？"},{"key":"SCENARIO_s20_30100100_04_0030","text":"圣诞节快到了呢……！"},{"key":"SCENARIO_s20_30100100_04_0040","text":"哇……\n嗯，是啊……"},{"key":"SCENARIO_s20_30100100_04_0050","text":"……灯织的父亲\n圣诞节能回来对吧……"},{"key":"SCENARIO_s20_30100100_04_0060","text":"嗯？啊……嗯\n他说确定没问题"},{"key":"SCENARIO_s20_30100100_04_0070","text":"……是吗……"},{"key":"SCENARIO_s20_30100100_04_0080","text":"嗯\n────不对，不是说这个……！"},{"key":"SCENARIO_s20_30100100_04_0090","text":"……？"},{"key":"SCENARIO_s20_30100100_04_0095","text":"Motion"},{"key":"SCENARIO_s20_30100100_04_0100","text":"真乃，如果要向圣诞老人许愿的话\n你会说要什么……！？"},{"key":"SCENARIO_s20_30100100_04_0105","text":"Motion"}]
