[{"key":"SCENARIO_s20_12400100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0002","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0010","text":"——抱歉让您等着了……！"},{"key":"SCENARIO_s20_12400100_02_0020","text":"走吧"},{"key":"SCENARIO_s20_12400100_02_0030","text":"好的"},{"key":"SCENARIO_s20_12400100_02_0040","text":"……呵呵"},{"key":"SCENARIO_s20_12400100_02_0041","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0050","text":"追上了"},{"key":"SCENARIO_s20_12400100_02_0051","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0052","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0060","text":"为了不让您这样等我，\n我得拼命努力才行……"},{"key":"SCENARIO_s20_12400100_02_0070","text":"……或许，没办法追上吧"},{"key":"SCENARIO_s20_12400100_02_0080","text":"……诶？"},{"key":"SCENARIO_s20_12400100_02_0081","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0090","text":"啊，没什么！\n只是有点喘不过气来"},{"key":"SCENARIO_s20_12400100_02_0091","text":"Motion"},{"key":"SCENARIO_s20_12400100_02_0100","text":"————呼……！\n到10楼了……！"}]
