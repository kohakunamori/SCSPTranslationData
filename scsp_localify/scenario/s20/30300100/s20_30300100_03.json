[{"key":"SCENARIO_s20_30300100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_30300100_03_0010","text":"…………"},{"key":"SCENARIO_s20_30300100_03_0020","text":"…………"},{"key":"SCENARIO_s20_30300100_03_0030","text":"…………"},{"key":"SCENARIO_s20_30300100_03_0031","text":"Motion"},{"key":"SCENARIO_s20_30300100_03_0040","text":"……困了吗？"},{"key":"SCENARIO_s20_30300100_03_0050","text":"嘿嘿，嗯……\n今天比平时早呢……"},{"key":"SCENARIO_s20_30300100_03_0060","text":"……但是，待会儿还要打扑克──"},{"key":"SCENARIO_s20_30300100_03_0070","text":"我觉得……早点起来再玩也不错呢……"},{"key":"SCENARIO_s20_30300100_03_0080","text":"嗯"},{"key":"SCENARIO_s20_30300100_03_0090","text":"赢了犯困的人也没意思嘛"},{"key":"SCENARIO_s20_30300100_03_0091","text":"Motion"},{"key":"SCENARIO_s20_30300100_03_0100","text":"……呵呵\n灯织，好有自信呢——"}]
