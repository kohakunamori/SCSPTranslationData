[{"key":"SCENARIO_s20_30300100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_30300100_01_0010","text":"泡芙！"},{"key":"SCENARIO_s20_30300100_01_0011","text":"Motion"},{"key":"SCENARIO_s20_30300100_01_0020","text":"呵呵……呢\n我提议吃华夫饼……呢"},{"key":"SCENARIO_s20_30300100_01_0030","text":"好的！"},{"key":"SCENARIO_s20_30300100_01_0031","text":"Motion"},{"key":"SCENARIO_s20_30300100_01_0040","text":"啊，快看！\n豆沙包看起来也很好吃！"},{"key":"SCENARIO_s20_30300100_01_0050","text":"呼哇……"},{"key":"SCENARIO_s20_30300100_01_0060","text":"我买了当早餐的红豆面包——\n可以另算吧！？　红豆类的……！"},{"key":"SCENARIO_s20_30300100_01_0070","text":"嗯、嗯……"},{"key":"SCENARIO_s20_30300100_01_0071","text":"Motion"},{"key":"SCENARIO_s20_30300100_01_0080","text":"────抱歉，等一下"},{"key":"SCENARIO_s20_30300100_01_0081","text":"Motion"},{"key":"SCENARIO_s20_30300100_01_0090","text":"……说真的，再多吃就吃不下了"},{"key":"SCENARIO_s20_30300100_01_0100","text":"……！\n────……"}]
