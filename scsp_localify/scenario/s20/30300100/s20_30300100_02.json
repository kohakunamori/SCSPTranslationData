[{"key":"SCENARIO_s20_30300100_02_0000","text":"Motion"},{"key":"SCENARIO_s20_30300100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_30300100_02_0010","text":"樱花的香气——……"},{"key":"SCENARIO_s20_30300100_02_0020","text":"不错呢\n我也换那个洗发水好了"},{"key":"SCENARIO_s20_30300100_02_0030","text":"嗯……"},{"key":"SCENARIO_s20_30300100_02_0031","text":"Motion"},{"key":"SCENARIO_s20_30300100_02_0040","text":"……\n我也买一样的可以吗……？"},{"key":"SCENARIO_s20_30300100_02_0041","text":"Motion"},{"key":"SCENARIO_s20_30300100_02_0050","text":"啊，嘿嘿……！\n我也想跟你们用一样的！——结果"},{"key":"SCENARIO_s20_30300100_02_0060","text":"呵呵"},{"key":"SCENARIO_s20_30300100_02_0070","text":"那就，这个也买三个了呢……呢"},{"key":"SCENARIO_s20_30300100_02_0080","text":"是啊。小瓶的虽然便宜……\n但买多了也用不完，各自买小瓶装吧"},{"key":"SCENARIO_s20_30300100_02_0090","text":"巡，护发素也买一样的可以吗……？"},{"key":"SCENARIO_s20_30300100_02_0100","text":"──……！　嗯！"}]
