[{"key":"SCENARIO_s20_21200100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_21200100_03_0010","text":"早上好！"},{"key":"SCENARIO_s20_21200100_03_0020","text":"『果穗小姐』"},{"key":"SCENARIO_s20_21200100_03_0030","text":"辛苦了！"},{"key":"SCENARIO_s20_21200100_03_0040","text":"『智代子小姐』"},{"key":"SCENARIO_s20_21200100_03_0050","text":"辛苦啦！"},{"key":"SCENARIO_s20_21200100_03_0060","text":"『树里小姐』"},{"key":"SCENARIO_s20_21200100_03_0002","text":"Motion"},{"key":"SCENARIO_s20_21200100_03_0003","text":"Motion"},{"key":"SCENARIO_s20_21200100_03_0070","text":"哎呀，大家都来得挺早呢"},{"key":"SCENARIO_s20_21200100_03_0080","text":"“夏叶”"},{"key":"SCENARIO_s20_21200100_03_0004","text":"Motion"},{"key":"SCENARIO_s20_21200100_03_0005","text":"Motion"},{"key":"SCENARIO_s20_21200100_03_0090","text":"『诸位到来，\n　凛世的一日由此开始』"},{"key":"SCENARIO_s20_21200100_03_0100","text":"『愿父亲大人、母亲大人，诸位的一日\n　亦温暖而愉快。谨此』"}]
