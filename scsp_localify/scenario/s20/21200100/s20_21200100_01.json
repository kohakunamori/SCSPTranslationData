[{"key":"SCENARIO_s20_21200100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_21200100_01_0010","text":"『敬启』"},{"key":"SCENARIO_s20_21200100_01_0020","text":"『别来无恙否』"},{"key":"SCENARIO_s20_21200100_01_0030","text":"『凛世一切安好』"},{"key":"SCENARIO_s20_21200100_01_0040","text":"────……"},{"key":"SCENARIO_s20_21200100_01_0050","text":"────真是……好天气……"},{"key":"SCENARIO_s20_21200100_01_0002","text":"Motion"},{"key":"SCENARIO_s20_21200100_01_0060","text":"这封信……"},{"key":"SCENARIO_s20_21200100_01_0070","text":"希望……不要被淋湿……\n平安送达……"},{"key":"SCENARIO_s20_21200100_01_0003","text":"Motion"},{"key":"SCENARIO_s20_21200100_01_0080","text":"凛世小姐？"},{"key":"SCENARIO_s20_21200100_01_0090","text":"好的……！"},{"key":"SCENARIO_s20_21200100_01_0100","text":"呵呵……\n要出发了……"}]
