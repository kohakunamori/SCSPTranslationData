[{"key":"SCENARIO_s20_21200100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_21200100_02_0010","text":"好，走咯"},{"key":"SCENARIO_s20_21200100_02_0020","text":"啊，凛世酱\n还能再靠近一点！"},{"key":"SCENARIO_s20_21200100_02_0030","text":"好的……\n谢谢你……"},{"key":"SCENARIO_s20_21200100_02_0040","text":"我也可以……再贴紧一点吗！"},{"key":"SCENARIO_s20_21200100_02_0050","text":"好的……\n呵呵……"},{"key":"SCENARIO_s20_21200100_02_0060","text":"要好好地在正中间笑着哦"},{"key":"SCENARIO_s20_21200100_02_0070","text":"哦——\n得把凛世精神满满的事，告诉家里才行！"},{"key":"SCENARIO_s20_21200100_02_0080","text":"老家的亲人们……\n会高兴的……"},{"key":"SCENARIO_s20_21200100_02_0090","text":"那么，就这样笑一个──！"},{"key":"SCENARIO_s20_21200100_02_0100","text":"笑一个……！"}]
