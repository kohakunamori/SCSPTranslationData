[{"key":"SCENARIO_s20_20900100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_20900100_01_0010","text":"哎呀，果穗\n你在看什么呢？"},{"key":"SCENARIO_s20_20900100_01_0011","text":"Motion"},{"key":"SCENARIO_s20_20900100_01_0020","text":"这是之前拍的照片！"},{"key":"SCENARIO_s20_20900100_01_0030","text":"是和夏叶小姐还有卡特蕾亚、豆丸\n一起去狗狗乐园时拍的！"},{"key":"SCENARIO_s20_20900100_01_0040","text":"夏叶小姐也看看吗？"},{"key":"SCENARIO_s20_20900100_01_0050","text":"真的可以吗？"},{"key":"SCENARIO_s20_20900100_01_0060","text":"给！\n请用……"},{"key":"SCENARIO_s20_20900100_01_0070","text":"谢谢，那我就不客气了"},{"key":"SCENARIO_s20_20900100_01_0071","text":"Motion"},{"key":"SCENARIO_s20_20900100_01_0080","text":"…………呵呵，拍了好多呢"},{"key":"SCENARIO_s20_20900100_01_0090","text":"诶嘿嘿，是的！"},{"key":"SCENARIO_s20_20900100_01_0100","text":"因为卡特蕾亚和豆丸\n玩得超～开心的！"}]
