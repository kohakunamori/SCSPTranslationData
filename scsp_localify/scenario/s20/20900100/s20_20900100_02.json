[{"key":"SCENARIO_s20_20900100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_20900100_02_0010","text":"夏叶小────啊"},{"key":"SCENARIO_s20_20900100_02_0020","text":"嘘——……"},{"key":"SCENARIO_s20_20900100_02_0030","text":"卡特蕾亚和豆丸，睡着了吗……？"},{"key":"SCENARIO_s20_20900100_02_0040","text":"嗯\n好像是玩累了"},{"key":"SCENARIO_s20_20900100_02_0050","text":"刚才闹得挺厉害的"},{"key":"SCENARIO_s20_20900100_02_0060","text":"我们也跑了好多呢……"},{"key":"SCENARIO_s20_20900100_02_0061","text":"Motion"},{"key":"SCENARIO_s20_20900100_02_0070","text":"呵呵，是啊\n果穗你不累吗？"},{"key":"SCENARIO_s20_20900100_02_0080","text":"我精神得很呢！\n不过，活动多了也得好好休息才行呢……！"},{"key":"SCENARIO_s20_20900100_02_0090","text":"嗯，休息很重要\n我们也歇一会儿吧"},{"key":"SCENARIO_s20_20900100_02_0100","text":"好的"}]
