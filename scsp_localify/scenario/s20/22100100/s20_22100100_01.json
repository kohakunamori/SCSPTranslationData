[{"key":"SCENARIO_s20_22100100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_22100100_01_0010","text":"『工作，结束了』"},{"key":"SCENARIO_s20_22100100_01_0020","text":"“你辛苦啦！”"},{"key":"SCENARIO_s20_22100100_01_0030","text":"『可以直接回去吗』"},{"key":"SCENARIO_s20_22100100_01_0040","text":"『啊，也没有要去事务所的事吧』"},{"key":"SCENARIO_s20_22100100_01_0050","text":"『我没什么事』"},{"key":"SCENARIO_s20_22100100_01_0051","text":"Motion"},{"key":"SCENARIO_s20_22100100_01_0060","text":"……雏菜呢？\n有事去事务所吗？"},{"key":"SCENARIO_s20_22100100_01_0070","text":"没有～！"},{"key":"SCENARIO_s20_22100100_01_0080","text":"『雏菜也说没有』"},{"key":"SCENARIO_s20_22100100_01_0090","text":"『那就没问题了！』"},{"key":"SCENARIO_s20_22100100_01_0100","text":"『天快黑了，路上小心』"}]
