[{"key":"SCENARIO_s20_22100100_02_0002","text":"Motion"},{"key":"SCENARIO_s20_22100100_02_0010","text":"『糟了，被拉进一个Chain群组了』"},{"key":"SCENARIO_s20_22100100_02_0020","text":"『全是陌生人』"},{"key":"SCENARIO_s20_22100100_02_0030","text":"『不是你自己给的吗？』"},{"key":"SCENARIO_s20_22100100_02_0040","text":"『给化妆师了』"},{"key":"SCENARIO_s20_22100100_02_0050","text":"『但没听说要拉我进群』"},{"key":"SCENARIO_s20_22100100_02_0060","text":"『这样啊』"},{"key":"SCENARIO_s20_22100100_02_0070","text":"『你那边也收到了？』"},{"key":"SCENARIO_s20_22100100_02_0080","text":"『雏菜没给过！』"},{"key":"SCENARIO_s20_22100100_02_0090","text":"「啊——」"},{"key":"SCENARIO_s20_22100100_02_0100","text":"“嗯”"}]
