[{"key":"SCENARIO_s20_32200100_02_0010","text":"那、那\n我们做点什么呢"},{"key":"SCENARIO_s20_32200100_02_0020","text":"在Producer先生来之前"},{"key":"SCENARIO_s20_32200100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32200100_02_0030","text":"啊……\n要做作业……吗？"},{"key":"SCENARIO_s20_32200100_02_0040","text":"嘿～？\n雏菜，没留作业～"},{"key":"SCENARIO_s20_32200100_02_0050","text":"啊—\n嗯"},{"key":"SCENARIO_s20_32200100_02_0060","text":"我也是"},{"key":"SCENARIO_s20_32200100_02_0070","text":"……小糸呢？\n有作业吗"},{"key":"SCENARIO_s20_32200100_02_0080","text":"啊……那个\n作业已经做完了"},{"key":"SCENARIO_s20_32200100_02_0090","text":"不、不过如果大家要学习的话\n我想着要不要预习一下……"},{"key":"SCENARIO_s20_32200100_02_0100","text":"……哼"}]
