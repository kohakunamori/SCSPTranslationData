[{"key":"SCENARIO_s20_31900200_02_0000","text":"Motion"},{"key":"SCENARIO_s20_31900200_02_0010","text":"……唔\n好冷～"},{"key":"SCENARIO_s20_31900200_02_0020","text":"没、没事吧！？"},{"key":"SCENARIO_s20_31900200_02_0030","text":"手好痛的说……"},{"key":"SCENARIO_s20_31900200_02_0040","text":"手套～……\n啊～，今天没带……！"},{"key":"SCENARIO_s20_31900200_02_0045","text":"Motion"},{"key":"SCENARIO_s20_31900200_02_0050","text":"……对了！\n朝日，握住我的手！"},{"key":"SCENARIO_s20_31900200_02_0060","text":"？\n好～"},{"key":"SCENARIO_s20_31900200_02_0070","text":"哦……\n爱依的手，好暖和啊"},{"key":"SCENARIO_s20_31900200_02_0080","text":"对吧！\n在缓过来之前握着也没关系哦～"},{"key":"SCENARIO_s20_31900200_02_0090","text":"呼～……"},{"key":"SCENARIO_s20_31900200_02_0100","text":"……呵呵"}]
