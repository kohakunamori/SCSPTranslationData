[{"key":"SCENARIO_s20_31900200_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31900200_04_0010","text":"…………\n啊！"},{"key":"SCENARIO_s20_31900200_04_0020","text":"下起来了下起来了～"},{"key":"SCENARIO_s20_31900200_04_0030","text":"啊，说起来\n天气预报说过会下"},{"key":"SCENARIO_s20_31900200_04_0040","text":"这个，会积起来吗～"},{"key":"SCENARIO_s20_31900200_04_0050","text":"哈哈\n听你这口气挺希望积起来的"},{"key":"SCENARIO_s20_31900200_04_0060","text":"那当然啦～\n想堆雪人、打雪仗嘛～"},{"key":"SCENARIO_s20_31900200_04_0070","text":"Producer是不是不太想啊？"},{"key":"SCENARIO_s20_31900200_04_0080","text":"我倒是想坦率地高兴一下\n但积太多的话开车出门就麻烦了"},{"key":"SCENARIO_s20_31900200_04_0090","text":"啊～，确实……！"},{"key":"SCENARIO_s20_31900200_04_0100","text":"！　那这样！　我来帮你铲雪！\n这样Producer也能超开心了吧！"}]
