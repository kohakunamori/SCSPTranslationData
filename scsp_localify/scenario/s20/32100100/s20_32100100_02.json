[{"key":"SCENARIO_s20_32100100_02_0001","text":"Motion"},{"key":"SCENARIO_s20_32100100_02_0010","text":"呼……呼……\n────………………"},{"key":"SCENARIO_s20_32100100_02_0020","text":"──……\n啊……好烫……"},{"key":"SCENARIO_s20_32100100_02_0030","text":"真的好烫啊……！\n也许该像雏菜那样吹一吹再吃……！"},{"key":"SCENARIO_s20_32100100_02_0040","text":"……不过嘛\n反正很快就会凉下来的"},{"key":"SCENARIO_s20_32100100_02_0050","text":"嗯"},{"key":"SCENARIO_s20_32100100_02_0060","text":"──……\n啊……好烫……"},{"key":"SCENARIO_s20_32100100_02_0070","text":"没，没问题吗……？"},{"key":"SCENARIO_s20_32100100_02_0080","text":"参拜怎么办～？"},{"key":"SCENARIO_s20_32100100_02_0090","text":"现在先等等\n等人少一点再去不就好了？"},{"key":"SCENARIO_s20_32100100_02_0100","text":"会、会变少吗……\n（注：新年参拜人潮通常不会很快散去）"}]
