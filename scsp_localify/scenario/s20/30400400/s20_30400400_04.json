[{"key":"SCENARIO_s20_30400400_04_0000","text":"Motion"},{"key":"SCENARIO_s20_30400400_04_0010","text":"～～♪"},{"key":"SCENARIO_s20_30400400_04_0020","text":"哦……！\n看起来好热闹啊"},{"key":"SCENARIO_s20_30400400_04_0030","text":"啊，欢迎回来～，制作人"},{"key":"SCENARIO_s20_30400400_04_0040","text":"嗯，我回来了\n恋钟，你们在看什么？"},{"key":"SCENARIO_s20_30400400_04_0050","text":"看这个～！"},{"key":"SCENARIO_s20_30400400_04_0060","text":"──旅行杂志吗……\n看起来挺有意思的！"},{"key":"SCENARIO_s20_30400400_04_0070","text":"对吧！制作人有什么\n想去的地方吗？"},{"key":"SCENARIO_s20_30400400_04_0080","text":"让我想想，想去的地方吗……\n哈哈，一时半会儿想不出来啊"},{"key":"SCENARIO_s20_30400400_04_0090","text":"那不如一起看吧！"},{"key":"SCENARIO_s20_30400400_04_0100","text":"会有一种去旅行了的感觉\n很有趣的～！"}]
