[{"key":"SCENARIO_s20_30400400_03_0000","text":"Motion"},{"key":"SCENARIO_s20_30400400_03_0001","text":"摄影师"},{"key":"SCENARIO_s20_30400400_03_0010","text":"L'Antica的各位，准备好了吗？"},{"key":"SCENARIO_s20_30400400_03_0020","text":"好的！／好～／好的／好的／好的……"},{"key":"SCENARIO_s20_30400400_03_0021","text":"摄影师"},{"key":"SCENARIO_s20_30400400_03_0030","text":"谢谢\n那么我们就开始了──"},{"key":"SCENARIO_s20_30400400_03_0040","text":"哎呀，吃得好饱啊～"},{"key":"SCENARIO_s20_30400400_03_0050","text":"嗯～\n全都是好吃的东西呢！"},{"key":"SCENARIO_s20_30400400_03_0060","text":"没想到连料理都能吃到\n真是没想到"},{"key":"SCENARIO_s20_30400400_03_0070","text":"嗯……吃得好撑……"},{"key":"SCENARIO_s20_30400400_03_0080","text":"有些味道感觉会残留很久的东西\n也毫不留情地吃掉了呢"},{"key":"SCENARIO_s20_30400400_03_0090","text":"我有口香糖\n大家要吗？"},{"key":"SCENARIO_s20_30400400_03_0100","text":"给我！／给我～／谢谢小樱／嗯……"}]
