[{"key":"SCENARIO_s20_31700100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_31700100_03_0001","text":"Motion"},{"key":"SCENARIO_s20_31700100_03_0009","text":"摄影师"},{"key":"SCENARIO_s20_31700100_03_0010","text":"不错嘛——\n冬优酱！表情做得真好呀"},{"key":"SCENARIO_s20_31700100_03_0020","text":"…………"},{"key":"SCENARIO_s20_31700100_03_0030","text":"……？"},{"key":"SCENARIO_s20_31700100_03_0035","text":"Motion"},{"key":"SCENARIO_s20_31700100_03_0040","text":"呐呐冬优子酱\n怎么样才能把表情做好啊！"},{"key":"SCENARIO_s20_31700100_03_0050","text":"怎么样……\n你有耐心听完吗？会很长的哦"},{"key":"SCENARIO_s20_31700100_03_0060","text":"诶，我要短的！"},{"key":"SCENARIO_s20_31700100_03_0070","text":"……那你要是被人问“为什么跳舞那么厉害？”，\n你能一句话回答出来吗？"},{"key":"SCENARIO_s20_31700100_03_0080","text":"…………\n不知道呢"},{"key":"SCENARIO_s20_31700100_03_0090","text":"──话说回来，我\n跳舞很厉害吗？"},{"key":"SCENARIO_s20_31700100_03_0100","text":"啊真是的…………"}]
