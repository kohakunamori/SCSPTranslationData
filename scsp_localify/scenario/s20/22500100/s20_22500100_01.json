[{"key":"SCENARIO_s20_22500100_01_0001","text":"Motion"},{"key":"SCENARIO_s20_22500100_01_0010","text":"好热啊……"},{"key":"SCENARIO_s20_22500100_01_0020","text":"为什么拍组合照\n会来这种地方啊……"},{"key":"SCENARIO_s20_22500100_01_0030","text":"而且偏偏挑这么好的天气\n在室外拍……"},{"key":"SCENARIO_s20_22500100_01_0040","text":"……是啊\n阳光好像还会更强"},{"key":"SCENARIO_s20_22500100_01_0041","text":"Motion"},{"key":"SCENARIO_s20_22500100_01_0050","text":"……！\n美琴小姐……！"},{"key":"SCENARIO_s20_22500100_01_0060","text":"制作人说去买点喝的"},{"key":"SCENARIO_s20_22500100_01_0070","text":"好像拍摄也还没开始\n让我们在阴凉处等他"},{"key":"SCENARIO_s20_22500100_01_0080","text":"是、是吗……！"},{"key":"SCENARIO_s20_22500100_01_0090","text":"谢谢您\n不好意思，还特意来告诉我们……"},{"key":"SCENARIO_s20_22500100_01_0100","text":"不会……走吧\n那边好像更凉快"}]
