[{"key":"SCENARIO_s20_22300100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_22300100_03_0010","text":"呐，透前辈开心～？"},{"key":"SCENARIO_s20_22300100_03_0020","text":"诶？"},{"key":"SCENARIO_s20_22300100_03_0030","text":"圆香前辈呢～？"},{"key":"SCENARIO_s20_22300100_03_0040","text":"嗯……"},{"key":"SCENARIO_s20_22300100_03_0050","text":"小糸酱呢～？\n开心～？"},{"key":"SCENARIO_s20_22300100_03_0060","text":"呜……！\n开、开心……！"},{"key":"SCENARIO_s20_22300100_03_0070","text":"非常……！"},{"key":"SCENARIO_s20_22300100_03_0080","text":"是吗～\n那大家也都开心～？"},{"key":"SCENARIO_s20_22300100_03_0090","text":"啊哈～\n这样啊"},{"key":"SCENARIO_s20_22300100_03_0100","text":"太好了呢～！"}]
