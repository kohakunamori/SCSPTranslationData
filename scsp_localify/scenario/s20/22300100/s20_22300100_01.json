[{"key":"SCENARIO_s20_22300100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_22300100_01_0010","text":"嗯～……"},{"key":"SCENARIO_s20_22300100_01_0020","text":"啊哈～\n这个好好喝～"},{"key":"SCENARIO_s20_22300100_01_0030","text":"Good"},{"key":"SCENARIO_s20_22300100_01_0040","text":"两、两位\n不用做准备吗……？"},{"key":"SCENARIO_s20_22300100_01_0050","text":"诶～？"},{"key":"SCENARIO_s20_22300100_01_0060","text":"在做啊～？"},{"key":"SCENARIO_s20_22300100_01_0070","text":"为了不在舞台上肚子叫\n现在好好吃东西就是在做准备！"},{"key":"SCENARIO_s20_22300100_01_0080","text":"是、是这样吗……？"},{"key":"SCENARIO_s20_22300100_01_0090","text":"嗯～\n小糸酱要是肚子叫了怎么办～？"},{"key":"SCENARIO_s20_22300100_01_0100","text":"咿、咿诶……"}]
