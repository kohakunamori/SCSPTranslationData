[{"key":"SCENARIO_s20_32300400_04_0000","text":"Motion"},{"key":"SCENARIO_s20_32300400_04_0009","text":"体育会系男性"},{"key":"SCENARIO_s20_32300400_04_0010","text":"加油干～！\n好，一二、三四！"},{"key":"SCENARIO_s20_32300400_04_0019","text":"体育会系男性"},{"key":"SCENARIO_s20_32300400_04_0020","text":"一二、三四！"},{"key":"SCENARIO_s20_32300400_04_0030","text":"……"},{"key":"SCENARIO_s20_32300400_04_0031","text":"Motion"},{"key":"SCENARIO_s20_32300400_04_0040","text":"莫非，圆香前辈也想加入～？"},{"key":"SCENARIO_s20_32300400_04_0050","text":"……只是看着而已"},{"key":"SCENARIO_s20_32300400_04_0060","text":"在沙滩上跑步，果然能锻炼身体吧～"},{"key":"SCENARIO_s20_32300400_04_0070","text":"应该是吧"},{"key":"SCENARIO_s20_32300400_04_0080","text":"想知道能锻炼多少的话，\n试试看不就好了～？"},{"key":"SCENARIO_s20_32300400_04_0090","text":"……您一个人请便"},{"key":"SCENARIO_s20_32300400_04_0100","text":"啊哈～\n雏菜没问题～！"}]
