[{"key":"SCENARIO_s20_32000500_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32000500_01_0010","text":"…………"},{"key":"SCENARIO_s20_32000500_01_0011","text":"Motion"},{"key":"SCENARIO_s20_32000500_01_0020","text":"你从哪里来的？\n你这家伙"},{"key":"SCENARIO_s20_32000500_01_0030","text":"从哪里来，又要去哪里？"},{"key":"SCENARIO_s20_32000500_01_0040","text":"要睡觉了啊\n那是在梦里吧"},{"key":"SCENARIO_s20_32000500_01_0050","text":"啊……透酱……！\n你在做什────"},{"key":"SCENARIO_s20_32000500_01_0060","text":"呀……！\n猫、猫……！？　原来在啊……"},{"key":"SCENARIO_s20_32000500_01_0070","text":"哦——\n欢迎回来"},{"key":"SCENARIO_s20_32000500_01_0080","text":"？\n它、它不是逃走了吗，为什么说欢迎回来？"},{"key":"SCENARIO_s20_32000500_01_0090","text":"嗯\n因为它回来了"},{"key":"SCENARIO_s20_32000500_01_0100","text":"那家伙\n跑到哪里去了呢"}]
