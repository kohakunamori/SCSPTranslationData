[{"key":"SCENARIO_s20_20500100_03_0000","text":"Motion"},{"key":"SCENARIO_s20_20500100_03_0010","text":"…………"},{"key":"SCENARIO_s20_20500100_03_0011","text":"Motion"},{"key":"SCENARIO_s20_20500100_03_0020","text":"啊……"},{"key":"SCENARIO_s20_20500100_03_0030","text":"诶，那个……\n…………"},{"key":"SCENARIO_s20_20500100_03_0040","text":"…………呵呵"},{"key":"SCENARIO_s20_20500100_03_0050","text":"啊……"},{"key":"SCENARIO_s20_20500100_03_0060","text":"摩美美酱……\n原来醒着啊……"},{"key":"SCENARIO_s20_20500100_03_0070","text":"嗯——，抱歉\n我在想雾子该怎么办呢"},{"key":"SCENARIO_s20_20500100_03_0080","text":"呵呵……\n嗯……"},{"key":"SCENARIO_s20_20500100_03_0090","text":"我也是……\n在想该怎么办呢……"},{"key":"SCENARIO_s20_20500100_03_0100","text":"呵呵——\n那就去训练吧"}]
