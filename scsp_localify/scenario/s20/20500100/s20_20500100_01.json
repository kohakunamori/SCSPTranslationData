[{"key":"SCENARIO_s20_20500100_01_0000","text":"Motion"},{"key":"SCENARIO_s20_20500100_01_0010","text":"…………"},{"key":"SCENARIO_s20_20500100_01_0020","text":"（……嗯……\n　好困…………）"},{"key":"SCENARIO_s20_20500100_01_0030","text":"（……到练习时间之前────）"},{"key":"SCENARIO_s20_20500100_01_0040","text":"（……嘛，还能再睡五分钟吧——……）"},{"key":"SCENARIO_s20_20500100_01_0050","text":"…………"},{"key":"SCENARIO_s20_20500100_01_0060","text":"（果然，还是再睡十分钟────……）"},{"key":"SCENARIO_s20_20500100_01_0070","text":"…………"},{"key":"SCENARIO_s20_20500100_01_0080","text":"『摩美美～～～～～～～～』"},{"key":"SCENARIO_s20_20500100_01_0090","text":"『你在哪儿啊～～？？？？？？』"},{"key":"SCENARIO_s20_20500100_01_0100","text":"『小摩美！！\n　练习要先开始咯！？』"},{"key":"SCENARIO_s20_20500100_01_0101","text":"Motion"}]
