[{"key":"SCENARIO_s20_32100400_02_0000","text":"Motion"},{"key":"SCENARIO_s20_32100400_02_0010","text":"短剧《巧克力》"},{"key":"SCENARIO_s20_32100400_02_0020","text":"巧克力试吃中～\n怎么样～？"},{"key":"SCENARIO_s20_32100400_02_0030","text":"……那，来一个"},{"key":"SCENARIO_s20_32100400_02_0040","text":"好的，请用～"},{"key":"SCENARIO_s20_32100400_02_0050","text":"啊——嗯！\n嗯～，好好吃～！"},{"key":"SCENARIO_s20_32100400_02_0060","text":"等等\n试吃一般不是客人吃的吗"},{"key":"SCENARIO_s20_32100400_02_0070","text":"你想吃吗～？\n那，啊——？"},{"key":"SCENARIO_s20_32100400_02_0080","text":"…………\n…………啊——嗯…………"},{"key":"SCENARIO_s20_32100400_02_0090","text":"────嗯！\n嗯～，好好吃～！"},{"key":"SCENARIO_s20_32100400_02_0100","text":"喂！"}]
