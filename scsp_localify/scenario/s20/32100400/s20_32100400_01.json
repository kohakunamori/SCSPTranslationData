[{"key":"SCENARIO_s20_32100400_01_0000","text":"Motion"},{"key":"SCENARIO_s20_32100400_01_0010","text":"漫才《情人节》"},{"key":"SCENARIO_s20_32100400_01_0020","text":"耶——／大家好～"},{"key":"SCENARIO_s20_32100400_01_0030","text":"收到了吗？\n情人节"},{"key":"SCENARIO_s20_32100400_01_0040","text":"嗯，还算有吧\n浅仓呢"},{"key":"SCENARIO_s20_32100400_01_0050","text":"收到了\n在车站前"},{"key":"SCENARIO_s20_32100400_01_0060","text":"纸巾"},{"key":"SCENARIO_s20_32100400_01_0070","text":"那又不是情人节吧"},{"key":"SCENARIO_s20_32100400_01_0080","text":"背面写着“我喜欢你，请跟我交往”"},{"key":"SCENARIO_s20_32100400_01_0090","text":"你就不能好好告白吗\n算了算了"},{"key":"SCENARIO_s20_32100400_01_0100","text":"谢谢大家～"}]
