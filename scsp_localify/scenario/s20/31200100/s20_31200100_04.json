[{"key":"SCENARIO_s20_31200100_04_0000","text":"Motion"},{"key":"SCENARIO_s20_31200100_04_0001","text":"Motion"},{"key":"SCENARIO_s20_31200100_04_0010","text":"万圣节派对，真开心呢"},{"key":"SCENARIO_s20_31200100_04_0004","text":"Motion"},{"key":"SCENARIO_s20_31200100_04_0020","text":"是啊\n虽然可能算不上多专业……"},{"key":"SCENARIO_s20_31200100_04_0030","text":"是吗？\n不是也扮装了吗"},{"key":"SCENARIO_s20_31200100_04_0040","text":"大家都超——级合适的！"},{"key":"SCENARIO_s20_31200100_04_0050","text":"呵呵……不过，\n凛世的黑猫有点犯规了呢"},{"key":"SCENARIO_s20_31200100_04_0060","text":"……？"},{"key":"SCENARIO_s20_31200100_04_0070","text":"啊\n凛世的黑猫确实犯规"},{"key":"SCENARIO_s20_31200100_04_0080","text":"那、那是……\n不是凛世……选的……"},{"key":"SCENARIO_s20_31200100_04_0090","text":"凛世酱，没事的！\n大家都是在夸你！"},{"key":"SCENARIO_s20_31200100_04_0100","text":"是的！\n凛世小姐的小猫咪超——级可爱的！"},{"key":"SCENARIO_s20_31200100_04_0002","text":"Motion"},{"key":"SCENARIO_s20_31200100_04_0003","text":"Motion"}]
