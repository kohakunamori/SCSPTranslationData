[{"key":"SCENARIO_s20_30900200_03_0001","text":"Motion"},{"key":"SCENARIO_s20_30900200_03_0010","text":"…………"},{"key":"SCENARIO_s20_30900200_03_0020","text":"…………"},{"key":"SCENARIO_s20_30900200_03_0030","text":"烤好了哦——！"},{"key":"SCENARIO_s20_30900200_03_0040","text":"哇，看起来不错！"},{"key":"SCENARIO_s20_30900200_03_0050","text":"巧克力……\n让各位久等了……"},{"key":"SCENARIO_s20_30900200_03_0060","text":"谢谢！／谢谢！／谢啦／\n谢谢！"},{"key":"SCENARIO_s20_30900200_03_0061","text":"Motion"},{"key":"SCENARIO_s20_30900200_03_0070","text":"…………"},{"key":"SCENARIO_s20_30900200_03_0080","text":"（大家一起做饭\n　平时只有拍摄的时候才能这样）"},{"key":"SCENARIO_s20_30900200_03_0090","text":"（超级开心的！）"},{"key":"SCENARIO_s20_30900200_03_0100","text":"（就算不是拍摄\n　要是在事务所也能这样就好了）"}]
