[{"key":"SCENARIO_s03_04020000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_04020000_00_0010","text":"甘奈想做～\n这个～"},{"key":"SCENARIO_s03_04020000_00_0020","text":"嗯！\n甜花酱应该会喜欢"},{"key":"SCENARIO_s03_04020000_00_0030","text":"嘿嘿，那就这么定了！\n接下来……制作人觉得哪个好？"},{"key":"SCENARIO_s03_04020000_00_0040","text":"甜花会喜欢的点心吗……"},{"key":"SCENARIO_s03_04020000_00_0005","text":"还是\n布丁吧"},{"key":"SCENARIO_s03_04020000_00_0006","text":"整个蛋糕\n就选这个吧"},{"key":"SCENARIO_s03_04020000_00_0007","text":"咖啡果冻"},{"key":"SCENARIO_s03_04020000_01_0001","text":"Motion"},{"key":"SCENARIO_s03_04020000_01_0010","text":"绝对不能少呢！"},{"key":"SCENARIO_s03_04020000_01_0020","text":"那布丁我就多做一点吧"},{"key":"SCENARIO_s03_04020000_02_0001","text":"Motion"},{"key":"SCENARIO_s03_04020000_02_0010","text":"大家一起分着吃也很棒呢"},{"key":"SCENARIO_s03_04020000_02_0020","text":"制作人的那份\n我也会留好的！"},{"key":"SCENARIO_s03_04020000_03_0001","text":"Motion"},{"key":"SCENARIO_s03_04020000_03_0010","text":"制作人……\n你刚才说的是自己想吃的吧～"},{"key":"SCENARIO_s03_04020000_03_0020","text":"嘿嘿，下次我会做来给你吃的～"}]
