[{"key":"SCENARIO_s03_06030000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06030000_00_0010","text":"有人带手机充电线吗？"},{"key":"SCENARIO_s03_06030000_00_0020","text":"诶？　啊——……"},{"key":"SCENARIO_s03_06030000_00_0030","text":"没带～"},{"key":"SCENARIO_s03_06030000_00_0040","text":"啊……\n事务所的能借用一下吗……！"},{"key":"SCENARIO_s03_06030000_00_0003","text":"我的借你吧"},{"key":"SCENARIO_s03_06030000_00_0004","text":"啊，我有"},{"key":"SCENARIO_s03_06030000_00_0005","text":"我去买一根来！"},{"key":"SCENARIO_s03_06030000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06030000_01_0010","text":"…………"},{"key":"SCENARIO_s03_06030000_01_0020","text":"……不是事务所的，是你自己的？"},{"key":"SCENARIO_s03_06030000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06030000_02_0010","text":"…………"},{"key":"SCENARIO_s03_06030000_02_0020","text":"……不好意思\n谢谢您"},{"key":"SCENARIO_s03_06030000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06030000_03_0010","text":"诶……？"},{"key":"SCENARIO_s03_06030000_03_0020","text":"不用了，不必了\n需要的话我自己会买"}]
