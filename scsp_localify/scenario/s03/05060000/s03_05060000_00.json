[{"key":"SCENARIO_s03_05060000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_05060000_00_0010","text":"…………"},{"key":"SCENARIO_s03_05060000_00_0020","text":"…………"},{"key":"SCENARIO_s03_05060000_00_0030","text":"…………──"},{"key":"SCENARIO_s03_05060000_00_0040","text":"确认一下啊……\n你们俩没在吵架吧……？"},{"key":"SCENARIO_s03_05060000_00_0004","text":"朝日？"},{"key":"SCENARIO_s03_05060000_00_0005","text":"冬优子……？"},{"key":"SCENARIO_s03_05060000_00_0006","text":"你们俩"},{"key":"SCENARIO_s03_05060000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_05060000_01_0010","text":"啊，朝日……？"},{"key":"SCENARIO_s03_05060000_01_0020","text":"不用担心，没事的\n她们很安静，就让她们待着吧"},{"key":"SCENARIO_s03_05060000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_05060000_02_0010","text":"怎么可能在吵架\n冬优在查东西，那家伙──不知道在干嘛"},{"key":"SCENARIO_s03_05060000_02_0020","text":"各干各的而已\n反而还挺自在的"},{"key":"SCENARIO_s03_05060000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_05060000_03_0010","text":"？\n怎么了？制作人"},{"key":"SCENARIO_s03_05060000_03_0020","text":"别问那种傻问题啦——"}]
