[{"key":"SCENARIO_s03_05070000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_05070000_00_0010","text":"呐呐冬优子酱的话会买哪个！？\n哪个更适合我～！？"},{"key":"SCENARIO_s03_05070000_00_0020","text":"诶……？\n嗯——"},{"key":"SCENARIO_s03_05070000_00_0030","text":"哈哈，真热闹啊\n怎么了？"},{"key":"SCENARIO_s03_05070000_00_0040","text":"在纠结买哪件新衣服～！"},{"key":"SCENARIO_s03_05070000_00_0004","text":"什么样的？"},{"key":"SCENARIO_s03_05070000_00_0005","text":"右边那件吧？"},{"key":"SCENARIO_s03_05070000_00_0006","text":"我觉得左边好"},{"key":"SCENARIO_s03_05070000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_05070000_01_0010","text":"就是这个！制作人也看看～！\n然后告诉我哪个更好～？"},{"key":"SCENARIO_s03_05070000_01_0020","text":"责任重大呢\n好好选啊？"},{"key":"SCENARIO_s03_05070000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_05070000_02_0010","text":"哎呀呀\n擅自偷看别人的手机"},{"key":"SCENARIO_s03_05070000_02_0020","text":"诶！？　啊，不小心！！\n抱歉……！"},{"key":"SCENARIO_s03_05070000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_05070000_03_0010","text":"同感"},{"key":"SCENARIO_s03_05070000_03_0020","text":"OK！\n那就定左边了～♪"}]
