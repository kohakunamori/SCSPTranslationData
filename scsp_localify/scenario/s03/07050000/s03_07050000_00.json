[{"key":"SCENARIO_s03_07050000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_07050000_00_0010","text":"…………\n…………────"},{"key":"SCENARIO_s03_07050000_00_0020","text":"嘶——……哈——……"},{"key":"SCENARIO_s03_07050000_00_0030","text":"哦，在做什么呢？"},{"key":"SCENARIO_s03_07050000_00_0040","text":"……看不出来的话就请您闭嘴——\n在做拉伸啦……"},{"key":"SCENARIO_s03_07050000_00_0005","text":"──────呼——\n……哈——……"},{"key":"SCENARIO_s03_07050000_00_0006","text":"明白了，\n抱歉！"},{"key":"SCENARIO_s03_07050000_00_0007","text":"原来如此。美琴\n姿势真好看啊"},{"key":"SCENARIO_s03_07050000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_07050000_01_0010","text":"……！\n等……您是想掺一脚吗……？"},{"key":"SCENARIO_s03_07050000_01_0020","text":"……！　对、对不起……\n不知不觉就被带着做了……！"},{"key":"SCENARIO_s03_07050000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_07050000_02_0010","text":"……美琴小姐正在专心做，\n请您不要打扰她——"},{"key":"SCENARIO_s03_07050000_02_0020","text":"…………────"},{"key":"SCENARIO_s03_07050000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_07050000_03_0010","text":"……是吗"},{"key":"SCENARIO_s03_07050000_03_0020","text":"……！　美琴小姐正在专心做，\n请您不要看了——！"}]
