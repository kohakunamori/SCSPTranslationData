[{"key":"SCENARIO_s03_06010000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06010000_00_0010","text":"────抱歉\n你们看到遥控器了吗？电视的"},{"key":"SCENARIO_s03_06010000_00_0020","text":"……不知道"},{"key":"SCENARIO_s03_06010000_00_0030","text":"遥、遥控器吗……？\n那个────"},{"key":"SCENARIO_s03_06010000_00_0040","text":"啊——"},{"key":"SCENARIO_s03_06010000_00_0041","text":"Motion"},{"key":"SCENARIO_s03_06010000_00_0042","text":"Motion"},{"key":"SCENARIO_s03_06010000_00_0004","text":"哦，你知道？"},{"key":"SCENARIO_s03_06010000_00_0005","text":"哦，能告诉我的话\n就帮大忙了"},{"key":"SCENARIO_s03_06010000_00_0006","text":"……是透啊"},{"key":"SCENARIO_s03_06010000_01_0001","text":"Motion"},{"key":"SCENARIO_s03_06010000_01_0010","text":"诶？"},{"key":"SCENARIO_s03_06010000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06010000_01_0020","text":"虽然我也不知道就是了"},{"key":"SCENARIO_s03_06010000_02_0001","text":"Motion"},{"key":"SCENARIO_s03_06010000_02_0010","text":"嗯——\n阳台"},{"key":"SCENARIO_s03_06010000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06010000_02_0020","text":"洒了。果汁"},{"key":"SCENARIO_s03_06010000_03_0001","text":"Motion"},{"key":"SCENARIO_s03_06010000_03_0010","text":"诶？ 嗯——"},{"key":"SCENARIO_s03_06010000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06010000_03_0020","text":"……呵呵。坐在上面了\n都焐热了"}]
