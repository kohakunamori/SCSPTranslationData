[{"key":"SCENARIO_s03_06060000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06060000_00_0010","text":"透前辈将来也想\n一个人住什么的吗～？"},{"key":"SCENARIO_s03_06060000_00_0020","text":"嗯——……"},{"key":"SCENARIO_s03_06060000_00_0030","text":"那跟雏菜两个人住呢～？"},{"key":"SCENARIO_s03_06060000_00_0040","text":"哦——"},{"key":"SCENARIO_s03_06060000_00_0004","text":"看你很开心"},{"key":"SCENARIO_s03_06060000_00_0005","text":"感觉会很热闹"},{"key":"SCENARIO_s03_06060000_00_0006","text":"有点担心啊"},{"key":"SCENARIO_s03_06060000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06060000_01_0010","text":"呀哈～\n那制作人也一起住不就好了～？"},{"key":"SCENARIO_s03_06060000_01_0020","text":"诶，我、我也吗……？"},{"key":"SCENARIO_s03_06060000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06060000_02_0010","text":"耶——"},{"key":"SCENARIO_s03_06060000_02_0020","text":"那就每天开派对吧～！"},{"key":"SCENARIO_s03_06060000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06060000_03_0010","text":"诶——！\n为什么～～～？"},{"key":"SCENARIO_s03_06060000_03_0020","text":"怎么了？"}]
