[{"key":"SCENARIO_s03_06090000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06090000_00_0010","text":"饭团也想吃，\n但面包也想吃的吧～？"},{"key":"SCENARIO_s03_06090000_00_0020","text":"嗯"},{"key":"SCENARIO_s03_06090000_00_0030","text":"各种味道都想尝尝，\n而且听说早上多吃也不会胖～……"},{"key":"SCENARIO_s03_06090000_00_0040","text":"啊——"},{"key":"SCENARIO_s03_06090000_00_0004","text":"看起来很好吃啊"},{"key":"SCENARIO_s03_06090000_00_0005","text":"早饭吗？"},{"key":"SCENARIO_s03_06090000_00_0006","text":"量好大啊"},{"key":"SCENARIO_s03_06090000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06090000_01_0010","text":"Good"},{"key":"SCENARIO_s03_06090000_01_0020","text":"啊哈～\n不过没有制作人的份哦～？"},{"key":"SCENARIO_s03_06090000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06090000_02_0010","text":"嗯——……"},{"key":"SCENARIO_s03_06090000_02_0020","text":"鲑鱼～！"},{"key":"SCENARIO_s03_06090000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06090000_03_0010","text":"嗯～\n跟透前辈分着吃～"},{"key":"SCENARIO_s03_06090000_03_0020","text":"耶——\n分着吃——"}]
