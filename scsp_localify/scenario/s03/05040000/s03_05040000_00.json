[{"key":"SCENARIO_s03_05040000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_05040000_00_0010","text":"下次工作的集合时间和集合地点，都知道了吧？"},{"key":"SCENARIO_s03_05040000_00_0020","text":"好的！"},{"key":"SCENARIO_s03_05040000_00_0030","text":"当然！"},{"key":"SCENARIO_s03_05040000_00_0040","text":"好，那就──"},{"key":"SCENARIO_s03_05040000_00_0004","text":"事务所前面？"},{"key":"SCENARIO_s03_05040000_00_0005","text":"早上８点？"},{"key":"SCENARIO_s03_05040000_00_0006","text":"……咦？"},{"key":"SCENARIO_s03_05040000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_05040000_01_0010","text":"早上８点！"},{"key":"SCENARIO_s03_05040000_01_0020","text":"嗯，等着你们"},{"key":"SCENARIO_s03_05040000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_05040000_02_0010","text":"事务所前面～！"},{"key":"SCENARIO_s03_05040000_02_0020","text":"正确\n之后大家一起坐车过去"},{"key":"SCENARIO_s03_05040000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_05040000_03_0010","text":"……我说\n你要是没搞清楚可不是闹着玩的"},{"key":"SCENARIO_s03_05040000_03_0020","text":"哈哈，开玩笑的\n早上８点事务所前，拜托了！"}]
