[{"key":"SCENARIO_s03_06020000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06020000_00_0010","text":"……啊——"},{"key":"SCENARIO_s03_06020000_00_0020","text":"那、那个，透酱\n你吃饭了吗……？"},{"key":"SCENARIO_s03_06020000_00_0030","text":"诶？　嗯——……"},{"key":"SCENARIO_s03_06020000_00_0003","text":"有没有什么\n吃的呢……"},{"key":"SCENARIO_s03_06020000_00_0004","text":"我去趟\n便利店"},{"key":"SCENARIO_s03_06020000_00_0005","text":"……糖果的话\n倒是有的"},{"key":"SCENARIO_s03_06020000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06020000_01_0010","text":"……\n啊，糖果的话有哦……！"},{"key":"SCENARIO_s03_06020000_01_0020","text":"哦，糖果\n肚子在咕咕叫。肚子也是"},{"key":"SCENARIO_s03_06020000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06020000_02_0010","text":"诶？　啊——\n……路上小心"},{"key":"SCENARIO_s03_06020000_02_0020","text":"……！\n应、应该不是那个意思吧……！"},{"key":"SCENARIO_s03_06020000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06020000_03_0010","text":"我、我也有糖果……！"},{"key":"SCENARIO_s03_06020000_03_0020","text":"呵呵\nAMAZING"}]
