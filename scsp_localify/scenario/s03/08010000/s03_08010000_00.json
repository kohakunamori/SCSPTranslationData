[{"key":"SCENARIO_s03_08010000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_08010000_00_0010","text":"……\n我的饮料怎么没有……？"},{"key":"SCENARIO_s03_08010000_00_0020","text":"啊——！我也正想喝饮料呢\n一起去买怎么样？"},{"key":"SCENARIO_s03_08010000_00_0030","text":"或者，红茶的话\n我可以分你一点哦？"},{"key":"SCENARIO_s03_08010000_00_0040","text":"啧…………"},{"key":"SCENARIO_s03_08010000_00_0004","text":"冰箱里面\n找过了吗？"},{"key":"SCENARIO_s03_08010000_00_0005","text":"红茶啊……"},{"key":"SCENARIO_s03_08010000_00_0006","text":"我也没有饮料"},{"key":"SCENARIO_s03_08010000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_08010000_01_0010","text":"啊？　里面…………？\n……………………啊…………"},{"key":"SCENARIO_s03_08010000_01_0020","text":"…………\n看什么看……"},{"key":"SCENARIO_s03_08010000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_08010000_02_0010","text":"不知怎么的我也想喝了"},{"key":"SCENARIO_s03_08010000_02_0020","text":"呵呵……追加订单来啦——"},{"key":"SCENARIO_s03_08010000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_08010000_03_0010","text":"那正好，大家一起去买饮料吧\n我请客"},{"key":"SCENARIO_s03_08010000_03_0020","text":"哇——，太好了\n制作人，谢谢你！"}]
