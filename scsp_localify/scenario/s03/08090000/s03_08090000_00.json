[{"key":"SCENARIO_s03_08090000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_08090000_00_0012","text":"Motion"},{"key":"SCENARIO_s03_08090000_00_0010","text":"……嘘……"},{"key":"SCENARIO_s03_08090000_00_0020","text":"路加，睡着了……！"},{"key":"SCENARIO_s03_08090000_00_0030","text":"啊……\n真的呢……"},{"key":"SCENARIO_s03_08090000_00_0040","text":"……那个\n怎么办好呢──？"},{"key":"SCENARIO_s03_08090000_00_0004","text":"喂——大家，\n吃点心……"},{"key":"SCENARIO_s03_08090000_00_0005","text":"哦哦！大家\n都聚在一起──"},{"key":"SCENARIO_s03_08090000_00_0006","text":"……嗯？路加，\n睡着了吗……"},{"key":"SCENARIO_s03_08090000_01_0010","text":"……啊，制作人\n小声点──！"},{"key":"SCENARIO_s03_08090000_01_0020","text":"──哦哦，抱歉……！\n我轻点进去……"},{"key":"SCENARIO_s03_08090000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_08090000_02_0022","text":"Motion"},{"key":"SCENARIO_s03_08090000_02_0010","text":"…………啊……？"},{"key":"SCENARIO_s03_08090000_02_0020","text":"啊～～\n把她吵醒了……"},{"key":"SCENARIO_s03_08090000_03_0010","text":"…………────"},{"key":"SCENARIO_s03_08090000_03_0020","text":"……──\n辛苦了，制作人"}]
