[{"key":"SCENARIO_s03_06040000_00_0001","text":"Motion"},{"key":"SCENARIO_s03_06040000_00_0010","text":"诶，要出去？去哪"},{"key":"SCENARIO_s03_06040000_00_0020","text":"便利店\n就买瓶饮料"},{"key":"SCENARIO_s03_06040000_00_0030","text":"有想要的东西吗？"},{"key":"SCENARIO_s03_06040000_00_0040","text":"啊，碳酸？"},{"key":"SCENARIO_s03_06040000_00_0004","text":"啊，\n咖啡……！"},{"key":"SCENARIO_s03_06040000_00_0005","text":"一起去吧"},{"key":"SCENARIO_s03_06040000_00_0006","text":"我没事的"},{"key":"SCENARIO_s03_06040000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_06040000_01_0010","text":"……是吗"},{"key":"SCENARIO_s03_06040000_01_0020","text":"那请您自己来吧"},{"key":"SCENARIO_s03_06040000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_06040000_02_0010","text":"…………我不去了"},{"key":"SCENARIO_s03_06040000_02_0020","text":"诶——碳酸的"},{"key":"SCENARIO_s03_06040000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_06040000_03_0010","text":"……哈？"},{"key":"SCENARIO_s03_06040000_03_0020","text":"能请您不要插话吗？"}]
