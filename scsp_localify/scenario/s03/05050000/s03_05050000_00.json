[{"key":"SCENARIO_s03_05050000_00_0011","text":"Motion"},{"key":"SCENARIO_s03_05050000_00_0010","text":"我赢了就吃荞麦面！"},{"key":"SCENARIO_s03_05050000_00_0020","text":"我赢了就吃汉堡！"},{"key":"SCENARIO_s03_05050000_00_0030","text":"……冬优赢了就吃披萨\n行，谁都不许记仇啊"},{"key":"SCENARIO_s03_05050000_00_0040","text":"午饭外卖，就按赢了我的那个人的提议来定\n……要上了哦？　石头剪刀布──"},{"key":"SCENARIO_s03_05050000_00_0004","text":"Good"},{"key":"SCENARIO_s03_05050000_00_0005","text":"剪刀"},{"key":"SCENARIO_s03_05050000_00_0006","text":"布"},{"key":"SCENARIO_s03_05050000_01_0011","text":"Motion"},{"key":"SCENARIO_s03_05050000_01_0010","text":"太好了～！我赢了！\n山药泥荞麦面四份哦制作人！"},{"key":"SCENARIO_s03_05050000_01_0020","text":"等等朝日\n先问问大家想吃什么面吧"},{"key":"SCENARIO_s03_05050000_02_0011","text":"Motion"},{"key":"SCENARIO_s03_05050000_02_0010","text":"好，定了\n──这个辣的是必点"},{"key":"SCENARIO_s03_05050000_02_0020","text":"四个人吃的话还得再来一份吧？\n你们俩，自己选吧"},{"key":"SCENARIO_s03_05050000_03_0011","text":"Motion"},{"key":"SCENARIO_s03_05050000_03_0010","text":"好耶！\n我今天特别想吃汉堡来着～"},{"key":"SCENARIO_s03_05050000_03_0020","text":"再点些薯条和炸鸡什么的\n搞成派对一样吧～♪"}]
