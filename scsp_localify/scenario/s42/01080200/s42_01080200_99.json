[{"key":"SCENARIO_s42_01080200_99_0000","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_9994","text":"影像"},{"key":"SCENARIO_s42_01080200_99_0010","text":"『Next Artist is────』"},{"key":"SCENARIO_s42_01080200_99_0020","text":"『CoMETIK！』"},{"key":"SCENARIO_s42_01080200_99_9995","text":"观众"},{"key":"SCENARIO_s42_01080200_99_0030","text":"CoMETIK！\nCoMETIK！"},{"key":"SCENARIO_s42_01080200_99_0040","text":"路加──────！"},{"key":"SCENARIO_s42_01080200_99_0050","text":"…………"},{"key":"SCENARIO_s42_01080200_99_9996","text":"女性音乐人"},{"key":"SCENARIO_s42_01080200_99_0060","text":"solo，不做了吗？"},{"key":"SCENARIO_s42_01080200_99_0007","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_0070","text":"什麼個人活動"},{"key":"SCENARIO_s42_01080200_99_9997","text":"信纸上写的字"},{"key":"SCENARIO_s42_01080200_99_0080","text":"『CoMETIK 斑鸠路加小姐』"},{"key":"SCENARIO_s42_01080200_99_0090","text":"什麼團體活動"},{"key":"SCENARIO_s42_01080200_99_0100","text":"────吵死了"},{"key":"SCENARIO_s42_01080200_99_0110","text":"哪邊怎樣\n那種東西"},{"key":"SCENARIO_s42_01080200_99_0001","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_9998","text":"美甲师"},{"key":"SCENARIO_s42_01080200_99_0120","text":"──说明现在的路加\n身心都很健康"},{"key":"SCENARIO_s42_01080200_99_0002","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_0003","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_0130","text":"…………"},{"key":"SCENARIO_s42_01080200_99_0004","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_0140","text":"路加？"},{"key":"SCENARIO_s42_01080200_99_0150","text":"隨便怎樣都……\n差不多該輪到我們了────……"},{"key":"SCENARIO_s42_01080200_99_0006","text":"Motion"},{"key":"SCENARIO_s42_01080200_99_9999","text":"观众"},{"key":"SCENARIO_s42_01080200_99_0160","text":"CoMETIK──！"},{"key":"SCENARIO_s42_01080200_99_0170","text":"吵死了"},{"key":"SCENARIO_s42_01080200_99_0180","text":"不管在哪裡──────\n不管是白是黑──────"},{"key":"SCENARIO_s42_01080200_99_0190","text":"我就是我──────"},{"key":"SCENARIO_s42_01080200_99_0200","text":"只是，放聲吶喊────────"}]
