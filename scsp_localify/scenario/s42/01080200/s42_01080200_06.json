[{"key":"SCENARIO_s42_01080200_06_0000","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0010","text":"…………"},{"key":"SCENARIO_s42_01080200_06_0001","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0020","text":"……没人在"},{"key":"SCENARIO_s42_01080200_06_0002","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0003","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0030","text":"…………"},{"key":"SCENARIO_s42_01080200_06_0004","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0040","text":"辛苦了——"},{"key":"SCENARIO_s42_01080200_06_0050","text":"……啊，路加──！\n辛苦了"},{"key":"SCENARIO_s42_01080200_06_0006","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0005","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0060","text":"旁边，可以坐吗？"},{"key":"SCENARIO_s42_01080200_06_0070","text":"…………"},{"key":"SCENARIO_s42_01080200_06_0080","text":"啊哈，我就当你是说“可以”了哦？"},{"key":"SCENARIO_s42_01080200_06_0007","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0090","text":"…………"},{"key":"SCENARIO_s42_01080200_06_0100","text":"那我就不客气啦～"},{"key":"SCENARIO_s42_01080200_06_0008","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0009","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0110","text":"…………"},{"key":"SCENARIO_s42_01080200_06_0011","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0012","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0120","text":"啊——！"},{"key":"SCENARIO_s42_01080200_06_0130","text":"路加，美甲好漂亮啊！"},{"key":"SCENARIO_s42_01080200_06_0140","text":"那是──为了活动做的吗？"},{"key":"SCENARIO_s42_01080200_06_0013","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0150","text":"……没什么特别的……"},{"key":"SCENARIO_s42_01080200_06_0160","text":"这样啊——"},{"key":"SCENARIO_s42_01080200_06_0014","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0015","text":"Motion"},{"key":"SCENARIO_s42_01080200_06_0170","text":"……我也想做做美甲看看呢"},{"key":"SCENARIO_s42_01080200_06_0180","text":"啊，不过得在店里\n坐两三个小时才行对吧？"},{"key":"SCENARIO_s42_01080200_06_0190","text":"啊哈，果然好麻烦──！"},{"key":"SCENARIO_s42_01080200_06_0200","text":"…………"}]
