[{"key":"SCENARIO_s42_01080200_05_0000","text":"Motion"},{"key":"SCENARIO_s42_01080200_05_9999","text":"美甲师"},{"key":"SCENARIO_s42_01080200_05_0010","text":"路加！"},{"key":"SCENARIO_s42_01080200_05_0020","text":"好久不见～～！\n我还以为你不来了呢～！！"},{"key":"SCENARIO_s42_01080200_05_0030","text":"看到你预约我超兴奋的！！"},{"key":"SCENARIO_s42_01080200_05_0040","text":"…………"},{"key":"SCENARIO_s42_01080200_05_0050","text":"────嗯，好久不见"},{"key":"SCENARIO_s42_01080200_05_0060","text":"这样啊这样啊\n总之我今天可是干劲满满哦！"},{"key":"SCENARIO_s42_01080200_05_0070","text":"…………"},{"key":"SCENARIO_s42_01080200_05_0001","text":"Motion"},{"key":"SCENARIO_s42_01080200_05_0080","text":"设计呢？交给我可以吗？\n我想做的款式超多的～"},{"key":"SCENARIO_s42_01080200_05_0090","text":"──……"},{"key":"SCENARIO_s42_01080200_05_0100","text":"OK\n不过，怎么又想起来找我了？什么契机？"},{"key":"SCENARIO_s42_01080200_05_0110","text":"──……"},{"key":"SCENARIO_s42_01080200_05_0002","text":"Motion"},{"key":"SCENARIO_s42_01080200_05_0120","text":"路加呢？\n有“最近重新开始的事情”吗？"},{"key":"SCENARIO_s42_01080200_05_0003","text":"Motion"},{"key":"SCENARIO_s42_01080200_05_0130","text":"────随便"},{"key":"SCENARIO_s42_01080200_05_0140","text":"这样啊……其实我啊\n在电视上看到你，还挺担心的哦？"},{"key":"SCENARIO_s42_01080200_05_0150","text":"不过太好了\n指甲没有裂，也很漂亮"},{"key":"SCENARIO_s42_01080200_05_0160","text":"──说明现在的路加\n身心都很健康"},{"key":"SCENARIO_s42_01080200_05_0170","text":"…………"},{"key":"SCENARIO_s42_01080200_05_0180","text":"──嘛，不过这副漂亮的指甲\n接下来要被我弄成超闪超夸张的款式就是了！"},{"key":"SCENARIO_s42_01080200_05_0190","text":"呵呵，敬请期待哦～"},{"key":"SCENARIO_s42_01080200_05_0200","text":"…………"}]
