[{"key":"SCENARIO_s42_01080200_04_0004","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0010","text":"…………"},{"key":"SCENARIO_s42_01080200_04_0000","text":"信纸上写的字"},{"key":"SCENARIO_s42_01080200_04_0020","text":"『CoMETIK 斑鸠路加小姐』"},{"key":"SCENARIO_s42_01080200_04_0001","text":"信纸上写的字"},{"key":"SCENARIO_s42_01080200_04_0030","text":"『♥给CoMETIK的路加♥』"},{"key":"SCENARIO_s42_01080200_04_0040","text":"CoMETIK————"},{"key":"SCENARIO_s42_01080200_04_0041","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0042","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0050","text":"与其说是“重新开始的事情”，\n不如说是久违地尝试了一下的事情……"},{"key":"SCENARIO_s42_01080200_04_0060","text":"前阵子，我久违地去游了次泳！"},{"key":"SCENARIO_s42_01080200_04_0070","text":"游泳──！"},{"key":"SCENARIO_s42_01080200_04_0071","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0080","text":"…………"},{"key":"SCENARIO_s42_01080200_04_0081","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0002","text":"女性音乐人"},{"key":"SCENARIO_s42_01080200_04_0090","text":"我果然还是最喜欢\nsolo时期的路加小姐────"},{"key":"SCENARIO_s42_01080200_04_0003","text":"女性音乐人"},{"key":"SCENARIO_s42_01080200_04_0100","text":"solo，不做了吗？"},{"key":"SCENARIO_s42_01080200_04_0110","text":"──solo的，路加"},{"key":"SCENARIO_s42_01080200_04_0120","text":"…………搞什么啊──"},{"key":"SCENARIO_s42_01080200_04_0121","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0130","text":"路加呢？\n有“最近重新开始的事情”吗？"},{"key":"SCENARIO_s42_01080200_04_0140","text":"……不走了"},{"key":"SCENARIO_s42_01080200_04_0141","text":"Motion"},{"key":"SCENARIO_s42_01080200_04_0150","text":"…………"},{"key":"SCENARIO_s42_01080200_04_0160","text":"……────"},{"key":"SCENARIO_s42_01080200_04_0170","text":"（美甲────）"},{"key":"SCENARIO_s42_01080200_04_0180","text":"（……掉了）"},{"key":"SCENARIO_s42_01080200_04_0190","text":"那么──"},{"key":"SCENARIO_s42_01080200_04_0200","text":"我们是CoMETIK──！"}]
