[{"key":"SCENARIO_s42_01890100_00_0000","text":"Motion"},{"key":"SCENARIO_s42_01890100_00_0010","text":"……还没画完"},{"key":"SCENARIO_s42_01890100_00_0019","text":"声音"},{"key":"SCENARIO_s42_01890100_00_0020","text":"喂──該回去囉──"},{"key":"SCENARIO_s42_01890100_00_0030","text":"！"},{"key":"SCENARIO_s42_01890100_00_0040","text":"…………啊"},{"key":"SCENARIO_s42_01890100_00_0049","text":"孩子"},{"key":"SCENARIO_s42_01890100_00_0050","text":"吶──吃完飯\n就來打遊戲吧！"},{"key":"SCENARIO_s42_01890100_00_0059","text":"小孩子"},{"key":"SCENARIO_s42_01890100_00_0060","text":"等媽媽說可以才行"},{"key":"SCENARIO_s42_01890100_00_0069","text":"孩子"},{"key":"SCENARIO_s42_01890100_00_0070","text":"欸──────！？"},{"key":"SCENARIO_s42_01890100_00_0080","text":"…………"},{"key":"SCENARIO_s42_01890100_00_0089","text":"声音"},{"key":"SCENARIO_s42_01890100_00_0090","text":"────日花"},{"key":"SCENARIO_s42_01890100_00_0091","text":"Motion"},{"key":"SCENARIO_s42_01890100_00_0100","text":"呼……呼……\n抱歉！來晚了……"},{"key":"SCENARIO_s42_01890100_00_0110","text":"……呼…………呼……\n對不起，我這就去把車開過來……"},{"key":"SCENARIO_s42_01890100_00_0120","text":"……呼吸────好吵……"},{"key":"SCENARIO_s42_01890100_00_0130","text":"诶？"},{"key":"SCENARIO_s42_01890100_00_0140","text":"……我剛才說「被蟲子瘋狂攻擊了呢」"},{"key":"SCENARIO_s42_01890100_00_0150","text":"啊……你一直在外面等著嗎\n抱歉，應該先跟你說還要花點時間的"},{"key":"SCENARIO_s42_01890100_00_0160","text":"日花拜託我的餐點的事，剛好負責人來了，比預想中花了不少時間"},{"key":"SCENARIO_s42_01890100_00_0170","text":"────啊……\n…………"},{"key":"SCENARIO_s42_01890100_00_0180","text":"我去把車開過來"},{"key":"SCENARIO_s42_01890100_00_0181","text":"Motion"},{"key":"SCENARIO_s42_01890100_00_0190","text":"到底是怎麼回事呢"},{"key":"SCENARIO_s42_01890100_00_0191","text":"Motion"},{"key":"SCENARIO_s42_01890100_00_0200","text":"……啊，對了\n先跟日花說一聲吧"},{"key":"SCENARIO_s42_01890100_00_0210","text":"關於這次的團體曲────"}]
