[{"key":"SCENARIO_s42_01890100_05_9900","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0010","text":"目前為止！子音太強了，要把母音撐起來\n雖然很基本，但請確實意識到重音的位置"},{"key":"SCENARIO_s42_01890100_05_0020","text":"……好／好！／好～／好……！"},{"key":"SCENARIO_s42_01890100_05_9901","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0030","text":"剛才那段，從頭開始────"},{"key":"SCENARIO_s42_01890100_05_9902","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0040","text":"那邊，我剛才說過了對吧？\n該彈的地方要彈起來，該收的地方要收乾淨"},{"key":"SCENARIO_s42_01890100_05_9903","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0050","text":"尤其是七草同学，因为个性太强很显眼\n请集中注意力"},{"key":"SCENARIO_s42_01890100_05_0060","text":"……！\n好……！"},{"key":"SCENARIO_s42_01890100_05_9904","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0070","text":"────停"},{"key":"SCENARIO_s42_01890100_05_9905","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0080","text":"刚才也说过了吧，七草同学\n这是第几次了？"},{"key":"SCENARIO_s42_01890100_05_9906","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0090","text":"你是真的想傳達嗎？\n那樣的唱法，聽起來就像一點都不想感謝"},{"key":"SCENARIO_s42_01890100_05_0100","text":"──────…………"},{"key":"SCENARIO_s42_01890100_05_0110","text":"…………"},{"key":"SCENARIO_s42_01890100_05_9907","text":"声乐教练"},{"key":"SCENARIO_s42_01890100_05_0120","text":"把至今的感謝……心意確實地融入聲音裡，\n珍惜每一個音、每一個音符────明白了嗎？"},{"key":"SCENARIO_s42_01890100_05_0130","text":"…………好……！"},{"key":"SCENARIO_s42_01890100_05_0140","text":"再來一次────"},{"key":"SCENARIO_s42_01890100_05_0141","text":"Motion"},{"key":"SCENARIO_s42_01890100_05_0150","text":"那这样的话────"},{"key":"SCENARIO_s42_01890100_05_0160","text":"…………"},{"key":"SCENARIO_s42_01890100_05_0161","text":"Motion"},{"key":"SCENARIO_s42_01890100_05_0170","text":"…………啊"},{"key":"SCENARIO_s42_01890100_05_0180","text":"大家辛苦了\n剛結束嗎？"},{"key":"SCENARIO_s42_01890100_05_0190","text":"對啊～～"},{"key":"SCENARIO_s42_01890100_05_0191","text":"Motion"},{"key":"SCENARIO_s42_01890100_05_0200","text":"……咦\n日花呢……？"},{"key":"SCENARIO_s42_01890100_05_0201","text":"Motion"},{"key":"SCENARIO_s42_01890100_05_0210","text":"那就把她帶過來啊\n帶到這裡"}]
