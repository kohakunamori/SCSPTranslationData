[{"key":"SCENARIO_s42_01890100_08_0000","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0001","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0009","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0010","text":"…………好厉害……\n这不就是制作人的自我满足吗"},{"key":"SCENARIO_s42_01890100_08_0020","text":"…………"},{"key":"SCENARIO_s42_01890100_08_0030","text":"搞什么啊……\n真是的…………"},{"key":"SCENARIO_s42_01890100_08_0040","text":"如果我说要一辈子待在这里，\n你真的会像镜子一样一辈子待在这里吗…………"},{"key":"SCENARIO_s42_01890100_08_0041","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0050","text":"────\n……唔"},{"key":"SCENARIO_s42_01890100_08_0051","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0060","text":"日花小姐……\n请用这个……"},{"key":"SCENARIO_s42_01890100_08_0070","text":"诶？\n这是…………"},{"key":"SCENARIO_s42_01890100_08_0080","text":"不嫌弃的话……请尝尝……"},{"key":"SCENARIO_s42_01890100_08_0090","text":"麦卢卡蜂蜜……\n谢谢你"},{"key":"SCENARIO_s42_01890100_08_0091","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0100","text":"…………\n吸一口……"},{"key":"SCENARIO_s42_01890100_08_0110","text":"在吃什么呀～？"},{"key":"SCENARIO_s42_01890100_08_0120","text":"是润喉糖……\n两位也请用……"},{"key":"SCENARIO_s42_01890100_08_0130","text":"凛世酱谢谢～！／谢谢你～"},{"key":"SCENARIO_s42_01890100_08_0140","text":"呵呵……\n凛世也来一颗……"},{"key":"SCENARIO_s42_01890100_08_0141","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0142","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0143","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0148","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0144","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0145","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0146","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0147","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0150","text":"大家都到齐了啊"},{"key":"SCENARIO_s42_01890100_08_0160","text":"尽情地把你们的歌声响彻出来吧\n让感谢的心情能够传达出去"},{"key":"SCENARIO_s42_01890100_08_0161","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0169","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0168","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_0170","text":"我会在的……一直都在\n只要那样能让日花幸福的话"},{"key":"SCENARIO_s42_01890100_08_0180","text":"但是……既然日花决定了要成为偶像，\n我就决定了要全力支持你，这是我的工作"},{"key":"SCENARIO_s42_01890100_08_0190","text":"日花一定会作为偶像成功的\n不管以什么形式……为了日花能获得幸福"},{"key":"SCENARIO_s42_01890100_08_0200","text":"…………"},{"key":"SCENARIO_s42_01890100_08_0210","text":"所以────\n回去吧，日花"},{"key":"SCENARIO_s42_01890100_08_0220","text":"…………"},{"key":"SCENARIO_s42_01890100_08_0229","text":"Motion"},{"key":"SCENARIO_s42_01890100_08_9900","text":"音响工作人员"},{"key":"SCENARIO_s42_01890100_08_0230","text":"那么录音即将开始\n请大家准备"},{"key":"SCENARIO_s42_01890100_08_0231","text":"Motion"}]
