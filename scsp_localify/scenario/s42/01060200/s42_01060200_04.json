[{"key":"SCENARIO_s42_01060200_04_0000","text":"Motion"},{"key":"SCENARIO_s42_01060200_04_0010","text":"……透同学！"},{"key":"SCENARIO_s42_01060200_04_0011","text":"Motion"},{"key":"SCENARIO_s42_01060200_04_0020","text":"……啊\n小糸同学"},{"key":"SCENARIO_s42_01060200_04_0030","text":"今天有练习对吧……！\n走吧……！"},{"key":"SCENARIO_s42_01060200_04_0040","text":"啊——，嗯"},{"key":"SCENARIO_s42_01060200_04_0050","text":"…………"},{"key":"SCENARIO_s42_01060200_04_0060","text":"……圆香同学和雏菜同学\n都在努力，好厉害啊……！"},{"key":"SCENARIO_s42_01060200_04_0070","text":"noctchill的活动虽然变少了……\n……练习也只剩下我和透同学两个人……"},{"key":"SCENARIO_s42_01060200_04_0080","text":"……\n……小糸同学"},{"key":"SCENARIO_s42_01060200_04_0090","text":"咿……！\n怎、怎么了？"},{"key":"SCENARIO_s42_01060200_04_0100","text":"绕个路\n就一会儿"},{"key":"SCENARIO_s42_01060200_04_0101","text":"Motion"},{"key":"SCENARIO_s42_01060200_04_0102","text":"Motion"},{"key":"SCENARIO_s42_01060200_04_0990","text":"男学生"},{"key":"SCENARIO_s42_01060200_04_0110","text":"────啊，浅仓同学！！！"},{"key":"SCENARIO_s42_01060200_04_0111","text":"Motion"},{"key":"SCENARIO_s42_01060200_04_0991","text":"男学生"},{"key":"SCENARIO_s42_01060200_04_0120","text":"…………\n……啊…………那…………个…………"},{"key":"SCENARIO_s42_01060200_04_0992","text":"男学生"},{"key":"SCENARIO_s42_01060200_04_0130","text":"……────对不起，我喜欢你…………！！！！！！"},{"key":"SCENARIO_s42_01060200_04_0140","text":"诶……啊—……\n那个，对不────……"},{"key":"SCENARIO_s42_01060200_04_0993","text":"男学生"},{"key":"SCENARIO_s42_01060200_04_0150","text":"————————"},{"key":"SCENARIO_s42_01060200_04_0160","text":"噼呀……！"},{"key":"SCENARIO_s42_01060200_04_0170","text":"久、久等了……！\n透同学，刚才那是……"},{"key":"SCENARIO_s42_01060200_04_0180","text":"嗯\n走吧，去练习"},{"key":"SCENARIO_s42_01060200_04_0190","text":"诶？\n……嗯、嗯……！"},{"key":"SCENARIO_s42_01060200_04_0200","text":"透同学还是老样子……\n对吧？"}]
