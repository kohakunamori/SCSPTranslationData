[{"key":"SCENARIO_s42_01060200_99_0000","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0010","text":"……啊"},{"key":"SCENARIO_s42_01060200_99_0020","text":"之前有个跟透前辈告白完\n就不知道跑哪去的人"},{"key":"SCENARIO_s42_01060200_99_0030","text":"那件事，最后怎么样了～？"},{"key":"SCENARIO_s42_01060200_99_0040","text":"对、对啊……！\n透同学，你回复了吗……？"},{"key":"SCENARIO_s42_01060200_99_0001","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0050","text":"……诶"},{"key":"SCENARIO_s42_01060200_99_0002","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0003","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0060","text":"……不记得了吧"},{"key":"SCENARIO_s42_01060200_99_0070","text":"啊—……嗯\n不记得了，啥都不记得"},{"key":"SCENARIO_s42_01060200_99_0004","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0005","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0080","text":"不过，跟她说吧\n如果她来的话"},{"key":"SCENARIO_s42_01060200_99_0090","text":"对不起啦"},{"key":"SCENARIO_s42_01060200_99_0006","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0100","text":"噼诶……"},{"key":"SCENARIO_s42_01060200_99_0110","text":"啊哈～"},{"key":"SCENARIO_s42_01060200_99_0120","text":"吃吗？\n肉包子"},{"key":"SCENARIO_s42_01060200_99_0130","text":"吃～！"},{"key":"SCENARIO_s42_01060200_99_0007","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0008","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0140","text":"不，那是我的"},{"key":"SCENARIO_s42_01060200_99_0009","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0150","text":"……算了无所谓\n浅仓，把肉包子掰开"},{"key":"SCENARIO_s42_01060200_99_0011","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0160","text":"好喔——"},{"key":"SCENARIO_s42_01060200_99_0012","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0013","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0170","text":"噼呀……！"},{"key":"SCENARIO_s42_01060200_99_0014","text":"Motion"},{"key":"SCENARIO_s42_01060200_99_0180","text":"好\n那"},{"key":"SCENARIO_s42_01060200_99_0190","text":"四等分"},{"key":"SCENARIO_s42_01060200_99_0200","text":"……真笨"}]
