[{"key":"SCENARIO_s42_01060100_07_0000","text":"Motion"},{"key":"SCENARIO_s42_01060100_07_0010","text":"没想到\n你比我想象中靠谱多了嘛～"},{"key":"SCENARIO_s42_01060100_07_0020","text":"嗯"},{"key":"SCENARIO_s42_01060100_07_0001","text":"Motion"},{"key":"SCENARIO_s42_01060100_07_9998","text":"女生"},{"key":"SCENARIO_s42_01060100_07_0030","text":"那，那个……！"},{"key":"SCENARIO_s42_01060100_07_0040","text":"诶"},{"key":"SCENARIO_s42_01060100_07_0050","text":"上次……谢谢你了！"},{"key":"SCENARIO_s42_01060100_07_0060","text":"啊——"},{"key":"SCENARIO_s42_01060100_07_0070","text":"那个……托你的福\n脚也完全好了……！"},{"key":"SCENARIO_s42_01060100_07_0080","text":"嗯～\n哪里哪里"},{"key":"SCENARIO_s42_01060100_07_0090","text":"活动，加油哦！\n我会支持你的……！"},{"key":"SCENARIO_s42_01060100_07_0100","text":"呵呵\n谢谢"},{"key":"SCENARIO_s42_01060100_07_0002","text":"Motion"},{"key":"SCENARIO_s42_01060100_07_9999","text":"振兴会的大叔"},{"key":"SCENARIO_s42_01060100_07_0110","text":"啊，你是……浅仓小姐"},{"key":"SCENARIO_s42_01060100_07_0120","text":"上次不好意思啊\n说了你几句"},{"key":"SCENARIO_s42_01060100_07_0130","text":"啊——"},{"key":"SCENARIO_s42_01060100_07_0140","text":"不客气"},{"key":"SCENARIO_s42_01060100_07_0150","text":"听说我家女儿受你照顾了"},{"key":"SCENARIO_s42_01060100_07_0160","text":"刚才那孩子，是我女儿"},{"key":"SCENARIO_s42_01060100_07_0170","text":"……\n哦──"},{"key":"SCENARIO_s42_01060100_07_0180","text":"你是为了我女儿才迟到的\n我没问清楚情况就责怪你，实在抱歉"},{"key":"SCENARIO_s42_01060100_07_0190","text":"今天我会全力支持你们的活动"},{"key":"SCENARIO_s42_01060100_07_0003","text":"Motion"},{"key":"SCENARIO_s42_01060100_07_0200","text":"非常感谢"}]
