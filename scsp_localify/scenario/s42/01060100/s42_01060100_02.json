[{"key":"SCENARIO_s42_01060100_02_0008","text":"Motion"},{"key":"SCENARIO_s42_01060100_02_0010","text":"…………"},{"key":"SCENARIO_s42_01060100_02_0020","text":"『听说碰头会是17点开始\n　拜托你了』"},{"key":"SCENARIO_s42_01060100_02_0030","text":"…………唉"},{"key":"SCENARIO_s42_01060100_02_0031","text":"Motion"},{"key":"SCENARIO_s42_01060100_02_0000","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0040","text":"……那个"},{"key":"SCENARIO_s42_01060100_02_0001","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0050","text":"樋口小姐"},{"key":"SCENARIO_s42_01060100_02_0060","text":"……怎么了？"},{"key":"SCENARIO_s42_01060100_02_0002","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0070","text":"啊……那个\n打扫值日……"},{"key":"SCENARIO_s42_01060100_02_0080","text":"——————啊"},{"key":"SCENARIO_s42_01060100_02_0090","text":"……抱歉\n我一时忘了"},{"key":"SCENARIO_s42_01060100_02_0091","text":"Motion"},{"key":"SCENARIO_s42_01060100_02_0100","text":"…………"},{"key":"SCENARIO_s42_01060100_02_0003","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0110","text":"……啊"},{"key":"SCENARIO_s42_01060100_02_0004","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0120","text":"没关系，樋口同学\n我来做吧"},{"key":"SCENARIO_s42_01060100_02_0130","text":"诶？\n我来做，真的"},{"key":"SCENARIO_s42_01060100_02_0005","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0140","text":"不用不用，没事的\n你看起来挺忙的"},{"key":"SCENARIO_s42_01060100_02_0006","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0150","text":"我之后也没什么安排\n要是换一下比较方便的话……"},{"key":"SCENARIO_s42_01060100_02_0160","text":"…………"},{"key":"SCENARIO_s42_01060100_02_0170","text":"……抱歉\n说实话帮大忙了"},{"key":"SCENARIO_s42_01060100_02_0007","text":"同班同学"},{"key":"SCENARIO_s42_01060100_02_0180","text":"嗯\n交给我吧……！"},{"key":"SCENARIO_s42_01060100_02_0190","text":"谢谢\n……拜托你了"},{"key":"SCENARIO_s42_01060100_02_0191","text":"Motion"},{"key":"SCENARIO_s42_01060100_02_0200","text":"…………"}]
