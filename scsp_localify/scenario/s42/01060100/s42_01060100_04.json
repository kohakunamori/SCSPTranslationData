[{"key":"SCENARIO_s42_01060100_04_0003","text":"Motion"},{"key":"SCENARIO_s42_01060100_04_0010","text":"…………"},{"key":"SCENARIO_s42_01060100_04_0000","text":"老师"},{"key":"SCENARIO_s42_01060100_04_0020","text":"哎呀……\n今天的值日生，是福丸小姐？"},{"key":"SCENARIO_s42_01060100_04_0030","text":"……！\n好、好的……！"},{"key":"SCENARIO_s42_01060100_04_0001","text":"老师"},{"key":"SCENARIO_s42_01060100_04_0040","text":"是啊，真是够辛苦的呢"},{"key":"SCENARIO_s42_01060100_04_0050","text":"不、不会…………！"},{"key":"SCENARIO_s42_01060100_04_0002","text":"老师"},{"key":"SCENARIO_s42_01060100_04_0060","text":"别太勉强自己哦"},{"key":"SCENARIO_s42_01060100_04_0070","text":"非，非常感谢……！"},{"key":"SCENARIO_s42_01060100_04_0071","text":"Motion"},{"key":"SCENARIO_s42_01060100_04_0080","text":"………………"},{"key":"SCENARIO_s42_01060100_04_0081","text":"Motion"},{"key":"SCENARIO_s42_01060100_04_0090","text":"啊，找到了～～～"},{"key":"SCENARIO_s42_01060100_04_0100","text":"…………"},{"key":"SCENARIO_s42_01060100_04_0110","text":"小糸──────"},{"key":"SCENARIO_s42_01060100_04_0120","text":"…………"},{"key":"SCENARIO_s42_01060100_04_0130","text":"…………"},{"key":"SCENARIO_s42_01060100_04_0140","text":"────────\n呜诶……！？"},{"key":"SCENARIO_s42_01060100_04_0150","text":"雏、雏菜酱……！\n怎么了……？"},{"key":"SCENARIO_s42_01060100_04_0160","text":"……\n没事～\n "},{"key":"SCENARIO_s42_01060100_04_0170","text":"雏菜，要回去了～\n "},{"key":"SCENARIO_s42_01060100_04_0180","text":"……？"},{"key":"SCENARIO_s42_01060100_04_0190","text":"嗯、嗯……！\n那再见啦，雏菜酱"},{"key":"SCENARIO_s42_01060100_04_0191","text":"Motion"},{"key":"SCENARIO_s42_01060100_04_0200","text":"…………"},{"key":"SCENARIO_s42_01060100_04_0201","text":"Motion"}]
