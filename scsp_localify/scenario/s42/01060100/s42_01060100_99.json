[{"key":"SCENARIO_s42_01060100_99_0000","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0001","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0002","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0010","text":"大家辛苦了！\n振兴会的人都很高兴哦"},{"key":"SCENARIO_s42_01060100_99_0009","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0020","text":"这个……\n是振兴会送的慰问品"},{"key":"SCENARIO_s42_01060100_99_0003","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0030","text":"好耶～／哇……！／哦──／……哦──"},{"key":"SCENARIO_s42_01060100_99_0040","text":"大家一起吃吧"},{"key":"SCENARIO_s42_01060100_99_0050","text":"哦——"},{"key":"SCENARIO_s42_01060100_99_0060","text":"水果塔"},{"key":"SCENARIO_s42_01060100_99_0004","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0070","text":"啊…………！\n这、这是……！"},{"key":"SCENARIO_s42_01060100_99_0080","text":"雏，雏菜……！"},{"key":"SCENARIO_s42_01060100_99_0005","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0090","text":"啊哈～\n是我想吃的那家～"},{"key":"SCENARIO_s42_01060100_99_0006","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0100","text":"嗯、嗯……！"},{"key":"SCENARIO_s42_01060100_99_0110","text":"嗯～～～～！"},{"key":"SCENARIO_s42_01060100_99_0120","text":"好、好好吃……！"},{"key":"SCENARIO_s42_01060100_99_0130","text":"能行的"},{"key":"SCENARIO_s42_01060100_99_0140","text":"呵呵\n赞"},{"key":"SCENARIO_s42_01060100_99_0007","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0150","text":"诶嘿嘿……！"},{"key":"SCENARIO_s42_01060100_99_0160","text":"嗯～？\n小糸，你看起来好开心呢～？"},{"key":"SCENARIO_s42_01060100_99_0170","text":"诶……？\n有、有吗……？"},{"key":"SCENARIO_s42_01060100_99_0180","text":"啊哈～\n吃到塔罗饼了，太好了呢～"},{"key":"SCENARIO_s42_01060100_99_0008","text":"Motion"},{"key":"SCENARIO_s42_01060100_99_0190","text":"嗯、嗯……！"},{"key":"SCENARIO_s42_01060100_99_0200","text":"太好了……！"}]
