[{"key":"SCENARIO_s42_01060100_03_0009","text":"Motion"},{"key":"SCENARIO_s42_01060100_03_0010","text":"……17点"},{"key":"SCENARIO_s42_01060100_03_0011","text":"Motion"},{"key":"SCENARIO_s42_01060100_03_0020","text":"咦"},{"key":"SCENARIO_s42_01060100_03_0021","text":"Motion"},{"key":"SCENARIO_s42_01060100_03_0000","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0030","text":"………"},{"key":"SCENARIO_s42_01060100_03_0040","text":"怎么了？"},{"key":"SCENARIO_s42_01060100_03_0001","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0050","text":"啊……"},{"key":"SCENARIO_s42_01060100_03_0002","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0060","text":"不是，那个……"},{"key":"SCENARIO_s42_01060100_03_0003","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0070","text":"脚、扭到了……"},{"key":"SCENARIO_s42_01060100_03_0080","text":"啊——"},{"key":"SCENARIO_s42_01060100_03_0081","text":"Motion"},{"key":"SCENARIO_s42_01060100_03_0090","text":"先别急\n能站起来吗？"},{"key":"SCENARIO_s42_01060100_03_0004","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0100","text":"啊，好的……！"},{"key":"SCENARIO_s42_01060100_03_0110","text":"抓住我的手\n肩膀"},{"key":"SCENARIO_s42_01060100_03_0120","text":"……嘿咻\n能撑住吗？去保健室"},{"key":"SCENARIO_s42_01060100_03_0005","text":"女生"},{"key":"SCENARIO_s42_01060100_03_0130","text":"好的……！"},{"key":"SCENARIO_s42_01060100_03_0131","text":"Motion"},{"key":"SCENARIO_s42_01060100_03_0140","text":"早上好"},{"key":"SCENARIO_s42_01060100_03_0006","text":"振兴会的大叔"},{"key":"SCENARIO_s42_01060100_03_0150","text":"……浅仓小姐？"},{"key":"SCENARIO_s42_01060100_03_0160","text":"诶？\n是"},{"key":"SCENARIO_s42_01060100_03_0007","text":"振兴会的大叔"},{"key":"SCENARIO_s42_01060100_03_0170","text":"突然就迟到\n不太好吧"},{"key":"SCENARIO_s42_01060100_03_0180","text":"……啊\n对不起"},{"key":"SCENARIO_s42_01060100_03_0008","text":"振兴会的大叔"},{"key":"SCENARIO_s42_01060100_03_0190","text":"虽然是我们拜托你的……\n但你不按时来，大家可都在等着呢"},{"key":"SCENARIO_s42_01060100_03_0200","text":"不好意思"}]
