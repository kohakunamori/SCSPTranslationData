[{"key":"SCENARIO_s42_01060100_01_0000","text":"Motion"},{"key":"SCENARIO_s42_01060100_01_0010","text":"…………"},{"key":"SCENARIO_s42_01060100_01_0020","text":"没、没关系吗……"},{"key":"SCENARIO_s42_01060100_01_0021","text":"Motion"},{"key":"SCENARIO_s42_01060100_01_0030","text":"小、小型活动……吗？"},{"key":"SCENARIO_s42_01060100_01_0040","text":"嗯\n商店街振兴会那边拜托过来的"},{"key":"SCENARIO_s42_01060100_01_0050","text":"说是希望作为偶像\n帮忙主持活动、炒热气氛"},{"key":"SCENARIO_s42_01060100_01_0060","text":"难得的机会\n我觉得对今后的noctchill也有好处，所以……"},{"key":"SCENARIO_s42_01060100_01_0070","text":"这次是自愿参加\n参不参加，就交给小糸你自己决定"},{"key":"SCENARIO_s42_01060100_01_0080","text":"大、大家都会参加吗……？"},{"key":"SCENARIO_s42_01060100_01_0090","text":"嗯\n她们说会参加"},{"key":"SCENARIO_s42_01060100_01_0100","text":"…………\n这、这样啊"},{"key":"SCENARIO_s42_01060100_01_0110","text":"……小糸？"},{"key":"SCENARIO_s42_01060100_01_0120","text":"如果忙的话\n不用勉强也没关系"},{"key":"SCENARIO_s42_01060100_01_0130","text":"没，没有……"},{"key":"SCENARIO_s42_01060100_01_0140","text":"那个……！"},{"key":"SCENARIO_s42_01060100_01_0150","text":"……我也想试试！\n "},{"key":"SCENARIO_s42_01060100_01_0160","text":"哈哈，这样啊……！\n嗯，那就拜托你了"},{"key":"SCENARIO_s42_01060100_01_0162","text":"Motion"},{"key":"SCENARIO_s42_01060100_01_0161","text":"Motion"},{"key":"SCENARIO_s42_01060100_01_0170","text":"……考试、委员会、还有作业……"},{"key":"SCENARIO_s42_01060100_01_0180","text":"…………还有，雏菜酱"},{"key":"SCENARIO_s42_01060100_01_0181","text":"Motion"},{"key":"SCENARIO_s42_01060100_01_0190","text":"……没事"},{"key":"SCENARIO_s42_01060100_01_0200","text":"没关系，一定……！"}]
