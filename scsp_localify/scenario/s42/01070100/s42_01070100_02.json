[{"key":"SCENARIO_s42_01070100_02_0000","text":"Motion"},{"key":"SCENARIO_s42_01070100_02_0001","text":"Motion"},{"key":"SCENARIO_s42_01070100_02_0010","text":"早上好"},{"key":"SCENARIO_s42_01070100_02_0020","text":"啊，您早上好……！"},{"key":"SCENARIO_s42_01070100_02_0021","text":"Motion"},{"key":"SCENARIO_s42_01070100_02_0022","text":"Motion"},{"key":"SCENARIO_s42_01070100_02_0030","text":"——那个，那是……新歌的歌词吗？"},{"key":"SCENARIO_s42_01070100_02_0040","text":"嗯，我在想歌里的对唱互动\n该怎么表现出来才好"},{"key":"SCENARIO_s42_01070100_02_0050","text":"——新歌里的美琴小姐，\n设定是……为恋爱烦恼的女孩子，对吧"},{"key":"SCENARIO_s42_01070100_02_0060","text":"感觉非常盲目，或者说……"},{"key":"SCENARIO_s42_01070100_02_0070","text":"嗯"},{"key":"SCENARIO_s42_01070100_02_0080","text":"——是朋友吗？\n那个女孩在给“我”提建议"},{"key":"SCENARIO_s42_01070100_02_0090","text":"…………\n这首歌里的我，还挺自以为是的呢！"},{"key":"SCENARIO_s42_01070100_02_0100","text":"——哈哈\n原来在别人眼里是这样啊——"},{"key":"SCENARIO_s42_01070100_02_0101","text":"Motion"},{"key":"SCENARIO_s42_01070100_02_0110","text":"…………"},{"key":"SCENARIO_s42_01070100_02_0120","text":"——以前有过吗？那样的经历"},{"key":"SCENARIO_s42_01070100_02_0130","text":"——诶！"},{"key":"SCENARIO_s42_01070100_02_0140","text":"啊，那个……\n是、是在问我有没有被人咨询过恋爱问题……吗？"},{"key":"SCENARIO_s42_01070100_02_0150","text":"嗯"},{"key":"SCENARIO_s42_01070100_02_0160","text":"嗯……啊——那个……\n——哈哈，怎么样来着"},{"key":"SCENARIO_s42_01070100_02_0170","text":"很难呢，恋爱的建议什么的"},{"key":"SCENARIO_s42_01070100_02_0180","text":"…………说的是呢——\n很、很难呢——"},{"key":"SCENARIO_s42_01070100_02_0190","text":"——一边读着歌词，一边稍微想起了一些事"},{"key":"SCENARIO_s42_01070100_02_0200","text":"想着我以前也有过类似的事呢"}]
