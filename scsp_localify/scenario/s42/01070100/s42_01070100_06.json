[{"key":"SCENARIO_s42_01070100_06_0000","text":"Motion"},{"key":"SCENARIO_s42_01070100_06_9999","text":"少女"},{"key":"SCENARIO_s42_01070100_06_0010","text":"…………"},{"key":"SCENARIO_s42_01070100_06_0002","text":"Motion"},{"key":"SCENARIO_s42_01070100_06_0020","text":"喂——！喂——我说！"},{"key":"SCENARIO_s42_01070100_06_0030","text":"等等我嘛，别无视我嘛，美琴酱！！"},{"key":"SCENARIO_s42_01070100_06_0040","text":"——诶，我……？"},{"key":"SCENARIO_s42_01070100_06_0050","text":"一直在叫你哦——"},{"key":"SCENARIO_s42_01070100_06_0060","text":"难道说，是在假装没听到？"},{"key":"SCENARIO_s42_01070100_06_0070","text":"没有\n只是没想到是在叫我……"},{"key":"SCENARIO_s42_01070100_06_0080","text":"嗯——……算了，无所谓啦"},{"key":"SCENARIO_s42_01070100_06_0090","text":"刚才的课，我不小心听到了哦——\n果然美琴酱，钢琴弹得超好的呢！"},{"key":"SCENARIO_s42_01070100_06_0100","text":"…………"},{"key":"SCENARIO_s42_01070100_06_0110","text":"我就一直弹同一首曲子！\n已经差不多腻了呢——"},{"key":"SCENARIO_s42_01070100_06_0120","text":"——啊，我的钢琴声，大概被听到了吧？"},{"key":"SCENARIO_s42_01070100_06_0130","text":"上课时间就在美琴酱前面嘛"},{"key":"SCENARIO_s42_01070100_06_0140","text":"…………"},{"key":"SCENARIO_s42_01070100_06_0150","text":"——我，想弹更难的、\n更帅气的曲子！"},{"key":"SCENARIO_s42_01070100_06_0160","text":"所以，能教教我进步的诀窍吗？"},{"key":"SCENARIO_s42_01070100_06_0170","text":"那个……为什么？\n为什么想弹得更好？"},{"key":"SCENARIO_s42_01070100_06_0180","text":"嗯——\n那个，那是因为啊——"},{"key":"SCENARIO_s42_01070100_06_0003","text":"Motion"},{"key":"SCENARIO_s42_01070100_06_0190","text":"想起来了"},{"key":"SCENARIO_s42_01070100_06_0200","text":"为什么，现在会想起来呢"}]
