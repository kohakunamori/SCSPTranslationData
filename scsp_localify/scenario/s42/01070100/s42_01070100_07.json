[{"key":"SCENARIO_s42_01070100_07_0000","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0010","text":"……！"},{"key":"SCENARIO_s42_01070100_07_0001","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0020","text":"啊，辛苦了"},{"key":"SCENARIO_s42_01070100_07_0002","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0030","text":"辛、辛苦了……"},{"key":"SCENARIO_s42_01070100_07_0040","text":"一边确认歌词内容，\n一边稍微整理了一下思绪"},{"key":"SCENARIO_s42_01070100_07_0050","text":"啊，是这样啊……"},{"key":"SCENARIO_s42_01070100_07_0060","text":"…………"},{"key":"SCENARIO_s42_01070100_07_0070","text":"之前————"},{"key":"SCENARIO_s42_01070100_07_0003","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0080","text":"啊，好、好的……！"},{"key":"SCENARIO_s42_01070100_07_0090","text":"稍微聊过一点吧\n说以前有过类似的事"},{"key":"SCENARIO_s42_01070100_07_0004","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0100","text":"是、是的……"},{"key":"SCENARIO_s42_01070100_07_0110","text":"我就是在回想那时候的事"},{"key":"SCENARIO_s42_01070100_07_0120","text":"————为什么会想起来，\n我自己也觉得有点不可思议"},{"key":"SCENARIO_s42_01070100_07_0130","text":"…………"},{"key":"SCENARIO_s42_01070100_07_0005","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0140","text":"想着也许对理解和表现新歌\n会有帮助也说不定"},{"key":"SCENARIO_s42_01070100_07_0150","text":"……！"},{"key":"SCENARIO_s42_01070100_07_0160","text":"愿意听我说吗？"},{"key":"SCENARIO_s42_01070100_07_0170","text":"虽然不是什么有趣的故事"},{"key":"SCENARIO_s42_01070100_07_0006","text":"Motion"},{"key":"SCENARIO_s42_01070100_07_0180","text":"不会……！\n怎么会，完全不会！我、我想听！"},{"key":"SCENARIO_s42_01070100_07_0190","text":"嗯，我明白了"},{"key":"SCENARIO_s42_01070100_07_0200","text":"从哪里说起好呢……"}]
