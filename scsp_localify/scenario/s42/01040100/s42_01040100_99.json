[{"key":"SCENARIO_s42_01040100_99_0000","text":"Motion"},{"key":"SCENARIO_s42_01040100_99_9999","text":"推文投稿"},{"key":"SCENARIO_s42_01040100_99_0010","text":"『去泡了场叫什么ALSTROEMERIA演唱会的\n　极致治愈』"},{"key":"SCENARIO_s42_01040100_99_0020","text":"『感觉明天开始也能继续活下去了』"},{"key":"SCENARIO_s42_01040100_99_0030","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_99_0001","text":"Motion"},{"key":"SCENARIO_s42_01040100_99_0040","text":"──甘奈酱、甜花酱"},{"key":"SCENARIO_s42_01040100_99_0050","text":"『温柔强化月』，\n你们俩还在看吗？"},{"key":"SCENARIO_s42_01040100_99_0060","text":"当然想过！"},{"key":"SCENARIO_s42_01040100_99_0070","text":"昨天也……\n和小奈一起，看了……！"},{"key":"SCENARIO_s42_01040100_99_0080","text":"呵呵、这样啊"},{"key":"SCENARIO_s42_01040100_99_0090","text":"到现在还是有很多人\n在投稿呢"},{"key":"SCENARIO_s42_01040100_99_0100","text":"嗯……！\n好开心……"},{"key":"SCENARIO_s42_01040100_99_0110","text":"──甘奈呢……"},{"key":"SCENARIO_s42_01040100_99_0120","text":"想着如果能传达更多更多的\n温柔就好了"},{"key":"SCENARIO_s42_01040100_99_0130","text":"是呢……"},{"key":"SCENARIO_s42_01040100_99_0140","text":"为了做到这一点，如果能让我们\n把歌声传达给更多更多的人就好了"},{"key":"SCENARIO_s42_01040100_99_0150","text":"嗯……！"},{"key":"SCENARIO_s42_01040100_99_0160","text":"说的，也是呢……！"},{"key":"SCENARIO_s42_01040100_99_0170","text":"——啊……！"},{"key":"SCENARIO_s42_01040100_99_0180","text":"蛋糕，来了……！"},{"key":"SCENARIO_s42_01040100_99_0190","text":"哇，看起来好好吃……！"},{"key":"SCENARIO_s42_01040100_99_0200","text":"嘿嘿\n大家一起和蛋糕拍张照吧！"}]
