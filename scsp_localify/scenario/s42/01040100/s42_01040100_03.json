[{"key":"SCENARIO_s42_01040100_03_0000","text":"推文投稿"},{"key":"SCENARIO_s42_01040100_03_0010","text":"…………"},{"key":"SCENARIO_s42_01040100_03_0020","text":"──呼\n稍微休息一下吧"},{"key":"SCENARIO_s42_01040100_03_0030","text":"……说起来，\n甘奈那个标签怎么样了……"},{"key":"SCENARIO_s42_01040100_03_0040","text":"……！"},{"key":"SCENARIO_s42_01040100_03_0050","text":"『模仿ALSTROEMERIA的大家\n　我也试着发了一条』"},{"key":"SCENARIO_s42_01040100_03_0060","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_03_0070","text":"『今天在餐厅把手机忘在店里就走了，\n　店员跑着给我送了过来』"},{"key":"SCENARIO_s42_01040100_03_0080","text":"『感谢店员的温柔！』"},{"key":"SCENARIO_s42_01040100_03_0090","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_03_0100","text":"『今天忘带英语课本了，\n　旁边座位的同学借给我看了，帮大忙了』"},{"key":"SCENARIO_s42_01040100_03_0110","text":"『简直是神』"},{"key":"SCENARIO_s42_01040100_03_0120","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_03_0130","text":"……哈哈"},{"key":"SCENARIO_s42_01040100_03_0140","text":"制作人，你看你看！"},{"key":"SCENARIO_s42_01040100_03_0150","text":"『温柔强化月』，\n有好多人在用呢！"},{"key":"SCENARIO_s42_01040100_03_0160","text":"嗯，我也看到了"},{"key":"SCENARIO_s42_01040100_03_0170","text":"从ALSTROEMERIA的粉丝开始扩散，\n现在其他圈子的人也开始用了"},{"key":"SCENARIO_s42_01040100_03_0180","text":"嗯！\n……好开心啊～"},{"key":"SCENARIO_s42_01040100_03_0190","text":"太好了呢，甘奈"},{"key":"SCENARIO_s42_01040100_03_0200","text":"诶嘿嘿……！"}]
