[{"key":"SCENARIO_s42_01040100_02_0000","text":"Motion"},{"key":"SCENARIO_s42_01040100_02_0010","text":"……咦？"},{"key":"SCENARIO_s42_01040100_02_0020","text":"『今天在事务所的沙发上睡着了』"},{"key":"SCENARIO_s42_01040100_02_0030","text":"『醒来的时候发现身上盖着毯子』"},{"key":"SCENARIO_s42_01040100_02_0040","text":"『经常发生的事』"},{"key":"SCENARIO_s42_01040100_02_0050","text":"『不知道是谁\n　但一直很感谢』"},{"key":"SCENARIO_s42_01040100_02_0060","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_02_0070","text":"（甜花……）"},{"key":"SCENARIO_s42_01040100_02_0080","text":"……！"},{"key":"SCENARIO_s42_01040100_02_0090","text":"『今天节目录制前\n　工作人员给我送了慰问品』"},{"key":"SCENARIO_s42_01040100_02_0100","text":"『非常好吃的泡芙，\n　甜甜的，是个让人开心的惊喜……』"},{"key":"SCENARIO_s42_01040100_02_0110","text":"『希望我的感谢之情\n　能好好传达到他们的用心上』"},{"key":"SCENARIO_s42_01040100_02_0120","text":"『＃温柔强化月』"},{"key":"SCENARIO_s42_01040100_02_0001","text":"Motion"},{"key":"SCENARIO_s42_01040100_02_0130","text":"『甜花！千雪！\n　谢谢你们用＃温柔强化月！』"},{"key":"SCENARIO_s42_01040100_02_0140","text":"『甘奈才是\n　谢谢你创造了这么棒的标签』"},{"key":"SCENARIO_s42_01040100_02_0150","text":"『我觉得这是个非常好的主意』"},{"key":"SCENARIO_s42_01040100_02_0160","text":"『对吧』"},{"key":"SCENARIO_s42_01040100_02_0170","text":"『甜花也想用这个标签\n　来表达感谢』"},{"key":"SCENARIO_s42_01040100_02_0180","text":"『＃温柔强化月，\n　希望能和大家一起传播下去』"},{"key":"SCENARIO_s42_01040100_02_0190","text":"“嗯！”"},{"key":"SCENARIO_s42_01040100_02_0002","text":"Motion"},{"key":"SCENARIO_s42_01040100_02_0200","text":"诶嘿嘿……"}]
