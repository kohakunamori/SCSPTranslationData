[{"key":"SCENARIO_s42_01040100_07_0000","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0002","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0010","text":"……差不多到时间了\n大家，准备好了吗？"},{"key":"SCENARIO_s42_01040100_07_0020","text":"制作人……"},{"key":"SCENARIO_s42_01040100_07_0030","text":"……紧张吗？"},{"key":"SCENARIO_s42_01040100_07_0040","text":"……嗯……\n有一点……呢……"},{"key":"SCENARIO_s42_01040100_07_0050","text":"所以……\n可以……稍微牵一下手吗……？"},{"key":"SCENARIO_s42_01040100_07_0060","text":"嗯，我明白了"},{"key":"SCENARIO_s42_01040100_07_0003","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0070","text":"制作人，\n那个，我也……"},{"key":"SCENARIO_s42_01040100_07_0080","text":"嗯"},{"key":"SCENARIO_s42_01040100_07_0004","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0090","text":"……甜、甜花也要……！"},{"key":"SCENARIO_s42_01040100_07_0100","text":"当然了"},{"key":"SCENARIO_s42_01040100_07_0005","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0110","text":"甜花、千雪"},{"key":"SCENARIO_s42_01040100_07_0120","text":"谢谢你们\n陪我一起想MC的内容"},{"key":"SCENARIO_s42_01040100_07_0130","text":"……还有……甘奈烦恼的时候，\n谢谢你们陪在我身边"},{"key":"SCENARIO_s42_01040100_07_0140","text":"因为有你们俩……我才能重新\n相信温柔的力量……！"},{"key":"SCENARIO_s42_01040100_07_0006","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0150","text":"小奈……"},{"key":"SCENARIO_s42_01040100_07_0160","text":"呵呵……"},{"key":"SCENARIO_s42_01040100_07_0001","text":"Motion"},{"key":"SCENARIO_s42_01040100_07_0170","text":"……！"},{"key":"SCENARIO_s42_01040100_07_0180","text":"演唱会……一起加油吧……！"},{"key":"SCENARIO_s42_01040100_07_0190","text":"走吧，把我们的心意传递出去"},{"key":"SCENARIO_s42_01040100_07_0200","text":"……嗯！"}]
