[{"key":"SCENARIO_s42_01040100_05_0000","text":"Motion"},{"key":"SCENARIO_s42_01040100_05_0010","text":"……"},{"key":"SCENARIO_s42_01040100_05_0020","text":"──『温柔强化月』……\n是不是不该开始啊……"},{"key":"SCENARIO_s42_01040100_05_0030","text":"小奈……"},{"key":"SCENARIO_s42_01040100_05_0040","text":"……不\n不是那样的"},{"key":"SCENARIO_s42_01040100_05_0050","text":"……谢谢你……\n……但是，甘奈……"},{"key":"SCENARIO_s42_01040100_05_0060","text":"温柔在很多人之间传递开来……\n我只觉得……那是好事……"},{"key":"SCENARIO_s42_01040100_05_0070","text":"……完全没想到\n那可能会伤害到谁……"},{"key":"SCENARIO_s42_01040100_05_0080","text":"甘奈……"},{"key":"SCENARIO_s42_01040100_05_0090","text":"…………"},{"key":"SCENARIO_s42_01040100_05_0100","text":"甜、甜花……不想……放弃用那个标签……\n我……是这么想的……！"},{"key":"SCENARIO_s42_01040100_05_0110","text":"……甜花……小奈想出来的\n标签，试着用了之后，嗯……"},{"key":"SCENARIO_s42_01040100_05_0120","text":"果然……\n温柔是件好事……我是这么觉得的……！"},{"key":"SCENARIO_s42_01040100_05_0130","text":"所以……\n所以……！那个……"},{"key":"SCENARIO_s42_01040100_05_0140","text":"对那些……受伤的人……\n也想把温柔……传递过去……！"},{"key":"SCENARIO_s42_01040100_05_0150","text":"…………！"},{"key":"SCENARIO_s42_01040100_05_0160","text":"嗯，是啊"},{"key":"SCENARIO_s42_01040100_05_0170","text":"我也不想在这里放弃"},{"key":"SCENARIO_s42_01040100_05_0180","text":"我们一起想办法吧，\n甘奈、甜花"},{"key":"SCENARIO_s42_01040100_05_0001","text":"Motion"},{"key":"SCENARIO_s42_01040100_05_0002","text":"Motion"},{"key":"SCENARIO_s42_01040100_05_0190","text":"甜花……\n千雪……"},{"key":"SCENARIO_s42_01040100_05_0200","text":"…………\n谢谢……！"}]
