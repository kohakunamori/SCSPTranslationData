[{"key":"SCENARIO_s42_01060300_08_9999","text":"少女"},{"key":"SCENARIO_s42_01060300_08_0010","text":"……妈──？我出去一下────\n…………嗯，去买参考书────"},{"key":"SCENARIO_s42_01060300_08_0020","text":"（…………什么情况，好多人……？）"},{"key":"SCENARIO_s42_01060300_08_0000","text":"Motion"},{"key":"SCENARIO_s42_01060300_08_0030","text":"……诶！"},{"key":"SCENARIO_s42_01060300_08_0040","text":"结、结果……\n还是变成这样了呢……！"},{"key":"SCENARIO_s42_01060300_08_0050","text":"怎么办～？"},{"key":"SCENARIO_s42_01060300_08_0060","text":"嗯——"},{"key":"SCENARIO_s42_01060300_08_0070","text":"船到桥头自然直"},{"key":"SCENARIO_s42_01060300_08_0080","text":"耶……！"},{"key":"SCENARIO_s42_01060300_08_0090","text":"总之先把情绪搞起来吧～"},{"key":"SCENARIO_s42_01060300_08_9998","text":"工作人员"},{"key":"SCENARIO_s42_01060300_08_0100","text":"舞台在这边……！"},{"key":"SCENARIO_s42_01060300_08_0110","text":"谢啦"},{"key":"SCENARIO_s42_01060300_08_0001","text":"Motion"},{"key":"SCENARIO_s42_01060300_08_0120","text":"啊—，啊—"},{"key":"SCENARIO_s42_01060300_08_0130","text":"大家好，我们是noctchill"},{"key":"SCENARIO_s42_01060300_08_9997","text":"少女"},{"key":"SCENARIO_s42_01060300_08_0140","text":"……呼，……呼…………哈啊……────"},{"key":"SCENARIO_s42_01060300_08_0150","text":"（────是真的……真的是…………）"},{"key":"SCENARIO_s42_01060300_08_0003","text":"Motion"},{"key":"SCENARIO_s42_01060300_08_9996","text":"年轻人"},{"key":"SCENARIO_s42_01060300_08_0160","text":"哇，不是吧\n是noctchill"},{"key":"SCENARIO_s42_01060300_08_0004","text":"Motion"},{"key":"SCENARIO_s42_01060300_08_0170","text":"什么？电视……？\n…………────，…………────"},{"key":"SCENARIO_s42_01060300_08_0002","text":"Motion"},{"key":"SCENARIO_s42_01060300_08_0180","text":"……那，开唱吧"},{"key":"SCENARIO_s42_01060300_08_0190","text":"嗯——"},{"key":"SCENARIO_s42_01060300_08_0200","text":"请、请听……！"},{"key":"SCENARIO_s42_01060300_08_9995","text":"少女"},{"key":"SCENARIO_s42_01060300_08_0210","text":"……………………────────"}]
