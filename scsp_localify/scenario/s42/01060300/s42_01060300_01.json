[{"key":"SCENARIO_s42_01060300_01_0000","text":"Motion"},{"key":"SCENARIO_s42_01060300_01_0001","text":"Motion"},{"key":"SCENARIO_s42_01060300_01_0002","text":"Motion"},{"key":"SCENARIO_s42_01060300_01_9900","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0010","text":"请按安排好的来──！"},{"key":"SCENARIO_s42_01060300_01_0020","text":"对、对不起……！"},{"key":"SCENARIO_s42_01060300_01_9901","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0030","text":"外景地点已经确定了，所以想要一个球击中地图上这个位置的画面……"},{"key":"SCENARIO_s42_01060300_01_0040","text":"造假？"},{"key":"SCENARIO_s42_01060300_01_9902","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0050","text":"是演出效果────！"},{"key":"SCENARIO_s42_01060300_01_9903","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0060","text":"总之拜托了……\n时间也不多了……"},{"key":"SCENARIO_s42_01060300_01_0070","text":"那接下来雏菜来～\n嘿～"},{"key":"SCENARIO_s42_01060300_01_0080","text":"啊～……\n又打到海上了～……"},{"key":"SCENARIO_s42_01060300_01_0090","text":"……这要搞到什么时候"},{"key":"SCENARIO_s42_01060300_01_9904","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0100","text":"这次一定！\n这次一定拜托了，浅仓小姐！"},{"key":"SCENARIO_s42_01060300_01_0110","text":"嘿"},{"key":"SCENARIO_s42_01060300_01_0120","text":"又是海"},{"key":"SCENARIO_s42_01060300_01_9905","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0130","text":"至少让我在陆地上……！"},{"key":"SCENARIO_s42_01060300_01_0131","text":"Motion"},{"key":"SCENARIO_s42_01060300_01_0140","text":"是陆地哦"},{"key":"SCENARIO_s42_01060300_01_0150","text":"……真、真的耶……\n旁边的面板也稍微擦到了一点……"},{"key":"SCENARIO_s42_01060300_01_9906","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0160","text":"这是开车去旅行的外景拍摄啊！\n没有路的地方就跟大海一样──！"},{"key":"SCENARIO_s42_01060300_01_0170","text":"────"},{"key":"SCENARIO_s42_01060300_01_9907","text":"节目工作人员"},{"key":"SCENARIO_s42_01060300_01_0180","text":"总之，就是这个面板！\n瞄准这个面板上的村子吧！"},{"key":"SCENARIO_s42_01060300_01_0190","text":"OK，换人"},{"key":"SCENARIO_s42_01060300_01_0200","text":"圆香前辈也是海～～～"}]
