[{"key":"SCENARIO_s42_01030200_06_0000","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0010","text":"终于到正式演出了"},{"key":"SCENARIO_s42_01030200_06_0020","text":"能平安迎来今天，\n当然有自己一步步积累的努力──"},{"key":"SCENARIO_s42_01030200_06_0030","text":"更是因为成员、家人、制作人，\n以及所有协助过我们的工作人员们"},{"key":"SCENARIO_s42_01030200_06_0001","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0040","text":"我不会忘记是被大家带到了这里，\n受了多少帮助，就要用精彩的舞台来回报"},{"key":"SCENARIO_s42_01030200_06_0050","text":"──！"},{"key":"SCENARIO_s42_01030200_06_0002","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0060","text":"尽情享受吧！"},{"key":"SCENARIO_s42_01030200_06_0070","text":"哦——"},{"key":"SCENARIO_s42_01030200_06_0003","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0080","text":"带着笑容……\n出发吧……"},{"key":"SCENARIO_s42_01030200_06_0090","text":"哦——"},{"key":"SCENARIO_s42_01030200_06_0004","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0100","text":"不要受伤哦！"},{"key":"SCENARIO_s42_01030200_06_0110","text":"哦——"},{"key":"SCENARIO_s42_01030200_06_0005","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0120","text":"创造最棒的回忆吧！"},{"key":"SCENARIO_s42_01030200_06_0130","text":"哦——"},{"key":"SCENARIO_s42_01030200_06_0006","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0140","text":"今天也要！\n以第一为目标！"},{"key":"SCENARIO_s42_01030200_06_0150","text":"哦——"},{"key":"SCENARIO_s42_01030200_06_0007","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0160","text":"放课后Climax Girls——！"},{"key":"SCENARIO_s42_01030200_06_0170","text":"向着最强的偶像！"},{"key":"SCENARIO_s42_01030200_06_0011","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0180","text":"变·身！！"},{"key":"SCENARIO_s42_01030200_06_0008","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0190","text":"──"},{"key":"SCENARIO_s42_01030200_06_0009","text":"Motion"},{"key":"SCENARIO_s42_01030200_06_0200","text":"（──今天也要加油，大家……！）"}]
