[{"key":"SCENARIO_s42_01030200_05_0000","text":"Motion"},{"key":"SCENARIO_s42_01030200_05_9999","text":"工作人员1"},{"key":"SCENARIO_s42_01030200_05_0010","text":"喂──你们那个节目，放课后出过吗？"},{"key":"SCENARIO_s42_01030200_05_9998","text":"工作人员2"},{"key":"SCENARIO_s42_01030200_05_0020","text":"出过啊，怎么了？"},{"key":"SCENARIO_s42_01030200_05_9997","text":"工作人员1"},{"key":"SCENARIO_s42_01030200_05_0030","text":"我想要素材\n好素材。最好杜野多一点的"},{"key":"SCENARIO_s42_01030200_05_0040","text":"听说她们最近有演唱会\n会来上节目宣传，我想做个宣传用的视频"},{"key":"SCENARIO_s42_01030200_05_9996","text":"工作人员2"},{"key":"SCENARIO_s42_01030200_05_0050","text":"真难得，这么有干劲啊"},{"key":"SCENARIO_s42_01030200_05_9995","text":"工作人员1"},{"key":"SCENARIO_s42_01030200_05_0060","text":"是呢——"},{"key":"SCENARIO_s42_01030200_05_0070","text":"诶\n惩罚游戏，真的没有NG也没关系吗！？"},{"key":"SCENARIO_s42_01030200_05_0080","text":"有电击棒和苦茶之类的，挺狠的……"},{"key":"SCENARIO_s42_01030200_05_0001","text":"Motion"},{"key":"SCENARIO_s42_01030200_05_0090","text":"节目……我都有在看……"},{"key":"SCENARIO_s42_01030200_05_0100","text":"惩罚游戏……\n是观众们……期待的固定环节……"},{"key":"SCENARIO_s42_01030200_05_0110","text":"既然如此……\n凛世……也不会有例外……"},{"key":"SCENARIO_s42_01030200_05_0120","text":"到那时……\n我会努力……做出好的反应……"},{"key":"SCENARIO_s42_01030200_05_0002","text":"Motion"},{"key":"SCENARIO_s42_01030200_05_0130","text":"乍一看，会觉得是个不好相处的深闺大小姐吧\n但其实完全不是那样"},{"key":"SCENARIO_s42_01030200_05_0140","text":"意外地很调皮，也很放得开"},{"key":"SCENARIO_s42_01030200_05_0150","text":"而且，她说了会为了我们的节目努力\n──那我们也得努力才行吧？"},{"key":"SCENARIO_s42_01030200_05_9994","text":"工作人员2"},{"key":"SCENARIO_s42_01030200_05_0160","text":"哈哈，原来如此啊\n那，给你个好消息"},{"key":"SCENARIO_s42_01030200_05_0170","text":"──其实我，是放课后的粉丝"},{"key":"SCENARIO_s42_01030200_05_9993","text":"工作人员1"},{"key":"SCENARIO_s42_01030200_05_0180","text":"诶！"},{"key":"SCENARIO_s42_01030200_05_9992","text":"工作人员2"},{"key":"SCENARIO_s42_01030200_05_0190","text":"我以粉丝视角给你提供些让人开心的珍贵素材！\n一起做超高质量的宣传视频吧！"},{"key":"SCENARIO_s42_01030200_05_9991","text":"工作人员1"},{"key":"SCENARIO_s42_01030200_05_0200","text":"太棒了吧～～～～！？\n拜托了拜托了！"},{"key":"SCENARIO_s43_04020000_09_0130","text":"我们是“Straylight”\n…………无论是完美，还是不完美"},{"key":"SCENARIO_s43_04020000_09_0001","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0140","text":"……舞台上的自己，我一直当作是“角色”\n觉得那是“角色”，是“虚假的”"},{"key":"SCENARIO_s43_04020000_09_0002","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0150","text":"…………所以，也许一直心怀愧疚"},{"key":"SCENARIO_s43_04020000_09_0009","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0160","text":"所以，总觉得总有一天必须展现出真正的自己"},{"key":"SCENARIO_s43_04020000_09_0170","text":"………………"},{"key":"SCENARIO_s43_04020000_09_0003","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0180","text":"…………但是，不对吗？"},{"key":"SCENARIO_s43_04020000_09_0004","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0190","text":"在这里的就是“和泉爱依”\n…………无论是“我”还是“人家”"},{"key":"SCENARIO_s43_04020000_09_0005","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0200","text":"……呵呵"},{"key":"SCENARIO_s43_04020000_09_0210","text":"真是花了不少时间呢"},{"key":"SCENARIO_s43_04020000_09_0220","text":"诶……\n冬优子酱你早就知道了吗？"},{"key":"SCENARIO_s43_04020000_09_0230","text":"倒也不是那样\n只是，想看看你会得出什么样的结论而已"},{"key":"SCENARIO_s43_04020000_09_0006","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0240","text":"哈～～～…………"},{"key":"SCENARIO_s43_04020000_09_0250","text":"────得道谢才行\n对朝日酱，也对冬优子酱"},{"key":"SCENARIO_s43_04020000_09_0260","text":"真的……真的谢谢你们……！\n还有………………"},{"key":"SCENARIO_s43_04020000_09_0270","text":"给你们添麻烦了，对不起────"},{"key":"SCENARIO_s43_04020000_09_0007","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0280","text":"……！"},{"key":"SCENARIO_s43_04020000_09_0290","text":"看吧，明白吗？\n这种地方就是不解风情"},{"key":"SCENARIO_s43_04020000_09_0008","text":"Motion"},{"key":"SCENARIO_s43_04020000_09_0300","text":"……噗……啊哈哈……！\n嗯……！谢谢你，冬优子酱……！"},{"key":"SCENARIO_s43_04020000_09_0310","text":"……你确定？不会后悔吧？"},{"key":"SCENARIO_s43_04020000_09_0320","text":"虽然是被曝光的，但利用一下也不是不行哦"},{"key":"SCENARIO_s43_04020000_09_0330","text":"嗯，我已经决定了……！"},{"key":"SCENARIO_s43_04020000_09_0340","text":"人家还是想以“这个她”继续走下去\n不是因为什么策略或手段……"},{"key":"SCENARIO_s43_04020000_09_0350","text":"对我来说，\n“这个她”已经是真实的了"},{"key":"SCENARIO_s43_04020000_09_0360","text":"…………"},{"key":"SCENARIO_s43_04020000_09_0370","text":"──那么，就给我全部踢飞掉吧？"},{"key":"SCENARIO_s43_04020000_09_0380","text":"Yes Sir！\n──Twista投稿……出发！"},{"key":"SCENARIO_s43_04020000_09_0390","text":"哇，转得好快……\n速度好惊人……"},{"key":"SCENARIO_s43_04020000_09_0400","text":"啊哈哈……sanapi发了消息"},{"key":"SCENARIO_s43_04020000_09_0410","text":"朋友？"},{"key":"SCENARIO_s43_04020000_09_0420","text":"对吧～！真的是个超温柔的孩子～\n下次也介绍给冬优子酱认识──────"},{"key":"SCENARIO_s43_04020000_09_9999","text":"爱依的Twista"},{"key":"SCENARIO_s43_04020000_09_0430","text":"『比起传言』"},{"key":"SCENARIO_s43_04020000_09_0440","text":"『更希望大家去看舞台』"},{"key":"SCENARIO_s43_04020000_09_0450","text":"『因为我就在那里』"},{"key":"SCENARIO_s43_04020000_09_0460","text":"『然后』"},{"key":"SCENARIO_s43_04020000_09_0470","text":"『我们在的地方就有舞台』"},{"key":"SCENARIO_s43_04020000_09_0480","text":"『#Straylight』"}]
