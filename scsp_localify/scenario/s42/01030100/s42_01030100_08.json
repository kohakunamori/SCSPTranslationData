[{"key":"SCENARIO_s42_01030100_08_0000","text":"Motion"},{"key":"SCENARIO_s42_01030100_08_0021","text":"副部长"},{"key":"SCENARIO_s42_01030100_08_0022","text":"田径部部长"},{"key":"SCENARIO_s42_01030100_08_0010","text":"你好……！\n咦，夏叶小姐……？"},{"key":"SCENARIO_s42_01030100_08_0020","text":"辛苦了\n你今天接下来要去田径部对吧？"},{"key":"SCENARIO_s42_01030100_08_0030","text":"一起去吧？"},{"key":"SCENARIO_s42_01030100_08_0001","text":"Motion"},{"key":"SCENARIO_s42_01030100_08_0040","text":"你好～。在等你哦～\n从今天起请多关照！"},{"key":"SCENARIO_s42_01030100_08_0050","text":"请多指教……！"},{"key":"SCENARIO_s42_01030100_08_0060","text":"今天，我也参加练习可以吗？"},{"key":"SCENARIO_s42_01030100_08_0070","text":"……诶！"},{"key":"SCENARIO_s42_01030100_08_0080","text":"当然！欢迎！\n不过夏叶小姐看起来好快……我们可能没人跑得过你"},{"key":"SCENARIO_s42_01030100_08_0090","text":"哎呀，不试试怎么知道呢？"},{"key":"SCENARIO_s42_01030100_08_0100","text":"来吧，快点开始练习吧？\n先从什么开始好呢"},{"key":"SCENARIO_s42_01030100_08_0110","text":"先从热身运动开始吧\n我去叫大家过来"},{"key":"SCENARIO_s42_01030100_08_0120","text":"那，跟大家自我介绍一下吧！"},{"key":"SCENARIO_s42_01030100_08_0130","text":"好、好的……！"},{"key":"SCENARIO_s42_01030100_08_0140","text":"副部长她们在跑步了！"},{"key":"SCENARIO_s42_01030100_08_0150","text":"呵呵……\n好棒的……表情……"},{"key":"SCENARIO_s42_01030100_08_0160","text":"……"},{"key":"SCENARIO_s42_01030100_08_0170","text":"凛世小姐！\n请多拍一些照片！"},{"key":"SCENARIO_s42_01030100_08_0180","text":"嗯……"},{"key":"SCENARIO_s42_01030100_08_0190","text":"哇，这张照片……！"},{"key":"SCENARIO_s42_01030100_08_0002","text":"Motion"},{"key":"SCENARIO_s42_01030100_08_0200","text":"主打图，用这张不错吧……！\n也问问大家的意见……！"}]
