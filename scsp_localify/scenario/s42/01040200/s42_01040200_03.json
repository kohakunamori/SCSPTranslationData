[{"key":"SCENARIO_s42_01040200_03_0001","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0010","text":"小奈，稍微──"},{"key":"SCENARIO_s42_01040200_03_0020","text":"──关于改变，想到什么了吗？"},{"key":"SCENARIO_s42_01040200_03_0030","text":"啊……\n在打电话……"},{"key":"SCENARIO_s42_01040200_03_0040","text":"『我也试着想了各种办法\n　但没想到什么具体的点子』"},{"key":"SCENARIO_s42_01040200_03_0050","text":"甘奈也一样啊\n好想要点提示什么的……"},{"key":"SCENARIO_s42_01040200_03_0060","text":"…………"},{"key":"SCENARIO_s42_01040200_03_0070","text":"『因为是作业嘛\n　得由我们自己得出结论才行呢』"},{"key":"SCENARIO_s42_01040200_03_0080","text":"嗯，甘奈也这么想\n那，想到什么了再联系你吧！"},{"key":"SCENARIO_s42_01040200_03_0081","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0090","text":"……\n果然很难呢……"},{"key":"SCENARIO_s42_01040200_03_0091","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0100","text":"（稍微换个心情\n　出去走走吧）"},{"key":"SCENARIO_s42_01040200_03_0101","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0110","text":"那、那个……"},{"key":"SCENARIO_s42_01040200_03_0120","text":"甜花酱\n甘奈想出门走走"},{"key":"SCENARIO_s42_01040200_03_0130","text":"在打游戏，对吧……？"},{"key":"SCENARIO_s42_01040200_03_0140","text":"嗯……\n路上小心……"},{"key":"SCENARIO_s42_01040200_03_0150","text":"好——"},{"key":"SCENARIO_s42_01040200_03_0151","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0000","text":"训练师"},{"key":"SCENARIO_s42_01040200_03_0160","text":"说我们太稳定了"},{"key":"SCENARIO_s42_01040200_03_0170","text":"──关于改变，想到什么了吗？"},{"key":"SCENARIO_s42_01040200_03_0180","text":"…………"},{"key":"SCENARIO_s42_01040200_03_0181","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0190","text":"小奈……！"},{"key":"SCENARIO_s42_01040200_03_0191","text":"Motion"},{"key":"SCENARIO_s42_01040200_03_0200","text":"果然……\n甜花也，要去……！"}]
