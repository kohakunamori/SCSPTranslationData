[{"key":"SCENARIO_s42_01040200_04_0000","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0010","text":"～♪"},{"key":"SCENARIO_s42_01040200_04_0020","text":"小奈……\n看起来，好开心……"},{"key":"SCENARIO_s42_01040200_04_0030","text":"因为～\n甜花酱愿意来嘛☆"},{"key":"SCENARIO_s42_01040200_04_0040","text":"这样啊……"},{"key":"SCENARIO_s42_01040200_04_0050","text":"难得出来一趟～\n想给甜花酱搭搭衣服什么的呢"},{"key":"SCENARIO_s42_01040200_04_0060","text":"诶……\n甜花的话……"},{"key":"SCENARIO_s42_01040200_04_0061","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0070","text":"……嗯、嗯……\n好啊……"},{"key":"SCENARIO_s42_01040200_04_0080","text":"真、真的……！？"},{"key":"SCENARIO_s42_01040200_04_0081","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0090","text":"……甜花酱……\n那个，你没有在……勉强自己吧……？"},{"key":"SCENARIO_s42_01040200_04_0100","text":"因为甘奈老是邀请你\n所以没办法才来的……！"},{"key":"SCENARIO_s42_01040200_04_0110","text":"没有……\n不是那样的……"},{"key":"SCENARIO_s42_01040200_04_0120","text":"想试试看……\n和平常不一样的事情……"},{"key":"SCENARIO_s42_01040200_04_0130","text":"诶……？"},{"key":"SCENARIO_s42_01040200_04_0131","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0140","text":"小奈和千雪姐，说了……\n能试着改变的事情……"},{"key":"SCENARIO_s42_01040200_04_0150","text":"虽然没怎么想明白……\n但是……"},{"key":"SCENARIO_s42_01040200_04_0160","text":"能试着改变的事情……\n甜花能做的，正在试着做……"},{"key":"SCENARIO_s42_01040200_04_0161","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0170","text":"而且，既然要做的话……\n希望是开心的事情……"},{"key":"SCENARIO_s42_01040200_04_0180","text":"所以……和小奈一起出门……\n最合适……！"},{"key":"SCENARIO_s42_01040200_04_0190","text":"……甜花……"},{"key":"SCENARIO_s42_01040200_04_0191","text":"Motion"},{"key":"SCENARIO_s42_01040200_04_0200","text":"……这样啊……！\n……甘奈，好像知道答案了！"}]
