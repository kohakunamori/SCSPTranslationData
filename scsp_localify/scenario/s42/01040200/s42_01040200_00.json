[{"key":"SCENARIO_s42_01040200_00_0009","text":"Motion"},{"key":"SCENARIO_s42_01040200_00_0011","text":"Motion"},{"key":"SCENARIO_s42_01040200_00_0000","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0010","text":"嗯，辛苦了"},{"key":"SCENARIO_s42_01040200_00_0001","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0020","text":"不愧是你们\n这首歌明明是第一次表演，却完成得很好"},{"key":"SCENARIO_s42_01040200_00_0030","text":"……！"},{"key":"SCENARIO_s42_01040200_00_0002","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0040","text":"甘奈酱，\n一如既往的可爱和活力都表现出来了"},{"key":"SCENARIO_s42_01040200_00_0050","text":"嘿嘿\n谢谢您！"},{"key":"SCENARIO_s42_01040200_00_0003","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0060","text":"甜花酱也是\n在舒缓的氛围中有着治愈人心的感觉"},{"key":"SCENARIO_s42_01040200_00_0070","text":"太好了……！"},{"key":"SCENARIO_s42_01040200_00_0004","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0080","text":"千雪酱则是\n温柔沉稳的展现方式越来越熟练了呢"},{"key":"SCENARIO_s42_01040200_00_0090","text":"不敢当"},{"key":"SCENARIO_s42_01040200_00_0100","text":"一直看着我们成长的教练能这么说\n我们真的非常开心！"},{"key":"SCENARIO_s42_01040200_00_0110","text":"嘿嘿……／嗯"},{"key":"SCENARIO_s42_01040200_00_0111","text":"Motion"},{"key":"SCENARIO_s42_01040200_00_0005","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0120","text":"……但是啊"},{"key":"SCENARIO_s42_01040200_00_0130","text":"……？"},{"key":"SCENARIO_s42_01040200_00_0006","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0140","text":"说实话，我觉得有点太稳定了"},{"key":"SCENARIO_s42_01040200_00_0150","text":"……！"},{"key":"SCENARIO_s42_01040200_00_0160","text":"太稳定……\n了……"},{"key":"SCENARIO_s42_01040200_00_0170","text":"那个，请问是什么意思呢？"},{"key":"SCENARIO_s42_01040200_00_0180","text":"您不是说我们完成得很好吗……？"},{"key":"SCENARIO_s42_01040200_00_0007","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0190","text":"嗯，所以呢\n这是作业"},{"key":"SCENARIO_s42_01040200_00_0008","text":"训练师"},{"key":"SCENARIO_s42_01040200_00_0200","text":"大家一起，好好想想吧"}]
