[{"key":"SCENARIO_s42_01890200_01_0010","text":"────制作人\n这个冷盘我可以吃吗？"},{"key":"SCENARIO_s42_01890200_01_0020","text":"嗯，是拍摄剩下的吗……\n我去确认一下，你等等"},{"key":"SCENARIO_s42_01890200_01_0030","text":"────喂，制作人！\n有天鹅船吗？"},{"key":"SCENARIO_s42_01890200_01_0040","text":"呃……\n抱歉，那个我也去确认一下，稍等"},{"key":"SCENARIO_s42_01890200_01_0050","text":"────喂，制作人\n过来一起玩嘛──！"},{"key":"SCENARIO_s42_01890200_01_0060","text":"等、等一下\n我又不会分身……！"},{"key":"SCENARIO_s42_01890200_01_0070","text":"啊哈哈……"},{"key":"SCENARIO_s42_01890200_01_0071","text":"Motion"},{"key":"SCENARIO_s42_01890200_01_0072","text":"Motion"},{"key":"SCENARIO_s42_01890200_01_0080","text":"……照片？"},{"key":"SCENARIO_s42_01890200_01_0090","text":"啊，好的……\n也想给同组合的大家看看……"},{"key":"SCENARIO_s42_01890200_01_0100","text":"这样啊"},{"key":"SCENARIO_s42_01890200_01_0110","text":"那个……美琴也，如果可以的话……"},{"key":"SCENARIO_s42_01890200_01_0120","text":"──你们两个看这边～！"},{"key":"SCENARIO_s42_01890200_01_0121","text":"Motion"},{"key":"SCENARIO_s42_01890200_01_0130","text":"接下来比个耶～！"},{"key":"SCENARIO_s42_01890200_01_0140","text":"再来个热烈欢迎的姿势～！"},{"key":"SCENARIO_s42_01890200_01_0150","text":"耶，珍贵的双人合照到手～！\n两位谢啦……！"},{"key":"SCENARIO_s42_01890200_01_0160","text":"接下来，我能也加入吗～？"},{"key":"SCENARIO_s42_01890200_01_0161","text":"Motion"},{"key":"SCENARIO_s42_01890200_01_0170","text":"……？\n嗯，可以啊……"},{"key":"SCENARIO_s42_01890200_01_0180","text":"美琴小姐和冷酷的我……\n把真乃酱夹在中间────"},{"key":"SCENARIO_s42_01890200_01_0190","text":"脸颊亲亲的姿势……！"},{"key":"SCENARIO_s42_01890200_01_0200","text":"呼哇……"},{"key":"SCENARIO_s42_01890200_01_0210","text":"耶！"},{"key":"SCENARIO_s42_01890200_01_0211","text":"真乃＆美琴"},{"key":"SCENARIO_s42_01890200_01_0220","text":"不、不用了……／呵呵"}]
