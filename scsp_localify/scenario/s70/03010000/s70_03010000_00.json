[{"key":"SCENARIO_s70_03010009_00_0010","text":"感觉这次做得干脆利落！"},{"key":"SCENARIO_s70_03010009_00_0020","text":"是不是做得还挺好的！？"},{"key":"SCENARIO_s70_03010010_00_0010","text":"对吧！感觉挺顺利的！"},{"key":"SCENARIO_s70_03010010_00_0020","text":"嗯嗯！这是我们一起努力的结果！"},{"key":"SCENARIO_s70_03010011_00_0010","text":"今天状态是不是特别好！？"},{"key":"SCENARIO_s70_03010011_00_0020","text":"感觉找到窍门了！"},{"key":"SCENARIO_s70_03010012_00_0010","text":"嗯！只要在一起，感觉什么都能做到！"},{"key":"SCENARIO_s70_03010012_00_0020","text":"嘿嘿，一下子进步了好多呢？"},{"key":"SCENARIO_s70_03010013_00_0010","text":"制作人！成功了哦！"},{"key":"SCENARIO_s70_03010014_00_0010","text":"能一起努力到现在真是太好了！"},{"key":"SCENARIO_s70_03010015_00_0010","text":"是准备不够充分……之类的？"},{"key":"SCENARIO_s70_03010016_00_0010","text":"想想哪里做得不好吧！"},{"key":"SCENARIO_s70_03010017_00_0010","text":"对不起，搞砸了……"},{"key":"SCENARIO_s70_03010018_00_0010","text":"……好！朝着下次加油吧！"},{"key":"SCENARIO_s70_03010027_00_0010","text":"这说明还有成长空间！"},{"key":"SCENARIO_s70_03010028_00_0010","text":"想学会更多更多的事情呢。"},{"key":"SCENARIO_s70_03010029_00_0010","text":"感觉现在特别有偶像的样子！"},{"key":"SCENARIO_s70_03010030_00_0010","text":"能感觉到自己在前进！"},{"key":"SCENARIO_s70_03010031_00_0010","text":"已经走到这一步了啊！"},{"key":"SCENARIO_s70_03010032_00_0010","text":"感觉还没有太多实感呢！"},{"key":"SCENARIO_s70_03010033_00_0010","text":"想一口气往上冲！"},{"key":"SCENARIO_s70_03010034_00_0010","text":"那样的话，想做的事情就能做到了嘛。"},{"key":"SCENARIO_s70_03010035_00_0010","text":"下次要把“感觉像”变成“就是”！"},{"key":"SCENARIO_s70_03010036_00_0010","text":"这都是多亏了制作人哦！"},{"key":"SCENARIO_s70_03010037_00_0010","text":"总觉得，感觉自己还能走得更远呢！"},{"key":"SCENARIO_s70_03010038_00_0010","text":"制作人，真的谢谢你陪我走到这里！"}]
