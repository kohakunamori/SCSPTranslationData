[{"key":"SCENARIO_s70_17010009_00_0010","text":"还能继续的！"},{"key":"SCENARIO_s70_17010009_00_0020","text":"挺能干的嘛！"},{"key":"SCENARIO_s70_17010010_00_0010","text":"我，还想做更多！"},{"key":"SCENARIO_s70_17010010_00_0020","text":"接下来做什么呢～"},{"key":"SCENARIO_s70_17010011_00_0010","text":"大发现呢！"},{"key":"SCENARIO_s70_17010011_00_0020","text":"原来如此，是这样做的啊……"},{"key":"SCENARIO_s70_17010012_00_0010","text":"好耶～！"},{"key":"SCENARIO_s70_17010012_00_0020","text":"感觉还能做得更多更多！"},{"key":"SCENARIO_s70_17010013_00_0010","text":"这个……好厉害！"},{"key":"SCENARIO_s70_17010014_00_0010","text":"超开心的！"},{"key":"SCENARIO_s70_17010015_00_0010","text":"那个地方……再……"},{"key":"SCENARIO_s70_17010016_00_0010","text":"让我再做一次！"},{"key":"SCENARIO_s70_17010017_00_0010","text":"不想就这样结束！"},{"key":"SCENARIO_s70_17010018_00_0010","text":"下次一定要赢！"},{"key":"SCENARIO_s70_17010027_00_0010","text":"唔嗯……不能接受～……"},{"key":"SCENARIO_s70_17010028_00_0010","text":"不会就这样结束的，对吧？"},{"key":"SCENARIO_s70_17010029_00_0010","text":"是不是稍微有点上手了？"},{"key":"SCENARIO_s70_17010030_00_0010","text":"感觉一点点地，开始明白了"},{"key":"SCENARIO_s70_17010031_00_0010","text":"啊哈哈，好开心～！"},{"key":"SCENARIO_s70_17010032_00_0010","text":"眼前，满是闪闪发光的东西……"},{"key":"SCENARIO_s70_17010033_00_0010","text":"还要更加努力～！"},{"key":"SCENARIO_s70_17010034_00_0010","text":"还有更多更多……能做到的事情才对"},{"key":"SCENARIO_s70_17010035_00_0010","text":"下次要朝着更高的目标前进！"},{"key":"SCENARIO_s70_17010036_00_0010","text":"感觉还会有更多好玩的事！"},{"key":"SCENARIO_s70_17010037_00_0010","text":"下次，要朝着顶点去～！"},{"key":"SCENARIO_s70_17010038_00_0010","text":"兴奋的感觉，停不下来～！"}]
