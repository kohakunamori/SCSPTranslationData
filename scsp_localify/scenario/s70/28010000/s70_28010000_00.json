[{"key":"SCENARIO_s70_28010009_00_0010","text":"哇，配合得天衣无缝！"},{"key":"SCENARIO_s70_28010009_00_0020","text":"好开心～"},{"key":"SCENARIO_s70_28010010_00_0010","text":"就保持现在的感觉，加油吧！"},{"key":"SCENARIO_s70_28010010_00_0020","text":"下次再一起吧"},{"key":"SCENARIO_s70_28010011_00_0010","text":"完美！ 对上了呢～"},{"key":"SCENARIO_s70_28010011_00_0020","text":"刚才那个，简直完美吧……！"},{"key":"SCENARIO_s70_28010012_00_0010","text":"感觉，自信心要冒出来了～……！"},{"key":"SCENARIO_s70_28010012_00_0020","text":"感觉我们的话，哪里都能去！"},{"key":"SCENARIO_s70_28010013_00_0010","text":"做到了～！ 都是大家的功劳"},{"key":"SCENARIO_s70_28010014_00_0010","text":"心里，满满的……！"},{"key":"SCENARIO_s70_28010015_00_0010","text":"啊……好可惜……"},{"key":"SCENARIO_s70_28010016_00_0010","text":"挺直腰板，再来一次……！"},{"key":"SCENARIO_s70_28010017_00_0010","text":"没能触及到呢……"},{"key":"SCENARIO_s70_28010018_00_0010","text":"下次一定……！ 请看着吧……！"},{"key":"SCENARIO_s70_28010027_00_0010","text":"马马虎虎……吧？"},{"key":"SCENARIO_s70_28010028_00_0010","text":"怎么样？"},{"key":"SCENARIO_s70_28010029_00_0010","text":"呼……大概这种感觉吧？"},{"key":"SCENARIO_s70_28010030_00_0010","text":"嗯，感觉越来越好了呢"},{"key":"SCENARIO_s70_28010031_00_0010","text":"嘿嘿，耶──"},{"key":"SCENARIO_s70_28010032_00_0010","text":"呵呵！ 做到了～！"},{"key":"SCENARIO_s70_28010033_00_0010","text":"下次想更加努力"},{"key":"SCENARIO_s70_28010034_00_0010","text":"有需要改进的地方，得好好修正才行！"},{"key":"SCENARIO_s70_28010035_00_0010","text":"被夸奖的话我会很开心的～"},{"key":"SCENARIO_s70_28010036_00_0010","text":"还想朝着更高的目标前进……！"},{"key":"SCENARIO_s70_28010037_00_0010","text":"你看到了吗？ 制作人"},{"key":"SCENARIO_s70_28010038_00_0010","text":"呜……谢谢你……。这是我最满意的表现！"}]
