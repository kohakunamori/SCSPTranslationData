[{"key":"SCENARIO_s70_20002003_00_0010","text":"呵呵，别灰心"},{"key":"SCENARIO_s70_20002004_00_0010","text":"做到了？　还是说一般般？"},{"key":"SCENARIO_s70_20002005_00_0010","text":"做到了吧，相当不错"},{"key":"SCENARIO_s70_20002006_00_0010","text":"太厉害了，超厉害的"},{"key":"SCENARIO_s70_20002007_00_0010","text":"好厉害好厉害"},{"key":"SCENARIO_s70_20002008_00_0010","text":"看到了吗？　闪闪发光的"}]
