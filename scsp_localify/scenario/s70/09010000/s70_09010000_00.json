[{"key":"SCENARIO_s70_09010009_00_0010","text":"感觉做得挺好的！"},{"key":"SCENARIO_s70_09010009_00_0020","text":"做得很好—！"},{"key":"SCENARIO_s70_09010010_00_0010","text":"嗯！ 超级开心！"},{"key":"SCENARIO_s70_09010010_00_0020","text":"嘿嘿，完美！"},{"key":"SCENARIO_s70_09010011_00_0010","text":"满分！"},{"key":"SCENARIO_s70_09010011_00_0020","text":"就这么定了！"},{"key":"SCENARIO_s70_09010012_00_0010","text":"嗯！ 完全胜利！"},{"key":"SCENARIO_s70_09010012_00_0020","text":"和大家在一起就绝对不会输！"},{"key":"SCENARIO_s70_09010013_00_0010","text":"哇—！ 做到了！"},{"key":"SCENARIO_s70_09010014_00_0010","text":"超级帅的对吧……！"},{"key":"SCENARIO_s70_09010015_00_0010","text":"只要不放弃就不算失败对吧……？"},{"key":"SCENARIO_s70_09010016_00_0010","text":"再挑战一次吧！"},{"key":"SCENARIO_s70_09010017_00_0010","text":"还有下次对吧……？"},{"key":"SCENARIO_s70_09010018_00_0010","text":"嗯……下次一定……！"},{"key":"SCENARIO_s70_09010027_00_0010","text":"下次要更加更加努力！"},{"key":"SCENARIO_s70_09010028_00_0010","text":"放弃了就结束了……！"},{"key":"SCENARIO_s70_09010029_00_0010","text":"我，在向前走着对吧……！"},{"key":"SCENARIO_s70_09010030_00_0010","text":"感觉还能继续！"},{"key":"SCENARIO_s70_09010031_00_0010","text":"都是托Producer先生的福—！"},{"key":"SCENARIO_s70_09010032_00_0010","text":"Producer先生是英雄！"},{"key":"SCENARIO_s70_09010033_00_0010","text":"所以……我不会放弃的！"},{"key":"SCENARIO_s70_09010034_00_0010","text":"还想再练习……！"},{"key":"SCENARIO_s70_09010035_00_0010","text":"“向前走就能看到前方”——"},{"key":"SCENARIO_s70_09010036_00_0010","text":"想要更加更加更加更加努力—！"},{"key":"SCENARIO_s70_09010037_00_0010","text":"放课后的大家——都很强！"},{"key":"SCENARIO_s70_09010038_00_0010","text":"到这里……到顶点了！ 到了！"}]
