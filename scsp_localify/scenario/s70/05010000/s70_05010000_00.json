[{"key":"SCENARIO_s70_05010009_00_0010","text":"不错嘛～？"},{"key":"SCENARIO_s70_05010009_00_0020","text":"训练结束～"},{"key":"SCENARIO_s70_05010010_00_0010","text":"嘛，就一般般吧～"},{"key":"SCENARIO_s70_05010010_00_0020","text":"那，我去休息了"},{"key":"SCENARIO_s70_05010011_00_0010","text":"完美嘛"},{"key":"SCENARIO_s70_05010011_00_0020","text":"不知不觉就做到了呢"},{"key":"SCENARIO_s70_05010012_00_0010","text":"呵呵～，感觉超满足的～？"},{"key":"SCENARIO_s70_05010012_00_0020","text":"开始期待下次了呢"},{"key":"SCENARIO_s70_05010013_00_0010","text":"看到我的认真了吗～？"},{"key":"SCENARIO_s70_05010014_00_0010","text":"下次也别错过哦～"},{"key":"SCENARIO_s70_05010015_00_0010","text":"嘛，就当是发现了课题吧～"},{"key":"SCENARIO_s70_05010016_00_0010","text":"陪你练习也不是不行哦～"},{"key":"SCENARIO_s70_05010017_00_0010","text":"……不行了"},{"key":"SCENARIO_s70_05010018_00_0010","text":"下次会更努力的～"},{"key":"SCENARIO_s70_05010027_00_0010","text":"也就这样吧～"},{"key":"SCENARIO_s70_05010028_00_0010","text":"感觉才刚开始呢～"},{"key":"SCENARIO_s70_05010029_00_0010","text":"嘛，一般般吧～"},{"key":"SCENARIO_s70_05010030_00_0010","text":"感觉还行吧～"},{"key":"SCENARIO_s70_05010031_00_0010","text":"呵呵～，这样的话就无可挑剔了吧～？"},{"key":"SCENARIO_s70_05010032_00_0010","text":"那个～……再多夸夸我也行哦～？"},{"key":"SCENARIO_s70_05010033_00_0010","text":"就这样结束了吗"},{"key":"SCENARIO_s70_05010034_00_0010","text":"嘛，我会慢慢来的～"},{"key":"SCENARIO_s70_05010035_00_0010","text":"下次会做好的～"},{"key":"SCENARIO_s70_05010036_00_0010","text":"就是这样～，下次也请多关照～"},{"key":"SCENARIO_s70_05010037_00_0010","text":"制作人，奖励是什么呀？"},{"key":"SCENARIO_s70_05010038_00_0010","text":"呵呵～，刚才感动了吗？"}]
