[{"key":"SCENARIO_s70_27010009_00_0010","text":"呵呵，怎么样？"},{"key":"SCENARIO_s70_27010009_00_0020","text":"啊哈，很棒对吧？"},{"key":"SCENARIO_s70_27010010_00_0010","text":"就保持这个感觉冲吧──"},{"key":"SCENARIO_s70_27010010_00_0020","text":"呵呵，好开心啊──"},{"key":"SCENARIO_s70_27010011_00_0010","text":"顺利完成，太好了──"},{"key":"SCENARIO_s70_27010011_00_0020","text":"呀──，做到了呢──！"},{"key":"SCENARIO_s70_27010012_00_0010","text":"绝对是最完美的──"},{"key":"SCENARIO_s70_27010012_00_0020","text":"交给我们吧？"},{"key":"SCENARIO_s70_27010013_00_0010","text":"进行得很顺利吧？"},{"key":"SCENARIO_s70_27010014_00_0010","text":"就保持这个势头继续加油吧"},{"key":"SCENARIO_s70_27010015_00_0010","text":"哇──，好可惜……"},{"key":"SCENARIO_s70_27010016_00_0010","text":"再试一次吧──"},{"key":"SCENARIO_s70_27010017_00_0010","text":"下次要更加努力……！"},{"key":"SCENARIO_s70_27010018_00_0010","text":"我会好好反省的……"},{"key":"SCENARIO_s70_27010027_00_0010","text":"意思是──还差得远？"},{"key":"SCENARIO_s70_27010028_00_0010","text":"嗯──，这样啊──……"},{"key":"SCENARIO_s70_27010029_00_0010","text":"大概就是这个程度吧？"},{"key":"SCENARIO_s70_27010030_00_0010","text":"还有能做的事，对吧？"},{"key":"SCENARIO_s70_27010031_00_0010","text":"哇──，太好了……！"},{"key":"SCENARIO_s70_27010032_00_0010","text":"呀──，好厉害──！"},{"key":"SCENARIO_s70_27010033_00_0010","text":"我会更加努力的～……！"},{"key":"SCENARIO_s70_27010034_00_0010","text":"就当是潜力──怎么样？"},{"key":"SCENARIO_s70_27010035_00_0010","text":"在这里就满足的话，可不行呢"},{"key":"SCENARIO_s70_27010036_00_0010","text":"只要在一起，我还能继续努力"},{"key":"SCENARIO_s70_27010037_00_0010","text":"呐，能夸夸我吗？"},{"key":"SCENARIO_s70_27010038_00_0010","text":"……这也是，多亏了制作人呢？"}]
