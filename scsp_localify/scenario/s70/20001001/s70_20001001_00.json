[{"key":"SCENARIO_s70_20001001_00_0010","text":"哈啊……啊，抱歉\n早上好，制作人"},{"key":"SCENARIO_s70_20001001_00_0020","text":"吃吗？　零食"},{"key":"SCENARIO_s70_20001001_00_0030","text":"拿给你拿给你，日志\n等一下"},{"key":"SCENARIO_s70_20001002_00_0010","text":"喂\n听得到吗？\n喂"},{"key":"SCENARIO_s70_20001002_00_0020","text":"回去吧"},{"key":"SCENARIO_s70_20001001_00_0040","text":"呵呵，打哈欠？\n……哈啊\n完了，会传染的"},{"key":"SCENARIO_s70_20001001_00_0050","text":"喂\n可以吃吗？　这个\n喂"},{"key":"SCENARIO_s70_20001003_00_0010","text":"赌100块会一直晴下去\n呵呵，怎么样？"},{"key":"SCENARIO_s70_20001003_00_0020","text":"哈啊…………"},{"key":"SCENARIO_s70_20001004_00_0010","text":"『阴』这个字\n感觉就是阴沉沉的。超有"},{"key":"SCENARIO_s70_20001005_00_0010","text":"下雨了啊"},{"key":"SCENARIO_s70_20001005_00_0020","text":"有吗？　伞"},{"key":"SCENARIO_s70_20001006_00_0010","text":"呵呵，淋着走？"},{"key":"SCENARIO_s70_20001007_00_0010","text":"好白\n雪"},{"key":"SCENARIO_s70_20001010_00_0010","text":"天真高啊"},{"key":"SCENARIO_s70_20001010_00_0020","text":"秋天？\n诶，什么时候开始是秋天了？"},{"key":"SCENARIO_s70_20001030_00_0010","text":"又要老一岁了？\n……等等我啊"},{"key":"SCENARIO_s70_20001011_00_0010","text":"冷吗？　雪人\n一般？　热吗？"},{"key":"SCENARIO_s70_20001011_00_0020","text":"好冷\n冷冷冷冷冷冷……"},{"key":"SCENARIO_s70_20001014_00_0010","text":"万圣节\n你好。我要赢"},{"key":"SCENARIO_s70_20001015_00_0010","text":"诶，是节日吧\n圣诞节"},{"key":"SCENARIO_s70_20001036_00_0010","text":"耶\n明年见"},{"key":"SCENARIO_s70_20001018_00_0010","text":"生日啊\n真是很有生日的感觉呢"},{"key":"SCENARIO_s70_20001020_00_0010","text":"樋口的生日？\n生日快乐，耶"},{"key":"SCENARIO_s70_20001021_00_0010","text":"小糸酱的生日？\n生日快乐，好耶"},{"key":"SCENARIO_s70_20001022_00_0010","text":"是雏菜的生日吧？　她说过\n生日快乐，耶"},{"key":"SCENARIO_s70_20001012_00_0010","text":"压岁钱？\n拿到了。要挥霍一番"},{"key":"SCENARIO_s70_20001016_00_0010","text":"巧克力谢啦"},{"key":"SCENARIO_s70_20001008_00_0010","text":"春天了啊"},{"key":"SCENARIO_s70_20001008_00_0020","text":"嗯，春天了啊"},{"key":"SCENARIO_s70_20001017_00_0010","text":"今天是什么日子来着"},{"key":"SCENARIO_s70_20001033_00_0010","text":"吃吗？\n米花糖\n……那，张嘴"},{"key":"SCENARIO_s70_20001009_00_0010","text":"没有哦，防晒霜什么的\n黏糊糊的"},{"key":"SCENARIO_s70_20001009_00_0020","text":"夏天"},{"key":"SCENARIO_s70_20001013_00_0010","text":"喂，让天放晴嘛\n喂"},{"key":"SCENARIO_s70_20001031_00_0010","text":"月亮\n好圆呢，超圆的\n有没有兔子呢"},{"key":"SCENARIO_s70_20001032_00_0010","text":"银河……\n听说可以渡过去呢\n一年只有一次"},{"key":"SCENARIO_s70_20001034_00_0010","text":"诶\n花火大会？\n要去吗？"},{"key":"SCENARIO_s70_20001035_00_0010","text":"键～屋……\n玉～屋……"}]
