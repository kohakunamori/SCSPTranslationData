[{"key":"SCENARIO_s70_15010009_00_0010","text":"甜花，努力了……！"},{"key":"SCENARIO_s70_15010009_00_0020","text":"变厉害了吗……？"},{"key":"SCENARIO_s70_15010010_00_0010","text":"这个势头……不错……"},{"key":"SCENARIO_s70_15010010_00_0020","text":"好像明白了……大概……！"},{"key":"SCENARIO_s70_15010011_00_0010","text":"嘿嘿……好开心……"},{"key":"SCENARIO_s70_15010011_00_0020","text":"总觉得……好像开始明白了……！"},{"key":"SCENARIO_s70_15010012_00_0010","text":"下次……也会加油的……！"},{"key":"SCENARIO_s70_15010012_00_0020","text":"这种感觉……要记住……！"},{"key":"SCENARIO_s70_15010013_00_0010","text":"诶嘿嘿……"},{"key":"SCENARIO_s70_15010014_00_0010","text":"胜利的……V字手势……！"},{"key":"SCENARIO_s70_15010015_00_0010","text":"没能好好做到……"},{"key":"SCENARIO_s70_15010016_00_0010","text":"下次……要更加……"},{"key":"SCENARIO_s70_15010017_00_0010","text":"明明努力了，却……"},{"key":"SCENARIO_s70_15010018_00_0010","text":"为什么呢……"},{"key":"SCENARIO_s70_15010027_00_0010","text":"因为甜花……等级还低……"},{"key":"SCENARIO_s70_15010028_00_0010","text":"本来可以……再多做到一点的……"},{"key":"SCENARIO_s70_15010029_00_0010","text":"甜花……也有在好好当偶像吗……？"},{"key":"SCENARIO_s70_15010030_00_0010","text":"嘿嘿……甜花她们，好厉害……！"},{"key":"SCENARIO_s70_15010031_00_0010","text":"能努力过来……都是多亏了大家……"},{"key":"SCENARIO_s70_15010032_00_0010","text":"制作人……谢谢你……！"},{"key":"SCENARIO_s70_15010033_00_0010","text":"等级……得提升才行，呢……"},{"key":"SCENARIO_s70_15010034_00_0010","text":"甜花要是……有更多体力的话……"},{"key":"SCENARIO_s70_15010035_00_0010","text":"嘿嘿……会加油的，呢……！"},{"key":"SCENARIO_s70_15010036_00_0010","text":"在升级……对吧……！"},{"key":"SCENARIO_s70_15010037_00_0010","text":"甜花……也有帮上忙吗……？"},{"key":"SCENARIO_s70_15010038_00_0010","text":"甜花……也成了偶像了……！"}]
