[{"key":"SCENARIO_s70_19002003_00_0010","text":"抱歉！　我会多练习的～……！"},{"key":"SCENARIO_s70_19002004_00_0010","text":"感觉挺不错的吧？"},{"key":"SCENARIO_s70_19002005_00_0010","text":"呼，真是场好演出！"},{"key":"SCENARIO_s70_19002006_00_0010","text":"哇，真的超厉害的吧！"},{"key":"SCENARIO_s70_19002007_00_0010","text":"等等，真的假的……！　简直不敢相信……！"},{"key":"SCENARIO_s70_19002008_00_0010","text":"感觉现在什么都能做到！"}]
