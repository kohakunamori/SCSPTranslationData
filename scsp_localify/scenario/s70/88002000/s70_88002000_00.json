[{"key":"SCENARIO_s70_88002003_00_0010","text":"是练习还不够吗～……。"},{"key":"SCENARIO_s70_88002004_00_0010","text":"怎么样，制作人？"},{"key":"SCENARIO_s70_88002005_00_0010","text":"嘿嘿！ 太──棒了！"},{"key":"SCENARIO_s70_88002006_00_0010","text":"还能继续哦，制作人！"},{"key":"SCENARIO_s70_88002007_00_0010","text":"总觉得我，超级感动的！"},{"key":"SCENARIO_s70_88002008_00_0010","text":"唔──！ 心情最──棒了！"}]
