[{"key":"SCENARIO_s70_27002003_00_0010","text":"诶——，不行吗……？"},{"key":"SCENARIO_s70_27002004_00_0010","text":"还行？……一般般？"},{"key":"SCENARIO_s70_27002005_00_0010","text":"制作人，能好好夸夸我吗？"},{"key":"SCENARIO_s70_27002006_00_0010","text":"感觉怎么样……？"},{"key":"SCENARIO_s70_27002007_00_0010","text":"超棒的，对吧……！？"},{"key":"SCENARIO_s70_27002008_00_0010","text":"这种感觉，好想一直记住啊──！"}]
