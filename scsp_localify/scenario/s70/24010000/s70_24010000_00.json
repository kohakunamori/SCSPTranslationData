[{"key":"SCENARIO_s70_24010009_00_0010","text":"怎、怎么样呢……？"},{"key":"SCENARIO_s70_24010009_00_0020","text":"这种程度的话，嗯"},{"key":"SCENARIO_s70_24010010_00_0010","text":"好，辛苦了！"},{"key":"SCENARIO_s70_24010010_00_0020","text":"我会好好复习的！"},{"key":"SCENARIO_s70_24010011_00_0010","text":"稍微，做到了吗……"},{"key":"SCENARIO_s70_24010011_00_0020","text":"我觉得不差！"},{"key":"SCENARIO_s70_24010012_00_0010","text":"非，非常感谢……！"},{"key":"SCENARIO_s70_24010012_00_0020","text":"还没到值得夸奖的程度……！"},{"key":"SCENARIO_s70_24010013_00_0010","text":"太好了……！"},{"key":"SCENARIO_s70_24010014_00_0010","text":"好……！"},{"key":"SCENARIO_s70_24010015_00_0010","text":"抱歉，完全不行……"},{"key":"SCENARIO_s70_24010016_00_0010","text":"啊，请不要道歉……！"},{"key":"SCENARIO_s70_24010017_00_0010","text":"是因为我拖了后腿……"},{"key":"SCENARIO_s70_24010018_00_0010","text":"所以说，是我不行啊……！"},{"key":"SCENARIO_s70_24010027_00_0010","text":"还差得远……"},{"key":"SCENARIO_s70_24010028_00_0010","text":"……只能做了"},{"key":"SCENARIO_s70_24010029_00_0010","text":"现在才刚开始……"},{"key":"SCENARIO_s70_24010030_00_0010","text":"……感觉，做得还不错吧"},{"key":"SCENARIO_s70_24010031_00_0010","text":"啊哈哈，怎么说呢，说不出话来……"},{"key":"SCENARIO_s70_24010032_00_0010","text":"好……！"},{"key":"SCENARIO_s70_24010033_00_0010","text":"这种程度怎么行……"},{"key":"SCENARIO_s70_24010034_00_0010","text":"怎么可能在这里就结束"},{"key":"SCENARIO_s70_24010035_00_0010","text":"还差得远呢。还差得远……"},{"key":"SCENARIO_s70_24010036_00_0010","text":"顺利……吧！"},{"key":"SCENARIO_s70_24010037_00_0010","text":"……太好了"},{"key":"SCENARIO_s70_24010038_00_0010","text":"……骗人的吧"}]
