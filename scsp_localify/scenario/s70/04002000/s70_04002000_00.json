[{"key":"SCENARIO_s70_04002003_00_0010","text":"我可不会因为这种事就气馁！"},{"key":"SCENARIO_s70_04002004_00_0010","text":"感觉还能往更高的目标前进呢！"},{"key":"SCENARIO_s70_04002005_00_0010","text":"呵呵～，不愧是我嘛！"},{"key":"SCENARIO_s70_04002006_00_0010","text":"超～级厉害的说～～！"},{"key":"SCENARIO_s70_04002007_00_0010","text":"诶嘿嘿～，这就是我的实力哦！"},{"key":"SCENARIO_s70_04002008_00_0010","text":"我……开心得都要疯掉了……！"}]
