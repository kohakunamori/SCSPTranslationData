[{"key":"SCENARIO_s70_04010009_00_0010","text":"做得不错！"},{"key":"SCENARIO_s70_04010009_00_0020","text":"完美！"},{"key":"SCENARIO_s70_04010010_00_0010","text":"就照这个势头继续加油吧！"},{"key":"SCENARIO_s70_04010010_00_0020","text":"找到窍门了！"},{"key":"SCENARIO_s70_04010011_00_0010","text":"完美～～！ 真不愧是！"},{"key":"SCENARIO_s70_04010011_00_0020","text":"我们状态绝佳呢！"},{"key":"SCENARIO_s70_04010012_00_0010","text":"这样就能更加厉害了！"},{"key":"SCENARIO_s70_04010012_00_0020","text":"呵呵呵，自己的才能好可怕呀"},{"key":"SCENARIO_s70_04010013_00_0010","text":"这就是我们的实力哦！"},{"key":"SCENARIO_s70_04010014_00_0010","text":"所向无敌呢！"},{"key":"SCENARIO_s70_04010015_00_0010","text":"做得太过头了……"},{"key":"SCENARIO_s70_04010016_00_0010","text":"得从头再来才行！"},{"key":"SCENARIO_s70_04010017_00_0010","text":"搞砸了～……"},{"key":"SCENARIO_s70_04010018_00_0010","text":"下次绝对不会输！"},{"key":"SCENARIO_s70_04010027_00_0010","text":"我们可不止这种程度！"},{"key":"SCENARIO_s70_04010028_00_0010","text":"正在一点点成长呢！"},{"key":"SCENARIO_s70_04010029_00_0010","text":"制作人，你看到了吗～～～？"},{"key":"SCENARIO_s70_04010030_00_0010","text":"嗯嗯，感觉不错～！"},{"key":"SCENARIO_s70_04010031_00_0010","text":"嘿嘿，超～厉害的！！"},{"key":"SCENARIO_s70_04010032_00_0010","text":"这就是……我梦想中的偶像！"},{"key":"SCENARIO_s70_04010033_00_0010","text":"还得继续努力练习才行呢……！"},{"key":"SCENARIO_s70_04010034_00_0010","text":"要朝着更高的目标努力才行！"},{"key":"SCENARIO_s70_04010035_00_0010","text":"我们，越来越有偶像的样子了呢～！"},{"key":"SCENARIO_s70_04010036_00_0010","text":"离超～厉害的偶像，还差一步……！"},{"key":"SCENARIO_s70_04010037_00_0010","text":"制作人，真的谢谢你！"},{"key":"SCENARIO_s70_04010038_00_0010","text":"我们和制作人在一起的话，就是无敌的！"}]
