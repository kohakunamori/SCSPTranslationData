[{"key":"SCENARIO_s70_22010009_00_0010","text":"应、应该做到了吧……？"},{"key":"SCENARIO_s70_22010009_00_0020","text":"太、太好了……"},{"key":"SCENARIO_s70_22010010_00_0010","text":"辛、辛苦了……！"},{"key":"SCENARIO_s70_22010010_00_0020","text":"下、下次也能行……！"},{"key":"SCENARIO_s70_22010011_00_0010","text":"感、感觉不错……！"},{"key":"SCENARIO_s70_22010011_00_0020","text":"在、在成长呢……！"},{"key":"SCENARIO_s70_22010012_00_0010","text":"当、当然的吧……！"},{"key":"SCENARIO_s70_22010012_00_0020","text":"很、很轻松的吧……！"},{"key":"SCENARIO_s70_22010013_00_0010","text":"大、大家都好厉害……！"},{"key":"SCENARIO_s70_22010014_00_0010","text":"做、做到了呢……！"},{"key":"SCENARIO_s70_22010015_00_0010","text":"大、大家，那个……"},{"key":"SCENARIO_s70_22010016_00_0010","text":"下、下次，能做到的……！"},{"key":"SCENARIO_s70_22010017_00_0010","text":"都、都是我的错……"},{"key":"SCENARIO_s70_22010018_00_0010","text":"得、得更认真才行……"},{"key":"SCENARIO_s70_22010027_00_0010","text":"就、就这样结束了吗……？"},{"key":"SCENARIO_s70_22010028_00_0010","text":"还、还能继续的吧……？"},{"key":"SCENARIO_s70_22010029_00_0010","text":"还、还能做得更好……！"},{"key":"SCENARIO_s70_22010030_00_0010","text":"觉、觉得多少有点进步了……"},{"key":"SCENARIO_s70_22010031_00_0010","text":"觉得坚持到这里，真是太好了……"},{"key":"SCENARIO_s70_22010032_00_0010","text":"我、我们，好厉害呢……！"},{"key":"SCENARIO_s70_22010033_00_0010","text":"只、只能做了…… "},{"key":"SCENARIO_s70_22010034_00_0010","text":"得、得再多练习才行……"},{"key":"SCENARIO_s70_22010035_00_0010","text":"我会比现在更加努力的……！"},{"key":"SCENARIO_s70_22010036_00_0010","text":"我、我还绰绰有余呢……！"},{"key":"SCENARIO_s70_22010037_00_0010","text":"嘛、嘛，理所当然的……！"},{"key":"SCENARIO_s70_22010038_00_0010","text":"制作人，谢、谢谢你……！"}]
