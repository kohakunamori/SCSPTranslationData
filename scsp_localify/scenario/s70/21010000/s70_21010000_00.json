[{"key":"SCENARIO_s70_21010009_00_0010","text":"差不多就这样吧"},{"key":"SCENARIO_s70_21010009_00_0020","text":"要结束了吗？差不多该了吧"},{"key":"SCENARIO_s70_21010010_00_0010","text":"口渴了"},{"key":"SCENARIO_s70_21010010_00_0020","text":"辛苦了"},{"key":"SCENARIO_s70_21010011_00_0010","text":"OK——"},{"key":"SCENARIO_s70_21010011_00_0020","text":"不也挺好的"},{"key":"SCENARIO_s70_21010012_00_0010","text":"嗯——"},{"key":"SCENARIO_s70_21010012_00_0020","text":"那，就这样"},{"key":"SCENARIO_s70_21010013_00_0010","text":"好像合格了呢"},{"key":"SCENARIO_s70_21010014_00_0010","text":"……辛苦了"},{"key":"SCENARIO_s70_21010015_00_0010","text":"嗯……好累"},{"key":"SCENARIO_s70_21010016_00_0010","text":"先休息一下吧"},{"key":"SCENARIO_s70_21010017_00_0010","text":"好像不合格呢"},{"key":"SCENARIO_s70_21010018_00_0010","text":"嗯？嗯……"},{"key":"SCENARIO_s70_21010027_00_0010","text":"……哼"},{"key":"SCENARIO_s70_21010028_00_0010","text":"啊，好的"},{"key":"SCENARIO_s70_21010029_00_0010","text":"辛苦了"},{"key":"SCENARIO_s70_21010030_00_0010","text":"嘛，就这样吧"},{"key":"SCENARIO_s70_21010031_00_0010","text":"有意思的结果"},{"key":"SCENARIO_s70_21010032_00_0010","text":"……哼"},{"key":"SCENARIO_s70_21010033_00_0010","text":"……那么，辛苦了"},{"key":"SCENARIO_s70_21010034_00_0010","text":"有什么指教的话我会听的，形式上的"},{"key":"SCENARIO_s70_21010035_00_0010","text":"今后也会努力的，差不多那种程度"},{"key":"SCENARIO_s70_21010036_00_0010","text":"……那，可以了吗？"},{"key":"SCENARIO_s70_21010037_00_0010","text":"这下你满意了吧"},{"key":"SCENARIO_s70_21010038_00_0010","text":"……嗯"}]
