[{"key":"SCENARIO_s70_11010009_00_0010","text":"干得好"},{"key":"SCENARIO_s70_11010009_00_0020","text":"大家都很努力了呢"},{"key":"SCENARIO_s70_11010010_00_0010","text":"接下来也很期待啊"},{"key":"SCENARIO_s70_11010010_00_0020","text":"感觉抓到点什么了"},{"key":"SCENARIO_s70_11010011_00_0010","text":"刚才那个，好厉害！"},{"key":"SCENARIO_s70_11010011_00_0020","text":"真是配合得天衣无缝啊"},{"key":"SCENARIO_s70_11010012_00_0010","text":"都是大家的功劳"},{"key":"SCENARIO_s70_11010012_00_0020","text":"好，这结果我很满意"},{"key":"SCENARIO_s70_11010013_00_0010","text":"太好了！"},{"key":"SCENARIO_s70_11010014_00_0010","text":"太棒了"},{"key":"SCENARIO_s70_11010015_00_0010","text":"还差一点没够到吗……"},{"key":"SCENARIO_s70_11010016_00_0010","text":"再来一次挑战"},{"key":"SCENARIO_s70_11010017_00_0010","text":"啊——真可惜"},{"key":"SCENARIO_s70_11010018_00_0010","text":"应该还能做得更好的"},{"key":"SCENARIO_s70_11010027_00_0010","text":"嗯……"},{"key":"SCENARIO_s70_11010028_00_0010","text":"还算可以，吧？"},{"key":"SCENARIO_s70_11010029_00_0010","text":"嗯，差不多就这样吧"},{"key":"SCENARIO_s70_11010030_00_0010","text":"感觉不错"},{"key":"SCENARIO_s70_11010031_00_0010","text":"大家都露出笑容了呢"},{"key":"SCENARIO_s70_11010032_00_0010","text":"好……！　做到了……！"},{"key":"SCENARIO_s70_11010033_00_0010","text":"感觉还能继续加油"},{"key":"SCENARIO_s70_11010034_00_0010","text":"转换心情，继续下一个吧"},{"key":"SCENARIO_s70_11010035_00_0010","text":"已经慢慢成形了呢"},{"key":"SCENARIO_s70_11010036_00_0010","text":"朝着更高的目标前进吧"},{"key":"SCENARIO_s70_11010037_00_0010","text":"谢了，Producer！"},{"key":"SCENARIO_s70_11010038_00_0010","text":"能走到这一步，都是多亏了Producer"}]
