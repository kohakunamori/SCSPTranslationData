[{"key":"SCENARIO_s70_13010009_00_0010","text":"理所当然的结果呢！"},{"key":"SCENARIO_s70_13010009_00_0020","text":"太开心了！"},{"key":"SCENARIO_s70_13010010_00_0010","text":"就照这个势头加油吧"},{"key":"SCENARIO_s70_13010010_00_0020","text":"感觉找到窍门了呢"},{"key":"SCENARIO_s70_13010011_00_0010","text":"感觉不错呢！"},{"key":"SCENARIO_s70_13010011_00_0020","text":"完美！"},{"key":"SCENARIO_s70_13010012_00_0010","text":"呵呵……今天该好好夸夸自己呢"},{"key":"SCENARIO_s70_13010012_00_0020","text":"心情棒极了！"},{"key":"SCENARIO_s70_13010013_00_0010","text":"这个机会，一定要好好把握"},{"key":"SCENARIO_s70_13010014_00_0010","text":"又向梦想迈进了一步！"},{"key":"SCENARIO_s70_13010015_00_0010","text":"这次准备不足呢……"},{"key":"SCENARIO_s70_13010016_00_0010","text":"再努力一次吧"},{"key":"SCENARIO_s70_13010017_00_0010","text":"不应该只有这种程度才对"},{"key":"SCENARIO_s70_13010018_00_0010","text":"感觉看到了下一个课题呢"},{"key":"SCENARIO_s70_13010027_00_0010","text":"还早着呢……"},{"key":"SCENARIO_s70_13010028_00_0010","text":"是不是在一点点进步呢"},{"key":"SCENARIO_s70_13010029_00_0010","text":"感觉好像摸到门道了呢！"},{"key":"SCENARIO_s70_13010030_00_0010","text":"——我们，干得不错嘛！"},{"key":"SCENARIO_s70_13010031_00_0010","text":"呵呵呵……做到了！"},{"key":"SCENARIO_s70_13010032_00_0010","text":"心情棒极了！"},{"key":"SCENARIO_s70_13010033_00_0010","text":"课题还很多呢……"},{"key":"SCENARIO_s70_13010034_00_0010","text":"一起加油吧"},{"key":"SCENARIO_s70_13010035_00_0010","text":"就照这个势头"},{"key":"SCENARIO_s70_13010036_00_0010","text":"还能……再往上走吗？"},{"key":"SCENARIO_s70_13010037_00_0010","text":"我们以自己的方式闪耀了呢……！"},{"key":"SCENARIO_s70_13010038_00_0010","text":"只要齐心协力，什么都能做到！"}]
