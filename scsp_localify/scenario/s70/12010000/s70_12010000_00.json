[{"key":"SCENARIO_s70_12010009_00_0010","text":"很好地……做到了……"},{"key":"SCENARIO_s70_12010009_00_0020","text":"是满分……呢……"},{"key":"SCENARIO_s70_12010010_00_0010","text":"就照这个势头……继续前进吧……"},{"key":"SCENARIO_s70_12010010_00_0020","text":"唯有继续……锻炼……"},{"key":"SCENARIO_s70_12010011_00_0010","text":"是出色的……结果……"},{"key":"SCENARIO_s70_12010011_00_0020","text":"状态绝佳……呢……"},{"key":"SCENARIO_s70_12010012_00_0010","text":"让我们……将其连接到下一步吧……"},{"key":"SCENARIO_s70_12010012_00_0020","text":"切实感受到了……成长……"},{"key":"SCENARIO_s70_12010013_00_0010","text":"非常……开心……"},{"key":"SCENARIO_s70_12010014_00_0010","text":"都是托了……大家的福……"},{"key":"SCENARIO_s70_12010015_00_0010","text":"失态了……"},{"key":"SCENARIO_s70_12010016_00_0010","text":"为了不再……重蹈覆辙……"},{"key":"SCENARIO_s70_12010017_00_0010","text":"都是因为凛世……不够成熟……"},{"key":"SCENARIO_s70_12010018_00_0010","text":"让我们……再次挑战吧……"},{"key":"SCENARIO_s70_12010027_00_0010","text":"凛世……还能……继续……"},{"key":"SCENARIO_s70_12010028_00_0010","text":"哪怕一点点也好……向前迈进……"},{"key":"SCENARIO_s70_12010029_00_0010","text":"看起来……像个偶像吗……？"},{"key":"SCENARIO_s70_12010030_00_0010","text":"是否……更接近理想了呢……？"},{"key":"SCENARIO_s70_12010031_00_0010","text":"这都是……制作人大人指导的功劳……"},{"key":"SCENARIO_s70_12010032_00_0010","text":"真是……真是……耀眼的光景……"},{"key":"SCENARIO_s70_12010033_00_0010","text":"还请……多多指教……"},{"key":"SCENARIO_s70_12010034_00_0010","text":"若能……与您一同前行……"},{"key":"SCENARIO_s70_12010035_00_0010","text":"——……呵呵……今后也请多多关照……"},{"key":"SCENARIO_s70_12010036_00_0010","text":"成为您……理想中的偶像……"},{"key":"SCENARIO_s70_12010037_00_0010","text":"今后也……请让凛世……陪伴在您身边……——"},{"key":"SCENARIO_s70_12010038_00_0010","text":"能与制作人大人相遇……凛世……——"}]
