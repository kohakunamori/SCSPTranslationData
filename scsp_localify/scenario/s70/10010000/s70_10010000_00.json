[{"key":"SCENARIO_s70_10010009_00_0010","text":"顺利完成了呢！"},{"key":"SCENARIO_s70_10010009_00_0020","text":"感觉不错感觉不错！"},{"key":"SCENARIO_s70_10010010_00_0010","text":"嗯，完美！"},{"key":"SCENARIO_s70_10010010_00_0020","text":"保持这个势头继续加油吧！"},{"key":"SCENARIO_s70_10010011_00_0010","text":"简直完美……！？"},{"key":"SCENARIO_s70_10010011_00_0020","text":"满分！"},{"key":"SCENARIO_s70_10010012_00_0010","text":"这可真是出色呢！"},{"key":"SCENARIO_s70_10010012_00_0020","text":"要不要来点奖励的巧克力呢！？"},{"key":"SCENARIO_s70_10010013_00_0010","text":"这就叫大显身手！"},{"key":"SCENARIO_s70_10010014_00_0010","text":"因为是最强的偶像嘛！"},{"key":"SCENARIO_s70_10010015_00_0010","text":"还得更加更加努力才行……！"},{"key":"SCENARIO_s70_10010016_00_0010","text":"不足的地方，必须好好提升……！"},{"key":"SCENARIO_s70_10010017_00_0010","text":"好不甘心……！"},{"key":"SCENARIO_s70_10010018_00_0010","text":"下次一定要笑着结束！"},{"key":"SCENARIO_s70_10010027_00_0010","text":"从现在开始还要继续加油！"},{"key":"SCENARIO_s70_10010028_00_0010","text":"哪怕只是一点点，能不断前进就好了"},{"key":"SCENARIO_s70_10010029_00_0010","text":"还要更多更多，对吧！"},{"key":"SCENARIO_s70_10010030_00_0010","text":"我会朝着更美味的巧克力偶像努力的！"},{"key":"SCENARIO_s70_10010031_00_0010","text":"接下来也有大跃进的预感哦！"},{"key":"SCENARIO_s70_10010032_00_0010","text":"因为和大家──和Producer先生在一起\n才能走到今天这一步！"},{"key":"SCENARIO_s70_10010033_00_0010","text":"要从基础重新巩固……！"},{"key":"SCENARIO_s70_10010034_00_0010","text":"志存高远！ 就这样前进吧！"},{"key":"SCENARIO_s70_10010035_00_0010","text":"和大家一起，飞速成长！"},{"key":"SCENARIO_s70_10010036_00_0010","text":"前方一定还能不断前进的！"},{"key":"SCENARIO_s70_10010037_00_0010","text":"有可靠的伙伴们在，真的很安心呢"},{"key":"SCENARIO_s70_10010038_00_0010","text":"我们，华丽地登场偶像界──！\n应该做到了吧！"}]
