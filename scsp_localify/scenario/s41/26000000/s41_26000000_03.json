[{"key":"SCENARIO_s41_26000000_03_0000","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0001","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0010","text":"到了"},{"key":"SCENARIO_s41_26000000_03_0020","text":"今天的碰头会\n好像是在这里开"},{"key":"SCENARIO_s41_26000000_03_0030","text":"嗯──────？"},{"key":"SCENARIO_s41_26000000_03_0040","text":"怎么了吗？"},{"key":"SCENARIO_s41_26000000_03_0050","text":"这里……"},{"key":"SCENARIO_s41_26000000_03_0060","text":"你以前来过这里吗？"},{"key":"SCENARIO_s41_26000000_03_0070","text":"这里也对外出租\n而且是个老牌工作室了"},{"key":"SCENARIO_s41_26000000_03_0080","text":"那，路加也在这里……？"},{"key":"SCENARIO_s41_26000000_03_0090","text":"很久以前────"},{"key":"SCENARIO_s41_26000000_03_0100","text":"记不太清了"},{"key":"SCENARIO_s41_26000000_03_0101","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0102","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0110","text":"以前的路加，吗……\n想必从那时候起就一直在努力吧"},{"key":"SCENARIO_s41_26000000_03_0120","text":"…………"},{"key":"SCENARIO_s41_26000000_03_0121","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0122","text":"舞蹈讲师"},{"key":"SCENARIO_s41_26000000_03_0130","text":"做得很好～！\n路加酱，非常棒哦！"},{"key":"SCENARIO_s41_26000000_03_0140","text":"那，能到中间来跳一下吗？"},{"key":"SCENARIO_s41_26000000_03_0141","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0150","text":"在这里跳舞，是────"},{"key":"SCENARIO_s41_26000000_03_0151","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0160","text":"以小组形式参赛的\n舞蹈比赛上"},{"key":"SCENARIO_s41_26000000_03_0170","text":"只有被选为center的人\n才能穿着漂亮的服装跳舞"},{"key":"SCENARIO_s41_26000000_03_0180","text":"嗯，很好哦～！\n大家也要以路加酱为榜样哦"},{"key":"SCENARIO_s41_26000000_03_0181","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0190","text":"……………"},{"key":"SCENARIO_s41_26000000_03_0191","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0200","text":"我想穿着那套服装跳舞"},{"key":"SCENARIO_s41_26000000_03_0210","text":"所以\n每天都在练习"},{"key":"SCENARIO_s41_26000000_03_0220","text":"大家也都觉得\n会是我在中间跳舞"},{"key":"SCENARIO_s41_26000000_03_0230","text":"好，停──"},{"key":"SCENARIO_s41_26000000_03_0240","text":"今天有一位新朋友加入\n给大家介绍一下～"},{"key":"SCENARIO_s41_26000000_03_0241","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0242","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0250","text":"建筑里面也跟以前一样吗？"},{"key":"SCENARIO_s41_26000000_03_0260","text":"谁知道呢……"},{"key":"SCENARIO_s41_26000000_03_0261","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0270","text":"但是───────"},{"key":"SCENARIO_s41_26000000_03_0280","text":"被选中的\n不是我───────"},{"key":"SCENARIO_s41_26000000_03_0290","text":"因为出现了比我\n更适合那套服装的人"},{"key":"SCENARIO_s41_26000000_03_0300","text":"因为那个人比我\n穿起来更合适"},{"key":"SCENARIO_s41_26000000_03_0310","text":"比我───────"},{"key":"SCENARIO_s41_26000000_03_0320","text":"是个相当不错的工作室啊"},{"key":"SCENARIO_s41_26000000_03_0330","text":"…………"},{"key":"SCENARIO_s41_26000000_03_0331","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0332","text":"练习生１"},{"key":"SCENARIO_s41_26000000_03_0340","text":"你好～！"},{"key":"SCENARIO_s41_26000000_03_0350","text":"你好\n来练习吗？"},{"key":"SCENARIO_s41_26000000_03_0360","text":"是的\n我们接下来要开始"},{"key":"SCENARIO_s41_26000000_03_0361","text":"练习生２\n（练习生2）"},{"key":"SCENARIO_s41_26000000_03_0370","text":"打扰了……呵呵"},{"key":"SCENARIO_s41_26000000_03_0371","text":"Motion"},{"key":"SCENARIO_s41_26000000_03_0380","text":"…………"},{"key":"SCENARIO_s41_26000000_03_0390","text":"怎么了吗？"},{"key":"SCENARIO_s41_26000000_03_0400","text":"没什么\n什么都没有───────"}]
