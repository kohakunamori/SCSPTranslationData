[{"key":"SCENARIO_s41_26000000_01_0010","text":"────────"},{"key":"SCENARIO_s41_26000000_01_0020","text":"今天，到此结束"},{"key":"SCENARIO_s41_26000000_01_0030","text":"结束───────"},{"key":"SCENARIO_s41_26000000_01_0000","text":"观众２"},{"key":"SCENARIO_s41_26000000_01_0040","text":"路加酱──！\n谢谢你……！"},{"key":"SCENARIO_s41_26000000_01_0001","text":"观众１"},{"key":"SCENARIO_s41_26000000_01_0050","text":"下次也等着你哦──！"},{"key":"SCENARIO_s41_26000000_01_0002","text":"观众２"},{"key":"SCENARIO_s41_26000000_01_0060","text":"我没有路加就不行了──！"},{"key":"SCENARIO_s41_26000000_01_0070","text":"…………"},{"key":"SCENARIO_s41_26000000_01_0071","text":"Motion"},{"key":"SCENARIO_s41_26000000_01_0080","text":"神明大人就是───────"},{"key":"SCENARIO_s41_26000000_01_0090","text":"────────"},{"key":"SCENARIO_s41_26000000_01_0003","text":"粉丝１"},{"key":"SCENARIO_s41_26000000_01_0100","text":"演唱会，太棒了……！\n我都哭了……！"},{"key":"SCENARIO_s41_26000000_01_0004","text":"粉丝２"},{"key":"SCENARIO_s41_26000000_01_0110","text":"太厉害了！\n能给我签个名吗……！"},{"key":"SCENARIO_s41_26000000_01_0120","text":"嗯"},{"key":"SCENARIO_s41_26000000_01_0005","text":"粉丝３"},{"key":"SCENARIO_s41_26000000_01_0130","text":"这边也拜托了……！"},{"key":"SCENARIO_s41_26000000_01_0006","text":"粉丝１"},{"key":"SCENARIO_s41_26000000_01_0140","text":"下一场演唱会，是什么时候？"},{"key":"SCENARIO_s41_26000000_01_0150","text":"诶……"},{"key":"SCENARIO_s41_26000000_01_0007","text":"粉丝３"},{"key":"SCENARIO_s41_26000000_01_0160","text":"不管在哪里我都会去的！"},{"key":"SCENARIO_s41_26000000_01_0008","text":"粉丝１"},{"key":"SCENARIO_s41_26000000_01_0170","text":"只要能见到路加大人\n我就得到救赎了───────"},{"key":"SCENARIO_s41_26000000_01_0180","text":"…………"},{"key":"SCENARIO_s41_26000000_01_0190","text":"神明大人就是───────"},{"key":"SCENARIO_s41_26000000_01_0200","text":"───────哪里？"},{"key":"SCENARIO_s41_26000000_01_0009","text":"练习生１"},{"key":"SCENARIO_s41_26000000_01_0210","text":"啊——————"},{"key":"SCENARIO_s41_26000000_01_0220","text":"辛苦了……！"},{"key":"SCENARIO_s41_26000000_01_0230","text":"辛苦了"},{"key":"SCENARIO_s41_26000000_01_0231","text":"Motion"},{"key":"SCENARIO_s41_26000000_01_0011","text":"练习生２"},{"key":"SCENARIO_s41_26000000_01_0240","text":"喂，刚才那个难道是"},{"key":"SCENARIO_s41_26000000_01_0012","text":"练习生１"},{"key":"SCENARIO_s41_26000000_01_0250","text":"────哈……！\n好帅……！"},{"key":"SCENARIO_s41_26000000_01_0013","text":"练习生２"},{"key":"SCENARIO_s41_26000000_01_0260","text":"那种让人不敢靠近的气场……"},{"key":"SCENARIO_s41_26000000_01_0014","text":"练习生１"},{"key":"SCENARIO_s41_26000000_01_0270","text":"那不是当然的嘛～\n怎么可能随便让人接近"},{"key":"SCENARIO_s41_26000000_01_0280","text":"因为路加大人是───────"},{"key":"SCENARIO_s41_26000000_01_0015","text":"路加的SNS投稿"},{"key":"SCENARIO_s41_26000000_01_0290","text":"“哪里”"},{"key":"SCENARIO_s41_26000000_01_0016","text":"社交平台反应１"},{"key":"SCENARIO_s41_26000000_01_0300","text":"“永远追随路加”"},{"key":"SCENARIO_s41_26000000_01_0017","text":"社交平台反应２"},{"key":"SCENARIO_s41_26000000_01_0310","text":"“我的神明大人”"},{"key":"SCENARIO_s41_26000000_01_0320","text":"…………"},{"key":"SCENARIO_s41_26000000_01_0330","text":"神明大人───────"},{"key":"SCENARIO_s41_26000000_01_0340","text":"那么，我───────"},{"key":"SCENARIO_s41_26000000_01_0350","text":"───────是谁……"},{"key":"SCENARIO_s41_26000000_01_0360","text":"不───────\n那种东西，早就"},{"key":"SCENARIO_s41_26000000_01_0370","text":"“路加，你现在在哪？”"},{"key":"SCENARIO_s41_26000000_01_0380","text":"“联系不上你\n　很担心”"},{"key":"SCENARIO_s41_26000000_01_0390","text":"…………"},{"key":"SCENARIO_s41_26000000_01_0400","text":"我又没\n叫你们来───────"}]
