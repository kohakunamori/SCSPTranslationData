[{"key":"SCENARIO_s41_24000000_01_0001","text":"Motion"},{"key":"SCENARIO_s41_24000000_01_0002","text":"Motion"},{"key":"SCENARIO_s41_24000000_01_0010","text":"…………哦"},{"key":"SCENARIO_s41_24000000_01_0020","text":"辛苦了\n日花"},{"key":"SCENARIO_s41_24000000_01_0030","text":"……啊—\n辛苦了—"},{"key":"SCENARIO_s41_24000000_01_0040","text":"你来了啊\n我还以为──────"},{"key":"SCENARIO_s41_24000000_01_0050","text":"……\n能请你安静点吗？"},{"key":"SCENARIO_s41_24000000_01_0060","text":"看一眼就明白了吧\n这个"},{"key":"SCENARIO_s41_24000000_01_0070","text":"啊，嗯……\n作业，吗……？"},{"key":"SCENARIO_s41_24000000_01_0080","text":"──────抱歉……！\n那个，我会安静的……"},{"key":"SCENARIO_s41_24000000_01_0090","text":"那就太好了—"},{"key":"SCENARIO_s41_24000000_01_0100","text":"…………那么"},{"key":"SCENARIO_s41_24000000_01_0110","text":"………………"},{"key":"SCENARIO_s41_24000000_01_0120","text":"……嗯—\n…………"},{"key":"SCENARIO_s41_24000000_01_0130","text":"………………"},{"key":"SCENARIO_s41_24000000_01_0140","text":"…………"},{"key":"SCENARIO_s41_24000000_01_0150","text":"…………那个……"},{"key":"SCENARIO_s41_24000000_01_0160","text":"…………"},{"key":"SCENARIO_s41_24000000_01_0161","text":"Motion"},{"key":"SCENARIO_s41_24000000_01_0170","text":"…………那个……！"},{"key":"SCENARIO_s41_24000000_01_0180","text":"……诶？\n怎、怎么了？"},{"key":"SCENARIO_s41_24000000_01_0190","text":"…………\n你绝对听到了吧"},{"key":"SCENARIO_s41_24000000_01_0200","text":"对、对不起……\n我没听到……怎么了？"},{"key":"SCENARIO_s41_24000000_01_0210","text":"……\n键盘────────"},{"key":"SCENARIO_s41_24000000_01_0220","text":"诶？"},{"key":"SCENARIO_s41_24000000_01_0230","text":"键盘的声音……！\n那个，很吵——……"},{"key":"SCENARIO_s41_24000000_01_0240","text":"！\n对、对不起……"},{"key":"SCENARIO_s41_24000000_01_0250","text":"又不是只有制作人\n一个人在努力…………"},{"key":"SCENARIO_s41_24000000_01_0260","text":"抱歉，是我考虑不周\n我去别的地方弄"},{"key":"SCENARIO_s41_24000000_01_0270","text":"…………啊"},{"key":"SCENARIO_s41_24000000_01_0280","text":"──────啊，那个！\n不用到那种程度……"},{"key":"SCENARIO_s41_24000000_01_0290","text":"诶？"},{"key":"SCENARIO_s41_24000000_01_0300","text":"……不用到那种程度\n没关系的……！"},{"key":"SCENARIO_s41_24000000_01_0310","text":"但是……"},{"key":"SCENARIO_s41_24000000_01_0320","text":"感觉我……\n好像变成了超级坏人一样…………！"},{"key":"SCENARIO_s41_24000000_01_0330","text":"是、是吗…………\n那……我就待在这里了"},{"key":"SCENARIO_s41_24000000_01_0340","text":"…………\n这里又不是只有我一个人的地方……"},{"key":"SCENARIO_s41_24000000_01_0350","text":"──────啊\n对了……！"},{"key":"SCENARIO_s41_24000000_01_0360","text":"作业做完之后，\n能让我跟你谈谈工作的事吗？"},{"key":"SCENARIO_s41_24000000_01_0370","text":"……诶？"},{"key":"SCENARIO_s41_24000000_01_0380","text":"刚才开了个会\n因为也和日花有关，所以想跟你说一下"},{"key":"SCENARIO_s41_24000000_01_0390","text":"……诶—！？\n这种事\n不能早点说吗—！"},{"key":"SCENARIO_s41_24000000_01_0400","text":"…………这种话\n不能早点说吗—！"}]
