[{"key":"SCENARIO_s41_24000000_02_0001","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0010","text":"…………"},{"key":"SCENARIO_s41_24000000_02_0020","text":"辛苦了\n日花"},{"key":"SCENARIO_s41_24000000_02_0030","text":"…………"},{"key":"SCENARIO_s41_24000000_02_0040","text":"我送你"},{"key":"SCENARIO_s41_24000000_02_0050","text":"……………………"},{"key":"SCENARIO_s41_24000000_02_0051","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0060","text":"……呼…………啊……"},{"key":"SCENARIO_s41_24000000_02_0061","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0062","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0070","text":"…………\n──────────────"},{"key":"SCENARIO_s41_24000000_02_0080","text":"……！"},{"key":"SCENARIO_s41_24000000_02_0090","text":"………………——————"},{"key":"SCENARIO_s41_24000000_02_0100","text":"日花……\n没事吧？"},{"key":"SCENARIO_s41_24000000_02_0101","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0110","text":"…………"},{"key":"SCENARIO_s41_24000000_02_0120","text":"……离声乐训练还有一点时间\n要不要稍微睡一会儿？"},{"key":"SCENARIO_s41_24000000_02_0130","text":"……\n我又没在睡觉……"},{"key":"SCENARIO_s41_24000000_02_0140","text":"你是想说“我没在专心”之类的意思吗\n真是抱歉了—"},{"key":"SCENARIO_s41_24000000_02_0150","text":"我不是那个意思\n你看起来好像很困，所以想说趁现在休息一下──────"},{"key":"SCENARIO_s41_24000000_02_0160","text":"那不然我什么时候看节目资料？"},{"key":"SCENARIO_s41_24000000_02_0170","text":"……"},{"key":"SCENARIO_s41_24000000_02_0180","text":"那是…………"},{"key":"SCENARIO_s41_24000000_02_0190","text":"……\n只能拼了—"},{"key":"SCENARIO_s41_24000000_02_0200","text":"……抱歉，你说得对\n学习、打工、还要照顾家里────"},{"key":"SCENARIO_s41_24000000_02_0210","text":"────\n你能这么努力我很开心，只是……"},{"key":"SCENARIO_s41_24000000_02_0220","text":"哪怕稍微休息一下也好……"},{"key":"SCENARIO_s41_24000000_02_0230","text":"做不到啊—……我又不像制作人那样\n是能力超强的干将……！"},{"key":"SCENARIO_s41_24000000_02_0240","text":"日花………………"},{"key":"SCENARIO_s41_24000000_02_0250","text":"……我不是说了只能拼了吗\n啊哈哈，其实根本没做到……！"},{"key":"SCENARIO_s41_24000000_02_0260","text":"……………………"},{"key":"SCENARIO_s41_24000000_02_0261","text":"Motion"},{"key":"SCENARIO_s41_24000000_02_0270","text":"……………………"},{"key":"SCENARIO_s41_24000000_02_0280","text":"……嗓子"},{"key":"SCENARIO_s41_24000000_02_0290","text":"……又不是受伤了\n只是高音有点难发出来而已……明天之前我会调整好的"},{"key":"SCENARIO_s41_24000000_02_0300","text":"……嗯"},{"key":"SCENARIO_s41_24000000_02_0310","text":"只要保证充足的睡眠时间\n马上就能恢复的"},{"key":"SCENARIO_s41_24000000_02_0320","text":"…………"},{"key":"SCENARIO_s41_24000000_02_0330","text":"没时间这件事……\n你说得确实没错"},{"key":"SCENARIO_s41_24000000_02_0340","text":"…………"},{"key":"SCENARIO_s41_24000000_02_0350","text":"……只是，希望你能比现在\n再多珍惜一点日花自己"},{"key":"SCENARIO_s41_24000000_02_0360","text":"……才没有……！\n……\n要是那么容易做到的话\n就不用这么辛苦了……"},{"key":"SCENARIO_s41_24000000_02_0370","text":"……才没有……！\n……\n要是那么容易做到的话\n就不用这么辛苦了……"},{"key":"SCENARIO_s41_24000000_02_0380","text":"……是啊"},{"key":"SCENARIO_s41_24000000_02_0390","text":"日花也按自己的节奏\n哪怕一点点也好"},{"key":"SCENARIO_s41_24000000_02_0400","text":"……"}]
