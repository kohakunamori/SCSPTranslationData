[{"key":"SCENARIO_s41_23000000_03_0000","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0001","text":"摄影师"},{"key":"SCENARIO_s41_23000000_03_0002","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0003","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0004","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0010","text":"很好很好，雏菜酱！"},{"key":"SCENARIO_s41_23000000_03_0020","text":"…………"},{"key":"SCENARIO_s41_23000000_03_0030","text":"对对，就保持那个姿势……！"},{"key":"SCENARIO_s41_23000000_03_0040","text":"感觉不错！\n接下来稍微换个角度试试吧"},{"key":"SCENARIO_s41_23000000_03_0050","text":"嗯～……"},{"key":"SCENARIO_s41_23000000_03_0060","text":"这样吗～？"},{"key":"SCENARIO_s41_23000000_03_0070","text":"嗯嗯！感觉很好！"},{"key":"SCENARIO_s41_23000000_03_0080","text":"抱歉啊，有点辛苦，但再保持一下那个姿势……"},{"key":"SCENARIO_s41_23000000_03_0090","text":"好——的，最后来个最棒的笑容……！"},{"key":"SCENARIO_s41_23000000_03_0100","text":"啊哈～！"},{"key":"SCENARIO_s41_23000000_03_0110","text":"嗯…………看起来挺顺利的"},{"key":"SCENARIO_s41_23000000_03_0111","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0112","text":"工作人员"},{"key":"SCENARIO_s41_23000000_03_0120","text":"雏菜酱，今天的拍摄\n非常棒哦—！"},{"key":"SCENARIO_s41_23000000_03_0130","text":"啊哈～\n雏菜也超开心的～"},{"key":"SCENARIO_s41_23000000_03_0140","text":"今天的拍摄，\n我很期待看到杂志刊登出来哦！"},{"key":"SCENARIO_s41_23000000_03_0150","text":"谢谢～"},{"key":"SCENARIO_s41_23000000_03_0151","text":"Motion"},{"key":"SCENARIO_s41_23000000_03_0160","text":"雏菜，辛苦了"},{"key":"SCENARIO_s41_23000000_03_0170","text":"啊，制作人！"},{"key":"SCENARIO_s41_23000000_03_0180","text":"呐，雏菜怎么样～？"},{"key":"SCENARIO_s41_23000000_03_0190","text":"嗯，非常棒！\n摄影师的要求你都能马上应对\n而且和主题非常契合，不是吗"},{"key":"SCENARIO_s41_23000000_03_0200","text":"嗯，非常棒！\n摄影师的要求你都能马上应对\n而且和主题非常契合，不是吗"},{"key":"SCENARIO_s41_23000000_03_0210","text":"是吗～\n那就好～"},{"key":"SCENARIO_s41_23000000_03_0220","text":"嗯，现场的氛围也非常好\n工作人员们看起来也很享受"},{"key":"SCENARIO_s41_23000000_03_0230","text":"说不定，都是托雏菜的福呢"},{"key":"SCENARIO_s41_23000000_03_0240","text":"诶～？"},{"key":"SCENARIO_s41_23000000_03_0250","text":"雏菜开心的话\n大家也会跟着开心起来吧"},{"key":"SCENARIO_s41_23000000_03_0260","text":"啊哈～\n是吗～"},{"key":"SCENARIO_s41_23000000_03_0270","text":"那雏菜，很适合当偶像呢～？"},{"key":"SCENARIO_s41_23000000_03_0280","text":"哈哈，是啊"},{"key":"SCENARIO_s41_23000000_03_0290","text":"好期待下一个工作～"},{"key":"SCENARIO_s41_23000000_03_0300","text":"呐，制作人\n你也这么觉得吧～？"},{"key":"SCENARIO_s41_23000000_03_0310","text":"诶？\n啊，嗯……是啊"},{"key":"SCENARIO_s41_23000000_03_0320","text":"不过，接下来\n可能会有更辛苦的工作"},{"key":"SCENARIO_s41_23000000_03_0330","text":"说不定，也会有雏菜觉得\n不开心的工作……"},{"key":"SCENARIO_s41_23000000_03_0340","text":"欸～！？"},{"key":"SCENARIO_s41_23000000_03_0350","text":"雏菜，不开心的事就算了吧～"},{"key":"SCENARIO_s41_23000000_03_0360","text":"诶……不是，但是……！"},{"key":"SCENARIO_s41_23000000_03_0370","text":"因为，刚才制作人\n不是说了吗～？"},{"key":"SCENARIO_s41_23000000_03_0380","text":"雏菜开心的话\n大家也会开心"},{"key":"SCENARIO_s41_23000000_03_0390","text":"嗯，对\n我说了"},{"key":"SCENARIO_s41_23000000_03_0400","text":"我觉得雏菜\n一定有那样的力量"},{"key":"SCENARIO_s41_23000000_03_0410","text":"那，首先雏菜不超级开心的话\n就不行吧～？"},{"key":"SCENARIO_s41_23000000_03_0420","text":"…………\n说得也是"},{"key":"SCENARIO_s41_23000000_03_0421","text":"Motion"}]
