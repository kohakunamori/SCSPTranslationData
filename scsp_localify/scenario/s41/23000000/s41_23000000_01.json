[{"key":"SCENARIO_s41_23000000_01_0001","text":"Motion"},{"key":"SCENARIO_s41_23000000_01_0010","text":"啊，制作人"},{"key":"SCENARIO_s41_23000000_01_0020","text":"哦，雏菜……在吃饭吗？\n训练结束了？"},{"key":"SCENARIO_s41_23000000_01_0030","text":"嗯，结束啦～"},{"key":"SCENARIO_s41_23000000_01_0040","text":"完美搞定～"},{"key":"SCENARIO_s41_23000000_01_0050","text":"是吗\n辛苦了"},{"key":"SCENARIO_s41_23000000_01_0060","text":"嗯～"},{"key":"SCENARIO_s41_23000000_01_0070","text":"不过制作人也在工作吧～？"},{"key":"SCENARIO_s41_23000000_01_0080","text":"嗯，是啊"},{"key":"SCENARIO_s41_23000000_01_0090","text":"那制作人也——\n辛苦啦～"},{"key":"SCENARIO_s41_23000000_01_0100","text":"哈哈，谢谢你"},{"key":"SCENARIO_s41_23000000_01_0101","text":"Motion"},{"key":"SCENARIO_s41_23000000_01_0110","text":"那个，雏菜"},{"key":"SCENARIO_s41_23000000_01_0120","text":"嗯～？"},{"key":"SCENARIO_s41_23000000_01_0130","text":"今天是和其他人一起训练的吧"},{"key":"SCENARIO_s41_23000000_01_0140","text":"除了雏菜以外的人都回去了吗？"},{"key":"SCENARIO_s41_23000000_01_0150","text":"啊～\n谁知道呢"},{"key":"SCENARIO_s41_23000000_01_0160","text":"可能回去了吧～\n也可能还在练习～？"},{"key":"SCENARIO_s41_23000000_01_0170","text":"也就是说在自主练习……"},{"key":"SCENARIO_s41_23000000_01_0180","text":"对～\n好厉害吧～"},{"key":"SCENARIO_s41_23000000_01_0181","text":"Motion"},{"key":"SCENARIO_s41_23000000_01_0190","text":"雏菜今天已经累坏了～……"},{"key":"SCENARIO_s41_23000000_01_0200","text":"……是吗\n好好休息恢复体力也是工作的一部分，知道吧"},{"key":"SCENARIO_s41_23000000_01_0210","text":"嗯～\n说得对呢～"},{"key":"SCENARIO_s41_23000000_01_0220","text":"所以雏菜就这样在休息，不过～……"},{"key":"SCENARIO_s41_23000000_01_0230","text":"制作人呢？"},{"key":"SCENARIO_s41_23000000_01_0240","text":"诶？"},{"key":"SCENARIO_s41_23000000_01_0250","text":"还有工作吗～？"},{"key":"SCENARIO_s41_23000000_01_0260","text":"说有是有……"},{"key":"SCENARIO_s41_23000000_01_0270","text":"制作人也稍微休息一下～？"},{"key":"SCENARIO_s41_23000000_01_0280","text":"诶……嗯"},{"key":"SCENARIO_s41_23000000_01_0290","text":"说得也是……正好告一段落了\n我就歇一会儿吧"},{"key":"SCENARIO_s41_23000000_01_0300","text":"那制作人也一起吃吧～？"},{"key":"SCENARIO_s41_23000000_01_0310","text":"嗯\n我去泡杯咖啡吧"},{"key":"SCENARIO_s41_23000000_01_0320","text":"雏菜要喝点什么吗？"},{"key":"SCENARIO_s41_23000000_01_0330","text":"嗯——，雏菜要～……"},{"key":"SCENARIO_s41_23000000_01_0340","text":"今天是可可吗？\n加牛奶"},{"key":"SCENARIO_s41_23000000_01_0350","text":"嗯～～～！\n你怎么知道的～？"},{"key":"SCENARIO_s41_23000000_01_0360","text":"雏菜要可可～"},{"key":"SCENARIO_s41_23000000_01_0370","text":"要很甜的那种～！牛奶多多的～"},{"key":"SCENARIO_s41_23000000_01_0380","text":"哦……！"},{"key":"SCENARIO_s41_23000000_01_0390","text":"好厉害啊～，制作人"},{"key":"SCENARIO_s41_23000000_01_0400","text":"雏菜明明只了解自己的事呢～"}]
