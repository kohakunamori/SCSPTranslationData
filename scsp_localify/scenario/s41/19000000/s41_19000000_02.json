[{"key":"SCENARIO_s41_19000000_02_0000","text":"Motion"},{"key":"SCENARIO_s41_19000000_02_0001","text":"企划负责人"},{"key":"SCENARIO_s41_19000000_02_0010","text":"──那么，今天的会议就到这里\n感谢各位百忙之中抽出时间参加"},{"key":"SCENARIO_s41_19000000_02_0020","text":"哪里哪里，我们才是\n今后也请多多关照"},{"key":"SCENARIO_s41_19000000_02_0030","text":"拜托您了"},{"key":"SCENARIO_s41_19000000_02_0031","text":"Motion"},{"key":"SCENARIO_s41_19000000_02_0040","text":"……"},{"key":"SCENARIO_s41_19000000_02_0050","text":"～！"},{"key":"SCENARIO_s41_19000000_02_0060","text":"哈哈，喝得真痛快啊"},{"key":"SCENARIO_s41_19000000_02_0070","text":"啊哈哈～\n刚才实在太渴了嘛～"},{"key":"SCENARIO_s41_19000000_02_0080","text":"会议确实挺长的，辛苦了"},{"key":"SCENARIO_s41_19000000_02_0090","text":"哎呀，我们这边基本只是在听而已！\n制作人才是更辛苦的那个吧！"},{"key":"SCENARIO_s41_19000000_02_0100","text":"嗯，确实"},{"key":"SCENARIO_s41_19000000_02_0110","text":"今天说了不少话"},{"key":"SCENARIO_s41_19000000_02_0120","text":"……哦，已经空了"},{"key":"SCENARIO_s41_19000000_02_0130","text":"啊，那我去买吧\n你还要一样的吗？"},{"key":"SCENARIO_s41_19000000_02_0140","text":"不用了，那多不好──"},{"key":"SCENARIO_s41_19000000_02_0150","text":"──没事没事\n你看，我的也喝完了"},{"key":"SCENARIO_s41_19000000_02_0160","text":"对吧？\n不过我还想再喝一点"},{"key":"SCENARIO_s41_19000000_02_0170","text":"……谢谢\n那就麻烦你了？"},{"key":"SCENARIO_s41_19000000_02_0180","text":"OK！"},{"key":"SCENARIO_s41_19000000_02_0190","text":"……呼～……"},{"key":"SCENARIO_s41_19000000_02_0191","text":"孩子"},{"key":"SCENARIO_s41_19000000_02_0200","text":"──喂喂大哥哥！\n你在干什么呀？"},{"key":"SCENARIO_s41_19000000_02_0210","text":"！？　啊，这个嘛……\n也没在干什么特别的事……"},{"key":"SCENARIO_s41_19000000_02_0220","text":"！\n那，来陪我玩吧！"},{"key":"SCENARIO_s41_19000000_02_0230","text":"等一下，我在等人──"},{"key":"SCENARIO_s41_19000000_02_0240","text":"──不管！要玩！"},{"key":"SCENARIO_s41_19000000_02_0250","text":"（……这可怎么办……）"},{"key":"SCENARIO_s41_19000000_02_0260","text":"──那～姐姐来陪你玩好不好！"},{"key":"SCENARIO_s41_19000000_02_0270","text":"！"},{"key":"SCENARIO_s41_19000000_02_0280","text":"姐姐你是谁～？"},{"key":"SCENARIO_s41_19000000_02_0290","text":"嗯～我是……\n这位大哥哥的朋友～"},{"key":"SCENARIO_s41_19000000_02_0300","text":"原来是这样！\n嗯！那姐姐也可以！"},{"key":"SCENARIO_s41_19000000_02_0310","text":"啊哈哈～那玩什么好呢～\n姐姐想玩捉迷藏呢～"},{"key":"SCENARIO_s41_19000000_02_0320","text":"好呀！\n我可厉害了！"},{"key":"SCENARIO_s41_19000000_02_0330","text":"哎呀～\n我能不能赢呢～"},{"key":"SCENARIO_s41_19000000_02_0340","text":"大哥哥也来！"},{"key":"SCENARIO_s41_19000000_02_0350","text":"……\n好！行啊！"},{"key":"SCENARIO_s41_19000000_02_0360","text":"第一轮我来当鬼！\n数到十哦！一、二──"},{"key":"SCENARIO_s41_19000000_02_0370","text":"──哇，得赶紧跑～！"},{"key":"SCENARIO_s41_19000000_02_0380","text":"……得救了，爱依"},{"key":"SCENARIO_s41_19000000_02_0390","text":"啊哈哈\n这种事我习惯啦"},{"key":"SCENARIO_s41_19000000_02_0400","text":"交给我吧"}]
