[{"key":"SCENARIO_s41_02000000_01_0000","text":"Motion"},{"key":"SCENARIO_s41_02000000_01_0010","text":"……"},{"key":"SCENARIO_s41_02000000_01_0020","text":"…………"},{"key":"SCENARIO_s41_02000000_01_0030","text":"……咦\n已经喝完了吗……"},{"key":"SCENARIO_s41_02000000_01_0040","text":"…………"},{"key":"SCENARIO_s41_02000000_01_0050","text":"我去给您倒杯咖啡吧"},{"key":"SCENARIO_s41_02000000_01_0060","text":"诶！？"},{"key":"SCENARIO_s41_02000000_01_0070","text":"不不，怎么能让偶像来照顾制作人呢"},{"key":"SCENARIO_s41_02000000_01_0080","text":"谢谢\n我自己来就行"},{"key":"SCENARIO_s41_02000000_01_0090","text":"是吗"},{"key":"SCENARIO_s41_02000000_01_0100","text":"噢"},{"key":"SCENARIO_s41_02000000_01_0110","text":"对了，灯织要喝点什么吗？\n我去倒"},{"key":"SCENARIO_s41_02000000_01_0120","text":"不用了，我这里还有"},{"key":"SCENARIO_s41_02000000_01_0130","text":"这、这样啊！"},{"key":"SCENARIO_s41_02000000_01_0140","text":"那我去续杯了！"},{"key":"SCENARIO_s41_02000000_01_0150","text":"…………"},{"key":"SCENARIO_s41_02000000_01_0160","text":"嗯……"},{"key":"SCENARIO_s41_02000000_01_0170","text":"（有点拿捏不好距离感啊）"},{"key":"SCENARIO_s41_02000000_01_0180","text":"（她是个很靠谱的孩子……\n　我要是多管闲事反而会适得其反吧）"},{"key":"SCENARIO_s41_02000000_01_0190","text":"好"},{"key":"SCENARIO_s41_02000000_01_0200","text":"……"},{"key":"SCENARIO_s41_02000000_01_0201","text":"Motion"},{"key":"SCENARIO_s41_02000000_01_0210","text":"制作人"},{"key":"SCENARIO_s41_02000000_01_0220","text":"……嗯？"},{"key":"SCENARIO_s41_02000000_01_0230","text":"您是不是应该更高效地利用时间呢"},{"key":"SCENARIO_s41_02000000_01_0240","text":"……诶"},{"key":"SCENARIO_s41_02000000_01_0250","text":"您从什么时候开始工作的？"},{"key":"SCENARIO_s41_02000000_01_0260","text":"虽然用咖啡撑着，\n但明显比刚才更疲惫了吧"},{"key":"SCENARIO_s41_02000000_01_0270","text":"看起来那么明显吗"},{"key":"SCENARIO_s41_02000000_01_0280","text":"请不要打马虎眼"},{"key":"SCENARIO_s41_02000000_01_0290","text":"不，我没打马虎眼\n只是觉得被你看穿了啊"},{"key":"SCENARIO_s41_02000000_01_0300","text":"…………"},{"key":"SCENARIO_s41_02000000_01_0310","text":"我先说清楚……"},{"key":"SCENARIO_s41_02000000_01_0320","text":"不是因为我是我才看出来的\n谁看了都能发现"},{"key":"SCENARIO_s41_02000000_01_0330","text":"是吗……\n让你看到丢人的一面了"},{"key":"SCENARIO_s41_02000000_01_0340","text":"…………\n你不打算停下来吗？"},{"key":"SCENARIO_s41_02000000_01_0350","text":"嗯……\n事情比较急，现在不撑住不行"},{"key":"SCENARIO_s41_02000000_01_0360","text":"那就更应该高效利用时间了不是吗？\n我觉得你应该休息一次"},{"key":"SCENARIO_s41_02000000_01_0370","text":"这样下去对制作人也好、对工作也好\n都不太好"},{"key":"SCENARIO_s41_02000000_01_0380","text":"……嗯，你说得对\n那我稍微小睡一会儿"},{"key":"SCENARIO_s41_02000000_01_0390","text":"这么没出息真不好意思\n谢谢你，灯织"},{"key":"SCENARIO_s41_02000000_01_0400","text":"…………好的"}]
