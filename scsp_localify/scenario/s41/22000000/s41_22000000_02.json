[{"key":"SCENARIO_s41_22000000_02_0001","text":"Motion"},{"key":"SCENARIO_s41_22000000_02_0009","text":"教师"},{"key":"SCENARIO_s41_22000000_02_0010","text":"——那就拜托你了"},{"key":"SCENARIO_s41_22000000_02_0020","text":"是、是的……"},{"key":"SCENARIO_s41_22000000_02_0030","text":"啊……对了\n得跟大家联系一下"},{"key":"SCENARIO_s41_22000000_02_0040","text":"那个……"},{"key":"SCENARIO_s41_22000000_02_0050","text":"『今天的会议，可能会晚一点\n　被老师拜托帮忙打扫了』"},{"key":"SCENARIO_s41_22000000_02_0060","text":"『大家先到事务所去吧』"},{"key":"SCENARIO_s41_22000000_02_0070","text":"还有，Producer先生那边也得……"},{"key":"SCENARIO_s41_22000000_02_0080","text":"『今天的会议，可能会晚一点到』"},{"key":"SCENARIO_s41_22000000_02_0090","text":"『在学校被老师拜托帮忙打扫了』"},{"key":"SCENARIO_s41_22000000_02_0091","text":"Motion"},{"key":"SCENARIO_s41_22000000_02_0100","text":"……好"},{"key":"SCENARIO_s41_22000000_02_0110","text":"——好\n差不多该休息一下了"},{"key":"SCENARIO_s41_22000000_02_0120","text":"——哦，是小糸发来的"},{"key":"SCENARIO_s41_22000000_02_0130","text":"…………"},{"key":"SCENARIO_s41_22000000_02_0140","text":"“知道了，不用着急”……"},{"key":"SCENARIO_s41_22000000_02_0141","text":"Motion"},{"key":"SCENARIO_s41_22000000_02_0150","text":"——呼"},{"key":"SCENARIO_s41_22000000_02_0160","text":"这个时间的话，也许还来得及……"},{"key":"SCENARIO_s41_22000000_02_0161","text":"Motion"},{"key":"SCENARIO_s41_22000000_02_0162","text":"Motion"},{"key":"SCENARIO_s41_22000000_02_0170","text":"哈……哈……"},{"key":"SCENARIO_s41_22000000_02_0180","text":"哦，小糸啊\n辛苦了"},{"key":"SCENARIO_s41_22000000_02_0190","text":"是、是的……！\n辛苦了——"},{"key":"SCENARIO_s41_22000000_02_0200","text":"诶、咦……\n大家呢……？"},{"key":"SCENARIO_s41_22000000_02_0210","text":"啊，那个啊……"},{"key":"SCENARIO_s41_22000000_02_0220","text":"刚才收到了消息，\n说是“可能会晚一点到”"},{"key":"SCENARIO_s41_22000000_02_0230","text":"还、还没来吗……？"},{"key":"SCENARIO_s41_22000000_02_0240","text":"嗯，小糸是第一个到的"},{"key":"SCENARIO_s41_22000000_02_0250","text":"…………"},{"key":"SCENARIO_s41_22000000_02_0260","text":"小糸真了不起啊\n学校的事和工作的事都那么认真对待"},{"key":"SCENARIO_s41_22000000_02_0270","text":"就像现在，\n为了不迟到，急急忙忙赶过来了吧？"},{"key":"SCENARIO_s41_22000000_02_0280","text":"是、是的……"},{"key":"SCENARIO_s41_22000000_02_0290","text":"哈哈，真不愧是"},{"key":"SCENARIO_s41_22000000_02_0300","text":"啊……\n那个……！"},{"key":"SCENARIO_s41_22000000_02_0310","text":"嗯？"},{"key":"SCENARIO_s41_22000000_02_0320","text":"大、大家，\n现在应该也在赶路呢……！"},{"key":"SCENARIO_s41_22000000_02_0330","text":"时、时间也\n还有差不多５分钟……"},{"key":"SCENARIO_s41_22000000_02_0340","text":"……是啊"},{"key":"SCENARIO_s41_22000000_02_0350","text":"是、是的……！\n所以……"},{"key":"SCENARIO_s41_22000000_02_0360","text":"大家还没，\n确定会迟到呢……"},{"key":"SCENARIO_s41_22000000_02_0370","text":"哈哈，也是啊\n希望大家都赶得上"},{"key":"SCENARIO_s41_22000000_02_0380","text":"毕竟小糸都特意赶过来了嘛"},{"key":"SCENARIO_s41_22000000_02_0390","text":"应、应该马上\n就会到了……！"},{"key":"SCENARIO_s41_22000000_02_0400","text":"大，大概……"}]
