[{"key":"SCENARIO_s41_20000000_03_0000","text":"Motion"},{"key":"SCENARIO_s41_20000000_03_0010","text":"哦——……"},{"key":"SCENARIO_s41_20000000_03_0020","text":"……诶？"},{"key":"SCENARIO_s41_20000000_03_0030","text":"烤肉便当"},{"key":"SCENARIO_s41_20000000_03_0040","text":"……啊，好"},{"key":"SCENARIO_s41_20000000_03_0050","text":"我就选这个了\n────透也来一样的吗？"},{"key":"SCENARIO_s41_20000000_03_0060","text":"诶、嗯——……"},{"key":"SCENARIO_s41_20000000_03_0070","text":"啊，那个\n超想要的"},{"key":"SCENARIO_s41_20000000_03_0080","text":"啊啊……"},{"key":"SCENARIO_s41_20000000_03_0090","text":"哈哈哈\n这家店品种真全"},{"key":"SCENARIO_s41_20000000_03_0100","text":"嗯——"},{"key":"SCENARIO_s41_20000000_03_0110","text":"蛋包饭"},{"key":"SCENARIO_s41_20000000_03_0120","text":"嗯，软软的"},{"key":"SCENARIO_s41_20000000_03_0130","text":"鰤鱼便当"},{"key":"SCENARIO_s41_20000000_03_0140","text":"嗯，光泽不错"},{"key":"SCENARIO_s41_20000000_03_0150","text":"亲子丼"},{"key":"SCENARIO_s41_20000000_03_0160","text":"……嗯，该选这个还是蛋包饭呢"},{"key":"SCENARIO_s41_20000000_03_0170","text":"乌冬面"},{"key":"SCENARIO_s41_20000000_03_0180","text":"面类也不错啊"},{"key":"SCENARIO_s41_20000000_03_0190","text":"嗯——……"},{"key":"SCENARIO_s41_20000000_03_0200","text":"……\n好，可以选两个"},{"key":"SCENARIO_s41_20000000_03_0210","text":"……诶"},{"key":"SCENARIO_s41_20000000_03_0220","text":"选两个……\n吃不完的话，我帮你解决"},{"key":"SCENARIO_s41_20000000_03_0230","text":"……\n诶，你请客？"},{"key":"SCENARIO_s41_20000000_03_0240","text":"……诶？"},{"key":"SCENARIO_s41_20000000_03_0250","text":"诶……"},{"key":"SCENARIO_s41_20000000_03_0260","text":"不是一直都是吗？就是\n你请我吃饭这件事"},{"key":"SCENARIO_s41_20000000_03_0270","text":"……\n说是请客……不如说是……报销嘛"},{"key":"SCENARIO_s41_20000000_03_0280","text":"……诶，嗯\n可能是报销没错────"},{"key":"SCENARIO_s41_20000000_03_0290","text":"但今天又没干活\n什么也没……"},{"key":"SCENARIO_s41_20000000_03_0300","text":"只是听了听会议而已"},{"key":"SCENARIO_s41_20000000_03_0310","text":"……"},{"key":"SCENARIO_s41_20000000_03_0320","text":"……不觉得亏了吗？\n拿蛋包饭和亲子丼来换"},{"key":"SCENARIO_s41_20000000_03_0330","text":"……啊──────\n────哈哈哈，透……！"},{"key":"SCENARIO_s41_20000000_03_0340","text":"来参加会议，就已经是正经工作了\n不用在意"},{"key":"SCENARIO_s41_20000000_03_0350","text":"……"},{"key":"SCENARIO_s41_20000000_03_0360","text":"要是觉得不划算，\n下次好好努力就行"},{"key":"SCENARIO_s41_20000000_03_0361","text":"Motion"},{"key":"SCENARIO_s41_20000000_03_0370","text":"……好\n那"},{"key":"SCENARIO_s41_20000000_03_0380","text":"——————诶"},{"key":"SCENARIO_s41_20000000_03_0390","text":"『A5黑毛和牛牛排便当』"},{"key":"SCENARIO_s41_20000000_03_0400","text":"多谢款待"}]
