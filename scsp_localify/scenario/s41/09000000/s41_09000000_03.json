[{"key":"SCENARIO_s41_09000000_03_0000","text":"Motion"},{"key":"SCENARIO_s41_09000000_03_0010","text":"辛苦了，果穗"},{"key":"SCENARIO_s41_09000000_03_0020","text":"今天状态很不错吧？"},{"key":"SCENARIO_s41_09000000_03_0030","text":"嘿嘿！\n不知怎么的，特别能集中精神！"},{"key":"SCENARIO_s41_09000000_03_0040","text":"嗯\n托你的福，拍摄也提前结束了"},{"key":"SCENARIO_s41_09000000_03_0050","text":"……对了\n果穗，还有精神吗？"},{"key":"SCENARIO_s41_09000000_03_0060","text":"？\n有！精神着呢！"},{"key":"SCENARIO_s41_09000000_03_0070","text":"回事务所之前，要不要顺路去一下公园？\n喝点东西歇口气……怎么样？"},{"key":"SCENARIO_s41_09000000_03_0080","text":"！！\n我想去！"},{"key":"SCENARIO_s41_09000000_03_0090","text":"那就定了！\n不过不能太晚，只能待一会儿哦……！"},{"key":"SCENARIO_s41_09000000_03_0100","text":"好的！"},{"key":"SCENARIO_s41_09000000_03_0101","text":"Motion"},{"key":"SCENARIO_s41_09000000_03_0110","text":"——哈！"},{"key":"SCENARIO_s41_09000000_03_0120","text":"这个果汁\n超级甜，好好喝！"},{"key":"SCENARIO_s41_09000000_03_0130","text":"谢谢您\nProducer先生！"},{"key":"SCENARIO_s41_09000000_03_0140","text":"工作结束后的饮料，\n努力过的人喝起来会更好喝哦"},{"key":"SCENARIO_s41_09000000_03_0150","text":"这都是因为果穗努力了呀"},{"key":"SCENARIO_s41_09000000_03_0160","text":"诶嘿嘿……！"},{"key":"SCENARIO_s41_09000000_03_0170","text":"还有点时间\n怎么样？要去玩游乐设施吗？"},{"key":"SCENARIO_s41_09000000_03_0180","text":"！\n在秋千上比谁荡得更高────"},{"key":"SCENARIO_s41_09000000_03_0190","text":"──啊！"},{"key":"SCENARIO_s41_09000000_03_0200","text":"……嗯？\n哦，是小狗……是柴犬吧"},{"key":"SCENARIO_s41_09000000_03_0210","text":"小小的尾巴……！\n超——级可爱！"},{"key":"SCENARIO_s41_09000000_03_0220","text":"是啊……！"},{"key":"SCENARIO_s41_09000000_03_0230","text":"果穗喜欢狗吗？"},{"key":"SCENARIO_s41_09000000_03_0240","text":"最喜欢了！"},{"key":"SCENARIO_s41_09000000_03_0250","text":"我家也养了一只豆丸呢！\n超——级超——级可爱的！"},{"key":"SCENARIO_s41_09000000_03_0260","text":"豆丸……？"},{"key":"SCENARIO_s41_09000000_03_0270","text":"啊！\n那就是我家养的柴犬！"},{"key":"SCENARIO_s41_09000000_03_0280","text":"它精力充沛，还很聪明……！"},{"key":"SCENARIO_s41_09000000_03_0290","text":"从小就一直在一起呢！"},{"key":"SCENARIO_s41_09000000_03_0300","text":"哦，是这样啊……！\n什么时候我也想见见豆丸呢"},{"key":"SCENARIO_s41_09000000_03_0310","text":"真的吗！？\n我觉得一定能马上和它成为好朋友的！"},{"key":"SCENARIO_s41_09000000_03_0320","text":"如果能和制作人一起遛豆丸的话，\n一定很开心吧……！"},{"key":"SCENARIO_s41_09000000_03_0330","text":"事务所步行就能到，时间凑得上的话应该可以！"},{"key":"SCENARIO_s41_09000000_03_0340","text":"嗯……？"},{"key":"SCENARIO_s41_09000000_03_0350","text":"……！\n是刚才那只小狗……！"},{"key":"SCENARIO_s41_09000000_03_0360","text":"它在看着我们这边！"},{"key":"SCENARIO_s41_09000000_03_0370","text":"是想和果穗玩吗？\n你看，主人也在朝我们挥手呢"},{"key":"SCENARIO_s41_09000000_03_0380","text":"嗯……！"},{"key":"SCENARIO_s41_09000000_03_0390","text":"啊，这样啊……！\n时间没关系的，去玩吧"},{"key":"SCENARIO_s41_09000000_03_0400","text":"太好了！\n谢谢您！　我去了！"}]
