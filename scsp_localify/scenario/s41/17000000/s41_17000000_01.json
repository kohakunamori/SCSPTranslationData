[{"key":"SCENARIO_s41_17000000_01_0000","text":"Motion"},{"key":"SCENARIO_s41_17000000_01_0010","text":"——……呼"},{"key":"SCENARIO_s41_17000000_01_0020","text":"好，下一个……"},{"key":"SCENARIO_s41_17000000_01_0021","text":"Motion"},{"key":"SCENARIO_s41_17000000_01_0030","text":"朝日，那是……\n从教练那里借来的舞蹈视频吧"},{"key":"SCENARIO_s41_17000000_01_0040","text":"是的哦～"},{"key":"SCENARIO_s41_17000000_01_0050","text":"好厉害啊，这么多……\n全部看完好像很不容易"},{"key":"SCENARIO_s41_17000000_01_0060","text":"已经看完一半了"},{"key":"SCENARIO_s41_17000000_01_0070","text":"还要继续看吗？你已经集中精神看了好久了\n稍微休息一下吧"},{"key":"SCENARIO_s41_17000000_01_0080","text":"没关系的\n比起那个，我想快点看完"},{"key":"SCENARIO_s41_17000000_01_0090","text":"也不用一口气全看完吧……\n拿回家看什么的……"},{"key":"SCENARIO_s41_17000000_01_0100","text":"嗯——，带回去的话可能会弄丢"},{"key":"SCENARIO_s41_17000000_01_0110","text":"这样啊……\n那在这里看也行，不过……"},{"key":"SCENARIO_s41_17000000_01_0120","text":"一直盯着屏幕看不太好\n中间穿插点别的事情，好吗？"},{"key":"SCENARIO_s41_17000000_01_0130","text":"也是哦……别的事情的话可以吗"},{"key":"SCENARIO_s41_17000000_01_0140","text":"嘛……嗯"},{"key":"SCENARIO_s41_17000000_01_0150","text":"那我把看过的复习一遍！"},{"key":"SCENARIO_s41_17000000_01_0160","text":"诶，现在？"},{"key":"SCENARIO_s41_17000000_01_0170","text":"是的\n不过这里有点窄呢"},{"key":"SCENARIO_s41_17000000_01_0180","text":"去屋顶吧～！"},{"key":"SCENARIO_s41_17000000_01_0190","text":"好、好的……！\n适可而止啊……！"},{"key":"SCENARIO_s41_17000000_01_0191","text":"Motion"},{"key":"SCENARIO_s41_17000000_01_0200","text":"……朝日\n差不多该收工了吧"},{"key":"SCENARIO_s41_17000000_01_0210","text":"……制作人"},{"key":"SCENARIO_s41_17000000_01_0220","text":"……呼\n果然还是有点累了……"},{"key":"SCENARIO_s41_17000000_01_0230","text":"真不容易啊，要记的东西那么多……"},{"key":"SCENARIO_s41_17000000_01_0240","text":"不用记也没关系的哦？"},{"key":"SCENARIO_s41_17000000_01_0250","text":"诶？"},{"key":"SCENARIO_s41_17000000_01_0260","text":"只是说让我参考一下而已"},{"key":"SCENARIO_s41_17000000_01_0270","text":"但是，不知道该参考什么才好\n所以我就自己试着跳了跳！"},{"key":"SCENARIO_s41_17000000_01_0280","text":"原来是这样……\n我还以为是布置的作业呢"},{"key":"SCENARIO_s41_17000000_01_0290","text":"朝日还是一如既往地钻研精神旺盛啊……"},{"key":"SCENARIO_s41_17000000_01_0300","text":"……钻研？"},{"key":"SCENARIO_s41_17000000_01_0310","text":"嗯。像那样拼命地\n想要吸收东西"},{"key":"SCENARIO_s41_17000000_01_0320","text":"嗯——……？\n只是觉得好奇就去做了而已"},{"key":"SCENARIO_s41_17000000_01_0330","text":"不试试看的话不会知道的嘛"},{"key":"SCENARIO_s41_17000000_01_0340","text":"是吗……\n那有什么发现吗？"},{"key":"SCENARIO_s41_17000000_01_0350","text":"好的！"},{"key":"SCENARIO_s41_17000000_01_0360","text":"方便的话，跟我说说"},{"key":"SCENARIO_s41_17000000_01_0370","text":"好啊\n────咦"},{"key":"SCENARIO_s41_17000000_01_0380","text":"……不知道该怎么说才好"},{"key":"SCENARIO_s41_17000000_01_0390","text":"我试一下\n你看着哦！"},{"key":"SCENARIO_s41_17000000_01_0400","text":"哈哈……嗯"}]
