[{"key":"SCENARIO_s41_21000000_03_0001","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0010","text":"──……♪"},{"key":"SCENARIO_s41_21000000_03_0020","text":"……嗯～嗯～\n…………烤得～金灿灿～♪"},{"key":"SCENARIO_s41_21000000_03_0030","text":"脸蛋都要掉下来啦♪\n都要化掉啦～♪"},{"key":"SCENARIO_s41_21000000_03_0040","text":"才～不，才不才不♪\n甜～蜜蜜，曲～奇饼…………"},{"key":"SCENARIO_s41_21000000_03_0050","text":"咕………………………………"},{"key":"SCENARIO_s41_21000000_03_0060","text":"………………"},{"key":"SCENARIO_s41_21000000_03_0070","text":"不是的，圆香……"},{"key":"SCENARIO_s41_21000000_03_0080","text":"……请继续"},{"key":"SCENARIO_s41_21000000_03_0090","text":"摸鱼先生"},{"key":"SCENARIO_s41_21000000_03_0100","text":"这是误会"},{"key":"SCENARIO_s41_21000000_03_0110","text":"不"},{"key":"SCENARIO_s41_21000000_03_0111","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0120","text":"等、等等等等\n首先，现在是午休时间——"},{"key":"SCENARIO_s41_21000000_03_0130","text":"我是在试做料理节目工作人员教的\n点心食谱而已"},{"key":"SCENARIO_s41_21000000_03_0131","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0135","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0140","text":"所以"},{"key":"SCENARIO_s41_21000000_03_0150","text":"就算不工作也没关系，是吗"},{"key":"SCENARIO_s41_21000000_03_0160","text":"不、不不不不！\n我说过了吧，现在是午休时间…………！"},{"key":"SCENARIO_s41_21000000_03_0170","text":"所以"},{"key":"SCENARIO_s41_21000000_03_0180","text":"就算又唱又跳也没关系，是吗"},{"key":"SCENARIO_s41_21000000_03_0190","text":"唔…………………………"},{"key":"SCENARIO_s41_21000000_03_0191","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0200","text":"唱是唱了……"},{"key":"SCENARIO_s41_21000000_03_0210","text":"…………但没跳…………"},{"key":"SCENARIO_s41_21000000_03_0220","text":"请随意"},{"key":"SCENARIO_s41_21000000_03_0230","text":"反正是午休嘛？"},{"key":"SCENARIO_s41_21000000_03_0240","text":"………………"},{"key":"SCENARIO_s41_21000000_03_0250","text":"……抱歉"},{"key":"SCENARIO_s41_21000000_03_0251","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0260","text":"我无所谓"},{"key":"SCENARIO_s41_21000000_03_0270","text":"不，这里说到底还是工作场所吧\n我以为大家都出去了，就忍不住……"},{"key":"SCENARIO_s41_21000000_03_0280","text":"哈哈……太松懈了\n连圆香站在身后都没注意到"},{"key":"SCENARIO_s41_21000000_03_0290","text":"你什么时候回来的？\n可别告诉我其实一直都在"},{"key":"SCENARIO_s41_21000000_03_0300","text":"……嘛，是啊"},{"key":"SCENARIO_s41_21000000_03_0301","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0309","text":"手机的录音"},{"key":"SCENARIO_s41_21000000_03_0310","text":"『…………软乎乎～，烤好了～♪』"},{"key":"SCENARIO_s41_21000000_03_0320","text":"诶"},{"key":"SCENARIO_s41_21000000_03_0330","text":"『吃个够～♪　大口咬～♪』"},{"key":"SCENARIO_s41_21000000_03_0340","text":"等、等等等等等等……\n难道从唱第一句开始……就一直……！？"},{"key":"SCENARIO_s41_21000000_03_0341","text":"Motion"},{"key":"SCENARIO_s41_21000000_03_0350","text":"…………"},{"key":"SCENARIO_s41_21000000_03_0360","text":"比起那个……"},{"key":"SCENARIO_s41_21000000_03_0370","text":"有焦味"},{"key":"SCENARIO_s41_21000000_03_0380","text":"啊、啊啊啊～！\n忘了！"},{"key":"SCENARIO_s41_21000000_03_0390","text":"总、总之，圆香——！\n那个录音给我删——……哇、啊啊！"},{"key":"SCENARIO_s41_21000000_03_0400","text":"…………"}]
