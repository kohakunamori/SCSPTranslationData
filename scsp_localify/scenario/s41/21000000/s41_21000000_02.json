[{"key":"SCENARIO_s41_21000000_02_0000","text":"Motion"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0010","text":"──……哇……！"},{"key":"SCENARIO_s41_21000000_02_0002","text":"女高中生２"},{"key":"SCENARIO_s41_21000000_02_0020","text":"快看快看，我家推的首周排名第一……！"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0030","text":"噢，挺厉害嘛……"},{"key":"SCENARIO_s41_21000000_02_0040","text":"…………"},{"key":"SCENARIO_s41_21000000_02_0002","text":"女高中生２"},{"key":"SCENARIO_s41_21000000_02_0050","text":"——……啊，这个最近出道的偶像……"},{"key":"SCENARIO_s41_21000000_02_0060","text":"我认识她哦\n以前的同班同学"},{"key":"SCENARIO_s41_21000000_02_0070","text":"就是这个叫圆香的"},{"key":"SCENARIO_s41_21000000_02_0080","text":"…………"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0090","text":"——诶，挺可爱的嘛"},{"key":"SCENARIO_s41_21000000_02_0002","text":"女高中生２"},{"key":"SCENARIO_s41_21000000_02_0100","text":"是啊，她确实挺显眼的"},{"key":"SCENARIO_s41_21000000_02_0110","text":"不过没想到她会做这种事呢\n怎么说呢……就，哦，这样啊的感觉"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0120","text":"啊哈哈，什么啊——"},{"key":"SCENARIO_s41_21000000_02_0130","text":"（这些孩子，没注意到吗……）"},{"key":"SCENARIO_s41_21000000_02_0140","text":"（圆香跟她们在同一个车厢……）"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0150","text":"果然是被星探挖了之后\n就动心了吧？"},{"key":"SCENARIO_s41_21000000_02_0002","text":"女高中生２"},{"key":"SCENARIO_s41_21000000_02_0160","text":"是这样吗？可能是她自己去报名的"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0170","text":"“我想成为国民美少女！”像这样？"},{"key":"SCENARIO_s41_21000000_02_0002","text":"女高中生２"},{"key":"SCENARIO_s41_21000000_02_0180","text":"天哪，梦想也太大了吧\n不愧是可爱的女孩子，就是不一样……！"},{"key":"SCENARIO_s41_21000000_02_0001","text":"女高中生１"},{"key":"SCENARIO_s41_21000000_02_0190","text":"啊哈哈……！"},{"key":"SCENARIO_s41_21000000_02_0200","text":"……"},{"key":"SCENARIO_s41_21000000_02_0210","text":"（……去别的车厢吧）"},{"key":"SCENARIO_s41_21000000_02_0220","text":"（──……圆香）"},{"key":"SCENARIO_s41_21000000_02_0221","text":"Motion"},{"key":"SCENARIO_s41_21000000_02_0230","text":"……！"},{"key":"SCENARIO_s41_21000000_02_0240","text":"“多余的担心”"},{"key":"SCENARIO_s41_21000000_02_0250","text":"…………"},{"key":"SCENARIO_s41_21000000_02_0260","text":"“没关系吗？”"},{"key":"SCENARIO_s41_21000000_02_0270","text":"“在意也是白费功夫”"},{"key":"SCENARIO_s41_21000000_02_0280","text":"…………"},{"key":"SCENARIO_s41_21000000_02_0290","text":"“但是”"},{"key":"SCENARIO_s41_21000000_02_0300","text":"“不必特地留在这里听”"},{"key":"SCENARIO_s41_21000000_02_0310","text":"『不在眼前亲耳听到，就等于没有？』"},{"key":"SCENARIO_s41_21000000_02_0320","text":"『做这种活动，闲话也会变多』"},{"key":"SCENARIO_s41_21000000_02_0330","text":"“我知道的”"},{"key":"SCENARIO_s41_21000000_02_0340","text":"『抱歉，你说得对』"},{"key":"SCENARIO_s41_21000000_02_0350","text":"『嗯，让她们说去吧』"},{"key":"SCENARIO_s41_21000000_02_0360","text":"『反正她们对圆香的事什么都不知道』"},{"key":"SCENARIO_s41_21000000_02_0370","text":"“好的”"},{"key":"SCENARIO_s41_21000000_02_0380","text":"“就这样一直不了解吧”"},{"key":"SCENARIO_s41_21000000_02_0390","text":"“今后也不必了解”"},{"key":"SCENARIO_s41_21000000_02_0400","text":"『谁都不知道』"}]
