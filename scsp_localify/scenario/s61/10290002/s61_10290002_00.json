[{"key":"SCENARIO_s61_10290002_00_0001","text":"Motion"},{"key":"SCENARIO_s61_10290002_00_0010","text":"叶月小姐，生日快乐\n愿您度过美好的一年"},{"key":"SCENARIO_s61_10290002_00_0020","text":"呵呵，谢谢您♪\n那么，为了能度过美好的一年……"},{"key":"SCENARIO_s61_10290002_00_0021","text":"Motion"},{"key":"SCENARIO_s61_10290002_00_0030","text":"收据的提交，请尽早哦～"},{"key":"SCENARIO_s61_10290002_00_0040","text":"……！\n好的，明白了……！"},{"key":"SCENARIO_s61_10290002_00_0041","text":"Motion"}]
