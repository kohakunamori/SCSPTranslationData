[{"key":"SCENARIO_s61_10217002_00_0000","text":"Motion"},{"key":"SCENARIO_s61_10217002_00_0010","text":"制作人！"},{"key":"SCENARIO_s61_10217002_00_0020","text":"朝日！\n今天是你的生日吧，生日快乐────"},{"key":"SCENARIO_s61_10217002_00_0030","text":"那事待会再说，你先过来一下！\n我发现了超有趣的东西！"},{"key":"SCENARIO_s61_10217002_00_0040","text":"哦，有趣的东西？"},{"key":"SCENARIO_s61_10217002_00_0050","text":"对！\n快快快，在这边……！"},{"key":"SCENARIO_s61_10217002_00_0060","text":"哇──哈哈，等等我！\n不用拉我也会跟你走的啦……！"}]
