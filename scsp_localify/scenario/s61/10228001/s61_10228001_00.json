[{"key":"SCENARIO_s61_10228001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10228001_00_0010","text":"生日快乐\n阳希"},{"key":"SCENARIO_s61_10228001_00_0020","text":"哇……！\n好的……！嘿嘿……"},{"key":"SCENARIO_s61_10228001_00_0030","text":"……和家人朋友为我庆祝的感觉\n好像不太一样"},{"key":"SCENARIO_s61_10228001_00_0040","text":"呵呵～。『恭喜』真是个好词呢\n等轮到制作人的时候我也一定会说的"},{"key":"SCENARIO_s61_10228001_00_0050","text":"哈哈，嗯\n我很期待"}]
