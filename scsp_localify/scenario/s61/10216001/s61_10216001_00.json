[{"key":"SCENARIO_s61_10216001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10216001_00_0010","text":"～♪"},{"key":"SCENARIO_s61_10216001_00_0020","text":"生日快乐\n是你的生日吧，千雪"},{"key":"SCENARIO_s61_10216001_00_0030","text":"是的！\n哇，好开心啊……"},{"key":"SCENARIO_s61_10216001_00_0040","text":"蛋糕、花、漂亮的留言……\n还有奖励自己，一口气买下的首饰……"},{"key":"SCENARIO_s61_10216001_00_0050","text":"再加上制作人的祝福……！\n变成了充满幸福的特别的一天♪"}]
