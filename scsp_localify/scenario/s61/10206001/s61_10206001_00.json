[{"key":"SCENARIO_s61_10206001_00_0000","text":"Motion"},{"key":"SCENARIO_s61_10206001_00_0010","text":"……"},{"key":"SCENARIO_s61_10206001_00_0020","text":"咲耶"},{"key":"SCENARIO_s61_10206001_00_0030","text":"！\n怎么了？　制作人"},{"key":"SCENARIO_s61_10206001_00_0040","text":"生日快乐！\n让今天成为咲耶美好的一天，让这一年成为美好的一年吧！"},{"key":"SCENARIO_s61_10206001_00_0050","text":"──谢谢你认识我、记得我……\n我感到非常荣幸"}]
