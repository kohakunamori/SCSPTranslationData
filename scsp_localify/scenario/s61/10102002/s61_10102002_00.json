[{"key":"SCENARIO_s61_10102002_00_0000","text":"Motion"},{"key":"SCENARIO_s61_10102002_00_0010","text":"生日快乐\n制作人"},{"key":"SCENARIO_s61_10102002_00_0020","text":"哦，谢谢\n你还记得啊"},{"key":"SCENARIO_s61_10102002_00_0030","text":"是的，当然\n因为是重要的日子"},{"key":"SCENARIO_s61_10102002_00_0040","text":"哈哈，我的生日什么的，\n没那么夸张啦"},{"key":"SCENARIO_s61_10102002_00_0050","text":"…………"},{"key":"SCENARIO_s61_10102002_00_0060","text":"即便如此，对我来说也是非常重要的日子\n请让我好好为您庆祝"}]
