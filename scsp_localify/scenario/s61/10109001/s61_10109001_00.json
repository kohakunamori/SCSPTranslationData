[{"key":"SCENARIO_s61_10109001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10109001_00_0010","text":"制作人制作人\n制作人先—生！"},{"key":"SCENARIO_s61_10109001_00_0020","text":"生日快乐！！"},{"key":"SCENARIO_s61_10109001_00_0030","text":"谢谢你！果穗！"},{"key":"SCENARIO_s61_10109001_00_0040","text":"制作人，\n升级之后变得更强了对吧……！"},{"key":"SCENARIO_s61_10109001_00_0050","text":"也就是说从今天起的我们\n会变得超超超——级强对吧……！"}]
