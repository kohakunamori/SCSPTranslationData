[{"key":"SCENARIO_s61_10116002_00_0000","text":"Motion"},{"key":"SCENARIO_s61_10116002_00_0010","text":"制作人\n生日快乐♪"},{"key":"SCENARIO_s61_10116002_00_0020","text":"谢谢！\n……哎呀，被庆祝之前我都忘了"},{"key":"SCENARIO_s61_10116002_00_0030","text":"人长大了，\n对生日的实感会越来越淡啊"},{"key":"SCENARIO_s61_10116002_00_0040","text":"那种心情我也能理解……\n不过没关系，我会替您记住的"},{"key":"SCENARIO_s61_10116002_00_0050","text":"那我也会记住千雪的生日\n这样我们俩就绝对不会忘了吧！"},{"key":"SCENARIO_s61_10116002_00_0060","text":"呵呵……！\n可以让我住进制作人的记忆里吗？"}]
