[{"key":"SCENARIO_s61_10103001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10103001_00_0010","text":"制作人！"},{"key":"SCENARIO_s61_10103001_00_0020","text":"喔哦……！？\n小……巡？"},{"key":"SCENARIO_s61_10103001_00_0030","text":"嗯，是巡哦—！\n嘿嘿……"},{"key":"SCENARIO_s61_10103001_00_0040","text":"看你心情很好的样子？\n发生什么好事了吗？"},{"key":"SCENARIO_s61_10103001_00_0050","text":"有！是制作人的生日！\n——制作人，生日快乐！"}]
