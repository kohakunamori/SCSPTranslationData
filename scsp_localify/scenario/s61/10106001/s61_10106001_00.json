[{"key":"SCENARIO_s61_10106001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10106001_00_0010","text":"生日快乐，制作人"},{"key":"SCENARIO_s61_10106001_00_0020","text":"哦！\n谢谢你，咲耶"},{"key":"SCENARIO_s61_10106001_00_0030","text":"呵呵，不——\n该道谢的人是我才对"},{"key":"SCENARIO_s61_10106001_00_0040","text":"因为与你相遇，我才得以拥有\n为你庆生的这份幸福"},{"key":"SCENARIO_s61_10106001_00_0050","text":"希望往后的岁月里……\n也能一直这样传达给你"}]
