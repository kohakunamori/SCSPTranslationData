[{"key":"SCENARIO_s61_10117001_00_0010","text":"制作人\n有纸杯、保鲜膜芯和橡皮筋吗"},{"key":"SCENARIO_s61_10117001_00_0020","text":"仓库里应该都有吧\n要做什么的话我来帮忙"},{"key":"SCENARIO_s61_10117001_00_0030","text":"真的吗？\n我想做很多，帮大忙了"},{"key":"SCENARIO_s61_10117001_00_0040","text":"很多……？\n要做什么？"},{"key":"SCENARIO_s61_10117001_00_0050","text":"拉炮！\n今天是要拉很多响炮的日子对吧！"}]
