[{"key":"SCENARIO_s61_10105001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10105001_00_0010","text":"制作人，恭喜您～"},{"key":"SCENARIO_s61_10105001_00_0020","text":"哦，你还记得我的生日啊！\n谢谢你，摩美美……！"},{"key":"SCENARIO_s61_10105001_00_0030","text":"诶—？我可没说生日什么的哦—\n难道说，您在期待吗？"},{"key":"SCENARIO_s61_10105001_00_0040","text":"诶？　不、不是吗……？\n哈哈，抱歉……那，是在庆祝什么？"},{"key":"SCENARIO_s61_10105001_00_0050","text":"呵呵——……开玩笑的—\n生日快乐～"}]
