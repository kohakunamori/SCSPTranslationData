[{"key":"SCENARIO_s61_10202001_00_0011","text":"Motion"},{"key":"SCENARIO_s61_10202001_00_0010","text":"──灯织"},{"key":"SCENARIO_s61_10202001_00_0020","text":"好的……！"},{"key":"SCENARIO_s61_10202001_00_0030","text":"生日快乐！\n希望对灯织来说是美好的一年"},{"key":"SCENARIO_s61_10202001_00_0040","text":"呵呵……嗯\n谢谢你，制作人"},{"key":"SCENARIO_s61_10202001_00_0050","text":"明明知道您一定会来跟我说的……\n但果然还是很开心呢"}]
