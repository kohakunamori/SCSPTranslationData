[{"key":"SCENARIO_s40_01010000_05_0000","text":"Motion"},{"key":"SCENARIO_s40_01010000_05_0001","text":"Motion"},{"key":"SCENARIO_s40_01010000_05_0010","text":"……啊……"},{"key":"SCENARIO_s40_01010000_05_0020","text":"……喂，彩虹！"},{"key":"SCENARIO_s40_01010000_05_0030","text":"彩虹？"},{"key":"SCENARIO_s40_01010000_05_0040","text":"真的，好大……"},{"key":"SCENARIO_s40_01010000_05_0050","text":"呼哇……"},{"key":"SCENARIO_s40_01010000_05_0060","text":"好漂亮啊——……"},{"key":"SCENARIO_s40_01010000_05_0070","text":"啊……"},{"key":"SCENARIO_s40_01010000_05_0080","text":"彩虹，好像有两条……"},{"key":"SCENARIO_s40_01010000_05_0090","text":"诶"},{"key":"SCENARIO_s40_01010000_05_0100","text":"在大彩虹的里面，隐隐约约……\n好像……还有一条小彩虹……"},{"key":"SCENARIO_s40_01010000_05_0110","text":"啊啊……"},{"key":"SCENARIO_s40_01010000_05_0120","text":"……！\n好厉害好厉害！真的！"},{"key":"SCENARIO_s40_01010000_05_0130","text":"抱歉，我能拍张照吗？"},{"key":"SCENARIO_s40_01010000_05_0140","text":"好啊——！我们换座位！"},{"key":"SCENARIO_s40_01010000_05_0150","text":"巡也要拍吧？\n我从这里拍就行──"},{"key":"SCENARIO_s40_01010000_05_0160","text":"隧道……"},{"key":"SCENARIO_s40_01010000_05_0170","text":"出来了！"},{"key":"SCENARIO_s40_01010000_05_0180","text":"啊——……"},{"key":"SCENARIO_s40_01010000_05_0190","text":"好，趁现在──"},{"key":"SCENARIO_s40_01010000_05_0200","text":"啊——……"}]
