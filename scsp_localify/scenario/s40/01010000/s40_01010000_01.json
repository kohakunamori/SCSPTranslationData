[{"key":"SCENARIO_s40_01010000_01_0010","text":"…………\n嗯…………啊………"},{"key":"SCENARIO_s40_01010000_01_0020","text":"唔哇……"},{"key":"SCENARIO_s40_01010000_01_0030","text":"早上好，小P\n对不起……把你吵醒了……？"},{"key":"SCENARIO_s40_01010000_01_0031","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0040","text":"呵呵……"},{"key":"SCENARIO_s40_01010000_01_0041","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0050","text":"『早上好！』"},{"key":"SCENARIO_s40_01010000_01_0060","text":"『叫醒服务来啦——！』\n『大家都醒了的话请回复一下！』"},{"key":"SCENARIO_s40_01010000_01_0070","text":"………………"},{"key":"SCENARIO_s40_01010000_01_0071","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0080","text":"────………"},{"key":"SCENARIO_s40_01010000_01_0090","text":"“早安”"},{"key":"SCENARIO_s40_01010000_01_0100","text":"『醒了。现在开始准备』"},{"key":"SCENARIO_s40_01010000_01_0110","text":"…………"},{"key":"SCENARIO_s40_01010000_01_0120","text":"『早上好，我也醒了』"},{"key":"SCENARIO_s40_01010000_01_0130","text":"『我去准备了』"},{"key":"SCENARIO_s40_01010000_01_0140","text":"……嗯………"},{"key":"SCENARIO_s40_01010000_01_0141","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0142","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0143","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0150","text":"『我也刚醒。看来全员都没睡过头……！』"},{"key":"SCENARIO_s40_01010000_01_0160","text":"『哇，太阳都还没出来啊……』"},{"key":"SCENARIO_s40_01010000_01_0170","text":"『今天让大家这么早集合真的很抱歉』\n『我会按顺序去接你们的』────"},{"key":"SCENARIO_s40_01010000_01_0180","text":"…………………………"},{"key":"SCENARIO_s40_01010000_01_0190","text":"今天，会放晴吗……？"},{"key":"SCENARIO_s40_01010000_01_0191","text":"Motion"},{"key":"SCENARIO_s40_01010000_01_0200","text":"哇，水……？\n我现在帮你换新的，稍等一下哦……"}]
