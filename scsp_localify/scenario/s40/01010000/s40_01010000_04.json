[{"key":"SCENARIO_s40_01010000_04_0000","text":"Motion"},{"key":"SCENARIO_s40_01010000_04_0001","text":"Motion"},{"key":"SCENARIO_s40_01010000_04_0010","text":"──辛苦啦—"},{"key":"SCENARIO_s40_01010000_04_0020","text":"嗯，刚洗完澡\n……嗯"},{"key":"SCENARIO_s40_01010000_04_0030","text":"诶，已经播到了！？"},{"key":"SCENARIO_s40_01010000_04_0040","text":"哇，连节目广告里都有她……！"},{"key":"SCENARIO_s40_01010000_04_0050","text":"──对了，我把通话开了免提……\n你那边电视的声音，会不会太吵？没问题吗？"},{"key":"SCENARIO_s40_01010000_04_0060","text":"『…………，没事。几乎听不到』"},{"key":"SCENARIO_s40_01010000_04_0070","text":"非常棒！"},{"key":"SCENARIO_s40_01010000_04_0080","text":"『啊，开始了』"},{"key":"SCENARIO_s40_01010000_04_0090","text":"哇—！"},{"key":"SCENARIO_s40_01010000_04_0091","text":"电视的声音\n "},{"key":"SCENARIO_s40_01010000_04_0100","text":"『散步食堂，今天的嘉宾是────』"},{"key":"SCENARIO_s40_01010000_04_0101","text":"Motion"},{"key":"SCENARIO_s40_01010000_04_0110","text":"真乃——！"},{"key":"SCENARIO_s40_01010000_04_0120","text":"『……那套衣服好可爱』"},{"key":"SCENARIO_s40_01010000_04_0130","text":"对吧！我也是这么想的！\n超可爱——！"},{"key":"SCENARIO_s40_01010000_04_0131","text":"Motion"},{"key":"SCENARIO_s40_01010000_04_0140","text":"……真乃，现在是在工作中对吧？"},{"key":"SCENARIO_s40_01010000_04_0150","text":"『嗯，应该在录广播节目』"},{"key":"SCENARIO_s40_01010000_04_0160","text":"也是，那可能会打扰到她\n待会儿再发消息吧……"},{"key":"SCENARIO_s40_01010000_04_0170","text":"『呵呵……\n　嗯，也是呢』"},{"key":"SCENARIO_s40_01010000_04_0180","text":"『……从地里拔出来的，是什么蔬菜呢……』"},{"key":"SCENARIO_s40_01010000_04_0190","text":"对啊！是什么呢……？\n看起来挺重的？——或者说，感觉需要花不少力气……！"},{"key":"SCENARIO_s40_01010000_04_0200","text":"嚯——！加油——！\n真乃——……！"}]
