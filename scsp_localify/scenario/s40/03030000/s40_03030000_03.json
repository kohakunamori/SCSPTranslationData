[{"key":"SCENARIO_s40_03030000_03_0000","text":"Motion"},{"key":"SCENARIO_s40_03030000_03_0001","text":"Motion"},{"key":"SCENARIO_s40_03030000_03_0002","text":"Motion"},{"key":"SCENARIO_s40_03030000_03_0010","text":"夏叶，咱俩躲在这儿，\n不是白躲了吗……？"},{"key":"SCENARIO_s40_03030000_03_0020","text":"15、16、17……──"},{"key":"SCENARIO_s40_03030000_03_0030","text":"也是呢……\n但现在出去也太危险了。"},{"key":"SCENARIO_s40_03030000_03_0040","text":"18、19\n──20！"},{"key":"SCENARIO_s40_03030000_03_0050","text":"冲啦──！"},{"key":"SCENARIO_s40_03030000_03_0060","text":"不妙……！\n要来了……！"},{"key":"SCENARIO_s40_03030000_03_0070","text":"嗯。\n尽量缩成一团……"},{"key":"SCENARIO_s40_03030000_03_0080","text":"在哪儿呢──……！"},{"key":"SCENARIO_s40_03030000_03_0090","text":"──啊！\n发现小千前辈！"},{"key":"SCENARIO_s40_03030000_03_0100","text":"咦！？"},{"key":"SCENARIO_s40_03030000_03_0110","text":"喂、喂！\n小千，已经被找到了啊……"},{"key":"SCENARIO_s40_03030000_03_0120","text":"…………\n这股气息……"},{"key":"SCENARIO_s40_03030000_03_0130","text":"──凛世小姐，找到你了！"},{"key":"SCENARIO_s40_03030000_03_0140","text":"呵呵……\n被找到了呢……"},{"key":"SCENARIO_s40_03030000_03_0150","text":"凛世也被……！"},{"key":"SCENARIO_s40_03030000_03_0160","text":"怎么办？\n就剩咱俩了……！"},{"key":"SCENARIO_s40_03030000_03_0170","text":"我知道……！\n只能趁不被发现，赶紧转移了……"},{"key":"SCENARIO_s40_03030000_03_0180","text":"现在出去肯定完蛋吧……！？"},{"key":"SCENARIO_s40_03030000_03_0190","text":"话是这么说，但总比待在这里──……"},{"key":"SCENARIO_s40_03030000_03_0191","text":"Motion"},{"key":"SCENARIO_s40_03030000_03_0200","text":"树里酱！　夏叶小姐！\n两个人都找到啦！"}]
