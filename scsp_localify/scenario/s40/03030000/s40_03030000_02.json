[{"key":"SCENARIO_s40_03030000_02_0000","text":"Motion"},{"key":"SCENARIO_s40_03030000_02_0010","text":"嘿。"},{"key":"SCENARIO_s40_03030000_02_0020","text":"……嘿！"},{"key":"SCENARIO_s40_03030000_02_0030","text":"嚯。"},{"key":"SCENARIO_s40_03030000_02_0040","text":"……"},{"key":"SCENARIO_s40_03030000_02_0050","text":"──哇啊！？"},{"key":"SCENARIO_s40_03030000_02_0060","text":"是我赢了！"},{"key":"SCENARIO_s40_03030000_02_0070","text":"哇……输了啊……！\n果穗你怎么跑那么快？"},{"key":"SCENARIO_s40_03030000_02_0080","text":"诶嘿嘿……！"},{"key":"SCENARIO_s40_03030000_02_0090","text":"我经常和朋友玩这个！\n还有更厉害的台阶行走高手呢！"},{"key":"SCENARIO_s40_03030000_02_0100","text":"原来如此。\n难怪我赢不了你。"},{"key":"SCENARIO_s40_03030000_02_0110","text":"我朋友比我还要快哦！\n超级厉害的！"},{"key":"SCENARIO_s40_03030000_02_0120","text":"真的假的……！\n现在的小学生真可怕啊。"},{"key":"SCENARIO_s40_03030000_02_0130","text":"啊哈哈"},{"key":"SCENARIO_s40_03030000_02_0140","text":"……嘿哟"},{"key":"SCENARIO_s40_03030000_02_0150","text":"！"},{"key":"SCENARIO_s40_03030000_02_0160","text":"果穗，再来一局！"},{"key":"SCENARIO_s40_03030000_02_0170","text":"好的！"},{"key":"SCENARIO_s40_03030000_02_0180","text":"终点就定在那里。"},{"key":"SCENARIO_s40_03030000_02_0181","text":"Motion"},{"key":"SCENARIO_s40_03030000_02_0190","text":"预备……"},{"key":"SCENARIO_s40_03030000_02_0200","text":"跑！"}]
