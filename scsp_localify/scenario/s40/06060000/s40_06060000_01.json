[{"key":"SCENARIO_s40_06060000_01_0000","text":"Motion"},{"key":"SCENARIO_s40_06060000_01_0001","text":"记者"},{"key":"SCENARIO_s40_06060000_01_0010","text":"──诶，据说在这片海域\n有一位传说中的赶海大师──"},{"key":"SCENARIO_s40_06060000_01_0020","text":"赶海啊～"},{"key":"SCENARIO_s40_06060000_01_0030","text":"……嗯——"},{"key":"SCENARIO_s40_06060000_01_0040","text":"想去吗～？"},{"key":"SCENARIO_s40_06060000_01_0050","text":"……诶，啊"},{"key":"SCENARIO_s40_06060000_01_0060","text":"什么？赶海是什么"},{"key":"SCENARIO_s40_06060000_01_0070","text":"……！\n就、就是在沙滩上……抓各种东西吧……"},{"key":"SCENARIO_s40_06060000_01_0080","text":"能抓到章鱼吗～？"},{"key":"SCENARIO_s40_06060000_01_0090","text":"哦，章鱼"},{"key":"SCENARIO_s40_06060000_01_0100","text":"章、章鱼应该抓不到吧……！\n贝壳……之类的……？"},{"key":"SCENARIO_s40_06060000_01_0110","text":"贝壳啊\n扇贝呢？"},{"key":"SCENARIO_s40_06060000_01_0120","text":"……！\n那、那个可能也抓不到……！"},{"key":"SCENARIO_s40_06060000_01_0130","text":"……酱油和黄油，配"},{"key":"SCENARIO_s40_06060000_01_0140","text":"……！"},{"key":"SCENARIO_s40_06060000_01_0150","text":"酱油和黄油"},{"key":"SCENARIO_s40_06060000_01_0160","text":"酱油和黄油！"},{"key":"SCENARIO_s40_06060000_01_0170","text":"好、好像很好吃……！"},{"key":"SCENARIO_s40_06060000_01_0180","text":"────扇……"},{"key":"SCENARIO_s40_06060000_01_0190","text":"────妈妈……"},{"key":"SCENARIO_s40_06060000_01_0200","text":"扇贝好——今天想吃"},{"key":"SCENARIO_s40_06060000_01_0210","text":"四个——"}]
