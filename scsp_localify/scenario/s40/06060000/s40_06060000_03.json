[{"key":"SCENARIO_s40_06060000_03_0000","text":"Motion"},{"key":"SCENARIO_s40_06060000_03_0010","text":"怎么说呢\n有点渴了呢～？"},{"key":"SCENARIO_s40_06060000_03_0020","text":"是、是吗\n我倒是不渴……"},{"key":"SCENARIO_s40_06060000_03_0030","text":"要看看冰箱……？"},{"key":"SCENARIO_s40_06060000_03_0040","text":"早—"},{"key":"SCENARIO_s40_06060000_03_0042","text":"Motion"},{"key":"SCENARIO_s40_06060000_03_0041","text":"Motion"},{"key":"SCENARIO_s40_06060000_03_0050","text":"────『里面是麦茶。请随意饮用\n喝完的人请补充存货』"},{"key":"SCENARIO_s40_06060000_03_0060","text":"还、还挺少的……！"},{"key":"SCENARIO_s40_06060000_03_0070","text":"啊哈～\n喝吧～"},{"key":"SCENARIO_s40_06060000_03_0080","text":"喝、喝得挺多啊……"},{"key":"SCENARIO_s40_06060000_03_0090","text":"我也来一杯"},{"key":"SCENARIO_s40_06060000_03_0100","text":"喝、喝得挺多啊……！"},{"key":"SCENARIO_s40_06060000_03_0110","text":"……"},{"key":"SCENARIO_s40_06060000_03_0120","text":"……！\n透、透酱……"},{"key":"SCENARIO_s40_06060000_03_0130","text":"啊哈～\n留了底部一厘米～"},{"key":"SCENARIO_s40_06060000_03_0131","text":"Motion"},{"key":"SCENARIO_s40_06060000_03_0140","text":"耶……！"},{"key":"SCENARIO_s40_06060000_03_0150","text":"我、我就不用了……"},{"key":"SCENARIO_s40_06060000_03_0160","text":"喝了的人，要补充存货哦……！"},{"key":"SCENARIO_s40_06060000_03_0161","text":"Motion"},{"key":"SCENARIO_s40_06060000_03_0170","text":"那就————"},{"key":"SCENARIO_s40_06060000_03_0180","text":"大家一起？／拜托了／透前辈来～"},{"key":"SCENARIO_s40_06060000_03_0190","text":"嗯？\n啊——"},{"key":"SCENARIO_s40_06060000_03_0200","text":"是——"}]
