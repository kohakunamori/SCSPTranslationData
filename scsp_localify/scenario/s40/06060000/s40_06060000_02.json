[{"key":"SCENARIO_s40_06060000_02_0000","text":"Motion"},{"key":"SCENARIO_s40_06060000_02_0010","text":"来，透酱\n别动哦————"},{"key":"SCENARIO_s40_06060000_02_0020","text":"嗯——……"},{"key":"SCENARIO_s40_06060000_02_0030","text":"眼睛，闭上了哦～？"},{"key":"SCENARIO_s40_06060000_02_0040","text":"……"},{"key":"SCENARIO_s40_06060000_02_0050","text":"能、能不能睁开一只眼睛……？\n不然没法滴眼药水……！"},{"key":"SCENARIO_s40_06060000_02_0060","text":"嗯啊——……"},{"key":"SCENARIO_s40_06060000_02_0070","text":"啊哈～\n雏菜帮你撑开～"},{"key":"SCENARIO_s40_06060000_02_0080","text":"……嗯"},{"key":"SCENARIO_s40_06060000_02_0090","text":"睁、睁开了……！\n要滴了……！"},{"key":"SCENARIO_s40_06060000_02_0100","text":"别、别闭上啊……！／啊哈～"},{"key":"SCENARIO_s40_06060000_02_0110","text":"……根本没打算让人滴进去"},{"key":"SCENARIO_s40_06060000_02_0120","text":"嗯～……！\n喂，耳朵……！"},{"key":"SCENARIO_s40_06060000_02_0130","text":"会进耳朵的……眼药水……！"},{"key":"SCENARIO_s40_06060000_02_0140","text":"等、等一下……！\n没事的……！我给你纸巾……！"},{"key":"SCENARIO_s40_06060000_02_0150","text":"嗯——……"},{"key":"SCENARIO_s40_06060000_02_0160","text":"啊，眼睛睁开了～\n没事吧～？"},{"key":"SCENARIO_s40_06060000_02_0170","text":"嗯……\n──────喂"},{"key":"SCENARIO_s40_06060000_02_0180","text":"……怎么了？"},{"key":"SCENARIO_s40_06060000_02_0190","text":"“晴天霹雳”？刚才那句"},{"key":"SCENARIO_s40_06060000_02_0200","text":"……不知道"}]
