[{"key":"SCENARIO_s40_06060000_04_0000","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0001","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0002","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0003","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0004","text":"摄影师"},{"key":"SCENARIO_s40_06060000_04_0010","text":"──嗯，不错嘛！\n大家状态都很好嘛！"},{"key":"SCENARIO_s40_06060000_04_0020","text":"尤其是透酱和圆香酱！\n已经是嗨到飞起的节奏啦！"},{"key":"SCENARIO_s40_06060000_04_0030","text":"哦\n谢啦"},{"key":"SCENARIO_s40_06060000_04_0040","text":"非常感谢"},{"key":"SCENARIO_s40_06060000_04_0050","text":"雏菜酱也乘浪乘得很不错哦——！\n连专业冲浪手都要吓一跳的乘浪技术！"},{"key":"SCENARIO_s40_06060000_04_0060","text":"啊哈～\n是这样吗～？"},{"key":"SCENARIO_s40_06060000_04_0070","text":"小糸酱可以再放开一点哦！\n要有自信！"},{"key":"SCENARIO_s40_06060000_04_0080","text":"好、好的……！"},{"key":"SCENARIO_s40_06060000_04_0090","text":"那么，继续了哦"},{"key":"SCENARIO_s40_06060000_04_0091","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0092","text":"Motion"},{"key":"SCENARIO_s40_06060000_04_0100","text":"总觉得刚才那个摄影师\n好奇怪啊～"},{"key":"SCENARIO_s40_06060000_04_0110","text":"呵呵"},{"key":"SCENARIO_s40_06060000_04_0120","text":"这行里奇怪的人\n要多少有多少吧"},{"key":"SCENARIO_s40_06060000_04_0130","text":"……也、也是呢……"},{"key":"SCENARIO_s40_06060000_04_0140","text":"……嘛，无所谓了"},{"key":"SCENARIO_s40_06060000_04_0150","text":"啊……嗯"},{"key":"SCENARIO_s40_06060000_04_0160","text":"啊哈～\n那要上了哦～？"},{"key":"SCENARIO_s40_06060000_04_0170","text":"哗啦～！"},{"key":"SCENARIO_s40_06060000_04_0180","text":"诶……！\n什、什么……？"},{"key":"SCENARIO_s40_06060000_04_0190","text":"海浪的声音～\n啊，不过不是海浪，是冲浪的那个吧～"},{"key":"SCENARIO_s40_06060000_04_0200","text":"呵呵\n冲浪……！"},{"key":"SCENARIO_s40_06060000_04_0201","text":"Motion"}]
