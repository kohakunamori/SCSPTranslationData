[{"key":"SCENARIO_s40_06060000_05_0000","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0010","text":"透前辈，决定买什么了吗～？"},{"key":"SCENARIO_s40_06060000_05_0020","text":"嗯\n就这个"},{"key":"SCENARIO_s40_06060000_05_0030","text":"诶～，鱼肉香肠～？\n为什么～？"},{"key":"SCENARIO_s40_06060000_05_0040","text":"诶、嗯——……"},{"key":"SCENARIO_s40_06060000_05_0050","text":"凭感觉？"},{"key":"SCENARIO_s40_06060000_05_0060","text":"这样啊～"},{"key":"SCENARIO_s40_06060000_05_0061","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0070","text":"那，雏菜就选这个吧～"},{"key":"SCENARIO_s40_06060000_05_0080","text":"……『一口小鲷鱼烧』？"},{"key":"SCENARIO_s40_06060000_05_0091","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0090","text":"透酱和雏菜酱\n都是鱼呢……！"},{"key":"SCENARIO_s40_06060000_05_0100","text":"啊哈～"},{"key":"SCENARIO_s40_06060000_05_0110","text":"哪里“一口”了……？"},{"key":"SCENARIO_s40_06060000_05_0111","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0120","text":"那个……\n那，我就选这个吧"},{"key":"SCENARIO_s40_06060000_05_0121","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0130","text":"虾条？\n不错"},{"key":"SCENARIO_s40_06060000_05_0131","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0140","text":"那、圆香酱呢？"},{"key":"SCENARIO_s40_06060000_05_0141","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0150","text":"……哈？什么？"},{"key":"SCENARIO_s40_06060000_05_0151","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0152","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0160","text":"这、这样啊……！"},{"key":"SCENARIO_s40_06060000_05_0161","text":"Motion"},{"key":"SCENARIO_s40_06060000_05_0170","text":"嗯～？"},{"key":"SCENARIO_s40_06060000_05_0180","text":"圆香前辈的饮料\n包装上有路加～"},{"key":"SCENARIO_s40_06060000_05_0190","text":"诶……！\n啊，真、真的……！"},{"key":"SCENARIO_s40_06060000_05_0200","text":"……叽叽"},{"key":"SCENARIO_s40_06060000_05_0201","text":"Motion"}]
