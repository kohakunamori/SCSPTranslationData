[{"key":"SCENARIO_s40_08080000_04_0000","text":"Motion"},{"key":"SCENARIO_s40_08080000_04_0010","text":"呵呵……"},{"key":"SCENARIO_s40_08080000_04_0020","text":"呐呐\n羽那酱，你看这个……"},{"key":"SCENARIO_s40_08080000_04_0030","text":"……？\n日程本？"},{"key":"SCENARIO_s40_08080000_04_0040","text":"我在想……渐渐被偶像工作填满了呢～"},{"key":"SCENARIO_s40_08080000_04_0050","text":"啊，真的诶——"},{"key":"SCENARIO_s40_08080000_04_0060","text":"今天是拍摄……"},{"key":"SCENARIO_s40_08080000_04_0070","text":"──明天是下一个工作的碰头会"},{"key":"SCENARIO_s40_08080000_04_0080","text":"后天是排练～"},{"key":"SCENARIO_s40_08080000_04_0090","text":"再接下来，也是排练"},{"key":"SCENARIO_s40_08080000_04_0100","text":"……排练还是占多数呢"},{"key":"SCENARIO_s40_08080000_04_0110","text":"不过，工作安排\n也在慢慢变多"},{"key":"SCENARIO_s40_08080000_04_0120","text":"那样的话\n就要忙翻天了呢……！"},{"key":"SCENARIO_s40_08080000_04_0130","text":"嗯"},{"key":"SCENARIO_s40_08080000_04_0140","text":"呵呵\n忙到日程本全被写满黑字"},{"key":"SCENARIO_s40_08080000_04_0150","text":"…………"},{"key":"SCENARIO_s40_08080000_04_0160","text":"真到那时候，可厉害了……！"},{"key":"SCENARIO_s40_08080000_04_0170","text":"我说——"},{"key":"SCENARIO_s40_08080000_04_0171","text":"Motion"},{"key":"SCENARIO_s40_08080000_04_0180","text":"那片黑色里，有路加酱、羽那酱\n还有制作人……"},{"key":"SCENARIO_s40_08080000_04_0190","text":"忙忙碌碌……\n瞬息万变的每一天"},{"key":"SCENARIO_s40_08080000_04_0200","text":"快乐的，一片漆黑"},{"key":"SCENARIO_s40_08080000_04_0201","text":"Motion"}]
