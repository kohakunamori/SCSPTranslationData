[{"key":"SCENARIO_s40_08080000_02_0000","text":"路过的女性"},{"key":"SCENARIO_s40_08080000_02_0001","text":"路过的男性"},{"key":"SCENARIO_s40_08080000_02_0003","text":"Motion"},{"key":"SCENARIO_s40_08080000_02_0010","text":"哇……\n有乌鸦"},{"key":"SCENARIO_s40_08080000_02_0002","text":"Motion"},{"key":"SCENARIO_s40_08080000_02_0020","text":"真的\n是来翻垃圾吃的吧？"},{"key":"SCENARIO_s40_08080000_02_0030","text":"讨厌～\n好恶心～"},{"key":"SCENARIO_s40_08080000_02_0040","text":"这家伙完全不跑啊"},{"key":"SCENARIO_s40_08080000_02_0050","text":"喂，别看了快走吧\n我讨厌乌鸦"},{"key":"SCENARIO_s40_08080000_02_0060","text":"────"},{"key":"SCENARIO_s40_08080000_02_0070","text":"它说讨厌你"},{"key":"SCENARIO_s40_08080000_02_0080","text":"那不是挺好嘛"},{"key":"SCENARIO_s40_08080000_02_0090","text":"与其被那种东西喜欢\n还不如一个人待着"},{"key":"SCENARIO_s40_08080000_02_0004","text":"Motion"},{"key":"SCENARIO_s40_08080000_02_0100","text":"与其跟你们这群家伙搞好关系\n还不如去吃垃圾────"},{"key":"SCENARIO_s40_08080000_02_0110","text":"那种眼神……"},{"key":"SCENARIO_s40_08080000_02_0120","text":"我明白的……我也一样"},{"key":"SCENARIO_s40_08080000_02_0130","text":"想要的东西\n自己动手去抢────"},{"key":"SCENARIO_s40_08080000_02_0140","text":"谁都不需要"},{"key":"SCENARIO_s40_08080000_02_0150","text":"谁也不信"},{"key":"SCENARIO_s40_08080000_02_0160","text":"相信的只有────"},{"key":"SCENARIO_s40_08080000_02_0170","text":"自己的声音"},{"key":"SCENARIO_s40_08080000_02_0005","text":"Motion"},{"key":"SCENARIO_s40_08080000_02_0180","text":"只有自己────────"},{"key":"SCENARIO_s40_08080000_02_0190","text":"即使是现在，那份心情……"},{"key":"SCENARIO_s40_08080000_02_0200","text":"所以……"}]
