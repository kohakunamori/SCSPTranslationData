[{"key":"SCENARIO_s40_08080000_03_0000","text":"Motion"},{"key":"SCENARIO_s40_08080000_03_0010","text":"…………"},{"key":"SCENARIO_s40_08080000_03_0020","text":"……？\n阳希酱，那是──"},{"key":"SCENARIO_s40_08080000_03_0030","text":"啊哈，是我的照片呢\n之前拍的那组"},{"key":"SCENARIO_s40_08080000_03_0040","text":"抱歉，我先看了……！"},{"key":"SCENARIO_s40_08080000_03_0050","text":"不用的，我没事"},{"key":"SCENARIO_s40_08080000_03_0061","text":"Motion"},{"key":"SCENARIO_s40_08080000_03_0060","text":"这张黑白照片\n真的好帅啊……"},{"key":"SCENARIO_s40_08080000_03_0070","text":"呵呵，专业人士真厉害呢——"},{"key":"SCENARIO_s40_08080000_03_0080","text":"羽那酱也很厉害哦～？\n都看入迷了呢"},{"key":"SCENARIO_s40_08080000_03_0090","text":"──呐，羽那酱\n那时候穿的衣服是什么颜色的？"},{"key":"SCENARIO_s40_08080000_03_0100","text":"诶\n嗯……是什么呢？"},{"key":"SCENARIO_s40_08080000_03_0110","text":"看起来是黑色──但感觉又不太一样……\n蓝色……？"},{"key":"SCENARIO_s40_08080000_03_0120","text":"啊哈，完全不记得了"},{"key":"SCENARIO_s40_08080000_03_0130","text":"哈哈，是吗"},{"key":"SCENARIO_s40_08080000_03_0140","text":"这件衣服的黑、背景的黑、\n头发和影子的黑──"},{"key":"SCENARIO_s40_08080000_03_0150","text":"完全不同的颜色\n都包含在这片黑色里呢……"},{"key":"SCENARIO_s40_08080000_03_0151","text":"Motion"},{"key":"SCENARIO_s40_08080000_03_0160","text":"…………"},{"key":"SCENARIO_s40_08080000_03_0170","text":"不过，正因为看不见颜色\n反而有些东西能从被摄体身上浮现出来呢……"},{"key":"SCENARIO_s40_08080000_03_0180","text":"诶，你看到了什么？"},{"key":"SCENARIO_s40_08080000_03_0190","text":"用语言说不出来呢……"},{"key":"SCENARIO_s40_08080000_03_0200","text":"诶——？\n人家好想知道嘛——！"}]
