[{"key":"SCENARIO_s40_05050000_04_0000","text":"Motion"},{"key":"SCENARIO_s40_05050000_04_0010","text":"…………\n哈……！　…………"},{"key":"SCENARIO_s40_05050000_04_0020","text":"……"},{"key":"SCENARIO_s40_05050000_04_0030","text":"…………"},{"key":"SCENARIO_s40_05050000_04_0031","text":"车内广播"},{"key":"SCENARIO_s40_05050000_04_0040","text":"即将到达下一站\n开门方向为左侧"},{"key":"SCENARIO_s40_05050000_04_0041","text":"Motion"},{"key":"SCENARIO_s40_05050000_04_0050","text":"啊！有空位了！"},{"key":"SCENARIO_s40_05050000_04_0060","text":"爱依酱看起来困困的，坐下怎么样？\n朝日酱抱歉，可以吗……？"},{"key":"SCENARIO_s40_05050000_04_0070","text":"诶～……\n这样啊……"},{"key":"SCENARIO_s40_05050000_04_0080","text":"没、没事的……\n我站着就──"},{"key":"SCENARIO_s40_05050000_04_0090","text":"不行"},{"key":"SCENARIO_s40_05050000_04_0100","text":"因为爱依酱\n刚才不是平时的感觉嘛"},{"key":"SCENARIO_s40_05050000_04_0110","text":"来，爱依酱\n快点坐下啦！"},{"key":"SCENARIO_s40_05050000_04_0120","text":"谢、谢谢……"},{"key":"SCENARIO_s40_05050000_04_0121","text":"Motion"},{"key":"SCENARIO_s40_05050000_04_0130","text":"…………"},{"key":"SCENARIO_s40_05050000_04_0140","text":"……！\n冬优子酱！那朵云，不觉得很有趣吗？"},{"key":"SCENARIO_s40_05050000_04_0150","text":"？\n哪朵……？"},{"key":"SCENARIO_s40_05050000_04_0160","text":"就那朵啊！\n正面的……形状好奇怪！"},{"key":"SCENARIO_s40_05050000_04_0170","text":"是吗……\n在我眼里──"},{"key":"SCENARIO_s40_05050000_04_0180","text":"────不\n是啊……在我眼里可能像辆车"},{"key":"SCENARIO_s40_05050000_04_0181","text":"Motion"},{"key":"SCENARIO_s40_05050000_04_0190","text":"车吗……！\n是这样吗？为什么这么觉得？"},{"key":"SCENARIO_s40_05050000_04_0200","text":"下面那两个是轮胎，然后──"}]
