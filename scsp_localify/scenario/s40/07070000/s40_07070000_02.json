[{"key":"SCENARIO_s40_07070000_02_0000","text":"Motion"},{"key":"SCENARIO_s40_07070000_02_0001","text":"Motion"},{"key":"SCENARIO_s40_07070000_02_0010","text":"…………\n…………呼……呼……"},{"key":"SCENARIO_s40_07070000_02_0020","text":"……………………"},{"key":"SCENARIO_s40_07070000_02_0030","text":"不……\n不好意思，我稍微喝口水……！"},{"key":"SCENARIO_s40_07070000_02_0040","text":"……嗯\n五分钟后，开始吧"},{"key":"SCENARIO_s40_07070000_02_0050","text":"好的……！"},{"key":"SCENARIO_s40_07070000_02_0051","text":"Motion"},{"key":"SCENARIO_s40_07070000_02_0060","text":"……嗯……"},{"key":"SCENARIO_s40_07070000_02_0070","text":"…………嗯……"},{"key":"SCENARIO_s40_07070000_02_0071","text":"Motion"},{"key":"SCENARIO_s40_07070000_02_0080","text":"……"},{"key":"SCENARIO_s40_07070000_02_0090","text":"气温……升了不少呢……"},{"key":"SCENARIO_s40_07070000_02_0100","text":"……是啊"},{"key":"SCENARIO_s40_07070000_02_0110","text":"啊，饮料……那个────"},{"key":"SCENARIO_s40_07070000_02_0120","text":"今天，那个，我带了好多冻好的……！\n "},{"key":"SCENARIO_s40_07070000_02_0130","text":"如果不够的话\n尽管喝我的……！"},{"key":"SCENARIO_s40_07070000_02_0140","text":"……"},{"key":"SCENARIO_s40_07070000_02_0150","text":"……！\n对、对不起突然说这些，如果您方便的话……"},{"key":"SCENARIO_s40_07070000_02_0160","text":"……嗯"},{"key":"SCENARIO_s40_07070000_02_0170","text":"那，等它化的时候"},{"key":"SCENARIO_s40_07070000_02_0180","text":"…………！\n好、好的……！"},{"key":"SCENARIO_s40_07070000_02_0190","text":"好，那个──────"},{"key":"SCENARIO_s40_07070000_02_0200","text":"──────等它化的时候……！"}]
