[{"key":"SCENARIO_s40_07070000_01_0000","text":"Motion"},{"key":"SCENARIO_s40_07070000_01_0010","text":"────────────"},{"key":"SCENARIO_s40_07070000_01_0020","text":"──────……！"},{"key":"SCENARIO_s40_07070000_01_0030","text":"…………啊"},{"key":"SCENARIO_s40_07070000_01_0040","text":"…………啊……"},{"key":"SCENARIO_s40_07070000_01_0050","text":"……………………"},{"key":"SCENARIO_s40_07070000_01_0060","text":"────────────"},{"key":"SCENARIO_s40_07070000_01_0070","text":"──────……"},{"key":"SCENARIO_s40_07070000_01_0080","text":"……────"},{"key":"SCENARIO_s40_07070000_01_0090","text":"───────诶！"},{"key":"SCENARIO_s40_07070000_01_0100","text":"『练习室好像用不了了』"},{"key":"SCENARIO_s40_07070000_01_0110","text":"『换到链接里的那个工作室吧\n　好像很快就空出来了』"},{"key":"SCENARIO_s40_07070000_01_0120","text":"────\n美琴小姐，已经在训练场了——————！"},{"key":"SCENARIO_s40_07070000_01_0130","text":"『辛苦了！\n　没能提前确认好，非常抱歉！』"},{"key":"SCENARIO_s40_07070000_01_0140","text":"『您现在在去工作室的路上吗！？』"},{"key":"SCENARIO_s40_07070000_01_0150","text":"“嗯”"},{"key":"SCENARIO_s40_07070000_01_0160","text":"——————"},{"key":"SCENARIO_s40_07070000_01_0170","text":"『我马上出发！』"},{"key":"SCENARIO_s40_07070000_01_0171","text":"Motion"},{"key":"SCENARIO_s40_07070000_01_0180","text":"…………！"},{"key":"SCENARIO_s40_07070000_01_0190","text":"────好，换衣服……\n毛巾……"},{"key":"SCENARIO_s40_07070000_01_0200","text":"月票月票……！"}]
