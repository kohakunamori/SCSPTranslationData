[{"key":"SCENARIO_s08_03020200_00_0000","text":"Motion"},{"key":"SCENARIO_s08_03020200_00_0010","text":"马上就是联合集训了\n大家，有没有不安？"},{"key":"SCENARIO_s08_03020200_00_0020","text":"事到如今哪还有什么不安\n照常去做就行了"},{"key":"SCENARIO_s08_03020200_00_0030","text":"是啊\n照常，全力以赴地面对"},{"key":"SCENARIO_s08_03020200_00_0040","text":"好的！\n想和其他组合的大家一起『切磋琢磨』！"},{"key":"SCENARIO_s08_03020200_00_0050","text":"很好的心态\n希望你们把这次联合集训的机会变得有收获"},{"key":"SCENARIO_s08_03020200_00_0060","text":"我会加油的！／是！／包在我身上／好的……／\n嗯！"},{"key":"SCENARIO_s08_03020200_00_0061","text":"Motion"},{"key":"SCENARIO_s08_03020200_00_0062","text":"给凛世进行个别训练"},{"key":"SCENARIO_s08_03020200_00_0063","text":"给果穗进行个别训练"},{"key":"SCENARIO_s08_03020200_00_0064","text":"给夏叶进行个别训练"},{"key":"SCENARIO_s08_03020200_00_0065","text":"给智代子进行个别训练"},{"key":"SCENARIO_s08_03020200_00_0066","text":"给树里进行个别训练"}]
