[{"key":"SCENARIO_s08_06030200_00_0000","text":"Motion"},{"key":"SCENARIO_s08_06030200_00_0010","text":"这次是和L'Antica的联合集训\n准备好了吗？"},{"key":"SCENARIO_s08_06030200_00_0020","text":"没问题～\n集训感觉就像旅行一样呢～？"},{"key":"SCENARIO_s08_06030200_00_0030","text":"要玩吗？\n乒乓球什么的"},{"key":"SCENARIO_s08_06030200_00_0040","text":"可、可以吗\n玩什么的……"},{"key":"SCENARIO_s08_06030200_00_0050","text":"哈哈，享受当然好，但练习也要认真哦"},{"key":"SCENARIO_s08_06030200_00_0051","text":"Motion"},{"key":"SCENARIO_s08_06030200_00_0052","text":"给透进行个别训练"},{"key":"SCENARIO_s08_06030200_00_0053","text":"给小糸进行个别训练"},{"key":"SCENARIO_s08_06030200_00_0054","text":"给雏菜进行个别训练"},{"key":"SCENARIO_s08_06030200_00_0055","text":"给圆香进行个别训练"}]
