[{"key":"SCENARIO_s08_08030200_00_0000","text":"Motion"},{"key":"SCENARIO_s08_08030200_00_0010","text":"这次，又要进行联合集训了\n大家确认好日程吧"},{"key":"SCENARIO_s08_08030200_00_0020","text":"哇——\n好期待"},{"key":"SCENARIO_s08_08030200_00_0030","text":"这次也要和其他组合的人一起练习对吧\n呵呵，会跟谁一起呢"},{"key":"SCENARIO_s08_08030200_00_0040","text":"希望你们都能获得好的经验\n好好享受吧"},{"key":"SCENARIO_s08_08030200_00_0050","text":"……\n麻烦死了"},{"key":"SCENARIO_s08_08030200_00_0051","text":"Motion"},{"key":"SCENARIO_s08_08030200_00_0061","text":"给羽那进行个别训练"},{"key":"SCENARIO_s08_08030200_00_0062","text":"给路加进行个别训练"},{"key":"SCENARIO_s08_08030200_00_0063","text":"给阳希进行个别训练"}]
