[{"key":"SCENARIO_s08_04030200_99_0000","text":"Motion"},{"key":"SCENARIO_s08_04030200_99_0010","text":"集训辛苦了\n你们表现得很好"},{"key":"SCENARIO_s08_04030200_99_0020","text":"想……回家……\n好好……休息……"},{"key":"SCENARIO_s08_04030200_99_0030","text":"甜花酱练习得很努力嘛——\n回去之后好好放松一下吧！"},{"key":"SCENARIO_s08_04030200_99_0040","text":"呵呵\n我今天也要，悠哉地度过♪"},{"key":"SCENARIO_s08_04030200_99_0050","text":"哈哈，今天就让大家好好休息吧\n补充好精力，为接下来的工作做好准备"}]
