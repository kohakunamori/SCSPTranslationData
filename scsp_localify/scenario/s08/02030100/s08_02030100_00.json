[{"key":"SCENARIO_s08_02030100_00_0000","text":"Motion"},{"key":"SCENARIO_s08_02030100_00_0010","text":"迷你剧的制作，马上就要开始了"},{"key":"SCENARIO_s08_02030100_00_0020","text":"超～级期待！\n就让你见识一下我的名推理吧～！"},{"key":"SCENARIO_s08_02030100_00_0030","text":"啊哈哈，三峰也不能输才行呢！"},{"key":"SCENARIO_s08_02030100_00_0040","text":"我也……\n会加油的……"},{"key":"SCENARIO_s08_02030100_00_0050","text":"嗯，大家拜托了\n一起拍出一部好作品吧！"},{"key":"SCENARIO_s08_02030100_00_0060","text":"Motion"},{"key":"SCENARIO_s08_02030100_00_0061","text":"给摩美美进行个别训练"},{"key":"SCENARIO_s08_02030100_00_0062","text":"给恋钟做个别指导吧"},{"key":"SCENARIO_s08_02030100_00_0063","text":"给咲耶进行个别训练"},{"key":"SCENARIO_s08_02030100_00_0064","text":"给雾子进行个别训练"},{"key":"SCENARIO_s08_02030100_00_0065","text":"给结华进行个别训练"}]
