[{"key":"SCENARIO_s08_05020200_99_0000","text":"Motion"},{"key":"SCENARIO_s08_05020200_99_0010","text":"超开心的～\n已经到了想一直集训下去的程度！"},{"key":"SCENARIO_s08_05020200_99_0020","text":"……一直的话就算了"},{"key":"SCENARIO_s08_05020200_99_0030","text":"是啊\n训练的成果得在工作中展现出来"},{"key":"SCENARIO_s08_05020200_99_0040","text":"当然\n活用这次经验，展现出最棒的表演吧"},{"key":"SCENARIO_s08_05020200_99_0050","text":"好的！／当然／OK！"}]
