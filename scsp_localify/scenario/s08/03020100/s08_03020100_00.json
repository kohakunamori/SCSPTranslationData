[{"key":"SCENARIO_s08_03020100_00_0011","text":"Motion"},{"key":"SCENARIO_s08_03020100_00_0010","text":"关于下次的地方演出……\n我觉得对大家来说会是很好的经验。全力以赴吧"},{"key":"SCENARIO_s08_03020100_00_0020","text":"好的！／是！／知道了／好的……／嗯！"},{"key":"SCENARIO_s08_03020100_00_0021","text":"Motion"},{"key":"SCENARIO_s08_03020100_00_0022","text":"给凛世进行个别训练"},{"key":"SCENARIO_s08_03020100_00_0023","text":"给树里进行个别训练"},{"key":"SCENARIO_s08_03020100_00_0024","text":"给夏叶进行个别训练"},{"key":"SCENARIO_s08_03020100_00_0025","text":"给智代子进行个别训练"},{"key":"SCENARIO_s08_03020100_00_0026","text":"给果穗进行个别训练"}]
