[{"key":"SCENARIO_s01_01020000_03_0000","text":"提示板"},{"key":"SCENARIO_s01_01020000_03_0010","text":"…………"},{"key":"SCENARIO_s01_01020000_03_0020","text":"没人在吗……？"},{"key":"SCENARIO_s01_01020000_03_0030","text":"………………"},{"key":"SCENARIO_s01_01020000_03_0040","text":"巡——…… "},{"key":"SCENARIO_s01_01020000_03_0050","text":"！"},{"key":"SCENARIO_s01_01020000_03_0060","text":"巡……？在吗……！？"},{"key":"SCENARIO_s01_01020000_03_0070","text":"啊……难道在储物柜里……？\n我现在就打开……！！"},{"key":"SCENARIO_s01_01020000_03_0001","text":"Motion"},{"key":"SCENARIO_s01_01020000_03_0080","text":"怎，怎么了？"},{"key":"SCENARIO_s01_01020000_03_0090","text":"巡……对吧？\n诶，难道……"},{"key":"SCENARIO_s01_01020000_03_0100","text":"…………"},{"key":"SCENARIO_s01_01020000_03_0110","text":"不对！ 我要打开了——！！"},{"key":"SCENARIO_s01_01020000_03_0120","text":"……！"},{"key":"SCENARIO_s01_01020000_03_0130","text":"巡……！\n太好了……！"},{"key":"SCENARIO_s01_01020000_03_0140","text":"被抓到的时候有没有受伤？\n得在鬼来之前赶紧逃…………"},{"key":"SCENARIO_s01_01020000_03_0002","text":"Motion"},{"key":"SCENARIO_s01_01020000_03_0150","text":"……巡……？"},{"key":"SCENARIO_s01_01020000_03_0160","text":"抱歉，灯织……\n我自己也还没整理好心情……"},{"key":"SCENARIO_s01_01020000_03_0170","text":"好像现在我变成鬼了……抱歉"},{"key":"SCENARIO_s01_01020000_03_0180","text":"诶"},{"key":"SCENARIO_s01_01020000_03_0190","text":"诶、诶\n这个节目是这种规则的吗……？"},{"key":"SCENARIO_s01_01020000_03_0200","text":"“这是特别规则！”"},{"key":"SCENARIO_s01_01020000_03_0003","text":"Motion"}]
