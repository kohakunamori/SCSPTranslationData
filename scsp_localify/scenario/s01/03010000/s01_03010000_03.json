[{"key":"SCENARIO_s01_03010000_03_0000","text":"Motion"},{"key":"SCENARIO_s01_03010000_03_0010","text":"……"},{"key":"SCENARIO_s01_03010000_03_0020","text":"……"},{"key":"SCENARIO_s01_03010000_03_0030","text":"（上吧……！）"},{"key":"SCENARIO_s01_03010000_03_0040","text":"战斗讲究速战速决！\n我要出手了，凛世！"},{"key":"SCENARIO_s01_03010000_03_0050","text":"扫射……\n开始了……"},{"key":"SCENARIO_s01_03010000_03_0051","text":"Motion"},{"key":"SCENARIO_s01_03010000_03_0060","text":"哇——！？\n一齐攻击……！？"},{"key":"SCENARIO_s01_03010000_03_0070","text":"啧！\n哈啊！"},{"key":"SCENARIO_s01_03010000_03_0080","text":"没事吧！\n巧克力！"},{"key":"SCENARIO_s01_03010000_03_0090","text":"树里……！\n谢谢你……！"},{"key":"SCENARIO_s01_03010000_03_0091","text":"Motion"},{"key":"SCENARIO_s01_03010000_03_0100","text":"……干得不错嘛，树里"},{"key":"SCENARIO_s01_03010000_03_0110","text":"……你也是……！"},{"key":"SCENARIO_s01_03010000_03_0120","text":"（好厉害……！\n　大家都在激烈交锋……！）"},{"key":"SCENARIO_s01_03010000_03_0121","text":"Motion"},{"key":"SCENARIO_s01_03010000_03_0130","text":"……！"},{"key":"SCENARIO_s01_03010000_03_0140","text":"（树里……呼吸已经很急促了……\n　看来快到极限了……！）"},{"key":"SCENARIO_s01_03010000_03_0150","text":"（……不过话说回来\n　……我也没资格说别人……！）"},{"key":"SCENARIO_s01_03010000_03_0160","text":"（夏叶……被我逼到绝境了……！\n　下一击就分出胜负……！）"},{"key":"SCENARIO_s01_03010000_03_0170","text":"（不这样的话\n　被干掉的就是我了……！）"},{"key":"SCENARIO_s01_03010000_03_0180","text":"……"},{"key":"SCENARIO_s01_03010000_03_0190","text":"喂——大家\n稍微过来一——"},{"key":"SCENARIO_s01_03010000_03_0191","text":"Motion"},{"key":"SCENARIO_s01_03010000_03_0200","text":"……！\n嘿呀——！"}]
