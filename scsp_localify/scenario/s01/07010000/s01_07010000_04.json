[{"key":"SCENARIO_s01_07010000_04_0000","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0001","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0002","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0003","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0004","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0005","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0010","text":"……？\n有人────这么晚了……"},{"key":"SCENARIO_s01_07010000_04_0011","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0020","text":"１，２────"},{"key":"SCENARIO_s01_07010000_04_0030","text":"美琴小姐…………"},{"key":"SCENARIO_s01_07010000_04_0040","text":"────为什么……\n在这种地方…………"},{"key":"SCENARIO_s01_07010000_04_0041","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0050","text":"────旋转……好漂亮……\n……在那么窄的地方……好厉害……"},{"key":"SCENARIO_s01_07010000_04_0051","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0060","text":"……如果美琴一个人在跳舞的话──"},{"key":"SCENARIO_s01_07010000_04_0061","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0070","text":"……！"},{"key":"SCENARIO_s01_07010000_04_0080","text":"啊……"},{"key":"SCENARIO_s01_07010000_04_0090","text":"哦，日花\n这么晚了怎么了？"},{"key":"SCENARIO_s01_07010000_04_0100","text":"————……"},{"key":"SCENARIO_s01_07010000_04_0101","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0102","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0103","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0110","text":"必须练习──"},{"key":"SCENARIO_s01_07010000_04_0111","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0120","text":"────……\n１、２、３、４……"},{"key":"SCENARIO_s01_07010000_04_0121","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0122","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0123","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0124","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0125","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0129","text":"舞者"},{"key":"SCENARIO_s01_07010000_04_0130","text":"１、２────唔\n哈……哈……！"},{"key":"SCENARIO_s01_07010000_04_0140","text":"那个……"},{"key":"SCENARIO_s01_07010000_04_0150","text":"诶……啊，对不起……！\n我打扰到您了吧，在这种地方……！"},{"key":"SCENARIO_s01_07010000_04_0160","text":"哪里哪里，说什么呢～！\n这里可是SHHis的现场啊"},{"key":"SCENARIO_s01_07010000_04_0170","text":"那个，但是……我——————"},{"key":"SCENARIO_s01_07010000_04_0180","text":"是铅笔转吧……\n不介意的话我来辅助您吧？"},{"key":"SCENARIO_s01_07010000_04_0190","text":"诶——……"},{"key":"SCENARIO_s01_07010000_04_0191","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0200","text":"啊，好、好的！\n拜托了……！"},{"key":"SCENARIO_s01_07010000_04_0201","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0202","text":"Motion"},{"key":"SCENARIO_s01_07010000_04_0203","text":"Motion"}]
