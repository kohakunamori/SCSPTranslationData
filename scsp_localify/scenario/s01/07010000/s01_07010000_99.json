[{"key":"SCENARIO_s01_07010000_99_0000","text":"娱乐报道"},{"key":"SCENARIO_s01_07010000_99_0001","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0010","text":"『SHHis，\n　以压倒性的表演征服全场』"},{"key":"SCENARIO_s01_07010000_99_0011","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0020","text":"————美琴小姐……？"},{"key":"SCENARIO_s01_07010000_99_0030","text":"……啊，你辛苦了"},{"key":"SCENARIO_s01_07010000_99_0040","text":"辛苦了！\n如果去事务所的话，我也一起可以吗……？"},{"key":"SCENARIO_s01_07010000_99_0050","text":"嗯"},{"key":"SCENARIO_s01_07010000_99_0051","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0060","text":"……我们好像\n很少一起去事务所呢"},{"key":"SCENARIO_s01_07010000_99_0070","text":"……有这种事吗"},{"key":"SCENARIO_s01_07010000_99_0080","text":"……"},{"key":"SCENARIO_s01_07010000_99_0090","text":"……？"},{"key":"SCENARIO_s01_07010000_99_0100","text":"刚，刚开始的时候，我可兴奋了……！"},{"key":"SCENARIO_s01_07010000_99_0101","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0102","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0110","text":"……？是钢琴吗……？\n那边那台经常响呢"},{"key":"SCENARIO_s01_07010000_99_0120","text":"你会弹什么吗？"},{"key":"SCENARIO_s01_07010000_99_0130","text":"……诶……？\n我钢琴完全不会的……"},{"key":"SCENARIO_s01_07010000_99_0140","text":"那个………"},{"key":"SCENARIO_s01_07010000_99_0141","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0142","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0150","text":"————啊……"},{"key":"SCENARIO_s01_07010000_99_0151","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0160","text":"……呵呵\n……嘿，咻……"},{"key":"SCENARIO_s01_07010000_99_0161","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0170","text":"那是…………"},{"key":"SCENARIO_s01_07010000_99_0171","text":"Motion"},{"key":"SCENARIO_s01_07010000_99_0180","text":"舞台底层"},{"key":"SCENARIO_s01_07010000_99_0190","text":"舞台下方\n最能感受到观众席嘈杂声的地方"},{"key":"SCENARIO_s01_07010000_99_0200","text":"从这里攀登而上——————"}]
