[{"key":"SCENARIO_s01_08030000_99_0000","text":"Motion"},{"key":"SCENARIO_s01_08030000_99_0009","text":"街头大屏"},{"key":"SCENARIO_s01_08030000_99_0010","text":"『引发巨大反响的CoMETIK演唱会，\n　现已火速上线配信！』"},{"key":"SCENARIO_s01_08030000_99_0019","text":"路加的粉丝"},{"key":"SCENARIO_s01_08030000_99_0020","text":"………………"},{"key":"SCENARIO_s01_08030000_99_0029","text":"SNS的帖子"},{"key":"SCENARIO_s01_08030000_99_0030","text":"『CoMETIK的演唱会果然厉害』"},{"key":"SCENARIO_s01_08030000_99_0039","text":"SNS的帖子"},{"key":"SCENARIO_s01_08030000_99_0040","text":"『感觉有降低难度来糊弄的成分』"},{"key":"SCENARIO_s01_08030000_99_0049","text":"SNS的帖子"},{"key":"SCENARIO_s01_08030000_99_0050","text":"『果然还是觉得不舒服』"},{"key":"SCENARIO_s01_08030000_99_0059","text":"SNS的帖子"},{"key":"SCENARIO_s01_08030000_99_0060","text":"『CoMETIK最棒了\n　批评的人只是没认真看而已』"},{"key":"SCENARIO_s01_08030000_99_0070","text":"『大家high起来了吗～……！』"},{"key":"SCENARIO_s01_08030000_99_0080","text":"『你们开心吗—！』"},{"key":"SCENARIO_s01_08030000_99_0089","text":"路加的粉丝"},{"key":"SCENARIO_s01_08030000_99_0090","text":"……\n我只是，喜欢路加而已——————"},{"key":"SCENARIO_s01_08030000_99_0098","text":"路加的粉丝"},{"key":"SCENARIO_s01_08030000_99_0100","text":"……………………好痛……"},{"key":"SCENARIO_s01_08030000_99_0109","text":"路加的粉丝"},{"key":"SCENARIO_s01_08030000_99_0110","text":"因为喜欢啊…………\n………………因为…………"},{"key":"SCENARIO_s01_08030000_99_0120","text":"大家都上大屏幕了呢"},{"key":"SCENARIO_s01_08030000_99_0121","text":"Motion"},{"key":"SCENARIO_s01_08030000_99_0122","text":"Motion"},{"key":"SCENARIO_s01_08030000_99_0130","text":"之前的采访里被说，\n组合没有心灵的连接是不行的……"},{"key":"SCENARIO_s01_08030000_99_0140","text":"连接，吗……"},{"key":"SCENARIO_s01_08030000_99_0141","text":"Motion"},{"key":"SCENARIO_s01_08030000_99_0150","text":"总有一天，会变成那样吗……"},{"key":"SCENARIO_s01_08030000_99_0160","text":"不——————"},{"key":"SCENARIO_s01_08030000_99_0170","text":"也许，那是一件很难的事"},{"key":"SCENARIO_s01_08030000_99_0180","text":"各自走过的路不同，\n想法、喜欢的东西也不一样"},{"key":"SCENARIO_s01_08030000_99_0190","text":"今后肯定也会……"},{"key":"SCENARIO_s01_08030000_99_0200","text":"但是——————————"}]
