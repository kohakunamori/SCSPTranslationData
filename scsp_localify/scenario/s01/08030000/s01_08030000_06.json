[{"key":"SCENARIO_s01_08030000_06_0000","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0001","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_9900","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0010","text":"那我们就开始练习吧"},{"key":"SCENARIO_s01_08030000_06_9901","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0020","text":"路加好像请假了呢\n希望她身体没事……你从她本人那里听到什么了吗？"},{"key":"SCENARIO_s01_08030000_06_0030","text":"没有……什么都没……"},{"key":"SCENARIO_s01_08030000_06_0031","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0040","text":"联系什么的……也都没有……"},{"key":"SCENARIO_s01_08030000_06_9902","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0050","text":"好—，OK！　今天就到这里\n已经好多了哦～！"},{"key":"SCENARIO_s01_08030000_06_9903","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0060","text":"你们俩，就算没有路加在，\n动作也越来越整齐了哦！"},{"key":"SCENARIO_s01_08030000_06_0061","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_9904","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0070","text":"那下次继续。记得好好做拉伸哦～\n还有，下一个人要用这里，记得收拾好"},{"key":"SCENARIO_s01_08030000_06_0080","text":"好的……！　啊————\n说起来，今天没有放节拍器呢"},{"key":"SCENARIO_s01_08030000_06_0081","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0082","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_9905","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0090","text":"节拍器？　……啊，是呢\n因为放那个的，是路加————"},{"key":"SCENARIO_s01_08030000_06_0100","text":"路加放的？"},{"key":"SCENARIO_s01_08030000_06_9906","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0110","text":"节拍器对锻炼节奏感非常有用哦"},{"key":"SCENARIO_s01_08030000_06_0120","text":"路加明明已经那么厉害了，还在追求更高的目标……\n果然很厉害呢……感觉她一直在往前跑"},{"key":"SCENARIO_s01_08030000_06_9907","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0130","text":"嗯……？　啊哈哈！\n路加已经够厉害了，不需要那种东西啦"},{"key":"SCENARIO_s01_08030000_06_0140","text":"诶？\n那……"},{"key":"SCENARIO_s01_08030000_06_0141","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0142","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0150","text":"差不多该结束了吧？"},{"key":"SCENARIO_s01_08030000_06_0160","text":"对不起……！\n我，静不下来……！"},{"key":"SCENARIO_s01_08030000_06_0161","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_9908","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0170","text":"那个节拍器……\n一定是她为了你们俩放的"},{"key":"SCENARIO_s01_08030000_06_9909","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0180","text":"为了让你们……\n能更快地进步————————"},{"key":"SCENARIO_s01_08030000_06_9910","text":"舞蹈教练"},{"key":"SCENARIO_s01_08030000_06_0190","text":"虽然只是我的猜测——————"},{"key":"SCENARIO_s01_08030000_06_0200","text":"我还差得远"},{"key":"SCENARIO_s01_08030000_06_0210","text":"但我想……哪怕一点点也好，努力变得更好"},{"key":"SCENARIO_s01_08030000_06_0211","text":"Motion"},{"key":"SCENARIO_s01_08030000_06_0220","text":"『羽那和阳希，\n　一定也有过困惑的时候……但是——』"},{"key":"SCENARIO_s01_08030000_06_0230","text":"『即便如此，她们还是想站在CoMETIK的舞台上，\n　依然在坚持练习』"},{"key":"SCENARIO_s01_08030000_06_0240","text":"…………"}]
