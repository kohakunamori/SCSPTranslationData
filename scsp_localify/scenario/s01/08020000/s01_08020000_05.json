[{"key":"SCENARIO_s01_08020000_05_0000","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0010","text":"又……\n别来，别来啊……"},{"key":"SCENARIO_s01_08020000_05_0020","text":"搞什么……搞什么啊……你这家伙────……\n────────────────"},{"key":"SCENARIO_s01_08020000_05_0001","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0030","text":"住手……不对──────"},{"key":"SCENARIO_s01_08020000_05_0040","text":"────────\n为什么，会这么……这么……痛苦……啊"},{"key":"SCENARIO_s01_08020000_05_0050","text":"是谁………………的错\n──────────────────是谁──────"},{"key":"SCENARIO_s01_08020000_05_0002","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0006","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0060","text":"──────────────────"},{"key":"SCENARIO_s01_08020000_05_0070","text":"是吗……\n是你啊────"},{"key":"SCENARIO_s01_08020000_05_0080","text":"都是你的错……吗\n要是没有你，就好了吗────"},{"key":"SCENARIO_s01_08020000_05_0090","text":"都是你──────────────！"},{"key":"SCENARIO_s01_08020000_05_0100","text":"────────────────"},{"key":"SCENARIO_s01_08020000_05_0003","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0110","text":"是你……是你……！"},{"key":"SCENARIO_s01_08020000_05_0120","text":"是你不好！　是你不好！\n全都是你的错────────！"},{"key":"SCENARIO_s01_08020000_05_0004","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0130","text":"路加酱……\n到底怎么了"},{"key":"SCENARIO_s01_08020000_05_0140","text":"啊，等等，制作人──！"},{"key":"SCENARIO_s01_08020000_05_0005","text":"Motion"},{"key":"SCENARIO_s01_08020000_05_0150","text":"────……"},{"key":"SCENARIO_s01_08020000_05_9999","text":"声音"},{"key":"SCENARIO_s01_08020000_05_0160","text":"很痛吧"},{"key":"SCENARIO_s01_08020000_05_0170","text":"住手────────────────"},{"key":"SCENARIO_s01_08020000_05_0180","text":"很害怕吧"},{"key":"SCENARIO_s01_08020000_05_0190","text":"闭、嘴──────────────！"},{"key":"SCENARIO_s01_08020000_05_0200","text":"────────────────────！"}]
