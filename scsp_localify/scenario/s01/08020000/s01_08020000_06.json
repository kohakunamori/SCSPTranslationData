[{"key":"SCENARIO_s01_08020000_06_0000","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0001","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0010","text":"啊……"},{"key":"SCENARIO_s01_08020000_06_0002","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0020","text":"路加酱……"},{"key":"SCENARIO_s01_08020000_06_0003","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0030","text":"──辛、辛苦了……！\n我们时间刚好撞上了呢～"},{"key":"SCENARIO_s01_08020000_06_0004","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0005","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0040","text":"…………"},{"key":"SCENARIO_s01_08020000_06_0006","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0050","text":"……"},{"key":"SCENARIO_s01_08020000_06_0060","text":"…………"},{"key":"SCENARIO_s01_08020000_06_0007","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0008","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0070","text":"路、路加酱──────！"},{"key":"SCENARIO_s01_08020000_06_0009","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0080","text":"有东西想给你看……！\n这本杂志……"},{"key":"SCENARIO_s01_08020000_06_0011","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0090","text":"这里……！"},{"key":"SCENARIO_s01_08020000_06_0012","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0100","text":"『被人讨厌的女人的特征……\n　自私自利又────』"},{"key":"SCENARIO_s01_08020000_06_0110","text":"哇！\n对、对不起……！　不是不是～！"},{"key":"SCENARIO_s01_08020000_06_0120","text":"不是这里……\n嗯……～"},{"key":"SCENARIO_s01_08020000_06_0013","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0130","text":"是这里……！\n羽那酱登在上面……"},{"key":"SCENARIO_s01_08020000_06_0140","text":"羽那酱，拍这组照片的时候……\n说是参考了路加酱登的杂志"},{"key":"SCENARIO_s01_08020000_06_0150","text":"超级……棒的……！"},{"key":"SCENARIO_s01_08020000_06_0014","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0160","text":"我也是……"},{"key":"SCENARIO_s01_08020000_06_0170","text":"我有在参考路加酱的舞步\n练习哦"},{"key":"SCENARIO_s01_08020000_06_0180","text":"所以……如果方便的话\n接下来要跳的舞步……想请你看看"},{"key":"SCENARIO_s01_08020000_06_0015","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0016","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0017","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0190","text":"我、我开始了……！"},{"key":"SCENARIO_s01_08020000_06_0018","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0200","text":"……"},{"key":"SCENARIO_s01_08020000_06_0019","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0021","text":"Motion"},{"key":"SCENARIO_s01_08020000_06_0022","text":"Motion"}]
