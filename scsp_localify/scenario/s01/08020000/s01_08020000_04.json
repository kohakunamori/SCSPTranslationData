[{"key":"SCENARIO_s01_08020000_04_0000","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0001","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0010","text":"……制作人\n发生什么事了吗……？"},{"key":"SCENARIO_s01_08020000_04_0020","text":"诶！　啊，不……抱歉\n刚才在想事情"},{"key":"SCENARIO_s01_08020000_04_0030","text":"考虑的事？"},{"key":"SCENARIO_s01_08020000_04_0040","text":"……嗯\n周末，路加有一场演唱会──"},{"key":"SCENARIO_s01_08020000_04_0050","text":"哇，路加酱的演唱会？\n那我们可以去看吗？"},{"key":"SCENARIO_s01_08020000_04_0060","text":"诶……！"},{"key":"SCENARIO_s01_08020000_04_0070","text":"我也……！\n想去看看……！"},{"key":"SCENARIO_s01_08020000_04_0002","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0003","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0080","text":"谢谢……\n大家……谢……呜────"},{"key":"SCENARIO_s01_08020000_04_0004","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0090","text":"路加酱的舞台，好厉害啊"},{"key":"SCENARIO_s01_08020000_04_0100","text":"可是，总觉得……"},{"key":"SCENARIO_s01_08020000_04_0110","text":"…………"},{"key":"SCENARIO_s01_08020000_04_0006","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0120","text":"──好痛苦"},{"key":"SCENARIO_s01_08020000_04_0130","text":"呐────\n大家……你们……"},{"key":"SCENARIO_s01_08020000_04_0140","text":"大家……都不会……去什么地方────？\n不会……结束────？"},{"key":"SCENARIO_s01_08020000_04_0007","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0150","text":"──────────"},{"key":"SCENARIO_s01_08020000_04_0008","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0160","text":"不，不对────\n不对，不对……对不起……！"},{"key":"SCENARIO_s01_08020000_04_0009","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0170","text":"路加酱……"},{"key":"SCENARIO_s01_08020000_04_0011","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0180","text":"又……\n别来，别来啊……"},{"key":"SCENARIO_s01_08020000_04_0190","text":"搞什么……\n搞什么啊……你这家伙────……！"},{"key":"SCENARIO_s01_08020000_04_0014","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0013","text":"Motion"},{"key":"SCENARIO_s01_08020000_04_0200","text":"啊————"},{"key":"SCENARIO_s01_08020000_04_0012","text":"Motion"}]
