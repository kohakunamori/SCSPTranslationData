[{"key":"SCENARIO_s01_06030000_04_0000","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_9999","text":"手机屏幕"},{"key":"SCENARIO_s01_06030000_04_0010","text":"『#没写作业的人』"},{"key":"SCENARIO_s01_06030000_04_0020","text":"──啊哈～\n──────♪"},{"key":"SCENARIO_s01_06030000_04_0001","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_0030","text":"…………\n大家，都没联系啊"},{"key":"SCENARIO_s01_06030000_04_0040","text":"也毕竟是正月呢"},{"key":"SCENARIO_s01_06030000_04_0002","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_9998","text":"透的母亲"},{"key":"SCENARIO_s01_06030000_04_0050","text":"虽然有趣，但一直看也会腻，挺可惜的呢\n每天都是搞笑节目的话"},{"key":"SCENARIO_s01_06030000_04_0060","text":"啊——……嗯，怎么说呢，这不就是\n过年要结束的感觉吗？"},{"key":"SCENARIO_s01_06030000_04_0006","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_9997","text":"圆香的父亲"},{"key":"SCENARIO_s01_06030000_04_0070","text":"嗯，要出门吗"},{"key":"SCENARIO_s01_06030000_04_0080","text":"……说是出门，其实就是散散步"},{"key":"SCENARIO_s01_06030000_04_0090","text":"一路顺风"},{"key":"SCENARIO_s01_06030000_04_0100","text":"嗯"},{"key":"SCENARIO_s01_06030000_04_0110","text":"——喂喂"},{"key":"SCENARIO_s01_06030000_04_0120","text":"哈哈，怎么说呢，新年快乐\n今年也请多多关照……！"},{"key":"SCENARIO_s01_06030000_04_0130","text":"是，哈哈哈……提前一步开工了\n元旦虽然有现场，但还挺悠闲的"},{"key":"SCENARIO_s01_06030000_04_0140","text":"哪里哪里！比不过电视人啦～"},{"key":"SCENARIO_s01_06030000_04_0003","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_0150","text":"——啊……！"},{"key":"SCENARIO_s01_06030000_04_0160","text":"────\n广告啊……"},{"key":"SCENARIO_s01_06030000_04_0170","text":"────嗯\n得联系大家才行"},{"key":"SCENARIO_s01_06030000_04_0004","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_0180","text":"…………\n广告，真多啊……"},{"key":"SCENARIO_s01_06030000_04_0005","text":"Motion"},{"key":"SCENARIO_s01_06030000_04_0190","text":"————啊……"},{"key":"SCENARIO_s01_06030000_04_0200","text":"是制作人发来的……！"}]
