[{"key":"SCENARIO_s01_08010000_01_0000","text":"偶像1"},{"key":"SCENARIO_s01_08010000_01_0001","text":"偶像2"},{"key":"SCENARIO_s01_08010000_01_0010","text":"那个是————"},{"key":"SCENARIO_s01_08010000_01_0020","text":"无论何时都是突然降临────"},{"key":"SCENARIO_s01_08010000_01_0030","text":"绽放出格外耀眼的光芒────"},{"key":"SCENARIO_s01_08010000_01_0040","text":"然后────"},{"key":"SCENARIO_s01_08010000_01_0050","text":"然后──────…………"},{"key":"SCENARIO_s01_08010000_01_0060","text":"喂喂，你看新闻了吗？"},{"key":"SCENARIO_s01_08010000_01_0061","text":"偶像2"},{"key":"SCENARIO_s01_08010000_01_0070","text":"啊──看了看了！\n是流星对吧？"},{"key":"SCENARIO_s01_08010000_01_0071","text":"偶像1"},{"key":"SCENARIO_s01_08010000_01_0080","text":"不对啦\n是彗星～！"},{"key":"SCENARIO_s01_08010000_01_0081","text":"偶像2"},{"key":"SCENARIO_s01_08010000_01_0090","text":"诶～，那不是一样的吗～？"},{"key":"SCENARIO_s01_08010000_01_0100","text":"那种东西"},{"key":"SCENARIO_s01_08010000_01_0110","text":"反正很快就会────……"},{"key":"SCENARIO_s01_08010000_01_0111","text":"偶像1"},{"key":"SCENARIO_s01_08010000_01_0120","text":"……斑鸠小姐？"},{"key":"SCENARIO_s01_08010000_01_0112","text":"偶像2"},{"key":"SCENARIO_s01_08010000_01_0130","text":"啊，对了……！\n斑鸠小姐也看过吗？　彗星──……"},{"key":"SCENARIO_s01_08010000_01_0140","text":"…………"},{"key":"SCENARIO_s01_08010000_01_0141","text":"Motion"},{"key":"SCENARIO_s01_08010000_01_0150","text":"反正…………\n会消失的…………"},{"key":"SCENARIO_s01_08010000_01_0160","text":"一切的一切…………"},{"key":"SCENARIO_s01_08010000_01_0170","text":"什么都……"},{"key":"SCENARIO_s01_08010000_01_0180","text":"到最后都是那样…………"},{"key":"SCENARIO_s01_08010000_01_0190","text":"路加…………？"},{"key":"SCENARIO_s01_08010000_01_0200","text":"…………"},{"key":"SCENARIO_s01_08010000_01_0201","text":"Motion"}]
