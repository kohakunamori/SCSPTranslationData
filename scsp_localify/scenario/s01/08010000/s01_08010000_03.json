[{"key":"SCENARIO_s01_08010000_03_0000","text":"Motion"},{"key":"SCENARIO_s01_08010000_03_0010","text":"──────……"},{"key":"SCENARIO_s01_08010000_03_0011","text":"粉丝的声援"},{"key":"SCENARIO_s01_08010000_03_0020","text":"路加──……！"},{"key":"SCENARIO_s01_08010000_03_0030","text":"路加──……！！"},{"key":"SCENARIO_s01_08010000_03_0040","text":"──────────…………！！"},{"key":"SCENARIO_s01_08010000_03_0050","text":"（搞什么……）"},{"key":"SCENARIO_s01_08010000_03_0060","text":"（搞什么啊…………！）"},{"key":"SCENARIO_s01_08010000_03_0070","text":"（消失吧……！\n　…………消失吧消失吧消失吧消失吧！）"},{"key":"SCENARIO_s01_08010000_03_0080","text":"啊啊啊啊啊──……………………………………！"},{"key":"SCENARIO_s01_08010000_03_0090","text":"——————……！"},{"key":"SCENARIO_s01_08010000_03_0100","text":"路加…………"},{"key":"SCENARIO_s01_08010000_03_0110","text":"（别过来………\n　……………别靠近…………！）"},{"key":"SCENARIO_s01_08010000_03_0111","text":"Motion"},{"key":"SCENARIO_s01_08010000_03_0120","text":"抱歉…………今天已经……\n不唱了……声音…………"},{"key":"SCENARIO_s01_08010000_03_0130","text":"安可，也没有…………"},{"key":"SCENARIO_s01_08010000_03_0140","text":"路加──……！\n谢谢──……！"},{"key":"SCENARIO_s01_08010000_03_0150","text":"别太勉强啊──……！"},{"key":"SCENARIO_s01_08010000_03_0151","text":"Motion"},{"key":"SCENARIO_s01_08010000_03_0152","text":"Motion"},{"key":"SCENARIO_s01_08010000_03_0160","text":"…………你怎么了？"},{"key":"SCENARIO_s01_08010000_03_0170","text":"…………让开"},{"key":"SCENARIO_s01_08010000_03_0180","text":"为什么，要那样……\n故意把嗓子唱坏似的──……"},{"key":"SCENARIO_s01_08010000_03_0190","text":"像是要\n伤害自己一样的事────"},{"key":"SCENARIO_s01_08010000_03_0200","text":"…………说了让开"},{"key":"SCENARIO_s01_08010000_03_0201","text":"Motion"}]
