[{"key":"SCENARIO_s09_01012000_03_0000","text":"Motion"},{"key":"SCENARIO_s09_01012000_03_0010","text":"…………──────"},{"key":"SCENARIO_s09_01012000_03_0020","text":"————咦"},{"key":"SCENARIO_s09_01012000_03_0030","text":"不睡吗？"},{"key":"SCENARIO_s09_01012000_03_0040","text":"……嗯？\n啊……"},{"key":"SCENARIO_s09_01012000_03_0050","text":"嘛，毕竟是最后一晚了……\n我也不打算唠叨你"},{"key":"SCENARIO_s09_01012000_03_0060","text":"嗯……\n……呵呵"},{"key":"SCENARIO_s09_01012000_03_0070","text":"……？"},{"key":"SCENARIO_s09_01012000_03_0080","text":"不是，你看"},{"key":"SCENARIO_s09_01012000_03_0090","text":"星星，超多的"},{"key":"SCENARIO_s09_01012000_03_0100","text":"————啊啊……"},{"key":"SCENARIO_s09_01012000_03_0110","text":"────『是各种各样的东西，开始闪闪发光的时刻』"},{"key":"SCENARIO_s09_01012000_03_0120","text":"……"},{"key":"SCENARIO_s09_01012000_03_0130","text":"……哈哈，嗯"},{"key":"SCENARIO_s09_01012000_03_0140","text":"是啊\n就算是夜晚，也有这么多东西在发光呢"},{"key":"SCENARIO_s09_01012000_03_0001","text":"Motion"},{"key":"SCENARIO_s09_01012000_03_0150","text":"嗯——……"},{"key":"SCENARIO_s09_01012000_03_0160","text":"……嘛，不过"},{"key":"SCENARIO_s09_01012000_03_0170","text":"最后一天的早上，也要来叫我"},{"key":"SCENARIO_s09_01012000_03_0180","text":"在最漂亮的那个时刻"}]
