[{"key":"SCENARIO_s09_01012000_01_0000","text":"Motion"},{"key":"SCENARIO_s09_01012000_01_0010","text":"……──────"},{"key":"SCENARIO_s09_01012000_01_0020","text":"……喂——"},{"key":"SCENARIO_s09_01012000_01_0030","text":"玩手机可以，\n但差不多该回去准备熄灯了吧？"},{"key":"SCENARIO_s09_01012000_01_0040","text":"……嗯？\n啊……"},{"key":"SCENARIO_s09_01012000_01_0050","text":"几点起床来着\n……要设一下。闹钟"},{"key":"SCENARIO_s09_01012000_01_0060","text":"啊，原来是在弄这个……！\n不────"},{"key":"SCENARIO_s09_01012000_01_0070","text":"────只要赶得上早饭，\n其他时间自由安排就好"},{"key":"SCENARIO_s09_01012000_01_0080","text":"嗯……\n那你告诉我几点"},{"key":"SCENARIO_s09_01012000_01_0090","text":"诶？不，那个────\n────那……6点？"},{"key":"SCENARIO_s09_01012000_01_0100","text":"嗯——\n好早，超早的"},{"key":"SCENARIO_s09_01012000_01_0110","text":"……我想着散散步什么的应该也挺舒服的……\n那……7点半左右？"},{"key":"SCENARIO_s09_01012000_01_0120","text":"嗯——……"},{"key":"SCENARIO_s09_01012000_01_0130","text":"……7点40分左右？"},{"key":"SCENARIO_s09_01012000_01_0140","text":"好精确啊"},{"key":"SCENARIO_s09_01012000_01_0150","text":"……"},{"key":"SCENARIO_s09_01012000_01_0160","text":"──────那"},{"key":"SCENARIO_s09_01012000_01_0170","text":"来叫我"},{"key":"SCENARIO_s09_01012000_01_0180","text":"我会起来的\n在你来叫我的时候"}]
