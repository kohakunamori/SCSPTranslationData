[{"key":"SCENARIO_s09_01012000_02_0000","text":"Motion"},{"key":"SCENARIO_s09_01012000_02_0010","text":"────────"},{"key":"SCENARIO_s09_01012000_02_0020","text":"────────…………"},{"key":"SCENARIO_s09_01012000_02_0030","text":"──────嗯…………\n…………"},{"key":"SCENARIO_s09_01012000_02_0040","text":"…………完全打不通啊"},{"key":"SCENARIO_s09_01012000_02_0050","text":"…………────────"},{"key":"SCENARIO_s09_01012000_02_0060","text":"──────……\n…………啊──────"},{"key":"SCENARIO_s09_01012000_02_0070","text":"……\n要挂了哦……"},{"key":"SCENARIO_s09_01012000_02_0080","text":"『…………啊……』"},{"key":"SCENARIO_s09_01012000_02_0090","text":"『…………喂……？』"},{"key":"SCENARIO_s09_01012000_02_0100","text":"哦，醒了啊\n……哈哈，是不是有点太早了"},{"key":"SCENARIO_s09_01012000_02_0110","text":"『……诶？嗯…………\n　诶，几点了…………？』"},{"key":"SCENARIO_s09_01012000_02_0120","text":"嘛，怎么说呢────"},{"key":"SCENARIO_s09_01012000_02_0130","text":"『先钻出被窝，把窗帘拉开吧』"},{"key":"SCENARIO_s09_01012000_02_0140","text":"……诶？……嗯……\n等等────"},{"key":"SCENARIO_s09_01012000_02_0001","text":"Motion"},{"key":"SCENARIO_s09_01012000_02_0002","text":"Motion"},{"key":"SCENARIO_s09_01012000_02_0150","text":"──────哦……"},{"key":"SCENARIO_s09_01012000_02_0160","text":"『是各种各样的东西，开始闪闪发光的时刻』"},{"key":"SCENARIO_s09_01012000_02_0170","text":"“早上好”"},{"key":"SCENARIO_s09_01012000_02_0003","text":"Motion"},{"key":"SCENARIO_s09_01012000_02_0180","text":"早上好"}]
