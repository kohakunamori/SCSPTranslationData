[{"key":"SCENARIO_s09_02020900_02_0000","text":"训练师"},{"key":"SCENARIO_s09_02020900_02_0001","text":"Motion"},{"key":"SCENARIO_s09_02020900_02_0010","text":"好，今天就到这里\n辛苦了！"},{"key":"SCENARIO_s09_02020900_02_0020","text":"辛苦了！\n非常感谢！"},{"key":"SCENARIO_s09_02020900_02_0021","text":"Motion"},{"key":"SCENARIO_s09_02020900_02_0030","text":"制作人！"},{"key":"SCENARIO_s09_02020900_02_0040","text":"辛苦了，果穗\n状态绝佳啊"},{"key":"SCENARIO_s09_02020900_02_0050","text":"嘿嘿，是的！\n其他组合的大家也教了我好多……！"},{"key":"SCENARIO_s09_02020900_02_0060","text":"就像有很多老师一样！"},{"key":"SCENARIO_s09_02020900_02_0070","text":"啊，不过……光靠别人教\n可做不到“切磋琢磨”吧……？"},{"key":"SCENARIO_s09_02020900_02_0080","text":"不是那样的\n教别人、被别人教并不是学习的全部"},{"key":"SCENARIO_s09_02020900_02_0090","text":"果穗就做果穗力所能及的事吧\n这样就够了"},{"key":"SCENARIO_s09_02020900_02_0100","text":"是这样吗……？\n虽然不太明白……但我会这么做的！"}]
