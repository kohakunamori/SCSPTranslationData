[{"key":"SCENARIO_s09_03022600_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03022600_02_0010","text":"────────……"},{"key":"SCENARIO_s09_03022600_02_0020","text":"啊……──路加酱，真巧呢。\n你去洗澡了吗？"},{"key":"SCENARIO_s09_03022600_02_0030","text":"────────……\n算是吧……"},{"key":"SCENARIO_s09_03022600_02_0040","text":"呵呵，嗯……\n洗发水有很好闻的香味呢。"},{"key":"SCENARIO_s09_03022600_02_0050","text":"现在呢，大家聚在一起聊天。\n路加酱也一起来吗？"},{"key":"SCENARIO_s09_03022600_02_0060","text":"不用了……\n其他组合什么的……我没兴趣。"},{"key":"SCENARIO_s09_03022600_02_0070","text":"这样啊……"},{"key":"SCENARIO_s09_03022600_02_0080","text":"────路加酱的兴趣所在……\n就只有CoMETIK吗……"},{"key":"SCENARIO_s09_03022600_02_0090","text":"哈……？"},{"key":"SCENARIO_s09_03022600_02_0100","text":"确实是很棒的组合呢。"},{"key":"SCENARIO_s09_03022600_02_0110","text":"────────……\n那我，先走了……"},{"key":"SCENARIO_s09_03022600_02_0120","text":"啊，等一下──"},{"key":"SCENARIO_s09_03022600_02_0130","text":"点心，我也带了路加酱的份。\n要不要吃点？"},{"key":"SCENARIO_s09_03022600_02_0131","text":"Motion"},{"key":"SCENARIO_s09_03022600_02_0140","text":"给她们吧。"},{"key":"SCENARIO_s09_03022600_02_0150","text":"啊……好可惜……"}]
