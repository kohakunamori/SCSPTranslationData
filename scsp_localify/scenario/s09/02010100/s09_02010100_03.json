[{"key":"SCENARIO_s09_02010100_03_0000","text":"Motion"},{"key":"SCENARIO_s09_02010100_03_0010","text":"～♪"},{"key":"SCENARIO_s09_02010100_03_0020","text":"哈哈，都在哼歌了\n心情很好嘛"},{"key":"SCENARIO_s09_02010100_03_0030","text":"啊，不好意思，不自觉就……"},{"key":"SCENARIO_s09_02010100_03_0040","text":"没事，我懂你的心情\n今天跟工作人员们配合得也很好嘛"},{"key":"SCENARIO_s09_02010100_03_0050","text":"是的……！\n其实，我鼓起勇气主动跟工作人员们搭话了"},{"key":"SCENARIO_s09_02010100_03_0060","text":"结果大家都特别好……！"},{"key":"SCENARIO_s09_02010100_03_0070","text":"他们说，大家都是第一次跟偶像一起工作，\n一直在烦恼该怎么跟我们相处"},{"key":"SCENARIO_s09_02010100_03_0080","text":"然后我想起了制作人在那家店讲的话，\n觉得大家可能也想知道各种事情……！"},{"key":"SCENARIO_s09_02010100_03_0090","text":"啊，那件事啊！\n如果能成为真乃行动的契机，那就太好了"},{"key":"SCENARIO_s09_02010100_03_0100","text":"是的……谢谢您！"}]
