[{"key":"SCENARIO_s09_03021500_01_0000","text":"训练师"},{"key":"SCENARIO_s09_03021500_01_0001","text":"Motion"},{"key":"SCENARIO_s09_03021500_01_0010","text":"──今天就到这里吧\n你一直坚持到最后，很棒"},{"key":"SCENARIO_s09_03021500_01_0020","text":"…………好、好的…………"},{"key":"SCENARIO_s09_03021500_01_0021","text":"Motion"},{"key":"SCENARIO_s09_03021500_01_0030","text":"呜…………"},{"key":"SCENARIO_s09_03021500_01_0040","text":"辛苦了，甜花\n没事吧？"},{"key":"SCENARIO_s09_03021500_01_0041","text":"Motion"},{"key":"SCENARIO_s09_03021500_01_0050","text":"呜呜……\n好想，回家……"},{"key":"SCENARIO_s09_03021500_01_0060","text":"……那也太早了吧\n集训才刚开始呢"},{"key":"SCENARIO_s09_03021500_01_0070","text":"……也是呢……\n就，说说而已……"},{"key":"SCENARIO_s09_03021500_01_0080","text":"……哈哈\n还有力气说这种话，那肯定没问题"},{"key":"SCENARIO_s09_03021500_01_0090","text":"总之今天好好休息吧\n明天再继续加油"},{"key":"SCENARIO_s09_03021500_01_0091","text":"Motion"},{"key":"SCENARIO_s09_03021500_01_0100","text":"嗯……\n我会努力……撑到最后的……"}]
