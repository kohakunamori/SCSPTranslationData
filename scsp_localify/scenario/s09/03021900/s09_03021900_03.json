[{"key":"SCENARIO_s09_03021900_03_0000","text":"Motion"},{"key":"SCENARIO_s09_03021900_03_0010","text":"糟了～～～～！"},{"key":"SCENARIO_s09_03021900_03_0020","text":"怎么了爱依！？"},{"key":"SCENARIO_s09_03021900_03_0030","text":"手机在房间里怎么找都找不到～～～"},{"key":"SCENARIO_s09_03021900_03_0040","text":"──麻烦了……！\n总之先找吧，有没有什么线索！？"},{"key":"SCENARIO_s09_03021900_03_0050","text":"诶～……"},{"key":"SCENARIO_s09_03021900_03_0060","text":"应该没走太远，\n要么在合宿所里，要么就在附近吧～……"},{"key":"SCENARIO_s09_03021900_03_0070","text":"──好！\n先把合宿所里翻个遍吧！"},{"key":"SCENARIO_s09_03021900_03_0080","text":"爱依！\n是不是这个！？"},{"key":"SCENARIO_s09_03021900_03_0090","text":"就是它～～！\n制作人谢啦～～！"},{"key":"SCENARIO_s09_03021900_03_0100","text":"差点真的回不了家了～～～～"}]
