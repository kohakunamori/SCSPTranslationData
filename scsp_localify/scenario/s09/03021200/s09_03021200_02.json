[{"key":"SCENARIO_s09_03021200_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03021200_02_0010","text":"………………"},{"key":"SCENARIO_s09_03021200_02_0011","text":"Motion"},{"key":"SCENARIO_s09_03021200_02_0020","text":"小糸小姐……\n我给您拿来了……"},{"key":"SCENARIO_s09_03021200_02_0030","text":"啊……"},{"key":"SCENARIO_s09_03021200_02_0040","text":"用这块电池的话……\n应该能撑……一阵子……"},{"key":"SCENARIO_s09_03021200_02_0050","text":"是、是的……"},{"key":"SCENARIO_s09_03021200_02_0060","text":"那、那么……\n我就……充电了哦"},{"key":"SCENARIO_s09_03021200_02_0070","text":"啊，谢谢您……"},{"key":"SCENARIO_s09_03021200_02_0080","text":"能帮上忙的话……那就太好了……"},{"key":"SCENARIO_s09_03021200_02_0081","text":"Motion"},{"key":"SCENARIO_s09_03021200_02_0090","text":"凛世也……看视频之类的……\n经常会没电……"},{"key":"SCENARIO_s09_03021200_02_0100","text":"啊……\n是、是这样……啊……"},{"key":"SCENARIO_s09_03021200_02_0110","text":"……我、我也是\n会看视频……"},{"key":"SCENARIO_s09_03021200_02_0120","text":"比、比如学习类的……之类的……"},{"key":"SCENARIO_s09_03021200_02_0130","text":"原来如此……\n "},{"key":"SCENARIO_s09_03021200_02_0140","text":"如果有推荐的……也请告诉凛世……"},{"key":"SCENARIO_s09_03021200_02_0150","text":"是、是的……"}]
