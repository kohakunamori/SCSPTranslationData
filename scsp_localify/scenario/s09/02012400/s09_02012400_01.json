[{"key":"SCENARIO_s09_02012400_01_0001","text":"Motion"},{"key":"SCENARIO_s09_02012400_01_0002","text":"Motion"},{"key":"SCENARIO_s09_02012400_01_0010","text":"日花，现在方便吗？"},{"key":"SCENARIO_s09_02012400_01_0020","text":"——啊，好的\n这就开门"},{"key":"SCENARIO_s09_02012400_01_0022","text":"Motion"},{"key":"SCENARIO_s09_02012400_01_0030","text":"在看电视啊\n有什么有趣的节目吗？"},{"key":"SCENARIO_s09_02012400_01_0040","text":"全是没见过的本地节目呢"},{"key":"SCENARIO_s09_02012400_01_0041","text":"Motion"},{"key":"SCENARIO_s09_02012400_01_0050","text":"我出演的那个综艺\n这边好像没有播出"},{"key":"SCENARIO_s09_02012400_01_0060","text":"这样啊……\n那有点遗憾呢"},{"key":"SCENARIO_s09_02012400_01_0070","text":"比起那个，你是有事吧？\n一副煞有介事的样子拿着什么东西"},{"key":"SCENARIO_s09_02012400_01_0080","text":"啊，工作人员给了伴手礼\n说大老远跑过来辛苦了"},{"key":"SCENARIO_s09_02012400_01_0090","text":"是在欢迎日花呢"},{"key":"SCENARIO_s09_02012400_01_0100","text":"……意思是要我好好工作，对吧——\n不过，得先混个脸熟。面子"}]
