[{"key":"SCENARIO_s09_03021100_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03021100_02_0010","text":"（出去透透气吧）"},{"key":"SCENARIO_s09_03021100_02_0020","text":"哦，制作人"},{"key":"SCENARIO_s09_03021100_02_0030","text":"树里啊\n怎么了？"},{"key":"SCENARIO_s09_03021100_02_0040","text":"想出去透透气"},{"key":"SCENARIO_s09_03021100_02_0050","text":"！\n哈哈，是吗"},{"key":"SCENARIO_s09_03021100_02_0060","text":"你笑什么啊\n我说了什么好笑的话吗？"},{"key":"SCENARIO_s09_03021100_02_0070","text":"抱歉抱歉\n因为我也和树里一样"},{"key":"SCENARIO_s09_03021100_02_0080","text":"！\n原来如此。是这么回事啊"},{"key":"SCENARIO_s09_03021100_02_0090","text":"真是默契十足啊"},{"key":"SCENARIO_s09_03021100_02_0091","text":"Motion"},{"key":"SCENARIO_s09_03021100_02_0100","text":"哈哈！／啊哈哈！"}]
