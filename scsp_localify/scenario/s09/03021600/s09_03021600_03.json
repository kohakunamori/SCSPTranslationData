[{"key":"SCENARIO_s09_03021600_03_0001","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0003","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0002","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0010","text":"日花，辛苦了"},{"key":"SCENARIO_s09_03021600_03_0011","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0020","text":"哦，谢谢！"},{"key":"SCENARIO_s09_03021600_03_0022","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0021","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0030","text":"……"},{"key":"SCENARIO_s09_03021600_03_0031","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0040","text":"日花\n练习的复盘，你是怎么做的？"},{"key":"SCENARIO_s09_03021600_03_0041","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0050","text":"……诶？\n就是普通的，课后自主练习之类的"},{"key":"SCENARIO_s09_03021600_03_0051","text":"Motion"},{"key":"SCENARIO_s09_03021600_03_0060","text":"抱歉\n是我问得不好"},{"key":"SCENARIO_s09_03021600_03_0070","text":"我是想问，你有没有用卡片整理，\n或者做那种之后可以回顾的事情"},{"key":"SCENARIO_s09_03021600_03_0080","text":"啊，原来是这样"},{"key":"SCENARIO_s09_03021600_03_0090","text":"……\n写下来也许不错呢，思路也能整理清楚"},{"key":"SCENARIO_s09_03021600_03_0100","text":"呵呵，嗯"},{"key":"SCENARIO_s09_03021600_03_0110","text":"我从这次合宿开始试着做了\n课题会变得明确"},{"key":"SCENARIO_s09_03021600_03_0120","text":"之后回顾的时候，\n也能回想到“真是次不错的合宿”呢"},{"key":"SCENARIO_s09_03021600_03_0130","text":"……啊哈哈\n是啊"},{"key":"SCENARIO_s09_03021600_03_0140","text":"那……我先告辞了\n下一节练习要开始了"},{"key":"SCENARIO_s09_03021600_03_0150","text":"嗯，我们一起\n加油吧"}]
