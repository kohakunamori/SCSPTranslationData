[{"key":"SCENARIO_s09_03021700_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03021700_02_0010","text":"朝──"},{"key":"SCENARIO_s09_03021700_02_0020","text":"嘘——"},{"key":"SCENARIO_s09_03021700_02_0030","text":"…………"},{"key":"SCENARIO_s09_03021700_02_0040","text":"……听不到呢"},{"key":"SCENARIO_s09_03021700_02_0050","text":"什么？"},{"key":"SCENARIO_s09_03021700_02_0060","text":"是树倒下来的声音"},{"key":"SCENARIO_s09_03021700_02_0070","text":"如果在森林深处倒了的话，\n声音说不定会传到这里来啊"},{"key":"SCENARIO_s09_03021700_02_0080","text":"──肚子饿了！"},{"key":"SCENARIO_s09_03021700_02_0090","text":"哈哈，看来我们在这里待了很久了……\n好，一起去吃点东西吧"},{"key":"SCENARIO_s09_03021700_02_0100","text":"好的！"}]
