[{"key":"SCENARIO_s09_02011100_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02011100_01_0010","text":"你好！\n从今天开始请多关照"},{"key":"SCENARIO_s09_02011100_01_0020","text":"我是放学后CLIMAX GIRLS的西城树里\n请多指教！"},{"key":"SCENARIO_s09_02011100_01_0029","text":"当地工作人员"},{"key":"SCENARIO_s09_02011100_01_0030","text":"谢谢你的礼貌问候\n我们这边才是，请多关照"},{"key":"SCENARIO_s09_02011100_01_0035","text":"Motion"},{"key":"SCENARIO_s09_02011100_01_0040","text":"真不愧是树里\n问候得很到位"},{"key":"SCENARIO_s09_02011100_01_0050","text":"嗯？\n这种程度很正常吧？"},{"key":"SCENARIO_s09_02011100_01_0060","text":"比起那个，我有事想确认一下流程──"},{"key":"SCENARIO_s09_02011100_01_0070","text":"等工作人员有空了\n想跟他们聊聊……"},{"key":"SCENARIO_s09_02011100_01_0080","text":"哦，这样啊\n那我去跟他们说一声"},{"key":"SCENARIO_s09_02011100_01_0090","text":"……干劲十足啊，树里"},{"key":"SCENARIO_s09_02011100_01_0100","text":"啊，既然被叫来了\n就得全力以赴才行！"}]
