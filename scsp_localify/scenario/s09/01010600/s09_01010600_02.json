[{"key":"SCENARIO_s09_01010600_02_0001","text":"Motion"},{"key":"SCENARIO_s09_01010600_02_0003","text":"Motion"},{"key":"SCENARIO_s09_01010600_02_0010","text":"咲耶\n看来你更新得很努力呢"},{"key":"SCENARIO_s09_01010600_02_0020","text":"啊，是说Twista吗？\n那之后我一直在持续发帖呢"},{"key":"SCENARIO_s09_01010600_02_0030","text":"反响也很不错……！\n好像收到了很多回复"},{"key":"SCENARIO_s09_01010600_02_0040","text":"咲耶关心着大家这件事\n能好好传达出去真是太好了"},{"key":"SCENARIO_s09_01010600_02_0050","text":"呵呵……本是想对粉丝们说的话\n看来也传达到你那里了呢"},{"key":"SCENARIO_s09_01010600_02_0060","text":"啊，抱歉——\n不知不觉就好奇起反响如何了"},{"key":"SCENARIO_s09_01010600_02_0070","text":"这是值得庆幸的事\n在身边就有这样关注着我的人"},{"key":"SCENARIO_s09_01010600_02_0002","text":"Motion"},{"key":"SCENARIO_s09_01010600_02_0080","text":"哎呀……\n呵呵"},{"key":"SCENARIO_s09_01010600_02_0090","text":"你看，制作人\n有个一直给我回复的孩子"},{"key":"SCENARIO_s09_01010600_02_0100","text":"好像很期待我的更新呢\n就这样——把话语传递给我"},{"key":"SCENARIO_s09_01010600_02_0110","text":"那真是……\n太好了呢"},{"key":"SCENARIO_s09_01010600_02_0120","text":"呵呵，是啊\n明明是很宝贵的时间，却愿意这样为我花时间"},{"key":"SCENARIO_s09_01010600_02_0130","text":"咲耶不也是一样吗？\n你也是利用课后时间来发帖的——"},{"key":"SCENARIO_s09_01010600_02_0140","text":"呵呵，那就是彼此彼此呢\n我，还有这个孩子——……"},{"key":"SCENARIO_s09_01010600_02_0150","text":"而且，看Twista的大家也是\n即使相隔遥远，也依然相连——"},{"key":"SCENARIO_s09_01010600_02_0160","text":"是啊\n是咲耶的话语创造了联结"},{"key":"SCENARIO_s09_01010600_02_0170","text":"！　如果真是这样的话——……\n没有比这更令人高兴的事了"},{"key":"SCENARIO_s09_01010600_02_0180","text":"这都是多亏了制作人的提议呢\n——谢谢你"}]
