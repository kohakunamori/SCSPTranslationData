[{"key":"SCENARIO_s09_03020900_02_0001","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0002","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0010","text":"────透小姐？"},{"key":"SCENARIO_s09_03020900_02_0011","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0012","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0020","text":"啊，嗨\n熬夜？"},{"key":"SCENARIO_s09_03020900_02_0021","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0030","text":"不是……！\n我醒了……来买瓶水"},{"key":"SCENARIO_s09_03020900_02_0040","text":"这样啊"},{"key":"SCENARIO_s09_03020900_02_0050","text":"好的"},{"key":"SCENARIO_s09_03020900_02_0051","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0060","text":"透小姐才是熬夜了吗？"},{"key":"SCENARIO_s09_03020900_02_0061","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0070","text":"啊——醒了就起来了"},{"key":"SCENARIO_s09_03020900_02_0080","text":"──！\n我也是……呢！"},{"key":"SCENARIO_s09_03020900_02_0090","text":"那个，透小姐\n能陪我聊聊天吗？聊到……我犯困为止……"},{"key":"SCENARIO_s09_03020900_02_0091","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0092","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0100","text":"──要再来一杯吗？水"},{"key":"SCENARIO_s09_03020900_02_0110","text":"不用了！\n谢谢你！"},{"key":"SCENARIO_s09_03020900_02_0111","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0120","text":"因为透小姐陪我聊天，\n我已经开始犯困────"},{"key":"SCENARIO_s09_03020900_02_0121","text":"Motion"},{"key":"SCENARIO_s09_03020900_02_0130","text":"平时总是被说“快睡觉”，\n但半夜醒了的话，那也算熬夜吗？"},{"key":"SCENARIO_s09_03020900_02_0140","text":"这算是熬夜了吗……？"},{"key":"SCENARIO_s09_03020900_02_0150","text":"也许吧\n──不过，有什么关系嘛，聊得很开心"},{"key":"SCENARIO_s09_03020900_02_0151","text":"Motion"}]
