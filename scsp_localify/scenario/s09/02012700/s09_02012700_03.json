[{"key":"SCENARIO_s09_02012700_03_0000","text":"Motion"},{"key":"SCENARIO_s09_02012700_03_0002","text":"粉丝"},{"key":"SCENARIO_s09_02012700_03_0010","text":"啊…………\n那个，那个……！"},{"key":"SCENARIO_s09_02012700_03_0020","text":"——你好\n谢谢你来看我！"},{"key":"SCENARIO_s09_02012700_03_0030","text":"有什么想问的吗？"},{"key":"SCENARIO_s09_02012700_03_0040","text":"——那个…………！\n要怎么样才能变得那么可爱呢……？"},{"key":"SCENARIO_s09_02012700_03_0050","text":"诶——！嗯，是什么呢……\n好好吃饭，好好睡觉之类的？"},{"key":"SCENARIO_s09_02012700_03_0060","text":"好、好好吃饭，睡觉……"},{"key":"SCENARIO_s09_02012700_03_0070","text":"不过，我觉得你已经\n非常可爱了哦？"},{"key":"SCENARIO_s09_02012700_03_0001","text":"Motion"},{"key":"SCENARIO_s09_02012700_03_0080","text":"说想变得像羽那一样的\n粉丝女孩子还挺多的"},{"key":"SCENARIO_s09_02012700_03_0090","text":"是啊，还有孩子说在模仿我\n把头发留长了呢"},{"key":"SCENARIO_s09_02012700_03_0100","text":"呵呵，大家都好可爱啊～"}]
