[{"key":"SCENARIO_s09_02020800_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02020800_02_0010","text":"啊…………"},{"key":"SCENARIO_s09_02020800_02_0020","text":"哇……好厉害……"},{"key":"SCENARIO_s09_02020800_02_0025","text":"Motion"},{"key":"SCENARIO_s09_02020800_02_0030","text":"雾子酱\n怎么了～？"},{"key":"SCENARIO_s09_02020800_02_0040","text":"爱依酱……\n你看……"},{"key":"SCENARIO_s09_02020800_02_0050","text":"蚂蚁……\n在搬……糖果……"},{"key":"SCENARIO_s09_02020800_02_0060","text":"哦～，真的诶～\n好厉害！"},{"key":"SCENARIO_s09_02020800_02_0070","text":"嗯……\n明明比自己的……还大……"},{"key":"SCENARIO_s09_02020800_02_0080","text":"就是啊～！\n加油～！小蚂蚁～！"},{"key":"SCENARIO_s09_02020800_02_0090","text":"呵呵……\n要……给它加油……？"},{"key":"SCENARIO_s09_02020800_02_0100","text":"嗯！\n雾子酱也一起——"},{"key":"SCENARIO_s09_02020800_02_0110","text":"——哦，其他蚂蚁也聚过来了！"},{"key":"SCENARIO_s09_02020800_02_0120","text":"好多……\n是……朋友……吗……"},{"key":"SCENARIO_s09_02020800_02_0130","text":"啊哈哈\n要一起合力搬吗～"},{"key":"SCENARIO_s09_02020800_02_0140","text":"好嘞，那就用我们的朋友之力\n再给蚂蚁加加油吧～♪"},{"key":"SCENARIO_s09_02020800_02_0150","text":"嗯……\n加油……！"}]
