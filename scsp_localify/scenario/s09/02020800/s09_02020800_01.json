[{"key":"SCENARIO_s09_02020800_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02020800_01_0010","text":"雾子\n第一天的训练怎么样？"},{"key":"SCENARIO_s09_02020800_01_0020","text":"制作人……"},{"key":"SCENARIO_s09_02020800_01_0030","text":"嗯，那个……\n勉强……跟上了……"},{"key":"SCENARIO_s09_02020800_01_0040","text":"很开心……\n非常……热闹……"},{"key":"SCENARIO_s09_02020800_01_0050","text":"哈哈，那就好\n多人一起的训练也不错吧？"},{"key":"SCENARIO_s09_02020800_01_0060","text":"嗯……"},{"key":"SCENARIO_s09_02020800_01_0070","text":"和不同的人交流，\n我觉得会有很多发现和收获"},{"key":"SCENARIO_s09_02020800_01_0080","text":"哪怕只有一样也好\n希望你能在这次合宿中找到"},{"key":"SCENARIO_s09_02020800_01_0090","text":"收获……发现……"},{"key":"SCENARIO_s09_02020800_01_0100","text":"好的……\n我会加油的……"}]
