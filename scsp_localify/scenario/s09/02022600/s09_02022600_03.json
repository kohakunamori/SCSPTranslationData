[{"key":"SCENARIO_s09_02022600_03_0001","text":"Motion"},{"key":"SCENARIO_s09_02022600_03_0010","text":"────"},{"key":"SCENARIO_s09_02022600_03_0011","text":"Motion"},{"key":"SCENARIO_s09_02022600_03_0020","text":"大家还在练习啊\n你有去跟他们说说话吗？"},{"key":"SCENARIO_s09_02022600_03_0030","text":"为什么我要……"},{"key":"SCENARIO_s09_02022600_03_0040","text":"没什么好说的"},{"key":"SCENARIO_s09_02022600_03_0050","text":"…………"},{"key":"SCENARIO_s09_02022600_03_0060","text":"不过，之前你不是\n给圆香提了些建议吗？"},{"key":"SCENARIO_s09_02022600_03_0061","text":"Motion"},{"key":"SCENARIO_s09_02022600_03_0070","text":"────……"},{"key":"SCENARIO_s09_02022600_03_0080","text":"之前来练习场的时候\n碰巧看到你们俩在说话"},{"key":"SCENARIO_s09_02022600_03_0090","text":"你其实很关心大家的吧\n谢谢你"},{"key":"SCENARIO_s09_02022600_03_0100","text":"吵死了"},{"key":"SCENARIO_s09_02022600_03_0101","text":"Motion"}]
