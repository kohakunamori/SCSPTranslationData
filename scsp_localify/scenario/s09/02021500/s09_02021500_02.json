[{"key":"SCENARIO_s09_02021500_02_0001","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0002","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0010","text":"那个……\n这样，……然后这样……？"},{"key":"SCENARIO_s09_02021500_02_0000","text":"训练师"},{"key":"SCENARIO_s09_02021500_02_0020","text":"甜花同学，有点迟到了！\n大家跟上！"},{"key":"SCENARIO_s09_02021500_02_0030","text":"呀……！\n对、对不起……！"},{"key":"SCENARIO_s09_02021500_02_0031","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0040","text":"（……虽然有点担心\n　但甜花在努力跟上呢）"},{"key":"SCENARIO_s09_02021500_02_0050","text":"好，到此为止！\n休息一下吧！"},{"key":"SCENARIO_s09_02021500_02_0051","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0060","text":"呜呜……\n这样下去，不行……"},{"key":"SCENARIO_s09_02021500_02_0070","text":"……不行……\n才不是……！"},{"key":"SCENARIO_s09_02021500_02_0071","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0072","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0073","text":"Motion"},{"key":"SCENARIO_s09_02021500_02_0080","text":"那、那个……\n做得不好的地方，请告诉我……！"},{"key":"SCENARIO_s09_02021500_02_0090","text":"哦，甜花……\n主动去请教别人了啊"},{"key":"SCENARIO_s09_02021500_02_0100","text":"看那样子应该没问题了……！"}]
