[{"key":"SCENARIO_s09_03022300_01_0000","text":"Motion"},{"key":"SCENARIO_s09_03022300_01_0010","text":"哈啊～～～"},{"key":"SCENARIO_s09_03022300_01_0020","text":"雏菜，快到熄灯时间了"},{"key":"SCENARIO_s09_03022300_01_0030","text":"啊，已经这个点了～\n嗯…………"},{"key":"SCENARIO_s09_03022300_01_0040","text":"看起来挺累的\n练到很晚吗？"},{"key":"SCENARIO_s09_03022300_01_0050","text":"没有～\n大家一起聊天聊着聊着就晚了～"},{"key":"SCENARIO_s09_03022300_01_0060","text":"哈哈，原来如此\n看来你很享受合宿啊"},{"key":"SCENARIO_s09_03022300_01_0070","text":"练习累了～，也吃饱了～\n雏菜，回房间了哦～？"},{"key":"SCENARIO_s09_03022300_01_0080","text":"嗯，今天辛苦了\n晚安"},{"key":"SCENARIO_s09_03022300_01_0090","text":"嗯～\n晚安制作人"},{"key":"SCENARIO_s09_03022300_01_0100","text":"哈啊～～～"}]
