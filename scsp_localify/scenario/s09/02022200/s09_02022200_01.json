[{"key":"SCENARIO_s09_02022200_01_0001","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0002","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0010","text":"………………呼"},{"key":"SCENARIO_s09_02022200_01_0020","text":"（啊，已经这个点了……！）"},{"key":"SCENARIO_s09_02022200_01_0021","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0022","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0030","text":"────\n不对，再稍微快一点……"},{"key":"SCENARIO_s09_02022200_01_0040","text":"…………"},{"key":"SCENARIO_s09_02022200_01_0041","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0050","text":"（吃饭的时间……\n　快到了，但是……）"},{"key":"SCENARIO_s09_02022200_01_0060","text":"（可是，她看起来好专注……！）"},{"key":"SCENARIO_s09_02022200_01_0065","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0061","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0070","text":"噼呀……！"},{"key":"SCENARIO_s09_02022200_01_0071","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0080","text":"──……\n没事吧？"},{"key":"SCENARIO_s09_02022200_01_0090","text":"呀……！\n是、是的……！"},{"key":"SCENARIO_s09_02022200_01_0091","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0100","text":"…………"},{"key":"SCENARIO_s09_02022200_01_0110","text":"……怎么了？"},{"key":"SCENARIO_s09_02022200_01_0111","text":"Motion"},{"key":"SCENARIO_s09_02022200_01_0120","text":"那个……马、马上……\n……到吃饭的时间了，可能……"},{"key":"SCENARIO_s09_02022200_01_0130","text":"──啊\n这样啊"},{"key":"SCENARIO_s09_02022200_01_0140","text":"……谢谢你\n告诉我"},{"key":"SCENARIO_s09_02022200_01_0150","text":"啊……\n不、不用……"}]
