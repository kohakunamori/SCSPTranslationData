[{"key":"SCENARIO_s09_02022000_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0010","text":"………………"},{"key":"SCENARIO_s09_02022000_01_0020","text":"要吗？\n水"},{"key":"SCENARIO_s09_02022000_01_0021","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0030","text":"——啊"},{"key":"SCENARIO_s09_02022000_01_0040","text":"（noctchill的──）"},{"key":"SCENARIO_s09_02022000_01_0050","text":"不用了，我自己有"},{"key":"SCENARIO_s09_02022000_01_0060","text":"啊，这样啊\n那……"},{"key":"SCENARIO_s09_02022000_01_0061","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0070","text":"………………"},{"key":"SCENARIO_s09_02022000_01_0080","text":"（……回去吧）"},{"key":"SCENARIO_s09_02022000_01_0081","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0090","text":"好热啊"},{"key":"SCENARIO_s09_02022000_01_0100","text":"还要继续吗\n训练"},{"key":"SCENARIO_s09_02022000_01_0110","text":"………………"},{"key":"SCENARIO_s09_02022000_01_0120","text":"（才不是什么热……\n　我只是，必须去做而已──）"},{"key":"SCENARIO_s09_02022000_01_0130","text":"──好，我再练一会儿"},{"key":"SCENARIO_s09_02022000_01_0140","text":"请便，浅仓同学请休息吧\n那么，我先失陪了——"},{"key":"SCENARIO_s09_02022000_01_0141","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0142","text":"Motion"},{"key":"SCENARIO_s09_02022000_01_0150","text":"————好喝"}]
