[{"key":"SCENARIO_s09_02022000_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02022000_02_0010","text":"透，辛苦了\n来，补充水分"},{"key":"SCENARIO_s09_02022000_02_0020","text":"感谢"},{"key":"SCENARIO_s09_02022000_02_0021","text":"Motion"},{"key":"SCENARIO_s09_02022000_02_0030","text":"怎么了？\n不喝吗？"},{"key":"SCENARIO_s09_02022000_02_0040","text":"……热情"},{"key":"SCENARIO_s09_02022000_02_0050","text":"诶……？\n你说发烧了？"},{"key":"SCENARIO_s09_02022000_02_0060","text":"没事"},{"key":"SCENARIO_s09_02022000_02_0070","text":"没有热情，热情"},{"key":"SCENARIO_s09_02022000_02_0080","text":"……才没有那回事"},{"key":"SCENARIO_s09_02022000_02_0090","text":"在我眼里，透心里\n确实有热情"},{"key":"SCENARIO_s09_02022000_02_0100","text":"平时的训练也好，集训也好\n你不是一直在努力吗"},{"key":"SCENARIO_s09_02022000_02_0101","text":"Motion"}]
