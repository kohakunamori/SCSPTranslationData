[{"key":"SCENARIO_s09_02022000_03_0000","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0010","text":"透！"},{"key":"SCENARIO_s09_02022000_03_0020","text":"啊，制作人"},{"key":"SCENARIO_s09_02022000_03_0030","text":"这个，想给透来着"},{"key":"SCENARIO_s09_02022000_03_0031","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0040","text":"……水？"},{"key":"SCENARIO_s09_02022000_03_0050","text":"嗯。没能看着你训练，抱歉啊\n辛苦了"},{"key":"SCENARIO_s09_02022000_03_0060","text":"啊——，嗯"},{"key":"SCENARIO_s09_02022000_03_0061","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0062","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0063","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0064","text":"Motion"},{"key":"SCENARIO_s09_02022000_03_0070","text":"透……！？"},{"key":"SCENARIO_s09_02022000_03_0080","text":"呵呵，好冰……"},{"key":"SCENARIO_s09_02022000_03_0090","text":"……哈哈\n这就是透有热情的证据啊"},{"key":"SCENARIO_s09_02022000_03_0100","text":"诶……啊——\n嗯，有了"},{"key":"SCENARIO_s09_02022000_03_0101","text":"Motion"}]
