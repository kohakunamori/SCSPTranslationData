[{"key":"SCENARIO_s09_03022000_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03022000_02_0010","text":"啊——"},{"key":"SCENARIO_s09_03022000_02_0020","text":"下雨了……"},{"key":"SCENARIO_s09_03022000_02_0030","text":"嗯\n下起来了"},{"key":"SCENARIO_s09_03022000_02_0040","text":"天暗下来，突然就"},{"key":"SCENARIO_s09_03022000_02_0050","text":"是这样啊……"},{"key":"SCENARIO_s09_03022000_02_0060","text":"透酱……\n要……出去……吗……？"},{"key":"SCENARIO_s09_03022000_02_0070","text":"不去\n而且，伞"},{"key":"SCENARIO_s09_03022000_02_0080","text":"要……帮你拿……来吗……？"},{"key":"SCENARIO_s09_03022000_02_0090","text":"啊，不用\n谢谢"},{"key":"SCENARIO_s09_03022000_02_0100","text":"嗯…………"},{"key":"SCENARIO_s09_03022000_02_0110","text":"雨……感觉好舒服……\n叶子们……"},{"key":"SCENARIO_s09_03022000_02_0120","text":"一直……都是晴天……\n它们……好干……"},{"key":"SCENARIO_s09_03022000_02_0121","text":"Motion"},{"key":"SCENARIO_s09_03022000_02_0130","text":"温柔的……雨……"},{"key":"SCENARIO_s09_03022000_02_0140","text":"…………"},{"key":"SCENARIO_s09_03022000_02_0150","text":"温柔的吗\n雨"}]
