[{"key":"SCENARIO_s09_02020700_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02020700_01_0010","text":"哎呀……"},{"key":"SCENARIO_s09_02020700_01_0020","text":"怎么了？"},{"key":"SCENARIO_s09_02020700_01_0030","text":"我好像落了点东西"},{"key":"SCENARIO_s09_02020700_01_0040","text":"落了什么？\n要我去买吗"},{"key":"SCENARIO_s09_02020700_01_0050","text":"不用不用！完全不用费心！\n也不是什么必需的东西"},{"key":"SCENARIO_s09_02020700_01_0060","text":"其他组合也在嘛，我就想着能不能用自己的相机拍几张"},{"key":"SCENARIO_s09_02020700_01_0070","text":"不是手机的那种"},{"key":"SCENARIO_s09_02020700_01_0080","text":"啊，原来如此，相机……\n——啊，那这次用一次性相机怎么样？"},{"key":"SCENARIO_s09_02020700_01_0090","text":"不是手机这一点\n应该能拍出和平时不一样的感觉哦"},{"key":"SCENARIO_s09_02020700_01_0100","text":"啊哈，原来如此？\n那我就去搞一个来试试吧"}]
