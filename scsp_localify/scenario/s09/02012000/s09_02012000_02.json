[{"key":"SCENARIO_s09_02012000_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02012000_02_0010","text":"这附近很安静\n休息一下正合适"},{"key":"SCENARIO_s09_02012000_02_0011","text":"母亲"},{"key":"SCENARIO_s09_02012000_02_0020","text":"来，过来这边……\n好，抓到了！"},{"key":"SCENARIO_s09_02012000_02_0021","text":"孩子"},{"key":"SCENARIO_s09_02012000_02_0030","text":"呀哈哈！\n好痒——！"},{"key":"SCENARIO_s09_02012000_02_0040","text":"啊"},{"key":"SCENARIO_s09_02012000_02_0050","text":"走丢的孩子\n上次那个"},{"key":"SCENARIO_s09_02012000_02_0060","text":"诶？\n……那个孩子？"},{"key":"SCENARIO_s09_02012000_02_0070","text":"或许"},{"key":"SCENARIO_s09_02012000_02_0080","text":"感觉，有点像\n声音"},{"key":"SCENARIO_s09_02012000_02_0090","text":"……是吗\n今天笑得很开心呢"},{"key":"SCENARIO_s09_02012000_02_0100","text":"——嗯"}]
