[{"key":"SCENARIO_s09_02012000_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02012000_01_0010","text":"透，辛苦了\n你没事吧？"},{"key":"SCENARIO_s09_02012000_01_0020","text":"诶？"},{"key":"SCENARIO_s09_02012000_01_0030","text":"演唱会中你看起来有点走神\n如果身体不舒服的话——"},{"key":"SCENARIO_s09_02012000_01_0040","text":"啊——\n哭声，让我有点在意"},{"key":"SCENARIO_s09_02012000_01_0050","text":"……啊，是中途听到的小孩哭声吧\n工作人员已经去处理了"},{"key":"SCENARIO_s09_02012000_01_0060","text":"是走丢了吗？"},{"key":"SCENARIO_s09_02012000_01_0070","text":"嗯，好像是那样"},{"key":"SCENARIO_s09_02012000_01_0080","text":"在那之后不久\n家长就来接走了"},{"key":"SCENARIO_s09_02012000_01_0090","text":"这样啊"},{"key":"SCENARIO_s09_02012000_01_0100","text":"回去了啊"}]
