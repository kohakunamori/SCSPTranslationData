[{"key":"SCENARIO_s09_02012600_02_0001","text":"Motion"},{"key":"SCENARIO_s09_02012600_02_0010","text":"——路加\n又要去哪里吗？"},{"key":"SCENARIO_s09_02012600_02_0011","text":"Motion"},{"key":"SCENARIO_s09_02012600_02_0012","text":"Motion"},{"key":"SCENARIO_s09_02012600_02_0020","text":"随便吧"},{"key":"SCENARIO_s09_02012600_02_0030","text":"工作以外的事别管"},{"key":"SCENARIO_s09_02012600_02_0040","text":"啊，抱歉\n我当然没打算限制你的自由时间"},{"key":"SCENARIO_s09_02012600_02_0050","text":"只是，至少告诉我你去哪里的话我会很高兴\n万一出了什么事的话我会担心——"},{"key":"SCENARIO_s09_02012600_02_0051","text":"Motion"},{"key":"SCENARIO_s09_02012600_02_0060","text":"闭嘴……"},{"key":"SCENARIO_s09_02012600_02_0070","text":"你怎么样我才不管"},{"key":"SCENARIO_s09_02012600_02_0080","text":"但是……"},{"key":"SCENARIO_s09_02012600_02_0090","text":"别管我————"},{"key":"SCENARIO_s09_02012600_02_0091","text":"Motion"},{"key":"SCENARIO_s09_02012600_02_0100","text":"路加……"}]
