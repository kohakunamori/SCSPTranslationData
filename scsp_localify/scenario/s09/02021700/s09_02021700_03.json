[{"key":"SCENARIO_s09_02021700_03_0001","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0010","text":"………………"},{"key":"SCENARIO_s09_02021700_03_0011","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0019","text":"训练师"},{"key":"SCENARIO_s09_02021700_03_0020","text":"不错嘛，朝日酱\n合宿期间完全掌握了呢！"},{"key":"SCENARIO_s09_02021700_03_0021","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0022","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0030","text":"（……状态，看起来不错啊）"},{"key":"SCENARIO_s09_02021700_03_0031","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0032","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0033","text":"Motion"},{"key":"SCENARIO_s09_02021700_03_0040","text":"啊，制作人！\n您来了啊"},{"key":"SCENARIO_s09_02021700_03_0050","text":"嗯，你练得很专注啊"},{"key":"SCENARIO_s09_02021700_03_0060","text":"是吗？"},{"key":"SCENARIO_s09_02021700_03_0070","text":"我可是从挺久之前就在看了哦"},{"key":"SCENARIO_s09_02021700_03_0080","text":"啊哈哈\n我都没注意到"},{"key":"SCENARIO_s09_02021700_03_0090","text":"……集训，开心吗？"},{"key":"SCENARIO_s09_02021700_03_0100","text":"好的！"}]
