[{"key":"SCENARIO_s09_02022100_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02022100_01_0010","text":"圆香，你已经回来了啊"},{"key":"SCENARIO_s09_02022100_01_0020","text":"是的\n训练已经结束了"},{"key":"SCENARIO_s09_02022100_01_0030","text":"嗯，辛苦了\n接下来要去哪里吗？"},{"key":"SCENARIO_s09_02022100_01_0040","text":"只是来买点喝的\n这就回房间了"},{"key":"SCENARIO_s09_02022100_01_0050","text":"这样啊……跟其他组合的大家\n有交流吗？"},{"key":"SCENARIO_s09_02022100_01_0060","text":"难得的机会\n希望大家之间的感情能加深就好了"},{"key":"SCENARIO_s09_02022100_01_0070","text":"没什么问题\n请不用担心"},{"key":"SCENARIO_s09_02022100_01_0080","text":"噢"},{"key":"SCENARIO_s09_02022100_01_0001","text":"Motion"},{"key":"SCENARIO_s09_02022100_01_0002","text":"Motion"},{"key":"SCENARIO_s09_02022100_01_0090","text":"……这是什么"},{"key":"SCENARIO_s09_02022100_01_0100","text":"跟示范不一样"}]
