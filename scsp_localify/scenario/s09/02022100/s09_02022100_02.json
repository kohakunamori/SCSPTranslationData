[{"key":"SCENARIO_s09_02022100_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02022100_02_0010","text":"────……"},{"key":"SCENARIO_s09_02022100_02_0020","text":"不好意思"},{"key":"SCENARIO_s09_02022100_02_0030","text":"这里，我也可以用一下吗"},{"key":"SCENARIO_s09_02022100_02_0040","text":"嗯"},{"key":"SCENARIO_s09_02022100_02_0050","text":"抱歉，没注意到你"},{"key":"SCENARIO_s09_02022100_02_0060","text":"不\n我才是不好意思，打扰了"},{"key":"SCENARIO_s09_02022100_02_0070","text":"……来自己练习的？"},{"key":"SCENARIO_s09_02022100_02_0080","text":"嗯，算是吧"},{"key":"SCENARIO_s09_02022100_02_0090","text":"这样啊"},{"key":"SCENARIO_s09_02022100_02_0001","text":"Motion"},{"key":"SCENARIO_s09_02022100_02_0100","text":"…………"},{"key":"SCENARIO_s09_02022100_02_0110","text":"那我用这边这块地方"},{"key":"SCENARIO_s09_02022100_02_0120","text":"请"},{"key":"SCENARIO_s09_02022100_02_0002","text":"Motion"},{"key":"SCENARIO_s09_02022100_02_0130","text":"（美琴和圆香──）"},{"key":"SCENARIO_s09_02022100_02_0140","text":"…………"},{"key":"SCENARIO_s09_02022100_02_0150","text":"（在自主练习啊\n　我在那儿会碍事吧）"}]
