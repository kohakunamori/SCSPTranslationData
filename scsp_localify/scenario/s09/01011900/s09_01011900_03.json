[{"key":"SCENARIO_s09_01011900_03_0000","text":"Motion"},{"key":"SCENARIO_s09_01011900_03_0010","text":"……"},{"key":"SCENARIO_s09_01011900_03_0020","text":"──……怎么样？"},{"key":"SCENARIO_s09_01011900_03_0030","text":"嗯！不愧是爱依\n进步非常明显"},{"key":"SCENARIO_s09_01011900_03_0040","text":"真的假的！？\n太好了！"},{"key":"SCENARIO_s09_01011900_03_0050","text":"休息时间也一直在练习呢\n我觉得你的努力已经出成果了"},{"key":"SCENARIO_s09_01011900_03_0060","text":"嘛～……确实\n是有那么点感觉～？"},{"key":"SCENARIO_s09_01011900_03_0070","text":"不过，教练说我还能更进一步"},{"key":"SCENARIO_s09_01011900_03_0080","text":"所以现在是“要做到完美～！”\n的感觉～！"},{"key":"SCENARIO_s09_01011900_03_0090","text":"哈哈，说得对\n爱依的话一定做得到的"},{"key":"SCENARIO_s09_01011900_03_0100","text":"──你还要再练一会儿吧？\n我去买点喝的，有什么想要的──"},{"key":"SCENARIO_s09_01011900_03_0110","text":"！那不用了！"},{"key":"SCENARIO_s09_01011900_03_0120","text":"合宿所的大婶说“算是感谢你帮忙” \n给了我好多果汁呢！"},{"key":"SCENARIO_s09_01011900_03_0130","text":"诶……！？\n给了你，这么多……！？"},{"key":"SCENARIO_s09_01011900_03_0140","text":"哈哈……这样啊……\n爱依的温柔真的让她很开心吧…………"},{"key":"SCENARIO_s09_01011900_03_0150","text":"我超开心的～\n啊，制作人也拿几瓶去吧……！"},{"key":"SCENARIO_s09_01011900_03_0160","text":"……那就拿一瓶\n毕竟是爱依收到的东西嘛"},{"key":"SCENARIO_s09_01011900_03_0170","text":"诶，制作人也一起打扫了呀！\n一起喝嘛，来嘛……！"},{"key":"SCENARIO_s09_01011900_03_0171","text":"Motion"},{"key":"SCENARIO_s09_01011900_03_0180","text":"────……\n好！干劲也上来了，继续练咯～"},{"key":"SCENARIO_s09_01011900_03_0190","text":"和制作人在一起的话，\n我就是超强的！所以啦！"}]
