[{"key":"SCENARIO_s09_01011900_01_0000","text":"Motion"},{"key":"SCENARIO_s09_01011900_01_0010","text":"～♪"},{"key":"SCENARIO_s09_01011900_01_0020","text":"咦，爱依？"},{"key":"SCENARIO_s09_01011900_01_0030","text":"啊，制作人\n辛苦了～"},{"key":"SCENARIO_s09_01011900_01_0040","text":"这个时间你不是说要自己加练的吗？"},{"key":"SCENARIO_s09_01011900_01_0050","text":"啊，那个啊！"},{"key":"SCENARIO_s09_01011900_01_0060","text":"合宿所的大婶好像闪到腰了～\n看起来挺严重的"},{"key":"SCENARIO_s09_01011900_01_0070","text":"所以我就想让她先休息一下\n打扫就交给我来做吧！"},{"key":"SCENARIO_s09_01011900_01_0080","text":"原来如此……"},{"key":"SCENARIO_s09_01011900_01_0090","text":"……好！爱依，那把扫帚借我\n剩下的我来吧"},{"key":"SCENARIO_s09_01011900_01_0100","text":"等等，不不不！\n是我说要做的呀！"},{"key":"SCENARIO_s09_01011900_01_0110","text":"不，如果可以的话交给我吧\n我想让爱依能专心练习"},{"key":"SCENARIO_s09_01011900_01_0120","text":"……！"},{"key":"SCENARIO_s09_01011900_01_0130","text":"……对不起！制作人！\n我都没考虑好自己的优先顺序……！"},{"key":"SCENARIO_s09_01011900_01_0140","text":"……！不，抱歉\n我不是那个意思"},{"key":"SCENARIO_s09_01011900_01_0150","text":"能对遇到困难的人伸出援手\n是爱依非常棒的优点……所以我也想帮忙"},{"key":"SCENARIO_s09_01011900_01_0160","text":"…………\n谢啦……！"},{"key":"SCENARIO_s09_01011900_01_0161","text":"Motion"},{"key":"SCENARIO_s09_01011900_01_0170","text":"那……一起做完吧！\n然后马上就去加练！"},{"key":"SCENARIO_s09_01011900_01_0180","text":"好，就这么定了！"}]
