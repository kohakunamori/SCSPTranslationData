[{"key":"SCENARIO_s09_03011800_02_0000","text":"Motion"},{"key":"SCENARIO_s09_03011800_02_0010","text":"…………"},{"key":"SCENARIO_s09_03011800_02_0020","text":"（最后一个……）"},{"key":"SCENARIO_s09_03011800_02_0030","text":"——剪子石头……"},{"key":"SCENARIO_s09_03011800_02_0040","text":"——布！"},{"key":"SCENARIO_s09_03011800_02_0050","text":"哈哈，输了啊\n那这个是冬优子的了"},{"key":"SCENARIO_s09_03011800_02_0060","text":"你刚才，是不是慢出了"},{"key":"SCENARIO_s09_03011800_02_0070","text":"诶，有吗？"},{"key":"SCENARIO_s09_03011800_02_0080","text":"别装傻\n你那蹩脚的演技我一眼就能看穿"},{"key":"SCENARIO_s09_03011800_02_0090","text":"被人让着赢了我可高兴不起来\n重来！"},{"key":"SCENARIO_s09_03011800_02_0100","text":"石头剪刀——"}]
