[{"key":"SCENARIO_s09_03012000_03_0000","text":"Motion"},{"key":"SCENARIO_s09_03012000_03_0001","text":"拍摄工作人员"},{"key":"SCENARIO_s09_03012000_03_0010","text":"２８３的各位——\n我们差不多要撤了"},{"key":"SCENARIO_s09_03012000_03_0020","text":"好的，辛苦了\n我们这边也差不多──────"},{"key":"SCENARIO_s09_03012000_03_0030","text":"透\n……不回去吗？"},{"key":"SCENARIO_s09_03012000_03_0040","text":"又在看鸟什么的…………"},{"key":"SCENARIO_s09_03012000_03_0050","text":"不是\n是月亮"},{"key":"SCENARIO_s09_03012000_03_0060","text":"感觉它在靠近\n怎么说呢"},{"key":"SCENARIO_s09_03012000_03_0070","text":"……这句，跟电视剧结尾的台词一模一样啊"},{"key":"SCENARIO_s09_03012000_03_0080","text":"大概吧"},{"key":"SCENARIO_s09_03012000_03_0090","text":"制作人也要看吗？\n月亮落下来的场景"},{"key":"SCENARIO_s09_03012000_03_0100","text":"哈哈，那就看看吧\n虽然感觉会就这么迎来终结就是了"},{"key":"SCENARIO_s09_03012000_03_0110","text":"…………\n嗯"},{"key":"SCENARIO_s09_03012000_03_0120","text":"在一起\n所以"},{"key":"SCENARIO_s09_03012000_03_0130","text":"所以\n不用去找"},{"key":"SCENARIO_s09_03012000_03_0140","text":"好了，在那之前先回去吧"},{"key":"SCENARIO_s09_03012000_03_0150","text":"好喔——"},{"key":"SCENARIO_s09_03012000_03_0160","text":"再次说声辛苦了，透\n饿了吧，要不要去吃点什么──────"}]
