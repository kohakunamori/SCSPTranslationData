[{"key":"SCENARIO_s09_02020500_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02020500_01_0010","text":"哼……"},{"key":"SCENARIO_s09_02020500_01_0020","text":"怎么了？\n有什么在意的事吗？"},{"key":"SCENARIO_s09_02020500_01_0030","text":"没有，只是觉得稀奇的东西好多啊……"},{"key":"SCENARIO_s09_02020500_01_0040","text":"哈哈……\n因为和平时环境不一样嘛"},{"key":"SCENARIO_s09_02020500_01_0050","text":"气候、空气、景色都不一样\n是很好的刺激吧？"},{"key":"SCENARIO_s09_02020500_01_0060","text":"嗯，是啊——"},{"key":"SCENARIO_s09_02020500_01_0070","text":"因为和平时环境不一样嘛——"},{"key":"SCENARIO_s09_02020500_01_0080","text":"我就想着可以做些和平时不一样的恶作剧了——\n真是很好的刺激呢"},{"key":"SCENARIO_s09_02020500_01_0090","text":"不，那种刺激我可受不了……"},{"key":"SCENARIO_s09_02020500_01_0100","text":"哼哼——"}]
