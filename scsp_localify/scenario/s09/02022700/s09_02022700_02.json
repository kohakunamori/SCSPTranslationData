[{"key":"SCENARIO_s09_02022700_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02022700_02_0010","text":"——要买饮料吗？"},{"key":"SCENARIO_s09_02022700_02_0020","text":"啊——，嗯"},{"key":"SCENARIO_s09_02022700_02_0030","text":"在犹豫\n水，还是甜的"},{"key":"SCENARIO_s09_02022700_02_0040","text":"这样啊——"},{"key":"SCENARIO_s09_02022700_02_0050","text":"……难得买一次，\n买甜的不是更好吗？"},{"key":"SCENARIO_s09_02022700_02_0060","text":"啊——"},{"key":"SCENARIO_s09_02022700_02_0070","text":"嗯，决定了\n那"},{"key":"SCENARIO_s09_02022700_02_0001","text":"Motion"},{"key":"SCENARIO_s09_02022700_02_0080","text":"……你不买吗？"},{"key":"SCENARIO_s09_02022700_02_0090","text":"没带\n贵重物品"},{"key":"SCENARIO_s09_02022700_02_0100","text":"啊——，原来如此——！\n那，我来请客吧？"},{"key":"SCENARIO_s09_02022700_02_0002","text":"Motion"},{"key":"SCENARIO_s09_02022700_02_0110","text":"给\n请"},{"key":"SCENARIO_s09_02022700_02_0120","text":"感谢"},{"key":"SCENARIO_s09_02022700_02_0130","text":"下次借我，手机\n回礼"},{"key":"SCENARIO_s09_02022700_02_0140","text":"打电话什么的\n代替我"},{"key":"SCENARIO_s09_02022700_02_0150","text":"啊哈，嗯——！"}]
