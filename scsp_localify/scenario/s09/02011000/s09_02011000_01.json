[{"key":"SCENARIO_s09_02011000_01_0001","text":"Motion"},{"key":"SCENARIO_s09_02011000_01_0010","text":"～～♪"},{"key":"SCENARIO_s09_02011000_01_0020","text":"心情很好嘛？"},{"key":"SCENARIO_s09_02011000_01_0030","text":"！\n啊哈哈，不好意思……！"},{"key":"SCENARIO_s09_02011000_01_0040","text":"怎么说呢，就是……！\n那种『我来见到大家了！』的感觉让我好开心……！"},{"key":"SCENARIO_s09_02011000_01_0050","text":"哦\n……怎么说？"},{"key":"SCENARIO_s09_02011000_01_0060","text":"演唱会的话，\n总归比较容易在固定的场地举办"},{"key":"SCENARIO_s09_02011000_01_0070","text":"所以我觉得『让粉丝们来见我们』的感觉\n会比较强烈"},{"key":"SCENARIO_s09_02011000_01_0080","text":"但是，跑业务的话可以去到各种地方，\n能够主动去见大家──"},{"key":"SCENARIO_s09_02011000_01_0090","text":"能觉得自己为大家做了些什么，\n就会不由自主地感到开心"},{"key":"SCENARIO_s09_02011000_01_0100","text":"……——原来如此啊"},{"key":"SCENARIO_s09_02011000_01_0101","text":"Motion"}]
