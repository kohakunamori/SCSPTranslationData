[{"key":"SCENARIO_s09_01011800_01_0000","text":"Motion"},{"key":"SCENARIO_s09_01011800_01_0010","text":"呵呵"},{"key":"SCENARIO_s09_01011800_01_0020","text":"这地方真不错呢"},{"key":"SCENARIO_s09_01011800_01_0030","text":"啊啊……！"},{"key":"SCENARIO_s09_01011800_01_0040","text":"在这里的话合宿应该也能顺利推进吧"},{"key":"SCENARIO_s09_01011800_01_0050","text":"嗯"},{"key":"SCENARIO_s09_01011800_01_0060","text":"大自然环绕，空气也很清新吧？\n又安静又让人安心"},{"key":"SCENARIO_s09_01011800_01_0070","text":"无论如何都得拿出成果来"},{"key":"SCENARIO_s09_01011800_01_0080","text":"哦！\n尽管用吧"},{"key":"SCENARIO_s09_01011800_01_0090","text":"嘛，我倒也没觉得会一帆风顺就是了"},{"key":"SCENARIO_s09_01011800_01_0100","text":"毕竟，那些家伙啊…………"},{"key":"SCENARIO_s09_01011800_01_0110","text":"哈哈，朝阳和爱依\n也兴奋得不得了呢"},{"key":"SCENARIO_s09_01011800_01_0120","text":"她们一定对这次合宿干劲满满吧"},{"key":"SCENARIO_s09_01011800_01_0130","text":"……是啊"},{"key":"SCENARIO_s09_01011800_01_0140","text":"──总之，我会全力以赴的"},{"key":"SCENARIO_s09_01011800_01_0150","text":"嗯，拜托了"},{"key":"SCENARIO_s09_01011800_01_0160","text":"哈啊……"},{"key":"SCENARIO_s09_01011800_01_0170","text":"……你也要\n好好做好善后工作哦？"},{"key":"SCENARIO_s09_01011800_01_0180","text":"嗯嗯，当然！"}]
