[{"key":"SCENARIO_s09_01011800_03_0000","text":"Motion"},{"key":"SCENARIO_s09_01011800_03_0010","text":"冬优子，辛苦了"},{"key":"SCENARIO_s09_01011800_03_0011","text":"Motion"},{"key":"SCENARIO_s09_01011800_03_0020","text":"今天合宿就结束了呢"},{"key":"SCENARIO_s09_01011800_03_0030","text":"辛苦了\n是啊"},{"key":"SCENARIO_s09_01011800_03_0040","text":"虽然累得够呛，但学到了不少东西"},{"key":"SCENARIO_s09_01011800_03_0050","text":"这下总算能从看管那些家伙的差事里解放了"},{"key":"SCENARIO_s09_01011800_03_0060","text":"抱歉……要是能更好地支援你就好了\n但比想象中忙乱得多……"},{"key":"SCENARIO_s09_01011800_03_0070","text":"不，抱歉！\n是我在找借口……"},{"key":"SCENARIO_s09_01011800_03_0080","text":"没什么？\n你忙不忙我早就知道了"},{"key":"SCENARIO_s09_01011800_03_0090","text":"…………那些家伙\n也还算努力了"},{"key":"SCENARIO_s09_01011800_03_0100","text":"啊，是啊！\n这次合宿过得很充实吧"},{"key":"SCENARIO_s09_01011800_03_0110","text":"嗯"},{"key":"SCENARIO_s09_01011800_03_0120","text":"多亏了冬优子把大家团结得好"},{"key":"SCENARIO_s09_01011800_03_0130","text":"那还用说"},{"key":"SCENARIO_s09_01011800_03_0140","text":"……本来想这么说的\n但也有你的功劳……谢谢"},{"key":"SCENARIO_s09_01011800_03_0150","text":"哈哈，好的！"},{"key":"SCENARIO_s09_01011800_03_0160","text":"合宿虽然要结束了\n但之后也继续拜托你了"},{"key":"SCENARIO_s09_01011800_03_0170","text":"……你在说什么"},{"key":"SCENARIO_s09_01011800_03_0180","text":"你在跟谁说呢，笨蛋"}]
