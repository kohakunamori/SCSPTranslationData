[{"key":"SCENARIO_s09_02011900_02_0000","text":"Motion"},{"key":"SCENARIO_s09_02011900_02_0010","text":"辛苦了"},{"key":"SCENARIO_s09_02011900_02_0020","text":"啊，辛苦啦——"},{"key":"SCENARIO_s09_02011900_02_0030","text":"外景拿到的糖果，带回来给你\n有很多呢"},{"key":"SCENARIO_s09_02011900_02_0040","text":"非常感谢"},{"key":"SCENARIO_s09_02011900_02_0050","text":"啊，制作人辛苦了～\n我拿了糖果回来，给你一颗～"},{"key":"SCENARIO_s09_02011900_02_0060","text":"哦，谢啦\n这也是今天现场拿到的吗？"},{"key":"SCENARIO_s09_02011900_02_0070","text":"对呀～\n每次都会给我们点什么"},{"key":"SCENARIO_s09_02011900_02_0080","text":"这边的人，感觉都很温柔呢～"},{"key":"SCENARIO_s09_02011900_02_0090","text":"是啊，比如上次那家特产店的老板娘"},{"key":"SCENARIO_s09_02011900_02_0100","text":"啊哈哈～，那位老奶奶呀～\n不知道还能不能再见到呢～"}]
