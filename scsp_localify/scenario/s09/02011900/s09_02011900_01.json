[{"key":"SCENARIO_s09_02011900_01_0000","text":"Motion"},{"key":"SCENARIO_s09_02011900_01_0010","text":"你好"},{"key":"SCENARIO_s09_02011900_01_0001","text":"店主女性"},{"key":"SCENARIO_s09_02011900_01_0020","text":"你好啊\n来了个挺时髦的小姑娘呢……"},{"key":"SCENARIO_s09_02011900_01_0030","text":"……？\n有什么推荐的吗？"},{"key":"SCENARIO_s09_02011900_01_0040","text":"我们店的招牌……是这个烤点心\n配茶也很合适哦……"},{"key":"SCENARIO_s09_02011900_01_0050","text":"难得来一趟，来一个怎么样？\n我也给你泡杯茶吧……"},{"key":"SCENARIO_s09_02011900_01_0060","text":"谢谢\n那我就不客气了"},{"key":"SCENARIO_s09_02011900_01_0070","text":"结束啦——！\n中间加了即兴发挥，稍微有点紧张呢——！"},{"key":"SCENARIO_s09_02011900_01_0080","text":"应对得很好哦，谢谢\n那位店主，怎么说呢，挺有自己的节奏的"},{"key":"SCENARIO_s09_02011900_01_0090","text":"啊哈哈，懂～\n跟她聊天感觉好治愈～"},{"key":"SCENARIO_s09_02011900_01_0100","text":"伴手礼和茶都超好吃的！"}]
