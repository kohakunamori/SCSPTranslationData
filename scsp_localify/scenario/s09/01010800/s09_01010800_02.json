[{"key":"SCENARIO_s09_01010800_02_0000","text":"Motion"},{"key":"SCENARIO_s09_01010800_02_0010","text":"────"},{"key":"SCENARIO_s09_01010800_02_0020","text":"（今天的雾子，总觉得……）"},{"key":"SCENARIO_s09_01010800_02_0021","text":"Motion"},{"key":"SCENARIO_s09_01010800_02_0030","text":"雾子，辛苦了"},{"key":"SCENARIO_s09_01010800_02_0040","text":"……谢谢，您"},{"key":"SCENARIO_s09_01010800_02_0050","text":"今天你非常专注呢"},{"key":"SCENARIO_s09_01010800_02_0060","text":"看起来就像是不想漏掉\n教练说的每一句话一样"},{"key":"SCENARIO_s09_01010800_02_0070","text":"呵呵……"},{"key":"SCENARIO_s09_01010800_02_0080","text":"嗯……"},{"key":"SCENARIO_s09_01010800_02_0090","text":"因为……制作人\n说了……"},{"key":"SCENARIO_s09_01010800_02_0100","text":"诶？"},{"key":"SCENARIO_s09_01010800_02_0110","text":"大家……重要的事情……"},{"key":"SCENARIO_s09_01010800_02_0120","text":"都在传达给我……所以……"},{"key":"SCENARIO_s09_01010800_02_0130","text":"……哈哈"},{"key":"SCENARIO_s09_01010800_02_0140","text":"这样啊"},{"key":"SCENARIO_s09_01010800_02_0150","text":"……我说的话，\n你那么认真地记在心里了啊"},{"key":"SCENARIO_s09_01010800_02_0160","text":"——谢谢你\n雾子，真的很了不起"},{"key":"SCENARIO_s09_01010800_02_0161","text":"Motion"},{"key":"SCENARIO_s09_01010800_02_0170","text":"（……雾子总是从周围\n　接收到很多东西呢）"}]
