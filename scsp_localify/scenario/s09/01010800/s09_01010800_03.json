[{"key":"SCENARIO_s09_01010800_03_0000","text":"Motion"},{"key":"SCENARIO_s09_01010800_03_0010","text":"雾子？"},{"key":"SCENARIO_s09_01010800_03_0020","text":"制作人……\n早上好……"},{"key":"SCENARIO_s09_01010800_03_0030","text":"啊，早上好……\n雾子也起得真早"},{"key":"SCENARIO_s09_01010800_03_0040","text":"呵呵……\n是的……"},{"key":"SCENARIO_s09_01010800_03_0050","text":"总感觉……"},{"key":"SCENARIO_s09_01010800_03_0060","text":"因为能听到……\n各种各样的声音……"},{"key":"SCENARIO_s09_01010800_03_0070","text":"啊啊……"},{"key":"SCENARIO_s09_01010800_03_0080","text":"……哈哈，真的呢"},{"key":"SCENARIO_s09_01010800_03_0090","text":"能听到各种各样的声音"},{"key":"SCENARIO_s09_01010800_03_0091","text":"Motion"},{"key":"SCENARIO_s09_01010800_03_0100","text":"────\n大家……"},{"key":"SCENARIO_s09_01010800_03_0110","text":"大家……重要的事情……"},{"key":"SCENARIO_s09_01010800_03_0120","text":"有在传达给我吗……"},{"key":"SCENARIO_s09_01010800_03_0130","text":"……嗯"},{"key":"SCENARIO_s09_01010800_03_0140","text":"比如早晨这么舒服这件事？"},{"key":"SCENARIO_s09_01010800_03_0150","text":"哇……\n是的……"},{"key":"SCENARIO_s09_01010800_03_0151","text":"Motion"},{"key":"SCENARIO_s09_01010800_03_0160","text":"呵呵……\n希望……能一直……一直……"},{"key":"SCENARIO_s09_01010800_03_0170","text":"回响下去……"}]
