[{"key":"SCENARIO_s09_01010800_01_0000","text":"Motion"},{"key":"SCENARIO_s09_01010800_01_0010","text":"……"},{"key":"SCENARIO_s09_01010800_01_0020","text":"雾子"},{"key":"SCENARIO_s09_01010800_01_0030","text":"啊……\n制作人……"},{"key":"SCENARIO_s09_01010800_01_0040","text":"你脸色看起来不太好，没事吧？"},{"key":"SCENARIO_s09_01010800_01_0050","text":"——有些，担心的事情……"},{"key":"SCENARIO_s09_01010800_01_0060","text":"给家里……\n打了电话……"},{"key":"SCENARIO_s09_01010800_01_0070","text":"难道是必须回去处理的事情吗？\n如果是的话……"},{"key":"SCENARIO_s09_01010800_01_0080","text":"不……\n没事了……"},{"key":"SCENARIO_s09_01010800_01_0090","text":"他们说……不用担心我……"},{"key":"SCENARIO_s09_01010800_01_0100","text":"是吗\n雾子真的很温柔呢"},{"key":"SCENARIO_s09_01010800_01_0110","text":"没问题的\n你的心意一定能传达到的"},{"key":"SCENARIO_s09_01010800_01_0120","text":"是这样吗……"},{"key":"SCENARIO_s09_01010800_01_0130","text":"倒不如说，太过在意这些的\n雾子才更让人担心呢"},{"key":"SCENARIO_s09_01010800_01_0140","text":"——抱歉……"},{"key":"SCENARIO_s09_01010800_01_0150","text":"啊，抱歉。我不是在责备你\n我是说不用太放在心上"},{"key":"SCENARIO_s09_01010800_01_0160","text":"如果有什么重要的事情\n他们一定会告诉雾子的"},{"key":"SCENARIO_s09_01010800_01_0170","text":"……重要的，事情"},{"key":"SCENARIO_s09_01010800_01_0180","text":"就像雾子担心着身边的人一样\n身边的人也珍惜着雾子啊"},{"key":"SCENARIO_s09_01010800_01_0181","text":"Motion"}]
