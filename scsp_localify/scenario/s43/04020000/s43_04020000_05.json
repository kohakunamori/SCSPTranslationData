[{"key":"SCENARIO_s43_04020000_05_0000","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0010","text":"走吧"},{"key":"SCENARIO_s43_04020000_05_0020","text":"他们说想看朋友的情谊"},{"key":"SCENARIO_s43_04020000_05_0021","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0030","text":"那不是很简单吗"},{"key":"SCENARIO_s43_04020000_05_0040","text":"像平常一样就可以了吧"},{"key":"SCENARIO_s43_04020000_05_9900","text":"节目导演"},{"key":"SCENARIO_s43_04020000_05_0050","text":"──────你这是在干什么…………！"},{"key":"SCENARIO_s43_04020000_05_0060","text":"……………………"},{"key":"SCENARIO_s43_04020000_05_0070","text":"非、非常抱歉…………！"},{"key":"SCENARIO_s43_04020000_05_9901","text":"节目导演"},{"key":"SCENARIO_s43_04020000_05_0080","text":"只有你一个人在道歉可不行啊\n这些孩子们难道没什么要说的吗？"},{"key":"SCENARIO_s43_04020000_05_0090","text":"这件事全都是我监督不力\n所以——……"},{"key":"SCENARIO_s43_04020000_05_9902","text":"节目导演"},{"key":"SCENARIO_s43_04020000_05_0100","text":"啊──……好好好，是吗\n那就这样吧，我会好好跟她们谈谈的"},{"key":"SCENARIO_s43_04020000_05_9903","text":"节目导演"},{"key":"SCENARIO_s43_04020000_05_0110","text":"当然，包括今后的事情也是"},{"key":"SCENARIO_s43_04020000_05_0120","text":"……是的，那是当然的\n——大家，先回休息室去吧，好吗？"},{"key":"SCENARIO_s43_04020000_05_0130","text":"……………………"},{"key":"SCENARIO_s43_04020000_05_0140","text":"好的"},{"key":"SCENARIO_s43_04020000_05_0150","text":"………………"},{"key":"SCENARIO_s43_04020000_05_0160","text":"……走吧～？"},{"key":"SCENARIO_s43_04020000_05_0161","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0170","text":"………………"},{"key":"SCENARIO_s43_04020000_05_0171","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0172","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0173","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0180","text":"………………"},{"key":"SCENARIO_s43_04020000_05_0190","text":"很害怕吧，小糸酱～"},{"key":"SCENARIO_s43_04020000_05_0200","text":"没，没有……"},{"key":"SCENARIO_s43_04020000_05_0210","text":"透酱，谢谢你……"},{"key":"SCENARIO_s43_04020000_05_0220","text":"…………"},{"key":"SCENARIO_s43_04020000_05_0230","text":"我很开心……"},{"key":"SCENARIO_s43_04020000_05_0240","text":"……她可能觉得自己做成了什么吧"},{"key":"SCENARIO_s43_04020000_05_0250","text":"…………不觉得不太妙吗？"},{"key":"SCENARIO_s43_04020000_05_0260","text":"诶～……"},{"key":"SCENARIO_s43_04020000_05_0270","text":"多半会变得很麻烦\n我们也是——……"},{"key":"SCENARIO_s43_04020000_05_0271","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0272","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0280","text":"………制作人也是吗？"},{"key":"SCENARIO_s43_04020000_05_0290","text":"天知道"},{"key":"SCENARIO_s43_04020000_05_0300","text":"但是靠我们的话\n负不起这个责任"},{"key":"SCENARIO_s43_04020000_05_0310","text":"……是啊\n都是因为我，才变成这样——……"},{"key":"SCENARIO_s43_04020000_05_0320","text":"我觉得不是小糸酱的错啦～……"},{"key":"SCENARIO_s43_04020000_05_0321","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0330","text":"浅仓"},{"key":"SCENARIO_s43_04020000_05_0340","text":"什么？"},{"key":"SCENARIO_s43_04020000_05_0350","text":"别这样\n别又那样擅自跑掉"},{"key":"SCENARIO_s43_04020000_05_0360","text":"……该怎么办才好？"},{"key":"SCENARIO_s43_04020000_05_0370","text":"没办法"},{"key":"SCENARIO_s43_04020000_05_0380","text":"大概，以现在的我们来说"},{"key":"SCENARIO_s43_04020000_05_0390","text":"这样啊\n我知道了"},{"key":"SCENARIO_s43_04020000_05_0393","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0391","text":"Motion"},{"key":"SCENARIO_s43_04020000_05_0392","text":"Motion"}]
