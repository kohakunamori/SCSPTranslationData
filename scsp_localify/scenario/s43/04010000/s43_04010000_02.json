[{"key":"SCENARIO_s43_04010000_02_0000","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0010","text":"L'Antica的各位，全部收工──！"},{"key":"SCENARIO_s43_04010000_02_0020","text":"非常感谢！"},{"key":"SCENARIO_s43_04010000_02_0030","text":"……导演！"},{"key":"SCENARIO_s43_04010000_02_0040","text":"感谢您允许我们在雨中拍摄，\n真的非常感谢"},{"key":"SCENARIO_s43_04010000_02_0050","text":"我们提了任性的要求，实在抱歉！\n但是，多亏了导演，我们才能坚持到最后"},{"key":"SCENARIO_s43_04010000_02_0060","text":"真的，非常感谢……！"},{"key":"SCENARIO_s43_04010000_02_0062","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0063","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0061","text":"高宫导演"},{"key":"SCENARIO_s43_04010000_02_0070","text":"一决胜负的拍摄……只有此刻才能捕捉到的光芒……\n能拍到那些，不是我的功劳"},{"key":"SCENARIO_s43_04010000_02_0080","text":"……明白了吗？"},{"key":"SCENARIO_s43_04010000_02_0090","text":"…………！"},{"key":"SCENARIO_s43_04010000_02_0092","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0093","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0094","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0091","text":"工作人员"},{"key":"SCENARIO_s43_04010000_02_0100","text":"──我把毛巾拿来了！\n导演，请用"},{"key":"SCENARIO_s43_04010000_02_0110","text":"L'Antica的各位也请用……！\n１、２、３……啊，咦"},{"key":"SCENARIO_s43_04010000_02_0111","text":"高宫导演"},{"key":"SCENARIO_s43_04010000_02_0120","text":"……不够吗？"},{"key":"SCENARIO_s43_04010000_02_0121","text":"工作人员"},{"key":"SCENARIO_s43_04010000_02_0130","text":"对、对不起\n我马上去找……！"},{"key":"SCENARIO_s43_04010000_02_0131","text":"高宫导演"},{"key":"SCENARIO_s43_04010000_02_0140","text":"喏，先用这个吧"},{"key":"SCENARIO_s43_04010000_02_0150","text":"……！\n不，比起我们，导演您淋得更湿──"},{"key":"SCENARIO_s43_04010000_02_0160","text":"我不用\n……明白了吗？"},{"key":"SCENARIO_s43_04010000_02_0170","text":"谢谢……你……"},{"key":"SCENARIO_s43_04010000_02_0180","text":"但是……"},{"key":"SCENARIO_s43_04010000_02_0181","text":"Motion"},{"key":"SCENARIO_s43_04010000_02_0190","text":"……！"},{"key":"SCENARIO_s43_04010000_02_0200","text":"导演……！"},{"key":"SCENARIO_s43_04010000_02_0210","text":"明……明白了吗？"},{"key":"SCENARIO_s43_04010000_02_0220","text":"！"},{"key":"SCENARIO_s43_04010000_02_0230","text":"雾、雾子……！？"},{"key":"SCENARIO_s43_04010000_02_0240","text":"哼哼——"},{"key":"SCENARIO_s43_04010000_02_0250","text":"摩美美……！"},{"key":"SCENARIO_s43_04010000_02_0260","text":"雾子的话我借她就行啦\n导演，您就别客气尽管用吧"},{"key":"SCENARIO_s43_04010000_02_0270","text":"对、对啊……！\n我们一起用就好，不介意的话这条毛巾也……！"},{"key":"SCENARIO_s43_04010000_02_0280","text":"我的毛巾也，请务必……！"},{"key":"SCENARIO_s43_04010000_02_0290","text":"不……"},{"key":"SCENARIO_s43_04010000_02_0300","text":"你、你们在干什么啊\n大家……！"},{"key":"SCENARIO_s43_04010000_02_0310","text":"这种事是我的职责\n大家赶紧把自己擦干"},{"key":"SCENARIO_s43_04010000_02_0320","text":"……导演，不介意的话请务必用我的毛巾"},{"key":"SCENARIO_s43_04010000_02_0330","text":"……！\n哈哈哈哈……！"},{"key":"SCENARIO_s43_04010000_02_0331","text":"旁白"},{"key":"SCENARIO_s43_04010000_02_0340","text":"────在那之后的一段时间里"},{"key":"SCENARIO_s43_04010000_02_0350","text":"今天的点心是曲奇哦！\n……明白了吗？"},{"key":"SCENARIO_s43_04010000_02_0360","text":"了解\n我去准备红茶"},{"key":"SCENARIO_s43_04010000_02_0370","text":"还有雾子！\n……明白了吗？"},{"key":"SCENARIO_s43_04010000_02_0380","text":"呵呵……\n制作人……我也去叫他过来……"},{"key":"SCENARIO_s43_04010000_02_0381","text":"旁白"},{"key":"SCENARIO_s43_04010000_02_0390","text":"────在L'Antica中流行了起来"},{"key":"SCENARIO_s43_04010000_02_0400","text":"诶，完全听不懂呢——"}]
