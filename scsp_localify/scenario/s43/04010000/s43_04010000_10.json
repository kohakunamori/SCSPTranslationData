[{"key":"SCENARIO_s43_04010000_10_0000","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0001","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0002","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0010","text":"…………\n雾子酱、甜花酱……？"},{"key":"SCENARIO_s43_04010000_10_0003","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0004","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0020","text":"真乃酱……！"},{"key":"SCENARIO_s43_04010000_10_0030","text":"晚上好……"},{"key":"SCENARIO_s43_04010000_10_0040","text":"晚上好。\n你们俩也在夜里散步……？"},{"key":"SCENARIO_s43_04010000_10_0050","text":"呵呵……\n定位游戏……"},{"key":"SCENARIO_s43_04010000_10_0060","text":"靠定位来战斗的游戏……！\n再差一点点就能打倒这里的敌人了……！"},{"key":"SCENARIO_s43_04010000_10_0070","text":"我……\n在给甜花酱加油……"},{"key":"SCENARIO_s43_04010000_10_0071","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0080","text":"……旁边，可以坐吗……？\n我也想帮忙加油。"},{"key":"SCENARIO_s43_04010000_10_0090","text":"请坐……／嗯……！"},{"key":"SCENARIO_s43_04010000_10_0100","text":"…………！\n还差……一点点……"},{"key":"SCENARIO_s43_04010000_10_0110","text":"…………"},{"key":"SCENARIO_s43_04010000_10_0120","text":"睡不着吗……？"},{"key":"SCENARIO_s43_04010000_10_0130","text":"嗯、嗯\n稍微醒过来了……"},{"key":"SCENARIO_s43_04010000_10_0131","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0140","text":"我也是……明明运动了很多……\n明明已经很累了……"},{"key":"SCENARIO_s43_04010000_10_0150","text":"呵呵，嗯。\n明明是这样……"},{"key":"SCENARIO_s43_04010000_10_0160","text":"…………"},{"key":"SCENARIO_s43_04010000_10_0170","text":"今天……我……\n对不起……"},{"key":"SCENARIO_s43_04010000_10_0180","text":"……Center该做的事，\n我什么都……没能做到……"},{"key":"SCENARIO_s43_04010000_10_0190","text":"Center该做的事……\n那是指……什么呢……？"},{"key":"SCENARIO_s43_04010000_10_0200","text":"…………那、个……"},{"key":"SCENARIO_s43_04010000_10_0210","text":"对、对不起。\n连这个都回答不上来……所以我才不行吧……"},{"key":"SCENARIO_s43_04010000_10_0211","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0220","text":"耶、耶！　赢了……！"},{"key":"SCENARIO_s43_04010000_10_0221","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0230","text":"太好了……／恭喜……"},{"key":"SCENARIO_s43_04010000_10_0240","text":"嘿嘿……\n刚才在说什么来着……？"},{"key":"SCENARIO_s43_04010000_10_0250","text":"嗯、嗯……那个……\n我在说，我也想和大家一起努力……"},{"key":"SCENARIO_s43_04010000_10_0260","text":"那个，甜花也有一样的想法……"},{"key":"SCENARIO_s43_04010000_10_0270","text":"甜花也完全……做不到像大家那样……\n该怎么办才好呢……？"},{"key":"SCENARIO_s43_04010000_10_0280","text":"…………\n该怎么办……才好呢……"},{"key":"SCENARIO_s43_04010000_10_0290","text":"…………"},{"key":"SCENARIO_s43_04010000_10_0300","text":"一起烦恼吧……"},{"key":"SCENARIO_s43_04010000_10_0310","text":"和大家……一起……"},{"key":"SCENARIO_s43_04010000_10_0320","text":"……\n嗯……"},{"key":"SCENARIO_s43_04010000_10_0330","text":"──甜花们，要去下一个地点看看……！\n真乃酱也一起来吗……？"},{"key":"SCENARIO_s43_04010000_10_0340","text":"……我……\n再在这里待一会儿。"},{"key":"SCENARIO_s43_04010000_10_0350","text":"今天……谢谢你。\n真乃酱。"},{"key":"SCENARIO_s43_04010000_10_0360","text":"……？"},{"key":"SCENARIO_s43_04010000_10_0370","text":"陪在我身边，为我加油……\n甜花，很开心……！"},{"key":"SCENARIO_s43_04010000_10_0380","text":"明天……再见……\n晚安……！"},{"key":"SCENARIO_s43_04010000_10_0390","text":"嗯……\n晚安……！"},{"key":"SCENARIO_s43_04010000_10_0400","text":"…………"},{"key":"SCENARIO_s43_04010000_10_0401","text":"Motion"},{"key":"SCENARIO_s43_04010000_10_0410","text":"一起……烦恼吧……"},{"key":"SCENARIO_s43_04010000_10_0420","text":"和大家一起……"},{"key":"SCENARIO_s43_04010000_10_0430","text":"……不是一个人……"},{"key":"SCENARIO_s43_04010000_10_0440","text":"…………\n不是一个人，所以──────"}]
