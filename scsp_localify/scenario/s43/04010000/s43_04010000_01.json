[{"key":"SCENARIO_s43_04010000_01_0000","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0000","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0010","text":"制作人\n欢迎回来～"},{"key":"SCENARIO_s43_04010000_01_0020","text":"今天怎么样～？"},{"key":"SCENARIO_s43_04010000_01_0030","text":"啊……\n嗯"},{"key":"SCENARIO_s43_04010000_01_0040","text":"找到了一个人──……"},{"key":"SCENARIO_s43_04010000_01_0041","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0050","text":"训练结束了\n我先失陪了"},{"key":"SCENARIO_s43_04010000_01_0060","text":"──啊，辛苦了！\n回去路上小心点"},{"key":"SCENARIO_s43_04010000_01_0061","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0070","text":"啊，灯织酱！\n现在正要回去吗？方便的话一起──"},{"key":"SCENARIO_s43_04010000_01_0071","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0072","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0080","text":"啊……"},{"key":"SCENARIO_s43_04010000_01_0081","text":"文静的同班同学"},{"key":"SCENARIO_s43_04010000_01_0082","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0090","text":"…………"},{"key":"SCENARIO_s43_04010000_01_0100","text":"（她现在是要回去了吧\n　……方便的话一起……）"},{"key":"SCENARIO_s43_04010000_01_0101","text":"认真的同班同学"},{"key":"SCENARIO_s43_04010000_01_0102","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0110","text":"抱歉抱歉，久等了\n那，走吧……"},{"key":"SCENARIO_s43_04010000_01_0120","text":"…………"},{"key":"SCENARIO_s43_04010000_01_0130","text":"（我也……能改变的话……）"},{"key":"SCENARIO_s43_04010000_01_0140","text":"（交到朋友……开心地聊天……\n　普通的事情，能像普通人一样做到……）"},{"key":"SCENARIO_s43_04010000_01_0141","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0150","text":"我觉得我做不到"},{"key":"SCENARIO_s43_04010000_01_0152","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0153","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0154","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0151","text":"真乃的母亲"},{"key":"SCENARIO_s43_04010000_01_0160","text":"小真乃\n妈妈可以进来一下吗？"},{"key":"SCENARIO_s43_04010000_01_0170","text":"嗯……"},{"key":"SCENARIO_s43_04010000_01_0180","text":"今天的晚饭怎么样？"},{"key":"SCENARIO_s43_04010000_01_0190","text":"嗯，很好吃哦"},{"key":"SCENARIO_s43_04010000_01_0200","text":"呵呵，那就好\n不过话说回来，真乃不管什么都吃得津津有味呢～"},{"key":"SCENARIO_s43_04010000_01_0210","text":"……呐，今天发生什么事了吗？\n吃晚饭的时候，你好像有点心不在焉的"},{"key":"SCENARIO_s43_04010000_01_0220","text":"啊……"},{"key":"SCENARIO_s43_04010000_01_0230","text":"不想说也没关系\n妈妈至少还能听听你说说话"},{"key":"SCENARIO_s43_04010000_01_0231","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0240","text":"那个……\n其实今天……在公园里……"},{"key":"SCENARIO_s43_04010000_01_0241","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0250","text":"哎呀……？你拒绝了吗……？\n我还以为你还在考虑怎么答复呢"},{"key":"SCENARIO_s43_04010000_01_0251","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0260","text":"要不要去看看新的世界"},{"key":"SCENARIO_s43_04010000_01_0251","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0270","text":"我也……\n能改变吗……"},{"key":"SCENARIO_s43_04010000_01_0280","text":"能飞起来……吗……"},{"key":"SCENARIO_s43_04010000_01_0290","text":"我吃饱了\n菠菜乳蛋饼吐司，很好吃……呢"},{"key":"SCENARIO_s43_04010000_01_0300","text":"没有忘东西吧？"},{"key":"SCENARIO_s43_04010000_01_0310","text":"嗯……！\n我出门了"},{"key":"SCENARIO_s43_04010000_01_0311","text":"真乃的父亲"},{"key":"SCENARIO_s43_04010000_01_0320","text":"……真乃，怎么样了？"},{"key":"SCENARIO_s43_04010000_01_0321","text":"真乃的母亲"},{"key":"SCENARIO_s43_04010000_01_0330","text":"好像还在犹豫"},{"key":"SCENARIO_s43_04010000_01_0331","text":"真乃的父亲"},{"key":"SCENARIO_s43_04010000_01_0340","text":"今天早上也跟她聊了吗？"},{"key":"SCENARIO_s43_04010000_01_0341","text":"真乃的母亲"},{"key":"SCENARIO_s43_04010000_01_0350","text":"看她的表情就知道了"},{"key":"SCENARIO_s43_04010000_01_0351","text":"真乃的父亲"},{"key":"SCENARIO_s43_04010000_01_0360","text":"──不管她做出什么选择，我都想支持她……\n应该说，必须支持她才行啊……"},{"key":"SCENARIO_s43_04010000_01_0361","text":"真乃的母亲"},{"key":"SCENARIO_s43_04010000_01_0370","text":"呵呵，为人父母总会想东想西的呢\n明明前不久还是个小不点，却已经到了要放手的时候了吗之类的"},{"key":"SCENARIO_s43_04010000_01_0380","text":"不用着急，再当一会儿小小的你，之类的──"},{"key":"SCENARIO_s43_04010000_01_0381","text":"真乃的父亲"},{"key":"SCENARIO_s43_04010000_01_0382","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0390","text":"……不，这是做父母的擅自感伤罢了\n这话就我们俩说说就好"},{"key":"SCENARIO_s43_04010000_01_0391","text":"真乃的母亲"},{"key":"SCENARIO_s43_04010000_01_0392","text":"Motion"},{"key":"SCENARIO_s43_04010000_01_0400","text":"是啊\n……振翅高飞的那一天，一定很快就会到来──"},{"key":"SCENARIO_s43_04010000_01_0401","text":"Motion"}]
