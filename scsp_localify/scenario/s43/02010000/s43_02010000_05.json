[{"key":"SCENARIO_s43_02010000_05_0000","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_9999","text":"训练师"},{"key":"SCENARIO_s43_02010000_05_0010","text":"辛苦了\n那么，下次也拜托啦"},{"key":"SCENARIO_s43_02010000_05_0020","text":"好嘞～／非常感谢！／\n非常感谢"},{"key":"SCENARIO_s43_02010000_05_0001","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0030","text":"……嗯……！\n…………呼……"},{"key":"SCENARIO_s43_02010000_05_0002","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0040","text":"……"},{"key":"SCENARIO_s43_02010000_05_0003","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0050","text":"（到正式演出还有……）"},{"key":"SCENARIO_s43_02010000_05_0004","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0060","text":"你们两个！\n下次，要不要来我家合宿！？"},{"key":"SCENARIO_s43_02010000_05_0005","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0070","text":"好呀～\n感觉会很有趣！"},{"key":"SCENARIO_s43_02010000_05_0006","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0080","text":"冬优跳过\n我想按自己的节奏调整状态"},{"key":"SCENARIO_s43_02010000_05_0090","text":"啊，这样啊……"},{"key":"SCENARIO_s43_02010000_05_0007","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0100","text":"冬优子酱的节奏\n是什么样的节奏啊？"},{"key":"SCENARIO_s43_02010000_05_0110","text":"哈……？\n那种事情有很多种啊，很多种"},{"key":"SCENARIO_s43_02010000_05_0120","text":"很多种……\n不太懂呢"},{"key":"SCENARIO_s43_02010000_05_0008","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0130","text":"……那，不懂就算了\n总之，冬优想按自己的方式来"},{"key":"SCENARIO_s43_02010000_05_0140","text":"啊哈哈～……"},{"key":"SCENARIO_s43_02010000_05_0150","text":"话说回来……\n突然说要合宿是怎么回事？"},{"key":"SCENARIO_s43_02010000_05_0009","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0160","text":"就是觉得还想要更多一点嘛\n练习的时间"},{"key":"SCENARIO_s43_02010000_05_0170","text":"不是已经在做训练了吗"},{"key":"SCENARIO_s43_02010000_05_0180","text":"我觉得已经够了哦"},{"key":"SCENARIO_s43_02010000_05_0011","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0190","text":"嗯，按现在的日程\n也不觉得“不够”"},{"key":"SCENARIO_s43_02010000_05_0200","text":"但是，不是完美\n而是想要做到超完美，这次的演唱会"},{"key":"SCENARIO_s43_02010000_05_0012","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0210","text":"有什么区别吗？"},{"key":"SCENARIO_s43_02010000_05_0220","text":"就是想要超越我们自己的极限！　这种感觉"},{"key":"SCENARIO_s43_02010000_05_0230","text":"……"},{"key":"SCENARIO_s43_02010000_05_0240","text":"全员一起的演唱会\n又不是经常有的机会嘛？"},{"key":"SCENARIO_s43_02010000_05_0014","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0013","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0250","text":"所以，想让其他组合的大家看看──"},{"key":"SCENARIO_s43_02010000_05_0260","text":"──不对，是想让他们见识见识\n我们……Straylight有多厉害！"},{"key":"SCENARIO_s43_02010000_05_0015","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0016","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0270","text":"……哦"},{"key":"SCENARIO_s43_02010000_05_0280","text":"……明白了\n既然说到这个份上，那就做吧"},{"key":"SCENARIO_s43_02010000_05_0017","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0290","text":"……！\n太好了！"},{"key":"SCENARIO_s43_02010000_05_0300","text":"要做什么呢？\n冬优子酱也说可以了，先合宿吗？"},{"key":"SCENARIO_s43_02010000_05_0310","text":"那个驳回。重点不在那里吧\n我说的是重新审视练习方法"},{"key":"SCENARIO_s43_02010000_05_0320","text":"诶～……"},{"key":"SCENARIO_s43_02010000_05_0330","text":"过夜等演唱会结束之后再搞吧～！"},{"key":"SCENARIO_s43_02010000_05_0340","text":"……！\n说得对！"},{"key":"SCENARIO_s43_02010000_05_0018","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0350","text":"你们的日程表，让我看一下……\n我找找有没有能加自主练习的时间"},{"key":"SCENARIO_s43_02010000_05_0360","text":"好嘞／谢啦！"},{"key":"SCENARIO_s43_02010000_05_0370","text":"冬优子酱的计划\n我会超完美地完成的！"},{"key":"SCENARIO_s43_02010000_05_0380","text":"那不是当然的吗\n提议的人要是中途打退堂鼓，我可不会放过你"},{"key":"SCENARIO_s43_02010000_05_0390","text":"绝对不会那样的！\n拿命担保也行！"},{"key":"SCENARIO_s43_02010000_05_0019","text":"Motion"},{"key":"SCENARIO_s43_02010000_05_0400","text":"啊哈哈。越来越兴奋了～！"}]
