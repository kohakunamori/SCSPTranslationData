[{"key":"SCENARIO_s43_02020000_04_0000","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0009","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0010","text":"────我是────的优子"},{"key":"SCENARIO_s43_02020000_04_0019","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0020","text":"我是……的优…… \n────────"},{"key":"SCENARIO_s43_02020000_04_0021","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0030","text":"恕我直言……即使有些笨拙，由她们亲手\n制作的话，那个，对粉丝来说…………"},{"key":"SCENARIO_s43_02020000_04_0039","text":"企划策划人"},{"key":"SCENARIO_s43_02020000_04_0040","text":"对现有粉丝来说，那样或许也可以，\n但考虑到今后的发展，那样做说服力不够"},{"key":"SCENARIO_s43_02020000_04_0049","text":"企划策划人"},{"key":"SCENARIO_s43_02020000_04_0050","text":"大家也都很忙吧，\n交给我们来做的话，也能减轻大家的负担"},{"key":"SCENARIO_s43_02020000_04_0060","text":"嗯……话虽如此…………"},{"key":"SCENARIO_s43_02020000_04_0069","text":"企划策划人"},{"key":"SCENARIO_s43_02020000_04_0070","text":"２８３事务所的成功，我也是真心期望的\n多少推出一些新举措，不是很有必要吗"},{"key":"SCENARIO_s43_02020000_04_0071","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0080","text":"水里面，之类的…………或者像宇宙一样————"},{"key":"SCENARIO_s43_02020000_04_0090","text":"────……"},{"key":"SCENARIO_s43_02020000_04_0091","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0100","text":"啊……\n日花酱，在做糖霜装饰？"},{"key":"SCENARIO_s43_02020000_04_0101","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0110","text":"啊────是的……"},{"key":"SCENARIO_s43_02020000_04_0120","text":"呵呵，我也是\n肌肉酸痛好难消啊"},{"key":"SCENARIO_s43_02020000_04_0130","text":"是呢—……"},{"key":"SCENARIO_s43_02020000_04_0131","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0140","text":"要是能消失就好了\n…………比如重力什么的"},{"key":"SCENARIO_s43_02020000_04_0141","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0149","text":"冬优子"},{"key":"SCENARIO_s43_02020000_04_0150","text":"『为了什么而继续飞翔』"},{"key":"SCENARIO_s43_02020000_04_0160","text":"《要朝着何方继续飞翔》"},{"key":"SCENARIO_s43_02020000_04_0169","text":"音响监督"},{"key":"SCENARIO_s43_02020000_04_0170","text":"抱歉呢，黛小姐\n刚才那个地方，麻烦从头再来一遍"},{"key":"SCENARIO_s43_02020000_04_0180","text":"……好的\n拜托了！"},{"key":"SCENARIO_s43_02020000_04_0181","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0182","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0190","text":"————啊"},{"key":"SCENARIO_s43_02020000_04_0191","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0200","text":"那个……在的────\n对不起……"},{"key":"SCENARIO_s43_02020000_04_0201","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0210","text":"…………重力……"},{"key":"SCENARIO_s43_02020000_04_0220","text":"哈────哎……"},{"key":"SCENARIO_s43_02020000_04_0230","text":"…………如果消失的话……\n那个人就……不再是那个人了……"},{"key":"SCENARIO_s43_02020000_04_0240","text":"……我……之所以是我……\n能感受到的……就是重量……"},{"key":"SCENARIO_s43_02020000_04_0250","text":"所以……日花酱就是……\n日花酱……"},{"key":"SCENARIO_s43_02020000_04_0260","text":"啊……啊哈哈\n那个…………？"},{"key":"SCENARIO_s43_02020000_04_0261","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0270","text":"怎么说呢──────"},{"key":"SCENARIO_s43_02020000_04_0271","text":"Motion"},{"key":"SCENARIO_s43_02020000_04_0279","text":"音响监督"},{"key":"SCENARIO_s43_02020000_04_0280","text":"导演…………怎么样？"},{"key":"SCENARIO_s43_02020000_04_0289","text":"动画导演"},{"key":"SCENARIO_s43_02020000_04_0290","text":"嗯，完全不…… \n倒也不是不好……"},{"key":"SCENARIO_s43_02020000_04_0299","text":"动画导演"},{"key":"SCENARIO_s43_02020000_04_0300","text":"好不容易是先期录音……希望能更这样\n把素颜部分的那种原生态感发挥出来啊"},{"key":"SCENARIO_s43_02020000_04_0309","text":"动画导演"},{"key":"SCENARIO_s43_02020000_04_0310","text":"黛小姐，是这样的吗？\n……演技力"},{"key":"SCENARIO_s43_02020000_04_0320","text":"让这片天空变得狭窄的，是什么"},{"key":"SCENARIO_s43_02020000_04_0329","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0330","text":"────我是────的优子\n我……的……优……"},{"key":"SCENARIO_s43_02020000_04_0339","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0340","text":"────我是……我是……我是……\n我我我我我我我我我我我我我────"},{"key":"SCENARIO_s43_02020000_04_0349","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0350","text":"………………………………"},{"key":"SCENARIO_s43_02020000_04_0359","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0360","text":"…………？"},{"key":"SCENARIO_s43_02020000_04_0369","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0370","text":"我──────咦……\n…………咦……？"},{"key":"SCENARIO_s43_02020000_04_0379","text":"通信语音AGI"},{"key":"SCENARIO_s43_02020000_04_0380","text":"────什么\n『我』是…………"}]
