[{"key":"SCENARIO_s43_02020000_03_0001","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0002","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0010","text":"小透……\n你、你从哪里拿来的？"},{"key":"SCENARIO_s43_02020000_03_0011","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0020","text":"嗯……壁橱？\n妈妈的"},{"key":"SCENARIO_s43_02020000_03_0030","text":"这、这样啊……！\n不过，好突然啊…………相机"},{"key":"SCENARIO_s43_02020000_03_0040","text":"啊——……"},{"key":"SCENARIO_s43_02020000_03_0050","text":"呵呵\n嗯"},{"key":"SCENARIO_s43_02020000_03_0051","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0052","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0060","text":"……"},{"key":"SCENARIO_s43_02020000_03_0070","text":"……\n主题…………『我与未来』……"},{"key":"SCENARIO_s43_02020000_03_0071","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0075","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0080","text":"一直做这个不会腻吗～？"},{"key":"SCENARIO_s43_02020000_03_0090","text":"啊……不会腻……"},{"key":"SCENARIO_s43_02020000_03_0100","text":"诶～？"},{"key":"SCENARIO_s43_02020000_03_0110","text":"…………不会勉强自己去做……\n在腻……腻之前……就会停下来……"},{"key":"SCENARIO_s43_02020000_03_0120","text":"呵呵……／啊～～"},{"key":"SCENARIO_s43_02020000_03_0125","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0130","text":"啊～，制作人！\n要吃点心吗～？"},{"key":"SCENARIO_s43_02020000_03_0140","text":"红茶也…………准备好了……"},{"key":"SCENARIO_s43_02020000_03_0150","text":"啊，抱歉！接下来要开会\n谢谢，等我回来再说吧……────"},{"key":"SCENARIO_s43_02020000_03_0151","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0160","text":"制作人，好像有点勉强自己呢～"},{"key":"SCENARIO_s43_02020000_03_0170","text":"…………"},{"key":"SCENARIO_s43_02020000_03_0179","text":"企划策划人"},{"key":"SCENARIO_s43_02020000_03_0180","text":"由专业人士以理想化的形象蓝图来创作作品\n覆盖掉大家现有的形象"},{"key":"SCENARIO_s43_02020000_03_0190","text":"展示内在和真实面貌来卖点的做法，哪里都在做\n反过来，我们要把那些藏起来，为偶像找回神秘感"},{"key":"SCENARIO_s43_02020000_03_0200","text":"这是触达新受众层的绝佳机会\n推出全新形象，稳步提升吸引力吧"},{"key":"SCENARIO_s43_02020000_03_0201","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0210","text":"总觉得……\n会被统一起来呢"},{"key":"SCENARIO_s43_02020000_03_0220","text":"更多……更多…………"},{"key":"SCENARIO_s43_02020000_03_0230","text":"更多更多更多——————"},{"key":"SCENARIO_s43_02020000_03_0240","text":"大到能把我这种存在\n一下子吹飞的程度，更多………………"},{"key":"SCENARIO_s43_02020000_03_0241","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0250","text":"…………不够……这样还不够————"},{"key":"SCENARIO_s43_02020000_03_0260","text":"如果有更多留白的话————"},{"key":"SCENARIO_s43_02020000_03_0261","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0262","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0270","text":"那真的是必要的吗"},{"key":"SCENARIO_s43_02020000_03_0280","text":"为了能让你停留在所期望的天空中"},{"key":"SCENARIO_s43_02020000_03_0281","text":"Motion"},{"key":"SCENARIO_s43_02020000_03_0290","text":"……能拍到照片吗？"},{"key":"SCENARIO_s43_02020000_03_0300","text":"嗯——"},{"key":"SCENARIO_s43_02020000_03_0310","text":"可能会挡到\n那个"},{"key":"SCENARIO_s43_02020000_03_0320","text":"────啊\n被、被墙壁挡住了呢……对面的景色……"},{"key":"SCENARIO_s43_02020000_03_0330","text":"嗯"},{"key":"SCENARIO_s43_02020000_03_0340","text":"不能拆掉吗\n那面墙"},{"key":"SCENARIO_s43_02020000_03_0350","text":"墙壁"}]
