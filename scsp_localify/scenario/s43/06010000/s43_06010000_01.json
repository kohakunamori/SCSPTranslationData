[{"key":"SCENARIO_s43_06010000_01_0000","text":"Motion"},{"key":"SCENARIO_s43_06010000_01_0010","text":"短笺上的……愿望……"},{"key":"SCENARIO_s43_06010000_01_0020","text":"织女小姐和牛郎先生……！"},{"key":"SCENARIO_s43_06010000_01_0030","text":"啊，银河……！"},{"key":"SCENARIO_s43_06010000_01_0040","text":"竹叶沙沙响～"},{"key":"SCENARIO_s43_06010000_01_0050","text":"风铃的声音……"},{"key":"SCENARIO_s43_06010000_01_0060","text":"……嗯\n同款的浴衣……！"},{"key":"SCENARIO_s43_06010000_01_0070","text":"还有……\n烟、烟火大会……？"},{"key":"SCENARIO_s43_06010000_01_0080","text":"那还有小吃摊的味道……！"},{"key":"SCENARIO_s43_06010000_01_0090","text":"呵呵……团子……"},{"key":"SCENARIO_s43_06010000_01_0100","text":"鲷鱼烧……！"},{"key":"SCENARIO_s43_06010000_01_0110","text":"炒面……\n还有，苹果糖……！"},{"key":"SCENARIO_s43_06010000_01_0120","text":"呵呵\n完全跟七夕没关系了呢"},{"key":"SCENARIO_s43_06010000_01_0121","text":"众人"},{"key":"SCENARIO_s43_06010000_01_0130","text":"……！"}]
