[{"key":"SCENARIO_s10_10900100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_10900100_03_0010","text":"…………！"},{"key":"SCENARIO_s10_10900100_03_0020","text":"（坐立不安的……）"},{"key":"SCENARIO_s10_10900100_03_0030","text":"我现在就出来！"},{"key":"SCENARIO_s10_10900100_03_0031","text":"Motion"},{"key":"SCENARIO_s10_10900100_03_0040","text":"制、制作人\n那个，难道是……！"},{"key":"SCENARIO_s10_10900100_03_0050","text":"哦，果穗期待已久的衣服哦\n要试试吗？"},{"key":"SCENARIO_s10_10900100_03_0060","text":"好的！"},{"key":"SCENARIO_s10_10900100_03_0062","text":"Motion"},{"key":"SCENARIO_s10_10900100_03_0061","text":"Motion"},{"key":"SCENARIO_s10_10900100_03_0070","text":"制作人！　我穿好啦——！"},{"key":"SCENARIO_s10_10900100_03_0080","text":"哦……\n嗯，不错。非常合适哦"},{"key":"SCENARIO_s10_10900100_03_0090","text":"嘿嘿\n这样——就能实现想做的事了！"},{"key":"SCENARIO_s10_10900100_03_0100","text":"是啊，我也会努力的\n一起实现吧"}]
