[{"key":"SCENARIO_s10_10900100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_10900100_01_0010","text":"早上好"},{"key":"SCENARIO_s10_10900100_01_0020","text":"…………？\n制作人，你在看什么呢？"},{"key":"SCENARIO_s10_10900100_01_0030","text":"早上好，果穗\n这是新衣服的设计图哦"},{"key":"SCENARIO_s10_10900100_01_0040","text":"新衣服……！\n飘飘的，像翅膀一样……！"},{"key":"SCENARIO_s10_10900100_01_0041","text":"Motion"},{"key":"SCENARIO_s10_10900100_01_0050","text":"超——级可爱的！"},{"key":"SCENARIO_s10_10900100_01_0060","text":"反响好就再好不过了\n这个啊，是283事务所全员一起穿的东西哦"},{"key":"SCENARIO_s10_10900100_01_0070","text":"和大家一样的……！"},{"key":"SCENARIO_s10_10900100_01_0071","text":"Motion"},{"key":"SCENARIO_s10_10900100_01_0080","text":"好厉害！\n什么时候能穿呢！？"},{"key":"SCENARIO_s10_10900100_01_0090","text":"嗯——……\n还要再等一阵子吧"},{"key":"SCENARIO_s10_10900100_01_0100","text":"这样啊！\n好想快点穿上啊……！"}]
