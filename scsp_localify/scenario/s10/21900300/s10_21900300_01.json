[{"key":"SCENARIO_s10_21900300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21900300_01_0010","text":"……"},{"key":"SCENARIO_s10_21900300_01_0020","text":"！"},{"key":"SCENARIO_s10_21900300_01_0030","text":"制作人\n稍等一下"},{"key":"SCENARIO_s10_21900300_01_0040","text":"？"},{"key":"SCENARIO_s10_21900300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21900300_01_0050","text":"给，制作人也有份"},{"key":"SCENARIO_s10_21900300_01_0060","text":"哦哦，谢了\n多少钱？"},{"key":"SCENARIO_s10_21900300_01_0070","text":"只是我自己渴了而已\n不用啦"},{"key":"SCENARIO_s10_21900300_01_0080","text":"好吧，谢谢\n不过下次让我请回来"},{"key":"SCENARIO_s10_21900300_01_0090","text":"比起那个\n我们去休息室一起喝吧"},{"key":"SCENARIO_s10_21900300_01_0100","text":"干杯庆祝辛苦了"}]
