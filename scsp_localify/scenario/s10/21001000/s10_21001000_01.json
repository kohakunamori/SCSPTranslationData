[{"key":"SCENARIO_s10_21001000_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21001000_01_0001","text":"服装师"},{"key":"SCENARIO_s10_21001000_01_0010","text":"非常合适！"},{"key":"SCENARIO_s10_21001000_01_0020","text":"哇，真的吗？"},{"key":"SCENARIO_s10_21001000_01_0030","text":"嗯\n很帅气哦，智代子！"},{"key":"SCENARIO_s10_21001000_01_0040","text":"非常感谢！"},{"key":"SCENARIO_s10_21001000_01_0041","text":"服装师"},{"key":"SCENARIO_s10_21001000_01_0050","text":"如果有什么在意的地方，我可以调整──"},{"key":"SCENARIO_s10_21001000_01_0060","text":"谢谢。……顺便问一下，\n可以让我确认一下日程安排吗……？"},{"key":"SCENARIO_s10_21001000_01_0061","text":"服装师"},{"key":"SCENARIO_s10_21001000_01_0070","text":"当然可以！\n稍等一下，我拿手机出来……！"},{"key":"SCENARIO_s10_21001000_01_0080","text":"──嗯，彩排是在这一天，所以──"},{"key":"SCENARIO_s10_21001000_01_0090","text":"……"},{"key":"SCENARIO_s10_21001000_01_0100","text":"（……肚子，得注意才行……！）"}]
