[{"key":"SCENARIO_s10_20800200_03_0010","text":"————制作人……"},{"key":"SCENARIO_s10_20800200_03_0020","text":"嗯！\n雾子，做得很好……！"},{"key":"SCENARIO_s10_20800200_03_0030","text":"那个……\n好的……"},{"key":"SCENARIO_s10_20800200_03_0040","text":"因为我……听到了……"},{"key":"SCENARIO_s10_20800200_03_0041","text":"Motion"},{"key":"SCENARIO_s10_20800200_03_0050","text":"扑通……\n扑通……"},{"key":"SCENARIO_s10_20800200_03_0060","text":"怦怦……\n怦怦……"},{"key":"SCENARIO_s10_20800200_03_0070","text":"穿着这件衣服的……\n大家的声音……"},{"key":"SCENARIO_s10_20800200_03_0080","text":"看着我们的人们的……\n声音……"},{"key":"SCENARIO_s10_20800200_03_0090","text":"在身后支持着我们的……\n好多好多人的声音……"},{"key":"SCENARIO_s10_20800200_03_0100","text":"所以说————"}]
