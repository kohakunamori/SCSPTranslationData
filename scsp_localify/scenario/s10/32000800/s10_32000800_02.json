[{"key":"SCENARIO_s10_32000800_02_0001","text":"Motion"},{"key":"SCENARIO_s10_32000800_02_0009","text":"摄影师"},{"key":"SCENARIO_s10_32000800_02_0010","text":"再靠近一点哦——"},{"key":"SCENARIO_s10_32000800_02_0020","text":"浅仓同学，给我个眼神"},{"key":"SCENARIO_s10_32000800_02_0025","text":"Motion"},{"key":"SCENARIO_s10_32000800_02_0030","text":"好——"},{"key":"SCENARIO_s10_32000800_02_0040","text":"很好呢——……对对……\n再靠近一点——"},{"key":"SCENARIO_s10_32000800_02_0050","text":"这次视线移开——\n再靠近一点哦——"},{"key":"SCENARIO_s10_32000800_02_0060","text":"哇……！好痛……\n抱歉，靠太近了……"},{"key":"SCENARIO_s10_32000800_02_0070","text":"啊——\n您没事吧"},{"key":"SCENARIO_s10_32000800_02_0080","text":"不，没事\n不好意思，让你看到了外行一样的样子"},{"key":"SCENARIO_s10_32000800_02_0090","text":"大概是因为太有魅力了\n忍不住想靠近吧……哈哈哈"},{"key":"SCENARIO_s10_32000800_02_0100","text":"要是没有围栏，就撞上去了呢——"},{"key":"SCENARIO_s10_32000800_02_0110","text":"……"},{"key":"SCENARIO_s10_32000800_02_0120","text":"得集中精神才行\n来，继续拍摄吧"},{"key":"SCENARIO_s10_32000800_02_0125","text":"Motion"},{"key":"SCENARIO_s10_32000800_02_0130","text":"刚才那位摄影师，明明是资深前辈\n却完全入迷了呢"},{"key":"SCENARIO_s10_32000800_02_0140","text":"说想靠近"},{"key":"SCENARIO_s10_32000800_02_0150","text":"是吗——\n看了刚才的透，我好像能理解了"},{"key":"SCENARIO_s10_32000800_02_0160","text":"呵呵\n制作人也要撞上来吗？"}]
