[{"key":"SCENARIO_s10_32000800_01_0001","text":"Motion"},{"key":"SCENARIO_s10_32000800_01_0009","text":"女学生"},{"key":"SCENARIO_s10_32000800_01_0010","text":"那个……\n浅仓，前辈"},{"key":"SCENARIO_s10_32000800_01_0015","text":"Motion"},{"key":"SCENARIO_s10_32000800_01_0020","text":"啊────……"},{"key":"SCENARIO_s10_32000800_01_0029","text":"女学生的朋友"},{"key":"SCENARIO_s10_32000800_01_0030","text":"你怕什么呀，都走到这儿了\n来，鼓起勇气冲上去呀！"},{"key":"SCENARIO_s10_32000800_01_0039","text":"女学生"},{"key":"SCENARIO_s10_32000800_01_0040","text":"但是……"},{"key":"SCENARIO_s10_32000800_01_0050","text":"哦——要冲过来吗？"},{"key":"SCENARIO_s10_32000800_01_0060","text":"好啊，欢迎光临"},{"key":"SCENARIO_s10_32000800_01_0070","text":"啊，那个……"},{"key":"SCENARIO_s10_32000800_01_0075","text":"Motion"},{"key":"SCENARIO_s10_32000800_01_0080","text":"“我在校门口等你”"},{"key":"SCENARIO_s10_32000800_01_0090","text":"对不起，果然还是失礼了────！"},{"key":"SCENARIO_s10_32000800_01_0095","text":"Motion"},{"key":"SCENARIO_s10_32000800_01_0100","text":"辛苦了，透"},{"key":"SCENARIO_s10_32000800_01_0110","text":"哟——\n辛苦了——"},{"key":"SCENARIO_s10_32000800_01_0120","text":"在和朋友说话吗？\n抱歉让你久等了……"},{"key":"SCENARIO_s10_32000800_01_0130","text":"诶\n啊，没有"},{"key":"SCENARIO_s10_32000800_01_0140","text":"说是要来撞我，好像"},{"key":"SCENARIO_s10_32000800_01_0150","text":"来撞你……？\n是遇到什么麻烦了吗？"},{"key":"SCENARIO_s10_32000800_01_0160","text":"没有\n只是被搭话了"},{"key":"SCENARIO_s10_32000800_01_0170","text":"是吗？\n没什么事就好……"},{"key":"SCENARIO_s10_32000800_01_0180","text":"那先这样\n我去开车，你上来吧"},{"key":"SCENARIO_s10_32000800_01_0190","text":"是——"}]
