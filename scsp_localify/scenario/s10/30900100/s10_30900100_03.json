[{"key":"SCENARIO_s10_30900100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_30900100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_30900100_03_0010","text":"哇……"},{"key":"SCENARIO_s10_30900100_03_0020","text":"好厉害！\n是我从没穿过的感觉！"},{"key":"SCENARIO_s10_30900100_03_0030","text":"哦，是啊\n跟平时的感觉不太一样吧"},{"key":"SCENARIO_s10_30900100_03_0031","text":"Motion"},{"key":"SCENARIO_s10_30900100_03_0040","text":"嗯！\n这个我在正义Ⅴ里见过！"},{"key":"SCENARIO_s10_30900100_03_0050","text":"是吗\n我倒是没想过正义Ⅴ里会穿这个，是谁穿的？"},{"key":"SCENARIO_s10_30900100_03_0060","text":"是大家一起！\n穿着这样的衣服，大家一起帅气地战斗了！"},{"key":"SCENARIO_s10_30900100_03_0070","text":"战斗了吗……！？\n是说没有变身就战斗了吧……好厉害！"},{"key":"SCENARIO_s10_30900100_03_0080","text":"不过，确实看起来很好活动……对吧？"},{"key":"SCENARIO_s10_30900100_03_0081","text":"Motion"},{"key":"SCENARIO_s10_30900100_03_0090","text":"嗯！\n超级好活动！"},{"key":"SCENARIO_s10_30900100_03_0100","text":"我也能帅气地战斗了！"}]
