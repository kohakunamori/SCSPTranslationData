[{"key":"SCENARIO_s10_30900100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_30900100_01_0010","text":"早上好"},{"key":"SCENARIO_s10_30900100_01_0020","text":"……哦"},{"key":"SCENARIO_s10_30900100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_30900100_01_0030","text":"果穗，早上好\n今天来得真早啊"},{"key":"SCENARIO_s10_30900100_01_0040","text":"制作人！早上好！\n学校提前放学了，所以我就来了……！"},{"key":"SCENARIO_s10_30900100_01_0050","text":"这样啊……\n那果穗，能帮我一个忙吗？"},{"key":"SCENARIO_s10_30900100_01_0060","text":"……？\n什么事……？"},{"key":"SCENARIO_s10_30900100_01_0061","text":"Motion"},{"key":"SCENARIO_s10_30900100_01_0070","text":"干洗好的服装送到了\n能帮我一起收起来吗？"},{"key":"SCENARIO_s10_30900100_01_0080","text":"好的，我来帮忙！\n交给我吧！"},{"key":"SCENARIO_s10_30900100_01_0090","text":"谢谢\n那，过来这边一下"},{"key":"SCENARIO_s10_30900100_01_0100","text":"好的！"}]
