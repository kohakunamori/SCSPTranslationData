[{"key":"SCENARIO_s10_20901300_02_0001","text":"Motion"},{"key":"SCENARIO_s10_20901300_02_0010","text":"很合身哦，果穗！"},{"key":"SCENARIO_s10_20901300_02_0020","text":"谢谢你！\n好开心！"},{"key":"SCENARIO_s10_20901300_02_0030","text":"实际穿上感觉怎么样？"},{"key":"SCENARIO_s10_20901300_02_0031","text":"Motion"},{"key":"SCENARIO_s10_20901300_02_0040","text":"穿上之后……\n嗯，不只是漂亮——"},{"key":"SCENARIO_s10_20901300_02_0050","text":"感觉像游乐园一样！"},{"key":"SCENARIO_s10_20901300_02_0060","text":"游乐园吗……！"},{"key":"SCENARIO_s10_20901300_02_0061","text":"Motion"},{"key":"SCENARIO_s10_20901300_02_0070","text":"是的！\n各种颜色和花纹让人好兴奋！"},{"key":"SCENARIO_s10_20901300_02_0080","text":"原来如此，这么一想\n确实像游乐园呢……！"},{"key":"SCENARIO_s10_20901300_02_0090","text":"果穗感受到的那种兴奋感，\n希望能传达给粉丝们呢"},{"key":"SCENARIO_s10_20901300_02_0100","text":"嘿嘿，好的！\n我会努力传达出去的！"}]
