[{"key":"SCENARIO_s10_20901300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20901300_01_0005","text":"Motion"},{"key":"SCENARIO_s10_20901300_01_0010","text":"……！\n好厉害——！"},{"key":"SCENARIO_s10_20901300_01_0020","text":"有好多颜色，\n好漂亮，那个，那个……！"},{"key":"SCENARIO_s10_20901300_01_0030","text":"总之就是……好厉害！！"},{"key":"SCENARIO_s10_20901300_01_0031","text":"Motion"},{"key":"SCENARIO_s10_20901300_01_0040","text":"哈哈，嗯\n确实很厉害呢"},{"key":"SCENARIO_s10_20901300_01_0050","text":"我也觉得，该怎么形容才好呢，\n用我的词汇量很难表达"},{"key":"SCENARIO_s10_20901300_01_0060","text":"但就是“好厉害”啊！"},{"key":"SCENARIO_s10_20901300_01_0070","text":"好的！"},{"key":"SCENARIO_s10_20901300_01_0080","text":"“厉害”这个词，好难……但是——"},{"key":"SCENARIO_s10_20901300_01_0081","text":"Motion"},{"key":"SCENARIO_s10_20901300_01_0090","text":"总觉得，很有２８３事务所的感觉！\n好想快点穿上试试！"},{"key":"SCENARIO_s10_20901300_01_0100","text":"哈哈，好！\n我也很期待看到果穗穿上它的样子"},{"key":"SCENARIO_s10_20901300_01_0101","text":"Motion"}]
