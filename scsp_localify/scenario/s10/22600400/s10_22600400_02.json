[{"key":"SCENARIO_s10_22600400_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22600400_02_0010","text":"────────……"},{"key":"SCENARIO_s10_22600400_02_0020","text":"快到正式演出了吧"},{"key":"SCENARIO_s10_22600400_02_0030","text":"…………"},{"key":"SCENARIO_s10_22600400_02_0031","text":"舞蹈教练"},{"key":"SCENARIO_s10_22600400_02_0040","text":"这次没能保证充足的练习时间……"},{"key":"SCENARIO_s10_22600400_02_0050","text":"能不能做到完美的表演，\n也要看当天的状态……"},{"key":"SCENARIO_s10_22600400_02_0060","text":"不过，我觉得已经练得很好了……！"},{"key":"SCENARIO_s10_22600400_02_0070","text":"不要太勉强\n能做到什么程度就做到什么程度，这样就够了"},{"key":"SCENARIO_s10_22600400_02_0080","text":"吵死了……"},{"key":"SCENARIO_s10_22600400_02_0090","text":"……路加……\n为什么要选难度高的那个……？"},{"key":"SCENARIO_s10_22600400_02_0100","text":"难…………\n────────……那又怎样"}]
