[{"key":"SCENARIO_s10_22500500_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22500500_03_0010","text":"…………"},{"key":"SCENARIO_s10_22500500_03_0011","text":"女性１"},{"key":"SCENARIO_s10_22500500_03_0020","text":"啊，绯田美琴！"},{"key":"SCENARIO_s10_22500500_03_0030","text":"……诶？"},{"key":"SCENARIO_s10_22500500_03_0041","text":"女性２"},{"key":"SCENARIO_s10_22500500_03_0040","text":"那个MV超帅的诶。这是你最近迷上的SHHis的？"},{"key":"SCENARIO_s10_22500500_03_0051","text":"女性１"},{"key":"SCENARIO_s10_22500500_03_0050","text":"对对！　哈——新曲的MV也太绝了吧！\n我真的超爱的！"},{"key":"SCENARIO_s10_22500500_03_0061","text":"女性２"},{"key":"SCENARIO_s10_22500500_03_0060","text":"你真是迷得不轻呢。\n要是真那么好，我也听听看吧。"},{"key":"SCENARIO_s10_22500500_03_0070","text":"…………"},{"key":"SCENARIO_s10_22500500_03_0080","text":"抱歉！聊得太久了！\n让你久等了？"},{"key":"SCENARIO_s10_22500500_03_0090","text":"不用的，我没事"},{"key":"SCENARIO_s10_22500500_03_0100","text":"走吧，制作人。"}]
