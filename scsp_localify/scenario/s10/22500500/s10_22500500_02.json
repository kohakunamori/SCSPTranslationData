[{"key":"SCENARIO_s10_22500500_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22500500_02_0010","text":"…………"},{"key":"SCENARIO_s10_22500500_02_0020","text":"美琴，差不多要开始了，准备——哦。"},{"key":"SCENARIO_s10_22500500_02_0030","text":"原来你在看剧本。"},{"key":"SCENARIO_s10_22500500_02_0040","text":"嗯。\n想在拍摄之前再确认一遍流程。"},{"key":"SCENARIO_s10_22500500_02_0050","text":"哈哈，真不愧是冬优子"},{"key":"SCENARIO_s10_22500500_02_0060","text":"因为要做到完美嘛。"},{"key":"SCENARIO_s10_22500500_02_0070","text":"……拍摄，快开始了吗？"},{"key":"SCENARIO_s10_22500500_02_0080","text":"啊，对！"},{"key":"SCENARIO_s10_22500500_02_0090","text":"可以走了吗？"},{"key":"SCENARIO_s10_22500500_02_0100","text":"嗯，没问题。\n随时都可以出发。"}]
