[{"key":"SCENARIO_s10_12000100_02_0001","text":"Motion"},{"key":"SCENARIO_s10_12000100_02_0009","text":"舞蹈讲师"},{"key":"SCENARIO_s10_12000100_02_0010","text":"────好——\n那么，今天就到这里"},{"key":"SCENARIO_s10_12000100_02_0020","text":"穿着这套衣服跳舞，慢慢习惯起来吧"},{"key":"SCENARIO_s10_12000100_02_0030","text":"好——"},{"key":"SCENARIO_s10_12000100_02_0040","text":"辛苦了，透\n做得不错"},{"key":"SCENARIO_s10_12000100_02_0050","text":"衣服，待会儿交给叶月\n让她帮忙打理一下"},{"key":"SCENARIO_s10_12000100_02_0060","text":"好嘞～\n……啊"},{"key":"SCENARIO_s10_12000100_02_0070","text":"可以带回去吗？今天\n这个"},{"key":"SCENARIO_s10_12000100_02_0080","text":"诶？\n……嗯，也不是不行────"},{"key":"SCENARIO_s10_12000100_02_0090","text":"想看看呢\n妈妈说"},{"key":"SCENARIO_s10_12000100_02_0100","text":"对吧"}]
