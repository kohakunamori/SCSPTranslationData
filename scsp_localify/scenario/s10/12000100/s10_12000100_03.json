[{"key":"SCENARIO_s10_12000100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_12000100_03_0011","text":"Motion"},{"key":"SCENARIO_s10_12000100_03_0010","text":"……啊"},{"key":"SCENARIO_s10_12000100_03_0020","text":"……诶？"},{"key":"SCENARIO_s10_12000100_03_0030","text":"啊……\n那个……"},{"key":"SCENARIO_s10_12000100_03_0040","text":"是什么呢\n好像……忘了什么────"},{"key":"SCENARIO_s10_12000100_03_0050","text":"感觉快想起来了\n一看到Producer的脸"},{"key":"SCENARIO_s10_12000100_03_0060","text":"……是、是吗\n加油……！"},{"key":"SCENARIO_s10_12000100_03_0070","text":"嗯\n那个…………啊"},{"key":"SCENARIO_s10_12000100_03_0080","text":"想起来了\n衣服，忘带了。在家里"},{"key":"SCENARIO_s10_12000100_03_0090","text":"……\n去拿吧。我陪你"},{"key":"SCENARIO_s10_12000100_03_0091","text":"Motion"},{"key":"SCENARIO_s10_12000100_03_0100","text":"嗯。呵呵\n因为是很重要的东西嘛"}]
