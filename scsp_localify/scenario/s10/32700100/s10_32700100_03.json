[{"key":"SCENARIO_s10_32700100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32700100_03_0010","text":"──啊，制作人你看──！"},{"key":"SCENARIO_s10_32700100_03_0020","text":"外面下雪了哦～"},{"key":"SCENARIO_s10_32700100_03_0030","text":"好漂亮\n好美……！"},{"key":"SCENARIO_s10_32700100_03_0040","text":"哦……真的\n真少见啊"},{"key":"SCENARIO_s10_32700100_03_0050","text":"呵呵，拍张照留念吧"},{"key":"SCENARIO_s10_32700100_03_0060","text":"……雪，能拍得清楚吗？"},{"key":"SCENARIO_s10_32700100_03_0061","text":"Motion"},{"key":"SCENARIO_s10_32700100_03_0070","text":"嗯……\n还行吧？"},{"key":"SCENARIO_s10_32700100_03_0080","text":"难得的机会，\n要不要稍微出去走走……！"},{"key":"SCENARIO_s10_32700100_03_0090","text":"诶，可以吗？\n太好了！"},{"key":"SCENARIO_s10_32700100_03_0100","text":"……说不定，\n能做点有圣诞气氛的事呢——！"},{"key":"SCENARIO_s10_32700100_030101","text":"Motion"}]
