[{"key":"SCENARIO_s10_12100100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0000","text":"电视的声音\n "},{"key":"SCENARIO_s10_12100100_01_0010","text":"『哇哈哈，什么鬼啊────！』"},{"key":"SCENARIO_s10_12100100_01_0020","text":"『────以上，爆笑小品环节……』"},{"key":"SCENARIO_s10_12100100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0030","text":"『────这边的蔬菜是今天早上刚采摘的……』"},{"key":"SCENARIO_s10_12100100_01_0040","text":"『────由以下赞助商提供播出……』"},{"key":"SCENARIO_s10_12100100_01_0041","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0050","text":"『────这次是偶像团体大特辑……！』"},{"key":"SCENARIO_s10_12100100_01_0051","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0060","text":"『从网上热议的歌曲，到备受关注的新曲』\n『闪耀偶像们的魅力全部────』"},{"key":"SCENARIO_s10_12100100_01_0061","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0070","text":"哦，圆香……\n你来了啊"},{"key":"SCENARIO_s10_12100100_01_0080","text":"……不，已经到练习时间了"},{"key":"SCENARIO_s10_12100100_01_0081","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0082","text":"Motion"},{"key":"SCENARIO_s10_12100100_01_0090","text":"我出发了"},{"key":"SCENARIO_s10_12100100_01_0100","text":"啊，啊啊……\n那你慢走……！"}]
