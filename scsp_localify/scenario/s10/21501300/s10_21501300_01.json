[{"key":"SCENARIO_s10_21501300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21501300_01_0010","text":"………………"},{"key":"SCENARIO_s10_21501300_01_0020","text":"甜花，怎么了？\n身体不舒服吗……？"},{"key":"SCENARIO_s10_21501300_01_0030","text":"诶……"},{"key":"SCENARIO_s10_21501300_01_0040","text":"刚才你在哼哼吧？"},{"key":"SCENARIO_s10_21501300_01_0050","text":"啊，那个……\n是形象训练……"},{"key":"SCENARIO_s10_21501300_01_0060","text":"诶？"},{"key":"SCENARIO_s10_21501300_01_0070","text":"在脑子里，练习舞蹈……\n不用动身体……可以练好多次……！"},{"key":"SCENARIO_s10_21501300_01_0080","text":"哈哈……！\n原来如此，是这样啊"},{"key":"SCENARIO_s10_21501300_01_0090","text":"嗯，甜花也在各方面努力着呢"},{"key":"SCENARIO_s10_21501300_01_0100","text":"嘿嘿……\n这样的话……今天的练习，完美……！"}]
