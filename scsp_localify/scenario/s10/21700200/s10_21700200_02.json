[{"key":"SCENARIO_s10_21700200_02_0001","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0002","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0010","text":"……这个姿势，要保持好久\n好累哦～"},{"key":"SCENARIO_s10_21700200_02_0000","text":"摄影师"},{"key":"SCENARIO_s10_21700200_02_0020","text":"抱歉啦，朝日酱\n太帅了所以忍不住多拍了好多"},{"key":"SCENARIO_s10_21700200_02_0021","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0030","text":"这样摆怎么样？"},{"key":"SCENARIO_s10_21700200_02_0040","text":"不错！\n那边也拍几张哦～"},{"key":"SCENARIO_s10_21700200_02_0041","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0050","text":"辛苦了，朝日\n干得很棒"},{"key":"SCENARIO_s10_21700200_02_0060","text":"制作人你说过的啊\n演唱会需要今天拍的每一张照片"},{"key":"SCENARIO_s10_21700200_02_0061","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0070","text":"……！啊，今天拍的视觉图\n会在各种地方用来做宣传"},{"key":"SCENARIO_s10_21700200_02_0080","text":"让大家对演唱会越来越期待——\n从这个意义上来说非常重要"},{"key":"SCENARIO_s10_21700200_02_0081","text":"Motion"},{"key":"SCENARIO_s10_21700200_02_0090","text":"会……越来越期待吗？"},{"key":"SCENARIO_s10_21700200_02_0100","text":"嗯嗯、当然了"}]
