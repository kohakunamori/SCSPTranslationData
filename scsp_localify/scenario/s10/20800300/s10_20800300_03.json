[{"key":"SCENARIO_s10_20800300_03_0001","text":"Motion"},{"key":"SCENARIO_s10_20800300_03_0010","text":"哇……"},{"key":"SCENARIO_s10_20800300_03_0020","text":"呀……"},{"key":"SCENARIO_s10_20800300_03_0030","text":"——抱歉，吓到你了。\n在草地上脚滑了一下……"},{"key":"SCENARIO_s10_20800300_03_0031","text":"Motion"},{"key":"SCENARIO_s10_20800300_03_0040","text":"您没事吧……？\n制作人……"},{"key":"SCENARIO_s10_20800300_03_0050","text":"请……把手给我……"},{"key":"SCENARIO_s10_20800300_03_0060","text":"不不，这点小事我自己……"},{"key":"SCENARIO_s10_20800300_03_0070","text":"但是……"},{"key":"SCENARIO_s10_20800300_03_0080","text":"制作人……总是……\n会向我……伸出手……"},{"key":"SCENARIO_s10_20800300_03_0081","text":"Motion"},{"key":"SCENARIO_s10_20800300_03_0090","text":"这次……\n轮到我了……"},{"key":"SCENARIO_s10_20800300_03_0100","text":"哈哈……\n——那就，拜托你了吧。"},{"key":"SCENARIO_s10_20800300_03_0101","text":"Motion"}]
