[{"key":"SCENARIO_s10_22800300_02_0001","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0010","text":"────……"},{"key":"SCENARIO_s10_22800300_02_0020","text":"……阳希？"},{"key":"SCENARIO_s10_22800300_02_0030","text":"怎么了？\n是不是一下子觉得累了"},{"key":"SCENARIO_s10_22800300_02_0031","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0032","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0040","text":"呵呵～。对不起\n不是那样的……"},{"key":"SCENARIO_s10_22800300_02_0050","text":"我在回想舞台上的情景"},{"key":"SCENARIO_s10_22800300_02_0051","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0060","text":"明明刚才还在跟制作人说\n我不太擅长嘈杂的地方……"},{"key":"SCENARIO_s10_22800300_02_0070","text":"舞台上听到的那些声援\n却让我想一直沉浸其中……"},{"key":"SCENARIO_s10_22800300_02_0080","text":"————说到这个啊，阳希"},{"key":"SCENARIO_s10_22800300_02_0090","text":"作为制作人，对我来说\n那些献给阳希的呼声也是最棒的"},{"key":"SCENARIO_s10_22800300_02_0091","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0092","text":"Motion"},{"key":"SCENARIO_s10_22800300_02_0100","text":"这样啊……呵呵……\n那我就是双倍的开心了……！"}]
