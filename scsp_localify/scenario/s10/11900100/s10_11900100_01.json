[{"key":"SCENARIO_s10_11900100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_11900100_01_0010","text":"～～♪"},{"key":"SCENARIO_s10_11900100_01_0020","text":"心情这么好？\n怎么了？"},{"key":"SCENARIO_s10_11900100_01_0030","text":"怎么说呢～\n这个，叫“造形”？是这么说的吧？"},{"key":"SCENARIO_s10_11900100_01_0040","text":"超有艺人范儿的不觉得吗？"},{"key":"SCENARIO_s10_11900100_01_0050","text":"哈哈，原来是因为这个高兴啊"},{"key":"SCENARIO_s10_11900100_01_0060","text":"真的兴奋到不行～"},{"key":"SCENARIO_s10_11900100_01_0070","text":"这种程度的话\n随时都可以跟我说"},{"key":"SCENARIO_s10_11900100_01_0080","text":"好了，到了哦\n是试装的摄影棚"},{"key":"SCENARIO_s10_11900100_01_0090","text":"好嘞！"},{"key":"SCENARIO_s10_11900100_01_0100","text":"啊，话说回来\n试装什么的，也超有那种感觉的对吧～♪"}]
