[{"key":"SCENARIO_s10_22400100_02_0010","text":"１、２、３、４、\n５、６、７……"},{"key":"SCENARIO_s10_22400100_02_0020","text":"…………哈啊…………\n还、还不够…………这种程度……还不够……！"},{"key":"SCENARIO_s10_22400100_02_0021","text":"Motion"},{"key":"SCENARIO_s10_22400100_02_0030","text":"这、这样啊……\n…………唔"},{"key":"SCENARIO_s10_22400100_02_0040","text":"１、２、３、４、\n５、６、７────"},{"key":"SCENARIO_s10_22400100_02_0041","text":"Motion"},{"key":"SCENARIO_s10_22400100_02_0050","text":"日花，没事吧！？"},{"key":"SCENARIO_s10_22400100_02_0060","text":"……好痛……\n────啊……制作人"},{"key":"SCENARIO_s10_22400100_02_0070","text":"嗯\n……很努力嘛"},{"key":"SCENARIO_s10_22400100_02_0080","text":"比起这个，没受伤吧？\n不要太勉强自己──"},{"key":"SCENARIO_s10_22400100_02_0090","text":"一点都不勉强啊这种……这种…………！"},{"key":"SCENARIO_s10_22400100_02_0100","text":"…………练不好就穿那套衣服上台\n那才叫真的勉强呢"}]
