[{"key":"SCENARIO_s10_21000200_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21000200_01_0002","text":"Motion"},{"key":"SCENARIO_s10_21000200_01_0010","text":"制作人对不起……！\n到之前我可以先做一下作业吗……！"},{"key":"SCENARIO_s10_21000200_01_0020","text":"明天上课可能会被点名……！"},{"key":"SCENARIO_s10_21000200_01_0030","text":"嗯，当然可以"},{"key":"SCENARIO_s10_21000200_01_0040","text":"非常感谢"},{"key":"SCENARIO_s10_21000200_01_0041","text":"Motion"},{"key":"SCENARIO_s10_21000200_01_0050","text":"是什么科目？"},{"key":"SCENARIO_s10_21000200_01_0060","text":"英语\n老师虽然总是笑眯眯的，但提问起来毫不留情……"},{"key":"SCENARIO_s10_21000200_01_0070","text":"哈哈……好可怕啊……\n不过点名顺序容易预测这点倒是挺温柔的"},{"key":"SCENARIO_s10_21000200_01_0080","text":"确实是这样！"},{"key":"SCENARIO_s10_21000200_01_0081","text":"Motion"},{"key":"SCENARIO_s10_21000200_01_0090","text":"总之，加油啊！"},{"key":"SCENARIO_s10_21000200_01_0100","text":"好的！"},{"key":"SCENARIO_s10_21000200_01_0101","text":"Motion"}]
