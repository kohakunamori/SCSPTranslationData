[{"key":"SCENARIO_s10_31700200_02_0001","text":"Motion"},{"key":"SCENARIO_s10_31700200_02_0009","text":"共演者"},{"key":"SCENARIO_s10_31700200_02_0010","text":"哇……好可爱……！\n那件衣服难道是定制的？"},{"key":"SCENARIO_s10_31700200_02_0020","text":"嗯？\n是制作人给我做的"},{"key":"SCENARIO_s10_31700200_02_0030","text":"不不，与其说是我\n不如说是服装师非常用心"},{"key":"SCENARIO_s10_31700200_02_0040","text":"连背面都很讲究……\n朝日，你也看看背面吧"},{"key":"SCENARIO_s10_31700200_02_0041","text":"Motion"},{"key":"SCENARIO_s10_31700200_02_0050","text":"嗯，是这样吗"},{"key":"SCENARIO_s10_31700200_02_0060","text":"哇，真的耶！好厉害好厉害！\n──脚上也能让我看看吗！？"},{"key":"SCENARIO_s10_31700200_02_0061","text":"Motion"},{"key":"SCENARIO_s10_31700200_02_0070","text":"……脚吗？"},{"key":"SCENARIO_s10_31700200_02_0080","text":"哈哈……！\n请务必也从侧面看看"},{"key":"SCENARIO_s10_31700200_02_0081","text":"Motion"},{"key":"SCENARIO_s10_31700200_02_0090","text":"侧、侧面……！"},{"key":"SCENARIO_s10_31700200_02_0100","text":"我、我很忙的～！"}]
