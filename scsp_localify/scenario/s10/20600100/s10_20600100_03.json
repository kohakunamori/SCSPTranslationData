[{"key":"SCENARIO_s10_20600100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_20600100_03_0010","text":"哈……哈……"},{"key":"SCENARIO_s10_20600100_03_0020","text":"辛苦了，你还在啊"},{"key":"SCENARIO_s10_20600100_03_0030","text":"制作人\n嗯……我正打算差不多该收工了"},{"key":"SCENARIO_s10_20600100_03_0040","text":"是吗……别太勉强自己啊？\n来，补充点水分"},{"key":"SCENARIO_s10_20600100_03_0050","text":"谢谢……！\n让你费心了"},{"key":"SCENARIO_s10_20600100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_20600100_03_0060","text":"呼……\n──……即使是这样独自练习的时候"},{"key":"SCENARIO_s10_20600100_03_0070","text":"大家的努力身影也会浮现在脑海里\n感觉就像涌出了力量一样"},{"key":"SCENARIO_s10_20600100_03_0080","text":"大家一定也是一样的吧\n各自都在各自的岗位上努力着"},{"key":"SCENARIO_s10_20600100_03_0090","text":"呵呵，那毫无疑问\n嗯，事先说明一下──"},{"key":"SCENARIO_s10_20600100_03_0100","text":"“大家”里面也包括你哦\n谢谢你，制作人"}]
