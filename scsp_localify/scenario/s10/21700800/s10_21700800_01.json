[{"key":"SCENARIO_s10_21700800_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21700800_01_0001","text":"店员"},{"key":"SCENARIO_s10_21700800_01_0010","text":"让您久等了\n浓味玉米浓汤的客人……"},{"key":"SCENARIO_s10_21700800_01_0020","text":"啊，好的"},{"key":"SCENARIO_s10_21700800_01_0030","text":"咖啡请放到这边"},{"key":"SCENARIO_s10_21700800_01_0031","text":"新闻网站"},{"key":"SCENARIO_s10_21700800_01_0040","text":"『头条────惠梨，陷入泥沼的展开』\n『────的疑云，呈现互相泼脏水的态势』…………"},{"key":"SCENARIO_s10_21700800_01_0050","text":"『────陷入泥沼化的不当────』\n『三角关系的尽头────』"},{"key":"SCENARIO_s10_21700800_01_0060","text":"────真是黏糊糊的呢"},{"key":"SCENARIO_s10_21700800_01_0070","text":"诶？"},{"key":"SCENARIO_s10_21700800_01_0080","text":"玉米汤……黏糊糊的……"},{"key":"SCENARIO_s10_21700800_01_0090","text":"啊，是说玉米汤啊……\n新闻里也全是些黏糊糊的话题嘛────"},{"key":"SCENARIO_s10_21700800_01_0100","text":"…………？"}]
