[{"key":"SCENARIO_s10_32000300_02_0000","text":"Motion"},{"key":"SCENARIO_s10_32000300_02_0010","text":"喂—，你会来吗？\n那天"},{"key":"SCENARIO_s10_32000300_02_0020","text":"制作人也"},{"key":"SCENARIO_s10_32000300_02_0030","text":"嗯，泳池拍摄那天吗？\n当然，我打算去"},{"key":"SCENARIO_s10_32000300_02_0040","text":"呵呵，这样啊"},{"key":"SCENARIO_s10_32000300_02_0050","text":"先说好，这是工作哦"},{"key":"SCENARIO_s10_32000300_02_0060","text":"不知道有没有休息时间\n也不一定能玩哦"},{"key":"SCENARIO_s10_32000300_02_0070","text":"──如果有呢？"},{"key":"SCENARIO_s10_32000300_02_0080","text":"诶？"},{"key":"SCENARIO_s10_32000300_02_0090","text":"休息时间"},{"key":"SCENARIO_s10_32000300_02_0100","text":"陪我玩嘛，一起"}]
