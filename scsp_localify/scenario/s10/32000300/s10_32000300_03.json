[{"key":"SCENARIO_s10_32000300_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32000300_03_0001","text":"导演"},{"key":"SCENARIO_s10_32000300_03_0010","text":"那么，浅仓小姐\n请自由活动一下"},{"key":"SCENARIO_s10_32000300_03_0011","text":"Motion"},{"key":"SCENARIO_s10_32000300_03_0020","text":"──预备，开始！"},{"key":"SCENARIO_s10_32000300_03_0030","text":"……！\n摄影跟上！跑起来！"},{"key":"SCENARIO_s10_32000300_03_0040","text":"（──哈哈\n　透，玩得很开心啊）"},{"key":"SCENARIO_s10_32000300_03_0050","text":"今天辛苦啦——"},{"key":"SCENARIO_s10_32000300_03_0060","text":"透，辛苦了\n可以去换衣服了"},{"key":"SCENARIO_s10_32000300_03_0070","text":"……\n不是说了要陪我玩的吗"},{"key":"SCENARIO_s10_32000300_03_0080","text":"只是互相泼水而已"},{"key":"SCENARIO_s10_32000300_03_0090","text":"哈哈……我还穿着西装呢\n──只能玩一会儿哦"},{"key":"SCENARIO_s10_32000300_03_0091","text":"Motion"},{"key":"SCENARIO_s10_32000300_03_0100","text":"啊哈哈"}]
