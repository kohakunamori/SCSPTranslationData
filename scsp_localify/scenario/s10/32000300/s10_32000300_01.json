[{"key":"SCENARIO_s10_32000300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_32000300_01_0010","text":"泳装啊—"},{"key":"SCENARIO_s10_32000300_01_0020","text":"泳装的衣服，不喜欢吗？"},{"key":"SCENARIO_s10_32000300_01_0030","text":"嗯？\n啊—，不是"},{"key":"SCENARIO_s10_32000300_01_0040","text":"正好合适"},{"key":"SCENARIO_s10_32000300_01_0050","text":"因为会变热嘛，演唱会"},{"key":"SCENARIO_s10_32000300_01_0060","text":"哈哈，确实"},{"key":"SCENARIO_s10_32000300_01_0070","text":"然后，作为演唱会的演出环节\n决定要拍摄一段投放在舞台大屏幕上的影像"},{"key":"SCENARIO_s10_32000300_01_0080","text":"嘿——"},{"key":"SCENARIO_s10_32000300_01_0090","text":"拍摄是下周\n计划是让你穿上泳装，在泳池边拍摄"},{"key":"SCENARIO_s10_32000300_01_0100","text":"好喔——"}]
