[{"key":"SCENARIO_s10_22400600_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22400600_03_0010","text":"…………"},{"key":"SCENARIO_s10_22400600_03_0020","text":"日花"},{"key":"SCENARIO_s10_22400600_03_0030","text":"──────……哈？\n诶……话说回来，你怎么会在这儿……？"},{"key":"SCENARIO_s10_22400600_03_0040","text":"啊，那个……\n我不是想打扰你的"},{"key":"SCENARIO_s10_22400600_03_0050","text":"练习室，如果你想用的话\n跟我说一声的话……"},{"key":"SCENARIO_s10_22400600_03_0060","text":"…………\n我问的是你怎么会在这里——"},{"key":"SCENARIO_s10_22400600_03_0070","text":"啊，不是……\n就是感觉，你会在"},{"key":"SCENARIO_s10_22400600_03_0080","text":"啊——……楼下能听到啊\n吵到你们了不好意思……"},{"key":"SCENARIO_s10_22400600_03_0090","text":"诶？\n不，没有吵到……"},{"key":"SCENARIO_s10_22400600_03_0100","text":"……\n想用的时候，跟我说一声"},{"key":"SCENARIO_s10_22400600_03_0101","text":"Motion"}]
