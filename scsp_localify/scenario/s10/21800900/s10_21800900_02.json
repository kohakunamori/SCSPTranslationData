[{"key":"SCENARIO_s10_21800900_02_0000","text":"Motion"},{"key":"SCENARIO_s10_21800900_02_0010","text":"辛苦了！"},{"key":"SCENARIO_s10_21800900_02_0020","text":"辛苦了——"},{"key":"SCENARIO_s10_21800900_02_0030","text":"今天请多关照♡"},{"key":"SCENARIO_s10_21800900_02_0040","text":"啊，好的……！\n请多关照"},{"key":"SCENARIO_s10_21800900_02_0050","text":"啊，冬优子\n辛苦了"},{"key":"SCENARIO_s10_21800900_02_0060","text":"……\n辛苦了！"},{"key":"SCENARIO_s10_21800900_02_0070","text":"哈哈，果然厉害\n冬优子就是不一样"},{"key":"SCENARIO_s10_21800900_02_0080","text":"诶——，什么事呀？"},{"key":"SCENARIO_s10_21800900_02_0090","text":"啊，不\n我是说你对待工作人员的态度很周到"},{"key":"SCENARIO_s10_21800900_02_0100","text":"呵呵，真是奇怪的制作人\n这不是很普通的事吗？"}]
