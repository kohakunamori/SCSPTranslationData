[{"key":"SCENARIO_s10_32200100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_32200100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_32200100_01_0010","text":"小糸——可以进来吗？"},{"key":"SCENARIO_s10_32200100_01_0020","text":"啊，好，好的……！请进……！"},{"key":"SCENARIO_s10_32200100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_32200100_01_0030","text":"哦，很合适嘛"},{"key":"SCENARIO_s10_32200100_01_0040","text":"非，非常感谢……！"},{"key":"SCENARIO_s10_32200100_01_0050","text":"希望今天的拍摄也能顺利"},{"key":"SCENARIO_s10_32200100_01_0060","text":"是，是的……是啊……！"},{"key":"SCENARIO_s10_32200100_01_0070","text":"啊，对了\n饿不饿？我买了点吃的……"},{"key":"SCENARIO_s10_32200100_01_0071","text":"Motion"},{"key":"SCENARIO_s10_32200100_01_0080","text":"…………！\n……啊，不，不过……现在先不吃了"},{"key":"SCENARIO_s10_32200100_01_0090","text":"也是\n弄脏了衣服就麻烦了"},{"key":"SCENARIO_s10_32200100_01_0100","text":"也，也有那个原因……\n但要是吃饱了，感觉会犯困……"}]
