[{"key":"SCENARIO_s10_20500900_02_0000","text":"Motion"},{"key":"SCENARIO_s10_20500900_02_0001","text":"服装师"},{"key":"SCENARIO_s10_20500900_02_0010","text":"怎么样，摩美美酱？"},{"key":"SCENARIO_s10_20500900_02_0020","text":"是呢——……"},{"key":"SCENARIO_s10_20500900_02_0030","text":"腰部，再收紧一点\n可能比较好～"},{"key":"SCENARIO_s10_20500900_02_0031","text":"服装师"},{"key":"SCENARIO_s10_20500900_02_0040","text":"了解，调整一下腰带和尺寸\n其他没问题吧？"},{"key":"SCENARIO_s10_20500900_02_0050","text":"嗯～\n配饰也不会碍事～"},{"key":"SCENARIO_s10_20500900_02_0051","text":"服装师"},{"key":"SCENARIO_s10_20500900_02_0060","text":"OK\n摩美美酱说没问题那就肯定没问题"},{"key":"SCENARIO_s10_20500900_02_0070","text":"多谢了"},{"key":"SCENARIO_s10_20500900_02_0080","text":"（工作的时候倒是很靠谱嘛……）"},{"key":"SCENARIO_s10_20500900_02_0090","text":"怎么了？\n一直盯着我看～"},{"key":"SCENARIO_s10_20500900_02_0100","text":"没什么，觉得你穿得很合适……哈哈"}]
