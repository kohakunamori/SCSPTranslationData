[{"key":"SCENARIO_s10_32300100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32300100_03_0010","text":"…………"},{"key":"SCENARIO_s10_32300100_03_0020","text":"嗯？怎么了，雏菜"},{"key":"SCENARIO_s10_32300100_03_0030","text":"这个……\n超可爱的～"},{"key":"SCENARIO_s10_32300100_03_0040","text":"发簪吗？\n……啊，这家店是卖和风小物和和服的啊"},{"key":"SCENARIO_s10_32300100_03_0050","text":"呐，制作人\n我们进去看看～？"},{"key":"SCENARIO_s10_32300100_03_0060","text":"好啊\n之前不是说了要来看的嘛"},{"key":"SCENARIO_s10_32300100_03_0070","text":"制作人，你还记得呀～！"},{"key":"SCENARIO_s10_32300100_03_0080","text":"……啊，这个可能适合雏菜～"},{"key":"SCENARIO_s10_32300100_03_0090","text":"不错啊\n我觉得一定很适合你"},{"key":"SCENARIO_s10_32300100_03_0100","text":"啊哈～，那就选这个！\n好期待戴上它呀～"}]
