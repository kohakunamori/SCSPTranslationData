[{"key":"SCENARIO_s10_32700200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_32700200_01_0010","text":"——Peace"},{"key":"SCENARIO_s10_32700200_01_0020","text":"爱心"},{"key":"SCENARIO_s10_32700200_01_0030","text":"脸颊比姿势……"},{"key":"SCENARIO_s10_32700200_01_0040","text":"……唉\n还想要七个左右呢——"},{"key":"SCENARIO_s10_32700200_01_0001","text":"Motion"},{"key":"SCENARIO_s10_32700200_01_0050","text":"——羽那，\n你是在想拍摄活动用的姿势吗"},{"key":"SCENARIO_s10_32700200_01_0060","text":"嗯\n制作人有什么好的姿势点子吗？"},{"key":"SCENARIO_s10_32700200_01_0070","text":"嗯——\n让我想想啊……"},{"key":"SCENARIO_s10_32700200_01_0080","text":"双手高高举起——\n来个“高塔”姿势怎么样！？"},{"key":"SCENARIO_s10_32700200_01_0090","text":"啊哈，驳回"},{"key":"SCENARIO_s10_32700200_01_0100","text":"怎么这样……！"}]
