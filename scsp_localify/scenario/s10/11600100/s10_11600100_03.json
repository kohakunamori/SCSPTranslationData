[{"key":"SCENARIO_s10_11600100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_11600100_03_0010","text":"啊……"},{"key":"SCENARIO_s10_11600100_03_0020","text":"嗯？\n……啊，是CD店吗……？"},{"key":"SCENARIO_s10_11600100_03_0030","text":"嗯"},{"key":"SCENARIO_s10_11600100_03_0040","text":"贴了好多各种各样的海报呢"},{"key":"SCENARIO_s10_11600100_03_0050","text":"啊……\n以前你们是『看海报』的那一边吧……"},{"key":"SCENARIO_s10_11600100_03_0060","text":"呵呵，好的"},{"key":"SCENARIO_s10_11600100_03_0070","text":"我们也要努力，\n让海报也能被贴得到处都是——我一直在这么想"},{"key":"SCENARIO_s10_11600100_03_0080","text":"然后，总有一天……"},{"key":"SCENARIO_s10_11600100_03_0090","text":"希望能让２８３的所有人，\n穿着同款衣装的海报也被贴出来……"},{"key":"SCENARIO_s10_11600100_03_0100","text":"一起加油吧\n我当然也会努力的……！"}]
