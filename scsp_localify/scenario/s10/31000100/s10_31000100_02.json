[{"key":"SCENARIO_s10_31000100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_31000100_02_0001","text":"Motion"},{"key":"SCENARIO_s10_31000100_02_0002","text":"Motion"},{"key":"SCENARIO_s10_31000100_02_0003","text":"摄影师"},{"key":"SCENARIO_s10_31000100_02_0010","text":"──很好，妖精小姐！\n接下来视线看向这边！"},{"key":"SCENARIO_s10_31000100_02_0011","text":"Motion"},{"key":"SCENARIO_s10_31000100_02_0004","text":"摄影师"},{"key":"SCENARIO_s10_31000100_02_0020","text":"太棒了！\n那接下来再来个更有活力的妖精──"},{"key":"SCENARIO_s10_31000100_02_0021","text":"Motion"},{"key":"SCENARIO_s10_31000100_02_0030","text":"辛苦了\n午饭吃什么好呢，妖精小──"},{"key":"SCENARIO_s10_31000100_02_0040","text":"不不不好意思……！\n被摄影师先生传染了……！！"},{"key":"SCENARIO_s10_31000100_02_0050","text":"啊哈哈，没关系的！\n您确实一直在这么叫我嘛……！"},{"key":"SCENARIO_s10_31000100_02_0060","text":"妖精想吃冬天感觉的食物！"},{"key":"SCENARIO_s10_31000100_02_0070","text":"哈哈……！\n谢谢，那倒是……！"},{"key":"SCENARIO_s10_31000100_02_0080","text":"怎么样，砂锅乌冬面之类的……？"},{"key":"SCENARIO_s10_31000100_02_0090","text":"哇，赞成！"},{"key":"SCENARIO_s10_31000100_02_0100","text":"我可以查查这附近有什么店吗？\n找家好吃的店吧！"}]
