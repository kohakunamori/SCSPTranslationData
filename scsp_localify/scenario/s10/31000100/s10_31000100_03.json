[{"key":"SCENARIO_s10_31000100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_31000100_03_0010","text":"～～♪"},{"key":"SCENARIO_s10_31000100_03_0020","text":"我回来了──咦……？"},{"key":"SCENARIO_s10_31000100_03_0021","text":"Motion"},{"key":"SCENARIO_s10_31000100_03_0030","text":"──啊，智代子啊"},{"key":"SCENARIO_s10_31000100_03_0040","text":"辛苦了！"},{"key":"SCENARIO_s10_31000100_03_0050","text":"好香的味道啊"},{"key":"SCENARIO_s10_31000100_03_0060","text":"呵呵，是可可哦"},{"key":"SCENARIO_s10_31000100_03_0070","text":"制作人也要喝吗？\n马上就能泡好！"},{"key":"SCENARIO_s10_31000100_03_0080","text":"诶，那多不好──"},{"key":"SCENARIO_s10_31000100_03_0090","text":"请别客气！\n我可是负责冬天温暖心灵部分的妖精呢！"},{"key":"SCENARIO_s10_31000100_03_0100","text":"──哈哈\n那我就恭敬不如从命了……──！"},{"key":"SCENARIO_s10_31000100_03_0101","text":"Motion"}]
