[{"key":"SCENARIO_s10_32100400_02_0000","text":"Motion"},{"key":"SCENARIO_s10_32100400_02_0010","text":"USB接口的正反\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0020","text":"耳垂背后的凹陷\n不讨厌"},{"key":"SCENARIO_s10_32100400_02_0030","text":"翻过来的耳机套\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0040","text":"冲洗护发素的时间\n不讨厌"},{"key":"SCENARIO_s10_32100400_02_0001","text":"Motion"},{"key":"SCENARIO_s10_32100400_02_0050","text":"隧道里，被单一颜色染尽的世界\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0060","text":"被晚霞染红的天空\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0070","text":"被杂念染污的思绪\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0080","text":"被汗水浸透的衬衫\n讨厌"},{"key":"SCENARIO_s10_32100400_02_0002","text":"Motion"},{"key":"SCENARIO_s10_32100400_02_0090","text":"从舞台上看到的那一片赤红────…………"},{"key":"SCENARIO_s10_32100400_02_0100","text":"以上，是不会对任何人说的事"}]
