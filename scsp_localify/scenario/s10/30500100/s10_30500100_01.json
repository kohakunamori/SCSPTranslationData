[{"key":"SCENARIO_s10_30500100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_30500100_01_0010","text":"────"},{"key":"SCENARIO_s10_30500100_01_0020","text":"这么一件接一件地看，\n能分辨出哪件适合自己吗？"},{"key":"SCENARIO_s10_30500100_01_0030","text":"诶——\n一眼就能看出来啊"},{"key":"SCENARIO_s10_30500100_01_0040","text":"靠灵感\n啪地一下——"},{"key":"SCENARIO_s10_30500100_01_0050","text":"或许是那样吧～"},{"key":"SCENARIO_s10_30500100_01_0060","text":"要是可以的话，\n制作人的衣服我也帮你搭配哦——"},{"key":"SCENARIO_s10_30500100_01_0070","text":"诶？　是、是吗？\n那，要不也让摩美美帮我搭配一次————"},{"key":"SCENARIO_s10_30500100_01_0080","text":"制作人的话……"},{"key":"SCENARIO_s10_30500100_01_0090","text":"这种又放克又危险又超级花哨的\n我觉得挺合适的哦——"},{"key":"SCENARIO_s10_30500100_01_0100","text":"还、还是算了\n下次再说吧……哈哈哈"}]
