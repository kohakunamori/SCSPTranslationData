[{"key":"SCENARIO_s10_30900200_01_0001","text":"Motion"},{"key":"SCENARIO_s10_30900200_01_0010","text":"哇！\n小狗！"},{"key":"SCENARIO_s10_30900200_01_0020","text":"哦哦……！\n哈哈，真有精神啊"},{"key":"SCENARIO_s10_30900200_01_0030","text":"小狗，\n可以摸摸它吗……？"},{"key":"SCENARIO_s10_30900200_01_0031","text":"Motion"},{"key":"SCENARIO_s10_30900200_01_0040","text":"诶嘿嘿……"},{"key":"SCENARIO_s10_30900200_01_0050","text":"好亲近人啊！\n好可爱…………！"},{"key":"SCENARIO_s10_30900200_01_0060","text":"哇，被舔了"},{"key":"SCENARIO_s10_30900200_01_0070","text":"……是因为我手上沾了肉干的味道吗？"},{"key":"SCENARIO_s10_30900200_01_0080","text":"啊哈哈！"},{"key":"SCENARIO_s10_30900200_01_0081","text":"Motion"},{"key":"SCENARIO_s10_30900200_01_0090","text":"果穗，你真的很喜欢狗呢"},{"key":"SCENARIO_s10_30900200_01_0100","text":"嗯！\n最喜欢了！"}]
