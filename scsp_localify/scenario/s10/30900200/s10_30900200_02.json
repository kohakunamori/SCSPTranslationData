[{"key":"SCENARIO_s10_30900200_02_0001","text":"Motion"},{"key":"SCENARIO_s10_30900200_02_0010","text":"辛苦了，果穗"},{"key":"SCENARIO_s10_30900200_02_0020","text":"这个，是别人送的\n当点心吃吧"},{"key":"SCENARIO_s10_30900200_02_0021","text":"Motion"},{"key":"SCENARIO_s10_30900200_02_0030","text":"时间也刚好，\n一定要吃了再走"},{"key":"SCENARIO_s10_30900200_02_0040","text":"哇！谢谢您！"},{"key":"SCENARIO_s10_30900200_02_0050","text":"我开动了！"},{"key":"SCENARIO_s10_30900200_02_0060","text":"…………！"},{"key":"SCENARIO_s10_30900200_02_0061","text":"Motion"},{"key":"SCENARIO_s10_30900200_02_0070","text":"制作人！\n这个点心，好好吃！"},{"key":"SCENARIO_s10_30900200_02_0080","text":"哦，那太好了\n那我的那份也给果穗吧"},{"key":"SCENARIO_s10_30900200_02_0081","text":"Motion"},{"key":"SCENARIO_s10_30900200_02_0090","text":"可以吗！？\n太好了！谢谢您！"},{"key":"SCENARIO_s10_30900200_02_0100","text":"嘿嘿……！\n我——超级喜欢这个！"},{"key":"SCENARIO_s10_30900200_02_0101","text":"Motion"}]
