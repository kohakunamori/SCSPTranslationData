[{"key":"SCENARIO_s10_11800200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_11800200_02_0010","text":"冬优子，辛苦了"},{"key":"SCENARIO_s10_11800200_02_0020","text":"嗯，辛苦了"},{"key":"SCENARIO_s10_11800200_02_0030","text":"──今天的舞台上"},{"key":"SCENARIO_s10_11800200_02_0040","text":"？"},{"key":"SCENARIO_s10_11800200_02_0050","text":"我比任何人都更被冬优子吸引住了"},{"key":"SCENARIO_s10_11800200_02_0060","text":"……！"},{"key":"SCENARIO_s10_11800200_02_0070","text":"……哎呀\n这么简单就说出口可以吗？"},{"key":"SCENARIO_s10_11800200_02_0080","text":"我可没有随便说说"},{"key":"SCENARIO_s10_11800200_02_0090","text":"是吗"},{"key":"SCENARIO_s10_11800200_02_0100","text":"那，小冬也──\n今天的小冬就给你个MVP吧"}]
