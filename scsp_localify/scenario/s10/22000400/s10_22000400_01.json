[{"key":"SCENARIO_s10_22000400_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22000400_01_0001","text":"摄影师"},{"key":"SCENARIO_s10_22000400_01_0010","text":"嗯，很好\n那就在那里坐下试试吧"},{"key":"SCENARIO_s10_22000400_01_0020","text":"好的"},{"key":"SCENARIO_s10_22000400_01_0030","text":"听得见\n呼吸\n大楼的"},{"key":"SCENARIO_s10_22000400_01_0040","text":"呼吸\n大楼的"},{"key":"SCENARIO_s10_22000400_01_0050","text":"感觉要被吹走了"},{"key":"SCENARIO_s10_22000400_01_0060","text":"轻轻一蹬地面的话\n一下子就"},{"key":"SCENARIO_s10_22000400_01_0070","text":"（——总觉得，今天的透\n　好像随时都会飞到什么地方去……）"},{"key":"SCENARIO_s10_22000400_01_0080","text":"（可是，为什么呢……\n　与其说是不安，不如说我很想看看那个样子）"},{"key":"SCENARIO_s10_22000400_01_0090","text":"（该怎么表达才好呢……\n　透的这种，压倒性的美——）"},{"key":"SCENARIO_s10_22000400_01_0091","text":"Motion"},{"key":"SCENARIO_s10_22000400_01_0100","text":"OK！完美！"},{"key":"SCENARIO_s10_22000400_01_0101","text":"Motion"}]
