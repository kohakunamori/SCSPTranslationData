[{"key":"SCENARIO_s10_22000400_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22000400_03_0010","text":"该怎么说呢……\n能听到透活着的声响"},{"key":"SCENARIO_s10_22000400_03_0020","text":"活着的、声响……"},{"key":"SCENARIO_s10_22000400_03_0030","text":"这样啊"},{"key":"SCENARIO_s10_22000400_03_0040","text":"有的哦，确实有\n声响"},{"key":"SCENARIO_s10_22000400_03_0050","text":"嗯\n听得清清楚楚"},{"key":"SCENARIO_s10_22000400_03_0060","text":"──那就，记好了\n今天的声响、呼吸"},{"key":"SCENARIO_s10_22000400_03_0070","text":"是什么样的"},{"key":"SCENARIO_s10_22000400_03_0080","text":"嗯……我觉得忘不掉的\n今天透的声响"},{"key":"SCENARIO_s10_22000400_03_0090","text":"呵呵\n那我也会记好的，我也"},{"key":"SCENARIO_s10_22000400_03_0100","text":"今天制作人的声响\n呼吸"}]
