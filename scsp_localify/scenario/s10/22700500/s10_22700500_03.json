[{"key":"SCENARIO_s10_22700500_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22700500_03_0010","text":"１、２、３、４──"},{"key":"SCENARIO_s10_22700500_03_0020","text":"羽那，可以进去吗？"},{"key":"SCENARIO_s10_22700500_03_0030","text":"啊，嗯——！\n没问题哦"},{"key":"SCENARIO_s10_22700500_03_0040","text":"辛苦了\n差不多要正式上场了"},{"key":"SCENARIO_s10_22700500_03_0050","text":"……羽那\n今天的演唱会，你觉得能享受其中吗？"},{"key":"SCENARIO_s10_22700500_03_0060","text":"啊哈，完全不行\n紧张得要命——！"},{"key":"SCENARIO_s10_22700500_03_0070","text":"诶？是这样吗？"},{"key":"SCENARIO_s10_22700500_03_0080","text":"……所以呢，制作人\n今天的演唱会——"},{"key":"SCENARIO_s10_22700500_03_0090","text":"为了让我能不紧张、好好享受\n你能答应我，会好好看着我吗？"},{"key":"SCENARIO_s10_22700500_03_0100","text":"呵呵——！"}]
