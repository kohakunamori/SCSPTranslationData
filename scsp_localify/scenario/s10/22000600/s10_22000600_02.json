[{"key":"SCENARIO_s10_22000600_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22000600_02_0010","text":"制作人你\n被人告白过吗？"},{"key":"SCENARIO_s10_22000600_02_0020","text":"诶……？\n那个…………这个嘛……"},{"key":"SCENARIO_s10_22000600_02_0030","text":"这个嘛……？"},{"key":"SCENARIO_s10_22000600_02_0040","text":"哈哈，怎么说呢"},{"key":"SCENARIO_s10_22000600_02_0050","text":"呵呵\n你在糊弄我"},{"key":"SCENARIO_s10_22000600_02_0060","text":"不，哈哈……"},{"key":"SCENARIO_s10_22000600_02_0070","text":"那透你自己呢？\n有被人告白过吗"},{"key":"SCENARIO_s10_22000600_02_0080","text":"啊——……"},{"key":"SCENARIO_s10_22000600_02_0090","text":"哈哈，怎么说呢"},{"key":"SCENARIO_s10_22000600_02_0100","text":"哈哈，被你学去了"}]
