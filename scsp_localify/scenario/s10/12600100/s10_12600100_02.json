[{"key":"SCENARIO_s10_12600100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0001","text":"工作室工作人员"},{"key":"SCENARIO_s10_12600100_02_0010","text":"２８３的斑鸠小姐到了～\n请到这边来～"},{"key":"SCENARIO_s10_12600100_02_0011","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0012","text":"摄影师"},{"key":"SCENARIO_s10_12600100_02_0013","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0014","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0015","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0016","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0020","text":"路加小姐，非常棒哦～！"},{"key":"SCENARIO_s10_12600100_02_0021","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0022","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0030","text":"路加，辛苦了\n看起来状态不太好……没事吧？"},{"key":"SCENARIO_s10_12600100_02_0040","text":"啊……？"},{"key":"SCENARIO_s10_12600100_02_0050","text":"烦死了\n不是你们让我拍我才拍的吗…………！"},{"key":"SCENARIO_s10_12600100_02_0060","text":"啊……\n那倒是帮了大忙……"},{"key":"SCENARIO_s10_12600100_02_0070","text":"一个个的都…………\n２８３啊伙伴啊────"},{"key":"SCENARIO_s10_12600100_02_0080","text":"路加小姐辛苦了～\n记得跟２８３的朋友们问好哦～"},{"key":"SCENARIO_s10_12600100_02_0081","text":"Motion"},{"key":"SCENARIO_s10_12600100_02_0090","text":"──────…………"},{"key":"SCENARIO_s10_12600100_02_0100","text":"路加…………"}]
