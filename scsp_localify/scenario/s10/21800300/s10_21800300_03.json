[{"key":"SCENARIO_s10_21800300_03_0001","text":"Motion"},{"key":"SCENARIO_s10_21800300_03_0010","text":"那，什么时候去？"},{"key":"SCENARIO_s10_21800300_03_0020","text":"？"},{"key":"SCENARIO_s10_21800300_03_0021","text":"Motion"},{"key":"SCENARIO_s10_21800300_03_0030","text":"怎么……\n你想让冬优一个人去？"},{"key":"SCENARIO_s10_21800300_03_0040","text":"……诶？"},{"key":"SCENARIO_s10_21800300_03_0050","text":"好好看清楚啊，喏"},{"key":"SCENARIO_s10_21800300_03_0051","text":"Motion"},{"key":"SCENARIO_s10_21800300_03_0060","text":"上面不是写着吗\n限两名"},{"key":"SCENARIO_s10_21800300_03_0070","text":"……啊！"},{"key":"SCENARIO_s10_21800300_03_0080","text":"哈哈，我还真没注意到……"},{"key":"SCENARIO_s10_21800300_03_0081","text":"Motion"},{"key":"SCENARIO_s10_21800300_03_0090","text":"…………"},{"key":"SCENARIO_s10_21800300_03_0100","text":"……努力的人\n可不止冬优一个吧"}]
