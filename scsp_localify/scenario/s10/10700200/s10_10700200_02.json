[{"key":"SCENARIO_s10_10700200_02_0001","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0002","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0003","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0010","text":"大家辛苦了！\n以上，拍摄结束————！"},{"key":"SCENARIO_s10_10700200_02_0020","text":"非常感谢，辛苦了！"},{"key":"SCENARIO_s10_10700200_02_0021","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0030","text":"辛苦了\n接下来是采访"},{"key":"SCENARIO_s10_10700200_02_0040","text":"好——\n啊，衣服就这样穿着吗？"},{"key":"SCENARIO_s10_10700200_02_0050","text":"不，照片应该会用刚才拍的，\n你可以去换掉"},{"key":"SCENARIO_s10_10700200_02_0060","text":"如果想休息到开始前也可以继续穿着——\n结华怎么舒服怎么来就好"},{"key":"SCENARIO_s10_10700200_02_0070","text":"这样啊，那就赶紧去换一下吧"},{"key":"SCENARIO_s10_10700200_02_0071","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0080","text":"那这段时间就请Ｐ亲在外面等着了"},{"key":"SCENARIO_s10_10700200_02_0090","text":"啊，请不用在意我\n毕竟可不能让你去接受那边的采访嘛"},{"key":"SCENARIO_s10_10700200_02_0091","text":"Motion"},{"key":"SCENARIO_s10_10700200_02_0100","text":"──────啊哈哈"}]
