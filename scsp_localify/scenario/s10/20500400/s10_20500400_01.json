[{"key":"SCENARIO_s10_20500400_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0009","text":"礼仪讲师"},{"key":"SCENARIO_s10_20500400_01_0010","text":"用签子串着的料理，左手拿签，\n用筷子把食物取下来放到盘子里"},{"key":"SCENARIO_s10_20500400_01_0011","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0020","text":"啊────────"},{"key":"SCENARIO_s10_20500400_01_0030","text":"呵呵，用餐的时候\n尽量别发出声音哦"},{"key":"SCENARIO_s10_20500400_01_0031","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0040","text":"是——"},{"key":"SCENARIO_s10_20500400_01_0050","text":"切成一口大小再吃\n签子整齐地放在盘子对面一侧"},{"key":"SCENARIO_s10_20500400_01_0051","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0052","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0060","text":"…………"},{"key":"SCENARIO_s10_20500400_01_0061","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0070","text":"辛苦了\n怎么样？"},{"key":"SCENARIO_s10_20500400_01_0080","text":"嗯，就那样吧"},{"key":"SCENARIO_s10_20500400_01_0081","text":"Motion"},{"key":"SCENARIO_s10_20500400_01_0090","text":"只是……"},{"key":"SCENARIO_s10_20500400_01_0100","text":"“应该这样”这种事\n是谁决定的呢～"}]
