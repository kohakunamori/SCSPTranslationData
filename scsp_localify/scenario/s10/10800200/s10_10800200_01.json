[{"key":"SCENARIO_s10_10800200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_10800200_01_0010","text":"————哇……"},{"key":"SCENARIO_s10_10800200_01_0011","text":"Motion"},{"key":"SCENARIO_s10_10800200_01_0020","text":"────哦，雾子\n你来了啊"},{"key":"SCENARIO_s10_10800200_01_0030","text":"嗯……\n呵呵……"},{"key":"SCENARIO_s10_10800200_01_0040","text":"哈哈，怎么了\n一脸高兴的样子"},{"key":"SCENARIO_s10_10800200_01_0050","text":"没什么……\n那个……"},{"key":"SCENARIO_s10_10800200_01_0060","text":"花苞……"},{"key":"SCENARIO_s10_10800200_01_0070","text":"诶？\n……哦哦——，是天竺葵啊"},{"key":"SCENARIO_s10_10800200_01_0080","text":"好的……！"},{"key":"SCENARIO_s10_10800200_01_0090","text":"是吗\n新换的花盆，也长得很好呢……！"},{"key":"SCENARIO_s10_10800200_01_0100","text":"嗯……\n好像是……"}]
