[{"key":"SCENARIO_s10_22000200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22000200_01_0010","text":"…………"},{"key":"SCENARIO_s10_22000200_01_0020","text":"清"},{"key":"SCENARIO_s10_22000200_01_0030","text":"小心点啊\n今天风很大的"},{"key":"SCENARIO_s10_22000200_01_0040","text":"……会被吹走吗？"},{"key":"SCENARIO_s10_22000200_01_0050","text":"嗯，吹走倒不至于吧"},{"key":"SCENARIO_s10_22000200_01_0060","text":"但是，感觉能飞起来\n现在的话"},{"key":"SCENARIO_s10_22000200_01_0070","text":"像鸟一样吗？"},{"key":"SCENARIO_s10_22000200_01_0080","text":"嗯"},{"key":"SCENARIO_s10_22000200_01_0090","text":"鸟啊，或者像风筝那样"},{"key":"SCENARIO_s10_22000200_01_0100","text":"飞向天空"}]
