[{"key":"SCENARIO_s10_22001200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22001200_02_0010","text":"透，要看清楚信号灯啊"},{"key":"SCENARIO_s10_22001200_02_0020","text":"注意别遇到危险\n也是很重要的"},{"key":"SCENARIO_s10_22001200_02_0030","text":"好多啊\n重要的事"},{"key":"SCENARIO_s10_22001200_02_0040","text":"嗯\n为了活下去嘛"},{"key":"SCENARIO_s10_22001200_02_0050","text":"啊——"},{"key":"SCENARIO_s10_22001200_02_0060","text":"……明白了吗？"},{"key":"SCENARIO_s10_22001200_02_0070","text":"嗯\n那，走吧"},{"key":"SCENARIO_s10_22001200_02_0080","text":"诶？"},{"key":"SCENARIO_s10_22001200_02_0090","text":"绿灯了\n走吧，一起"},{"key":"SCENARIO_s10_22001200_02_0100","text":"不是要活下去嘛"}]
