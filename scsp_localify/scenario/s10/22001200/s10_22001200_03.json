[{"key":"SCENARIO_s10_22001200_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22001200_03_0010","text":"──────"},{"key":"SCENARIO_s10_22001200_03_0020","text":"……透——\n醒着吗——？"},{"key":"SCENARIO_s10_22001200_03_0030","text":"……睡着了——"},{"key":"SCENARIO_s10_22001200_03_0040","text":"太好了，你醒着"},{"key":"SCENARIO_s10_22001200_03_0050","text":"差不多该动身了\n马上就要开演了"},{"key":"SCENARIO_s10_22001200_03_0060","text":"……什么颜色？\n信号灯"},{"key":"SCENARIO_s10_22001200_03_0070","text":"信号灯？"},{"key":"SCENARIO_s10_22001200_03_0080","text":"绿灯？"},{"key":"SCENARIO_s10_22001200_03_0090","text":"……啊，是绿灯"},{"key":"SCENARIO_s10_22001200_03_0100","text":"OK\n那，走吧"},{"key":"SCENARIO_s10_22001200_03_0101","text":"Motion"},{"key":"SCENARIO_s10_22001200_03_0102","text":"Motion"}]
