[{"key":"SCENARIO_s10_32300400_03_0001","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0002","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0003","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0004","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0005","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0010","text":"雏菜，辛苦了"},{"key":"SCENARIO_s10_32300400_03_0011","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0012","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0020","text":"呐～，制作人\n雏菜怎么样～？"},{"key":"SCENARIO_s10_32300400_03_0030","text":"嗯，很适合你\n跟平时一样完美"},{"key":"SCENARIO_s10_32300400_03_0031","text":"Motion"},{"key":"SCENARIO_s10_32300400_03_0040","text":"诶～\n跟平时完全不一样吧～"},{"key":"SCENARIO_s10_32300400_03_0050","text":"啊……抱歉，我不是那个意思……\n我是说你认真完成拍摄的样子跟平时一样出色"},{"key":"SCENARIO_s10_32300400_03_0060","text":"这次的服装……比平时沉稳了好多\n我觉得展现出了雏菜不一样的一面"},{"key":"SCENARIO_s10_32300400_03_0070","text":"嗯～！\n雏菜喜欢这个～"},{"key":"SCENARIO_s10_32300400_03_0080","text":"大家也会说这个雏菜很棒吧～？"},{"key":"SCENARIO_s10_32300400_03_0090","text":"嗯。大家一定能感受到\n雏菜有各种各样的味道"},{"key":"SCENARIO_s10_32300400_03_0100","text":"啊哈～\n他们会更喜欢平时的雏菜吧～？"}]
