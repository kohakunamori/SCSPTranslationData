[{"key":"SCENARIO_s10_21800200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_21800200_02_0010","text":"…………呼"},{"key":"SCENARIO_s10_21800200_02_0020","text":"辛苦了\n这是给你带的饮料"},{"key":"SCENARIO_s10_21800200_02_0030","text":"啊——，谢啦"},{"key":"SCENARIO_s10_21800200_02_0040","text":"我挑了几种过来\n喝你喜欢的吧"},{"key":"SCENARIO_s10_21800200_02_0050","text":"…………"},{"key":"SCENARIO_s10_21800200_02_0060","text":"……呐，冬优现在想喝的\n你觉得是哪个？"},{"key":"SCENARIO_s10_21800200_02_0070","text":"诶？\n不是，你喜欢哪个就喝哪个…………"},{"key":"SCENARIO_s10_21800200_02_0080","text":"咦？　说好要好好研究冬优的\n是哪位来着？"},{"key":"SCENARIO_s10_21800200_02_0090","text":"还是说……冬优的制作人\n已经对冬优不感兴趣了吗？"},{"key":"SCENARIO_s10_21800200_02_0100","text":"诶、呃……\n嗯——，怎么说呢"},{"key":"SCENARIO_s10_21800200_02_0101","text":"Motion"}]
