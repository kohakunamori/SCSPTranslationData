[{"key":"SCENARIO_s10_20301000_03_0011","text":"Motion"},{"key":"SCENARIO_s10_20301000_03_0010","text":"……啊"},{"key":"SCENARIO_s10_20301000_03_0020","text":"嗯……\n………………"},{"key":"SCENARIO_s10_20301000_03_0021","text":"Motion"},{"key":"SCENARIO_s10_20301000_03_0030","text":"呐呐制作人！\n快看这个！"},{"key":"SCENARIO_s10_20301000_03_0040","text":"嗯？哪个？"},{"key":"SCENARIO_s10_20301000_03_0041","text":"SNS的帖子"},{"key":"SCENARIO_s10_20301000_03_0050","text":"『在283事务所全员出动时看到的那个孩子让我很在意\n　illumination STARS的黄色头发的孩子　名字想不起来了……』"},{"key":"SCENARIO_s10_20301000_03_0060","text":"“查到了！好像叫八宫巡\n　那套黑色基调的演出服很适合她呢～”"},{"key":"SCENARIO_s10_20301000_03_0070","text":"“要不要查查她最近的演出活动呢”"},{"key":"SCENARIO_s10_20301000_03_0080","text":"哦哦……！\n这是获得新粉丝了吧？"},{"key":"SCENARIO_s10_20301000_03_0090","text":"嘿嘿\n不过还只是“可能”获得了……！"},{"key":"SCENARIO_s10_20301000_03_0100","text":"巡的努力就是这样一点一点连起来的\n这是值得高兴的事哦"}]
