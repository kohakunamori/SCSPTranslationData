[{"key":"SCENARIO_s10_20200300_02_0000","text":"Motion"},{"key":"SCENARIO_s10_20200300_02_0010","text":"…………"},{"key":"SCENARIO_s10_20200300_02_0020","text":"………………嗯──"},{"key":"SCENARIO_s10_20200300_02_0030","text":"……嗯？\n怎么了？"},{"key":"SCENARIO_s10_20200300_02_0040","text":"……啊\n诶，我说出声了吗？"},{"key":"SCENARIO_s10_20200300_02_0050","text":"说出来了……倒不如说，\n是有点嘟囔声漏出来了……"},{"key":"SCENARIO_s10_20200300_02_0060","text":"…………对不起，让您听到难听的声音了"},{"key":"SCENARIO_s10_20200300_02_0070","text":"不不\n有什么烦恼吗？　方便的话跟我说说"},{"key":"SCENARIO_s10_20200300_02_0080","text":"……那个────\n……我看到有人说新歌的歌词很催泪"},{"key":"SCENARIO_s10_20200300_02_0090","text":"但我自己却没什么感觉……"},{"key":"SCENARIO_s10_20200300_02_0100","text":"原来如此……？"}]
