[{"key":"SCENARIO_s10_20200300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_20200300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20200300_01_0010","text":"…………"},{"key":"SCENARIO_s10_20200300_01_0020","text":"咦……怎么了？\n有什么在意的地方吗？"},{"key":"SCENARIO_s10_20200300_01_0030","text":"啊……没有"},{"key":"SCENARIO_s10_20200300_01_0040","text":"穿上衣服后，想起了毕业典礼的事……"},{"key":"SCENARIO_s10_20200300_01_0050","text":"啊……！\n灯织，中学时穿的是水手服嘛"},{"key":"SCENARIO_s10_20200300_01_0060","text":"是的\n明明不久前还是中学生，却觉得好怀念"},{"key":"SCENARIO_s10_20200300_01_0070","text":"还以为再也不会穿了呢"},{"key":"SCENARIO_s10_20200300_01_0080","text":"哈哈\n嗯，一般来说是这样吧"},{"key":"SCENARIO_s10_20200300_01_0090","text":"这算是缘分吗，这种东西"},{"key":"SCENARIO_s10_20200300_01_0100","text":"……好的"}]
