[{"key":"SCENARIO_s10_20400100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_20400100_01_0010","text":"唔唔唔……"},{"key":"SCENARIO_s10_20400100_01_0020","text":"换好衣服了……啊\n你、你没事吧……？"},{"key":"SCENARIO_s10_20400100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20400100_01_0030","text":"没、没事～～……\n我可是走酷酷路线的～……！"},{"key":"SCENARIO_s10_20400100_01_0040","text":"是、是这样啊……\n那个……自然的表情也想拍一些，所以"},{"key":"SCENARIO_s10_20400100_01_0050","text":"先放松一下，恋钟"},{"key":"SCENARIO_s10_20400100_01_0060","text":"是、是这样～～……？\n──呼～～～～！"},{"key":"SCENARIO_s10_20400100_01_0070","text":"哎呀～～～\n装酷也挺费劲的呢……！"},{"key":"SCENARIO_s10_20400100_01_0080","text":"哈哈……对了\n看看大家的照片的话，说不定能找到感觉呢？"},{"key":"SCENARIO_s10_20400100_01_0090","text":"哦～～～！好主意呀！\n给我看看给我看看～～！"},{"key":"SCENARIO_s10_20400100_01_0100","text":"那先看摩美美的──"}]
