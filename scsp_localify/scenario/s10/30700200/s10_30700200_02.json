[{"key":"SCENARIO_s10_30700200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_30700200_02_0010","text":"《极致·三峰》"},{"key":"SCENARIO_s10_30700200_02_0020","text":"很开心吧？"},{"key":"SCENARIO_s10_30700200_02_0030","text":"嗯哼哼，那当然啦～"},{"key":"SCENARIO_s10_30700200_02_0040","text":"因为被说了“衣装超棒，和形象完美契合”嘛！"},{"key":"SCENARIO_s10_30700200_02_0050","text":"──话说回来，P酱你怎么看？"},{"key":"SCENARIO_s10_30700200_02_0060","text":"嗯？　嗯—\n我觉得挺适合你的"},{"key":"SCENARIO_s10_30700200_02_0070","text":"哎呀，你那是什么说法嘛～"},{"key":"SCENARIO_s10_30700200_02_0080","text":"不，因为你看啊"},{"key":"SCENARIO_s10_30700200_02_0090","text":"？"},{"key":"SCENARIO_s10_30700200_02_0100","text":"要是只锁定一套的话，也太可惜了吧"}]
