[{"key":"SCENARIO_s10_22600200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22600200_02_0010","text":"原来你在这里啊"},{"key":"SCENARIO_s10_22600200_02_0011","text":"Motion"},{"key":"SCENARIO_s10_22600200_02_0020","text":"你不回休息室吗？"},{"key":"SCENARIO_s10_22600200_02_0030","text":"啊……？\n为什么"},{"key":"SCENARIO_s10_22600200_02_0040","text":"不是，录制前嘛\n跟她们俩对一下什么的"},{"key":"SCENARIO_s10_22600200_02_0050","text":"已经说得够多了"},{"key":"SCENARIO_s10_22600200_02_0060","text":"是、是吗？\n但她们俩──"},{"key":"SCENARIO_s10_22600200_02_0070","text":"吵死了\n这不是你自己擅自搞起来的事吗────"},{"key":"SCENARIO_s10_22600200_02_0080","text":"我从一开始就无所谓────"},{"key":"SCENARIO_s10_22600200_02_0090","text":"什么组合不组合的────"},{"key":"SCENARIO_s10_22600200_02_0091","text":"Motion"},{"key":"SCENARIO_s10_22600200_02_0100","text":"路加……\n我们在休息室等你啊……"},{"key":"SCENARIO_s10_22600200_02_0101","text":"Motion"}]
