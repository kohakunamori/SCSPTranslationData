[{"key":"SCENARIO_s10_22600200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22600200_01_0010","text":"路加？"},{"key":"SCENARIO_s10_22600200_01_0020","text":"今天的练习结束了吗？"},{"key":"SCENARIO_s10_22600200_01_0030","text":"……"},{"key":"SCENARIO_s10_22600200_01_0040","text":"我正打算去看看\n她们俩还在练吗？"},{"key":"SCENARIO_s10_22600200_01_0041","text":"Motion"},{"key":"SCENARIO_s10_22600200_01_0050","text":"那又怎样"},{"key":"SCENARIO_s10_22600200_01_0060","text":"是吗……"},{"key":"SCENARIO_s10_22600200_01_0070","text":"马上有节目录制了\n有时间的话，希望你能去看看她们俩的演唱"},{"key":"SCENARIO_s10_22600200_01_0080","text":"羽那和阳希都很依赖路加────"},{"key":"SCENARIO_s10_22600200_01_0090","text":"吵死了\n跟我没关系吧……"},{"key":"SCENARIO_s10_22600200_01_0100","text":"啊────\n路加……"}]
