[{"key":"SCENARIO_s10_22600200_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22600200_03_0010","text":"哦，路加\n你来了啊"},{"key":"SCENARIO_s10_22600200_03_0020","text":"我马上就走"},{"key":"SCENARIO_s10_22600200_03_0030","text":"是吗\n那在这之前，这个────"},{"key":"SCENARIO_s10_22600200_03_0040","text":"啊？"},{"key":"SCENARIO_s10_22600200_03_0050","text":"CoMETIK的CD到了\n是大家一起录的新曲"},{"key":"SCENARIO_s10_22600200_03_0060","text":"她们俩都很感谢路加……\n还说────"},{"key":"SCENARIO_s10_22600200_03_0061","text":"Motion"},{"key":"SCENARIO_s10_22600200_03_0070","text":"别过来────"},{"key":"SCENARIO_s10_22600200_03_0080","text":"下次，还要一起……"},{"key":"SCENARIO_s10_22600200_03_0090","text":"别过来啊────"},{"key":"SCENARIO_s10_22600200_03_0091","text":"Motion"},{"key":"SCENARIO_s10_22600200_03_0100","text":"不需要\n这种东西────"},{"key":"SCENARIO_s10_22600200_03_0101","text":"Motion"}]
