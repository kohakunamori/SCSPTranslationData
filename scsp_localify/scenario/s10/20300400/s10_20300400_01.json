[{"key":"SCENARIO_s10_20300400_01_0000","text":"Motion"},{"key":"SCENARIO_s10_20300400_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20300400_01_0002","text":"Motion"},{"key":"SCENARIO_s10_20300400_01_0010","text":"……呼"},{"key":"SCENARIO_s10_20300400_01_0020","text":"……？"},{"key":"SCENARIO_s10_20300400_01_0030","text":"巡……怎么了？"},{"key":"SCENARIO_s10_20300400_01_0040","text":"这个，是给我的……？"},{"key":"SCENARIO_s10_20300400_01_0050","text":"嗯，是慰问品。不嫌弃的话吃点吧\n想着你可能累了"},{"key":"SCENARIO_s10_20300400_01_0060","text":"……！　谢谢你，制作人！\n好开心……！"},{"key":"SCENARIO_s10_20300400_01_0070","text":"哈哈，那就好\n离回去还有时间，慢慢休息吧"},{"key":"SCENARIO_s10_20300400_01_0080","text":"嗯！"},{"key":"SCENARIO_s10_20300400_01_0090","text":"…………"},{"key":"SCENARIO_s10_20300400_01_0100","text":"哇……！"}]
