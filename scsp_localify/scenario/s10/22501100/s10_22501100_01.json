[{"key":"SCENARIO_s10_22501100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22501100_01_0010","text":"哦，有自动贩卖机────\n美琴，去那边买点什么喝的吧"},{"key":"SCENARIO_s10_22501100_01_0020","text":"嗯"},{"key":"SCENARIO_s10_22501100_01_0030","text":"挑你喜欢的吧"},{"key":"SCENARIO_s10_22501100_01_0040","text":"谢谢\n我就要水吧"},{"key":"SCENARIO_s10_22501100_01_0041","text":"Motion"},{"key":"SCENARIO_s10_22501100_01_0050","text":"那我就要……\n──嗯？"},{"key":"SCENARIO_s10_22501100_01_0051","text":"Motion"},{"key":"SCENARIO_s10_22501100_01_0060","text":"哦哦，中奖了……！\n美琴，运气真好！还能再拿一瓶哦！"},{"key":"SCENARIO_s10_22501100_01_0070","text":"是这样啊\n我一瓶就够了……"},{"key":"SCENARIO_s10_22501100_01_0080","text":"是吗……？\n……那我拿走可以吗"},{"key":"SCENARIO_s10_22501100_01_0090","text":"嗯\n谢谢"},{"key":"SCENARIO_s10_22501100_01_0100","text":"哈哈……\n这种事不值得你道谢啦"},{"key":"SCENARIO_s10_22501100_01_0101","text":"Motion"}]
