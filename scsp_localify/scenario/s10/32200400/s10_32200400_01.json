[{"key":"SCENARIO_s10_32200400_01_0001","text":"Motion"},{"key":"SCENARIO_s10_32200400_01_0009","text":"摄影师"},{"key":"SCENARIO_s10_32200400_01_0010","text":"那接下来，再更有精神一点试试！\n侧过身，手指指向前方！"},{"key":"SCENARIO_s10_32200400_01_0020","text":"手，手指……！"},{"key":"SCENARIO_s10_32200400_01_0025","text":"Motion"},{"key":"SCENARIO_s10_32200400_01_0030","text":"对对，很好！\n保持这样！"},{"key":"SCENARIO_s10_32200400_01_0040","text":"好、好的……！"},{"key":"SCENARIO_s10_32200400_01_0045","text":"Motion"},{"key":"SCENARIO_s10_32200400_01_0050","text":"OK，接下来像鲨鱼一样\n“嗷呜——”的感觉！"},{"key":"SCENARIO_s10_32200400_01_0060","text":"鲨，鲨鱼…………"},{"key":"SCENARIO_s10_32200400_01_0065","text":"Motion"},{"key":"SCENARIO_s10_32200400_01_0070","text":"这，这样…………吗……？"},{"key":"SCENARIO_s10_32200400_01_0080","text":"嗯嗯！很好！\n来！嗷呜——！"},{"key":"SCENARIO_s10_32200400_01_0090","text":"嗷，嗷呜——……！"},{"key":"SCENARIO_s10_32200400_01_0100","text":"（──没关系。很可爱哦，小糸……！）"}]
