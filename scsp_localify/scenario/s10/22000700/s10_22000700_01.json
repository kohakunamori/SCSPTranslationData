[{"key":"SCENARIO_s10_22000700_01_0001","text":"Motion"},{"key":"SCENARIO_s10_22000700_01_0010","text":"哦——\n黑色"},{"key":"SCENARIO_s10_22000700_01_0020","text":"和，灰色"},{"key":"SCENARIO_s10_22000700_01_0030","text":"很沉稳的颜色呢\n该说是单色系吗"},{"key":"SCENARIO_s10_22000700_01_0031","text":"Motion"},{"key":"SCENARIO_s10_22000700_01_0040","text":"啊——\n嗯"},{"key":"SCENARIO_s10_22000700_01_0050","text":"这个，要穿的吧\n大家"},{"key":"SCENARIO_s10_22000700_01_0060","text":"嗯\n是和大家一样的服装哦"},{"key":"SCENARIO_s10_22000700_01_0070","text":"──这样啊……\n混在一起的颜色"},{"key":"SCENARIO_s10_22000700_01_0080","text":"……诶？"},{"key":"SCENARIO_s10_22000700_01_0090","text":"会变成的，把颜料混在一起的话"},{"key":"SCENARIO_s10_22000700_01_0100","text":"这个颜色"}]
