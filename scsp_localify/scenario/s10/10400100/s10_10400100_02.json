[{"key":"SCENARIO_s10_10400100_02_0010","text":"好耶～～！"},{"key":"SCENARIO_s10_10400100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_10400100_02_0020","text":"制作人……\n怎么样～～？"},{"key":"SCENARIO_s10_10400100_02_0030","text":"嗯……不错嘛！\n颜色也出来得很漂亮"},{"key":"SCENARIO_s10_10400100_02_0040","text":"颜色～～？不是那个意思啦～～……\n是穿着这件衣服的我～～！"},{"key":"SCENARIO_s10_10400100_02_0050","text":"啊，抱歉……！\n非常合身哦！"},{"key":"SCENARIO_s10_10400100_02_0060","text":"嘿嘿，对吧～～～？\n我超喜欢这件～～！"},{"key":"SCENARIO_s10_10400100_02_0070","text":"是吗……！\n哈哈，急急忙忙跑过来值得了"},{"key":"SCENARIO_s10_10400100_02_0080","text":"嗯～！\n大家要一起穿这件呢～～……"},{"key":"SCENARIO_s10_10400100_02_0090","text":"是啊！\n２８３Ｐｒｏ的大家一起"},{"key":"SCENARIO_s10_10400100_02_0100","text":"好期待啊……\n会是什么样的舞台呢……！！"}]
