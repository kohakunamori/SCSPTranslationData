[{"key":"SCENARIO_s10_11200200_03_0000","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0010","text":"…………"},{"key":"SCENARIO_s10_11200200_03_0001","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0020","text":"嗯……"},{"key":"SCENARIO_s10_11200200_03_0030","text":"凛世，差不多该……\n——哦，看起来相当专注啊"},{"key":"SCENARIO_s10_11200200_03_0040","text":"制作人大人……\n好的……"},{"key":"SCENARIO_s10_11200200_03_0050","text":"作为２８３事务所的一员……\n该以怎样的形象出现在镜头前……我一直在思考……"},{"key":"SCENARIO_s10_11200200_03_0002","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0060","text":"——嗯，很合身！\n这次也完美！"},{"key":"SCENARIO_s10_11200200_03_0003","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0004","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0070","text":"……呵呵……\n一定……没问题的……"},{"key":"SCENARIO_s10_11200200_03_0005","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0080","text":"那么杜野小姐，拜托了"},{"key":"SCENARIO_s10_11200200_03_0006","text":"Motion"},{"key":"SCENARIO_s10_11200200_03_0090","text":"我是……２８３事务所……所属的偶像……\n杜野凛世……"},{"key":"SCENARIO_s10_11200200_03_0100","text":"今天……\n请多多关照……"}]
