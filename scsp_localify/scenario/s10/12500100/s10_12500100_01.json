[{"key":"SCENARIO_s10_12500100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_12500100_01_0010","text":"……这套服装"},{"key":"SCENARIO_s10_12500100_01_0020","text":"嗯，给美琴准备的\n做好了"},{"key":"SCENARIO_s10_12500100_01_0030","text":"想早点让美琴也看看"},{"key":"SCENARIO_s10_12500100_01_0040","text":"…………\n这样啊"},{"key":"SCENARIO_s10_12500100_01_0041","text":"Motion"},{"key":"SCENARIO_s10_12500100_01_0050","text":"…………"},{"key":"SCENARIO_s10_12500100_01_0060","text":"怎么样，要不要试穿一下？"},{"key":"SCENARIO_s10_12500100_01_0070","text":"……好啊\n那就试试吧"},{"key":"SCENARIO_s10_12500100_01_0080","text":"好！　期待\n那边的会议区，你用吧"},{"key":"SCENARIO_s10_12500100_01_0081","text":"Motion"},{"key":"SCENARIO_s10_12500100_01_0090","text":"……嗯\n那我去试试"},{"key":"SCENARIO_s10_12500100_01_0100","text":"那等我一下"}]
