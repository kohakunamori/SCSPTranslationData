[{"key":"SCENARIO_s10_12500100_02_0001","text":"Motion"},{"key":"SCENARIO_s10_12500100_02_0002","text":"Motion"},{"key":"SCENARIO_s10_12500100_02_0010","text":"……感觉，好新鲜"},{"key":"SCENARIO_s10_12500100_02_0020","text":"这种白色的……可爱风格的服装\n以前好像没怎么穿过"},{"key":"SCENARIO_s10_12500100_02_0030","text":"哈哈，是吗\n不过很合身哦"},{"key":"SCENARIO_s10_12500100_02_0040","text":"…………\n而且，这套服装"},{"key":"SCENARIO_s10_12500100_02_0050","text":"因为给人的印象就像是\n“283事务所的偶像”本身"},{"key":"SCENARIO_s10_12500100_02_0060","text":"……穿上它的时候\n稍微有点紧张了"},{"key":"SCENARIO_s10_12500100_02_0070","text":"是吗？\n完全看不出来哦"},{"key":"SCENARIO_s10_12500100_02_0080","text":"…………"},{"key":"SCENARIO_s10_12500100_02_0090","text":"因为从没想过自己会有穿上这套服装的一天\n就在不久之前"}]
