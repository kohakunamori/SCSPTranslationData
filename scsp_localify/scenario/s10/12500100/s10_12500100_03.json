[{"key":"SCENARIO_s10_12500100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_12500100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_12500100_03_0010","text":"……谢谢你，制作人"},{"key":"SCENARIO_s10_12500100_03_0020","text":"嗯？\n怎么了，突然这么说"},{"key":"SCENARIO_s10_12500100_03_0030","text":"没有，不是突然"},{"key":"SCENARIO_s10_12500100_03_0040","text":"谢谢你\n接纳我进入283事务所"},{"key":"SCENARIO_s10_12500100_03_0050","text":"美琴……"},{"key":"SCENARIO_s10_12500100_03_0060","text":"我并不是不明白，但穿上这套服装后，重新有了实感"},{"key":"SCENARIO_s10_12500100_03_0070","text":"我也是，283事务所的偶像"},{"key":"SCENARIO_s10_12500100_03_0080","text":"……嗯"},{"key":"SCENARIO_s10_12500100_03_0090","text":"我才要谢谢你\n愿意来283事务所"}]
