[{"key":"SCENARIO_s10_30800200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_30800200_01_0010","text":"…………"},{"key":"SCENARIO_s10_30800200_01_0020","text":"──久等了，雾────……"},{"key":"SCENARIO_s10_30800200_01_0030","text":"………………"},{"key":"SCENARIO_s10_30800200_01_0031","text":"Motion"},{"key":"SCENARIO_s10_30800200_01_0032","text":"Motion"},{"key":"SCENARIO_s10_30800200_01_0040","text":"制作人……"},{"key":"SCENARIO_s10_30800200_01_0050","text":"啊，抱歉雾子\n让你等了"},{"key":"SCENARIO_s10_30800200_01_0060","text":"没有……\n我……非常开心……"},{"key":"SCENARIO_s10_30800200_01_0070","text":"花瓣……轻轻飘落……\n飞舞的样子……"},{"key":"SCENARIO_s10_30800200_01_0080","text":"……其实啊，我刚才想着不该打扰你\n你看起来就像在和花瓣对话一样"},{"key":"SCENARIO_s10_30800200_01_0090","text":"哇……哼哼……"},{"key":"SCENARIO_s10_30800200_01_0100","text":"喂喂……\n接下来……要去哪里呀……？"}]
