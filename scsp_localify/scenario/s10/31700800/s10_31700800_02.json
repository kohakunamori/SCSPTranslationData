[{"key":"SCENARIO_s10_31700800_02_0000","text":"Motion"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0010","text":"──好漂亮……\n刚才那段影像，能不能再放一遍啊"},{"key":"SCENARIO_s10_31700800_02_0002","text":"女性2"},{"key":"SCENARIO_s10_31700800_02_0020","text":"那个孩子，好像在哪里见过\n是偶像吧"},{"key":"SCENARIO_s10_31700800_02_0021","text":"Motion"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0030","text":"啊！来了来了！"},{"key":"SCENARIO_s10_31700800_02_0002","text":"女性2"},{"key":"SCENARIO_s10_31700800_02_0040","text":"天使……？堕天使？\n怎么回事，移不开眼睛了────"},{"key":"SCENARIO_s10_31700800_02_0041","text":"Motion"},{"key":"SCENARIO_s10_31700800_02_0050","text":"哪里适合了？"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0060","text":"诶——"},{"key":"SCENARIO_s10_31700800_02_0070","text":"有什么好笑的？\n哪里好了？"},{"key":"SCENARIO_s10_31700800_02_0002","text":"女性2"},{"key":"SCENARIO_s10_31700800_02_0080","text":"哇……！？\n是这段影像里的孩子吧？真人？"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0090","text":"什么，是整蛊？在拍视频？"},{"key":"SCENARIO_s10_31700800_02_0091","text":"Motion"},{"key":"SCENARIO_s10_31700800_02_0100","text":"────！\n不好意思，突然……！！"},{"key":"SCENARIO_s10_31700800_02_0110","text":"不是拍摄之类的，请放心"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0120","text":"诶、诶\n那、是私人行程……？"},{"key":"SCENARIO_s10_31700800_02_0130","text":"哈哈……只是路过而已\n打扰了"},{"key":"SCENARIO_s10_31700800_02_0140","text":"来，走吧"},{"key":"SCENARIO_s10_31700800_02_0150","text":"好想多聊聊啊～"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0160","text":"走掉了……\n诶，是梦？还是现实？"},{"key":"SCENARIO_s10_31700800_02_0002","text":"女性2"},{"key":"SCENARIO_s10_31700800_02_0170","text":"她叫什么名字来着\n查查看吧"},{"key":"SCENARIO_s10_31700800_02_0001","text":"女性１"},{"key":"SCENARIO_s10_31700800_02_0180","text":"────Straylight的‘芹泽朝日’，是吗\n诶，骗人的吧。刚才那个可爱的孩子居然是这样的风格？"},{"key":"SCENARIO_s10_31700800_02_0002","text":"女性2"},{"key":"SCENARIO_s10_31700800_02_0190","text":"PV拍得好美，反差也太大了吧\n好在意～"}]
