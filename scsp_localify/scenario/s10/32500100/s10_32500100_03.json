[{"key":"SCENARIO_s10_32500100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32500100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_32500100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_32500100_03_0010","text":"────美琴……！"},{"key":"SCENARIO_s10_32500100_03_0020","text":"……制作人"},{"key":"SCENARIO_s10_32500100_03_0030","text":"辛苦了，非常棒……！"},{"key":"SCENARIO_s10_32500100_03_0040","text":"嗯"},{"key":"SCENARIO_s10_32500100_03_0050","text":"像派对一样\n华丽的舞台……！"},{"key":"SCENARIO_s10_32500100_03_0060","text":"灯光也看起来和平时不一样的光彩"},{"key":"SCENARIO_s10_32500100_03_0070","text":"……谢谢你"},{"key":"SCENARIO_s10_32500100_03_0080","text":"舞蹈动作也完全到位了\n────多亏了你认真钻研"},{"key":"SCENARIO_s10_32500100_03_0090","text":"因为，穿着这个跳舞的话────"},{"key":"SCENARIO_s10_32500100_03_0100","text":"────不把那里变成舞厅可不行呢"}]
