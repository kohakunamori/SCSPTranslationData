[{"key":"SCENARIO_s10_21201300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21201300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21201300_01_0009","text":"舞蹈教练"},{"key":"SCENARIO_s10_21201300_01_0010","text":"OK！\n凛世酱和平时一样，非常棒！"},{"key":"SCENARIO_s10_21201300_01_0020","text":"……"},{"key":"SCENARIO_s10_21201300_01_0030","text":"（？\n　凛世……？）"},{"key":"SCENARIO_s10_21201300_01_0040","text":"太、太不敢当……\n您过奖了……"},{"key":"SCENARIO_s10_21201300_01_0041","text":"Motion"},{"key":"SCENARIO_s10_21201300_01_0050","text":"凛世，辛苦了"},{"key":"SCENARIO_s10_21201300_01_0060","text":"制作人阁下……"},{"key":"SCENARIO_s10_21201300_01_0070","text":"练习中你一直闷闷不乐的，\n有什么在意的事吗？"},{"key":"SCENARIO_s10_21201300_01_0080","text":"不、不是……\n不是什么大事……"},{"key":"SCENARIO_s10_21201300_01_0090","text":"……是吗\n有什么的话随时跟我说"},{"key":"SCENARIO_s10_21201300_01_0100","text":"（也许是不太好说的事\n　硬要追问也不太对……先看着吧）"}]
