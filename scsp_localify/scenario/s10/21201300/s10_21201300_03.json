[{"key":"SCENARIO_s10_21201300_03_0000","text":"Motion"},{"key":"SCENARIO_s10_21201300_03_0010","text":"………………"},{"key":"SCENARIO_s10_21201300_03_0020","text":"差不多该上场了\n没问题吧？"},{"key":"SCENARIO_s10_21201300_03_0021","text":"Motion"},{"key":"SCENARIO_s10_21201300_03_0030","text":"没有问题……"},{"key":"SCENARIO_s10_21201300_03_0040","text":"嗯，和平时一样很专注呢"},{"key":"SCENARIO_s10_21201300_03_0050","text":"是的……\n不过……"},{"key":"SCENARIO_s10_21201300_03_0060","text":"啊，是和昨天之前不同的\n“今天的凛世”"},{"key":"SCENARIO_s10_21201300_03_0070","text":"呵呵……\n和平时一样……"},{"key":"SCENARIO_s10_21201300_03_0071","text":"Motion"},{"key":"SCENARIO_s10_21201300_03_0080","text":"Producer先生……\n总是……看得那么仔细……"},{"key":"SCENARIO_s10_21201300_03_0090","text":"那是当然的\n我可是凛世的Producer啊"},{"key":"SCENARIO_s10_21201300_03_0100","text":"是的……\n今天也是，明天也是，今后也是……"}]
