[{"key":"SCENARIO_s10_22100300_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22100300_02_0001","text":"独白"},{"key":"SCENARIO_s10_22100300_02_0010","text":"在清澈湛蓝的世界里────────"},{"key":"SCENARIO_s10_22100300_02_0020","text":"她轻盈地舞动，衣摆如鱼鳍般旋转，\n优美地翩然起舞"},{"key":"SCENARIO_s10_22100300_02_0030","text":"（……好美）"},{"key":"SCENARIO_s10_22100300_02_0003","text":"Motion"},{"key":"SCENARIO_s10_22100300_02_0002","text":"摄影师"},{"key":"SCENARIO_s10_22100300_02_0040","text":"很好，刚才那段太棒了！\n我确认一下，稍等哦"},{"key":"SCENARIO_s10_22100300_02_0050","text":"好的"},{"key":"SCENARIO_s10_22100300_02_0060","text":"…………干什么\n能不能别这么肆无忌惮地看"},{"key":"SCENARIO_s10_22100300_02_0070","text":"啊，……不，是看入迷了\n像人鱼一样"},{"key":"SCENARIO_s10_22100300_02_0080","text":"哈？"},{"key":"SCENARIO_s10_22100300_02_0090","text":"哈哈……真的\n把舞台和服装运用得很好，是很棒的演绎"},{"key":"SCENARIO_s10_22100300_02_0100","text":"………………"}]
