[{"key":"SCENARIO_s10_32000400_01_0001","text":"Motion"},{"key":"SCENARIO_s10_32000400_01_0010","text":"────美式餐厅的代言人吗……\n要做一日店员的话"},{"key":"SCENARIO_s10_32000400_01_0020","text":"也许该好好练练接待客人\n用打印出来的资料练习一下吧"},{"key":"SCENARIO_s10_32000400_01_0021","text":"Motion"},{"key":"SCENARIO_s10_32000400_01_0030","text":"嗯"},{"key":"SCENARIO_s10_32000400_01_0040","text":"──欢迎光临"},{"key":"SCENARIO_s10_32000400_01_0050","text":"——非常感谢"},{"key":"SCENARIO_s10_32000400_01_0060","text":"…………透，太字面意思了"},{"key":"SCENARIO_s10_32000400_01_0070","text":"啊—\n嗯"},{"key":"SCENARIO_s10_32000400_01_0071","text":"Motion"},{"key":"SCENARIO_s10_32000400_01_0080","text":"──还需要别的吗？"},{"key":"SCENARIO_s10_32000400_01_0090","text":"…………透"},{"key":"SCENARIO_s10_32000400_01_0091","text":"Motion"},{"key":"SCENARIO_s10_32000400_01_0100","text":"我读了哦，按字面意思"}]
