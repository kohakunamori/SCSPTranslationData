[{"key":"SCENARIO_s10_20901000_03_0000","text":"Motion"},{"key":"SCENARIO_s10_20901000_03_0001","text":"Motion"},{"key":"SCENARIO_s10_20901000_03_0010","text":"制作人……！"},{"key":"SCENARIO_s10_20901000_03_0011","text":"Motion"},{"key":"SCENARIO_s10_20901000_03_0020","text":"辛苦了果穗\n出了不少汗吧，用这个擦擦"},{"key":"SCENARIO_s10_20901000_03_0030","text":"好的！\n谢谢你！"},{"key":"SCENARIO_s10_20901000_03_0040","text":"嘿嘿……\n出了好多汗呢"},{"key":"SCENARIO_s10_20901000_03_0050","text":"服装……没问题吧……\n大家是不是都不怎么出汗呀……？"},{"key":"SCENARIO_s10_20901000_03_0060","text":"不用担心\n会送去干洗的，果穗你尽管尽情发挥就好"},{"key":"SCENARIO_s10_20901000_03_0070","text":"而且啊，出汗这件事\n不就是果穗在拼命努力的证明吗？"},{"key":"SCENARIO_s10_20901000_03_0080","text":"证明……！"},{"key":"SCENARIO_s10_20901000_03_0081","text":"Motion"},{"key":"SCENARIO_s10_20901000_03_0082","text":"Motion"},{"key":"SCENARIO_s10_20901000_03_0090","text":"——好的！"},{"key":"SCENARIO_s10_20901000_03_0100","text":"２８３的大家一起\n超——级努力中！"}]
