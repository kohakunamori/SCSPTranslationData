[{"key":"SCENARIO_s10_20901000_02_0000","text":"Motion"},{"key":"SCENARIO_s10_20901000_02_0001","text":"Motion"},{"key":"SCENARIO_s10_20901000_02_0010","text":"好厉害……！"},{"key":"SCENARIO_s10_20901000_02_0020","text":"有什么在意的地方吗？"},{"key":"SCENARIO_s10_20901000_02_0030","text":"嗯——……"},{"key":"SCENARIO_s10_20901000_02_0040","text":"没有！"},{"key":"SCENARIO_s10_20901000_02_0050","text":"是吗，那就好"},{"key":"SCENARIO_s10_20901000_02_0060","text":"啊，不过！"},{"key":"SCENARIO_s10_20901000_02_0070","text":"嗯？"},{"key":"SCENARIO_s10_20901000_02_0080","text":"这套服装，像黑色战士一样好帅！\n有种追加战士的感觉！"},{"key":"SCENARIO_s10_20901000_02_0090","text":"确实……！\n以黑色为主调嘛！"},{"key":"SCENARIO_s10_20901000_02_0100","text":"是的！\n看起来很强大！"}]
