[{"key":"SCENARIO_s10_20901000_01_0000","text":"Motion"},{"key":"SCENARIO_s10_20901000_01_0010","text":"…………"},{"key":"SCENARIO_s10_20901000_01_0020","text":"果穗，抱歉打扰你做功课\n差不多该出发了，能准备一下吗？"},{"key":"SCENARIO_s10_20901000_01_0030","text":"好的！"},{"key":"SCENARIO_s10_20901000_01_0040","text":"我马上准备好！"},{"key":"SCENARIO_s10_20901000_01_0050","text":"——果穗\n等一下"},{"key":"SCENARIO_s10_20901000_01_0060","text":"？\n怎么了？"},{"key":"SCENARIO_s10_20901000_01_0070","text":"手掌侧面\n都黑黑的了哦"},{"key":"SCENARIO_s10_20901000_01_0080","text":"啊！"},{"key":"SCENARIO_s10_20901000_01_0090","text":"语文课就是这样呢\n先去把手洗了吧"},{"key":"SCENARIO_s10_20901000_01_0100","text":"好的！"}]
