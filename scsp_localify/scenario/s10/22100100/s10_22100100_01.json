[{"key":"SCENARIO_s10_22100100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22100100_01_0010","text":"制作人～\n差不多要开始量尺寸了…………"},{"key":"SCENARIO_s10_22100100_01_0020","text":"啊，好的\n那我去大厅那边"},{"key":"SCENARIO_s10_22100100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_22100100_01_0030","text":"那，圆香就拜托你啦～！"},{"key":"SCENARIO_s10_22100100_01_0040","text":"请多指教"},{"key":"SCENARIO_s10_22100100_01_0050","text":"……noctchill的第一套演出服啊"},{"key":"SCENARIO_s10_22100100_01_0060","text":"接下来请伸直手臂～\n对对，就这样保持————"},{"key":"SCENARIO_s10_22100100_01_0070","text":"好了\n这样可以吗……？"},{"key":"SCENARIO_s10_22100100_01_0080","text":"作为偶像的演出服……"},{"key":"SCENARIO_s10_22100100_01_0090","text":"…………"},{"key":"SCENARIO_s10_22100100_01_0100","text":"……要成为偶像了啊\n从这里开始"}]
