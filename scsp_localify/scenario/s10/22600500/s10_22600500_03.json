[{"key":"SCENARIO_s10_22600500_03_0000","text":"Motion"},{"key":"SCENARIO_s10_22600500_03_0001","text":"偶像１"},{"key":"SCENARIO_s10_22600500_03_0010","text":"这个舞台，已经站过好多次了\n所以很顺手，挺好的呢～"},{"key":"SCENARIO_s10_22600500_03_0011","text":"偶像２"},{"key":"SCENARIO_s10_22600500_03_0020","text":"嗯嗯，熟悉的地方\n不知不觉就会有感情呢"},{"key":"SCENARIO_s10_22600500_03_0021","text":"偶像１"},{"key":"SCENARIO_s10_22600500_03_0030","text":"就像主场的感觉？"},{"key":"SCENARIO_s10_22600500_03_0031","text":"Motion"},{"key":"SCENARIO_s10_22600500_03_0040","text":"路加————"},{"key":"SCENARIO_s10_22600500_03_0050","text":"怎么了？\n刚才在发呆，没事吧？"},{"key":"SCENARIO_s10_22600500_03_0060","text":"吵死了"},{"key":"SCENARIO_s10_22600500_03_0070","text":"没事就好……\n组合的站位呢────"},{"key":"SCENARIO_s10_22600500_03_0080","text":"不是说了吵死了吗……"},{"key":"SCENARIO_s10_22600500_03_0090","text":"啊，嗯……\n刚才确认过了，没问题对吧"},{"key":"SCENARIO_s10_22600500_03_0091","text":"Motion"},{"key":"SCENARIO_s10_22600500_03_0100","text":"别进来。"}]
