[{"key":"SCENARIO_s10_22600500_02_0000","text":"Motion"},{"key":"SCENARIO_s10_22600500_02_0001","text":"Motion"},{"key":"SCENARIO_s10_22600500_02_0010","text":"啊，路加────"},{"key":"SCENARIO_s10_22600500_02_0020","text":"等一下啊！"},{"key":"SCENARIO_s10_22600500_02_0030","text":"干嘛？"},{"key":"SCENARIO_s10_22600500_02_0031","text":"Motion"},{"key":"SCENARIO_s10_22600500_02_0040","text":"呃……刚才也说了\n今天结束后，她们俩想一起吃个晚饭再回去"},{"key":"SCENARIO_s10_22600500_02_0050","text":"那又怎么了"},{"key":"SCENARIO_s10_22600500_02_0060","text":"所以，路加也一起────"},{"key":"SCENARIO_s10_22600500_02_0070","text":"谁要去啊\n又不是工作……"},{"key":"SCENARIO_s10_22600500_02_0080","text":"但是————"},{"key":"SCENARIO_s10_22600500_02_0090","text":"你们自己爱怎么好怎么好吧"},{"key":"SCENARIO_s10_22600500_02_0091","text":"Motion"},{"key":"SCENARIO_s10_22600500_02_0100","text":"什么一起吃晚饭……\n笑死人了────"}]
