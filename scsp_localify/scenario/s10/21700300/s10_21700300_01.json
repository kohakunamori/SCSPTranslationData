[{"key":"SCENARIO_s10_21700300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21700300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21700300_01_0010","text":"制作人\n我肚子饿了"},{"key":"SCENARIO_s10_21700300_01_0020","text":"！"},{"key":"SCENARIO_s10_21700300_01_0030","text":"（也是\n　已经过了中午了……）"},{"key":"SCENARIO_s10_21700300_01_0040","text":"稍等一下"},{"key":"SCENARIO_s10_21700300_01_0050","text":"附近有家庭餐厅\n还有荞麦面、回转寿司、拉面之类的"},{"key":"SCENARIO_s10_21700300_01_0060","text":"想去哪家？"},{"key":"SCENARIO_s10_21700300_01_0070","text":"家庭餐厅上次也跟制作人一起去过了\n除了那家都行"},{"key":"SCENARIO_s10_21700300_01_0080","text":"好，那就\n去回转寿司吧"},{"key":"SCENARIO_s10_21700300_01_0090","text":"（这几家里看起来最开心嘛）"},{"key":"SCENARIO_s10_21700300_01_0100","text":"我懂了！"}]
