[{"key":"SCENARIO_s10_12300200_03_0000","text":"Motion"},{"key":"SCENARIO_s10_12300200_03_0010","text":"制片人\n差不多要开始了吗～？"},{"key":"SCENARIO_s10_12300200_03_0020","text":"嗯！\n雏菜，准备好了吗？"},{"key":"SCENARIO_s10_12300200_03_0030","text":"嗯～！"},{"key":"SCENARIO_s10_12300200_03_0040","text":"服装也完美对吧～？"},{"key":"SCENARIO_s10_12300200_03_0050","text":"哈哈，是啊"},{"key":"SCENARIO_s10_12300200_03_0060","text":"非常适合哦"},{"key":"SCENARIO_s10_12300200_03_0070","text":"呀哈～！"},{"key":"SCENARIO_s10_12300200_03_0080","text":"……哦，马上要出场了"},{"key":"SCENARIO_s10_12300200_03_0090","text":"我出发啦\n制片人！"},{"key":"SCENARIO_s10_12300200_03_0100","text":"嗯……！\n加油，雏菜！"}]
