[{"key":"SCENARIO_s10_12300200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_12300200_01_0010","text":"雏菜，关于下次的活动"},{"key":"SCENARIO_s10_12300200_01_0020","text":"诶～？"},{"key":"SCENARIO_s10_12300200_01_0030","text":"因为要穿新服装"},{"key":"SCENARIO_s10_12300200_01_0040","text":"等送来了之后你确认一下吧"},{"key":"SCENARIO_s10_12300200_01_0050","text":"嗯，没事哦～"},{"key":"SCENARIO_s10_12300200_01_0060","text":"设计草图已经送到了\n感兴趣的话要看看吗？"},{"key":"SCENARIO_s10_12300200_01_0070","text":"诶～！\n现在就能看吗～！？"},{"key":"SCENARIO_s10_12300200_01_0080","text":"嗯\n……不对，雏菜，先去洗个手吧"},{"key":"SCENARIO_s10_12300200_01_0090","text":"啊哈～！\n说得也是～"},{"key":"SCENARIO_s10_12300200_01_0100","text":"手上都是零食的油嘛～"}]
