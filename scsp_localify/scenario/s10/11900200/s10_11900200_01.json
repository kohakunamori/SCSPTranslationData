[{"key":"SCENARIO_s10_11900200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_11900200_01_0010","text":"怎么样，新衣服"},{"key":"SCENARIO_s10_11900200_01_0020","text":"不错嘛～！\n好想赶紧穿上这个去开演唱会啊～"},{"key":"SCENARIO_s10_11900200_01_0030","text":"啊，对了对了\n这个，是和大家一样的对吧"},{"key":"SCENARIO_s10_11900200_01_0040","text":"嗯，是啊"},{"key":"SCENARIO_s10_11900200_01_0050","text":"啊哈哈～，这样啊这样啊～♪"},{"key":"SCENARIO_s10_11900200_01_0060","text":"真好啊\n全员都一样"},{"key":"SCENARIO_s10_11900200_01_0070","text":"对吧！\n就是那种“耶——！”的感觉！"},{"key":"SCENARIO_s10_11900200_01_0080","text":"好想和大家一起拍照啊～"},{"key":"SCENARIO_s10_11900200_01_0090","text":"说得对，那到时候\n大家一起摆个“耶——”的姿势吧"},{"key":"SCENARIO_s10_11900200_01_0100","text":"太好了！"}]
