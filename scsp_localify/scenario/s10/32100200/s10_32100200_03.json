[{"key":"SCENARIO_s10_32100200_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32100200_03_0001","text":"粉丝女孩"},{"key":"SCENARIO_s10_32100200_03_0010","text":"圆香酱——！"},{"key":"SCENARIO_s10_32100200_03_0020","text":"……谢谢你"},{"key":"SCENARIO_s10_32100200_03_0002","text":"粉丝女孩"},{"key":"SCENARIO_s10_32100200_03_0030","text":"圆香酱有种厌世感呢\n很清冷的感觉……"},{"key":"SCENARIO_s10_32100200_03_0003","text":"粉丝的朋友"},{"key":"SCENARIO_s10_32100200_03_0040","text":"明明是偶像，却不太笑呢"},{"key":"SCENARIO_s10_32100200_03_0004","text":"粉丝女孩"},{"key":"SCENARIO_s10_32100200_03_0050","text":"嗯，是啊……\n这一点────"},{"key":"SCENARIO_s10_32100200_03_0005","text":"粉丝女孩＆朋友"},{"key":"SCENARIO_s10_32100200_03_0060","text":"好可爱！！"},{"key":"SCENARIO_s10_32100200_03_0061","text":"Motion"},{"key":"SCENARIO_s10_32100200_03_0070","text":"…………"},{"key":"SCENARIO_s10_32100200_03_0080","text":"辛苦了\n是“好可爱”舞台哦"},{"key":"SCENARIO_s10_32100200_03_0090","text":"……泛用性很高的词"},{"key":"SCENARIO_s10_32100200_03_0100","text":"所谓“可爱”，是各种个性的杂烩集合体\n……明白了"}]
