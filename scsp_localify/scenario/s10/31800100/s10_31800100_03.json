[{"key":"SCENARIO_s10_31800100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_31800100_03_0010","text":"哦……\n今天比平时更有干劲啊"},{"key":"SCENARIO_s10_31800100_03_0020","text":"注意你的说法"},{"key":"SCENARIO_s10_31800100_03_0030","text":"冬优子我什么时候都是干劲满满的哦？"},{"key":"SCENARIO_s10_31800100_03_0040","text":"对、对不起……！\n你说得对"},{"key":"SCENARIO_s10_31800100_03_0050","text":"…………"},{"key":"SCENARIO_s10_31800100_03_0060","text":"……嘛，毕竟也是新衣服嘛\n看起来那样也难怪"},{"key":"SCENARIO_s10_31800100_03_0070","text":"非常合适哦"},{"key":"SCENARIO_s10_31800100_03_0080","text":"那还用说"},{"key":"SCENARIO_s10_31800100_03_0090","text":"希望能把冬优子新的魅力传达出去呢"},{"key":"SCENARIO_s10_31800100_03_0100","text":"笨蛋\n不是‘希望能传达’而是要传达出去啊"}]
