[{"key":"SCENARIO_s10_31800100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_31800100_01_0010","text":"…………"},{"key":"SCENARIO_s10_31800100_01_0020","text":"久等了"},{"key":"SCENARIO_s10_31800100_01_0030","text":"……？\n在看什么呢？"},{"key":"SCENARIO_s10_31800100_01_0040","text":"啊啊，不是……"},{"key":"SCENARIO_s10_31800100_01_0050","text":"什么？\n有什么值得看呆的东西吗？"},{"key":"SCENARIO_s10_31800100_01_0060","text":"那边有冬优子的广告\n所以就看入迷了"},{"key":"SCENARIO_s10_31800100_01_0070","text":"……"},{"key":"SCENARIO_s10_31800100_01_0080","text":"……是吗"},{"key":"SCENARIO_s10_31800100_01_0090","text":"……嘛，也没办法呢，毕竟是冬优子嘛"},{"key":"SCENARIO_s10_31800100_01_0100","text":"好！"}]
