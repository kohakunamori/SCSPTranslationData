[{"key":"SCENARIO_s10_21500300_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21500300_01_0010","text":"哇……"},{"key":"SCENARIO_s10_21500300_01_0020","text":"好厉害……\n布景……好漂亮……！"},{"key":"SCENARIO_s10_21500300_01_0021","text":"Motion"},{"key":"SCENARIO_s10_21500300_01_0030","text":"──那个，今天……"},{"key":"SCENARIO_s10_21500300_01_0040","text":"要在这里，变成妖精对吧……？"},{"key":"SCENARIO_s10_21500300_01_0050","text":"哈哈\n『变成妖精』吗……！"},{"key":"SCENARIO_s10_21500300_01_0060","text":"诶……不对吗……？"},{"key":"SCENARIO_s10_21500300_01_0070","text":"不，没有不对\n今天是拍摄妖精主题的照片"},{"key":"SCENARIO_s10_21500300_01_0080","text":"嘿嘿……\n对吧……！"},{"key":"SCENARIO_s10_21500300_01_0090","text":"那……\n我要调整好心情了……！"},{"key":"SCENARIO_s10_21500300_01_0100","text":"──甜花是……妖精……\n甜花是……妖精……！"}]
