[{"key":"SCENARIO_s10_12600200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_12600200_01_0010","text":"线香花火吗…………"},{"key":"SCENARIO_s10_12600200_01_0020","text":"事务所里有放旧了没人玩的花火"},{"key":"SCENARIO_s10_12600200_01_0030","text":"没办法\n就帮他们用完吧"},{"key":"SCENARIO_s10_12600200_01_0040","text":"是吗……"},{"key":"SCENARIO_s10_12600200_01_0050","text":"嘛，花火什么的，一瞬就烧完了……"},{"key":"SCENARIO_s10_12600200_01_0060","text":"得处理掉才行呢──────"},{"key":"SCENARIO_s10_12600200_01_0061","text":"Motion"},{"key":"SCENARIO_s10_12600200_01_0070","text":"就算旧了也挺美的"},{"key":"SCENARIO_s10_12600200_01_0080","text":"火花变了…………"},{"key":"SCENARIO_s10_12600200_01_0090","text":"快要…………"},{"key":"SCENARIO_s10_12600200_01_0100","text":"熄灭了────…………"}]
