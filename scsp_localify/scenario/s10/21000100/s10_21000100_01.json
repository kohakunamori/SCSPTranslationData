[{"key":"SCENARIO_s10_21000100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21000100_01_0010","text":"哇……！\n哇啊……！"},{"key":"SCENARIO_s10_21000100_01_0020","text":"我的服装……！"},{"key":"SCENARIO_s10_21000100_01_0030","text":"嗯，很合身"},{"key":"SCENARIO_s10_21000100_01_0040","text":"真的吗……！？"},{"key":"SCENARIO_s10_21000100_01_0050","text":"嗯！"},{"key":"SCENARIO_s10_21000100_01_0060","text":"——……太好了……！"},{"key":"SCENARIO_s10_21000100_01_0061","text":"Motion"},{"key":"SCENARIO_s10_21000100_01_0070","text":"────"},{"key":"SCENARIO_s10_21000100_01_0071","text":"Motion"},{"key":"SCENARIO_s10_21000100_01_0080","text":"放学后CLIMAX GIRLS、\n巧克力偶像的园田智代子！"},{"key":"SCENARIO_s10_21000100_01_0081","text":"Motion"},{"key":"SCENARIO_s10_21000100_01_0090","text":"……嘿嘿，怎么样呢……？"},{"key":"SCENARIO_s10_21000100_01_0100","text":"！\n——我觉得帅呆了"},{"key":"SCENARIO_s10_21000100_01_0101","text":"Motion"}]
