[{"key":"SCENARIO_s10_11200100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_11200100_02_0010","text":"……那个……\n您觉得……怎么样……？"},{"key":"SCENARIO_s10_11200100_02_0020","text":"嗯……完美！\n像白鸟一样美丽"},{"key":"SCENARIO_s10_11200100_02_0030","text":"制、制作人大人……！\n说我美丽……什么的…………"},{"key":"SCENARIO_s10_11200100_02_0040","text":"…………"},{"key":"SCENARIO_s10_11200100_02_0050","text":"……？"},{"key":"SCENARIO_s10_11200100_02_0001","text":"Motion"},{"key":"SCENARIO_s10_11200100_02_0060","text":"……\n美丽……"},{"key":"SCENARIO_s10_11200100_02_0070","text":"我……真的美丽吗……"},{"key":"SCENARIO_s10_11200100_02_0080","text":"……嗯？\n哦！很美丽啊"},{"key":"SCENARIO_s10_11200100_02_0090","text":"……！\n那、那个……那个…………！"},{"key":"SCENARIO_s10_11200100_02_0002","text":"Motion"},{"key":"SCENARIO_s10_11200100_02_0100","text":"啊，凛世……！？\n凛世────"}]
