[{"key":"SCENARIO_s10_22200100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_22200100_01_0010","text":"哇、哇……！"},{"key":"SCENARIO_s10_22200100_01_0020","text":"怎么样？\n不错吧？"},{"key":"SCENARIO_s10_22200100_01_0030","text":"是、是的……！\n可、可以再仔细看看吗？"},{"key":"SCENARIO_s10_22200100_01_0040","text":"嗯嗯、当然了"},{"key":"SCENARIO_s10_22200100_01_0050","text":"好、好厉害……\n好可爱啊……"},{"key":"SCENARIO_s10_22200100_01_0060","text":"这个缎带是……\n用来绑头发的吗……？"},{"key":"SCENARIO_s10_22200100_01_0070","text":"光看也不错，不过试穿一下怎么样？\n那样不是更能感受到氛围吗？"},{"key":"SCENARIO_s10_22200100_01_0080","text":"……！\n可、可以吗……？"},{"key":"SCENARIO_s10_22200100_01_0090","text":"哈哈，当然啦？"},{"key":"SCENARIO_s10_22200100_01_0100","text":"那可是小糸的服装啊。"},{"key":"SCENARIO_s10_22200100_01_0001","text":"Motion"}]
