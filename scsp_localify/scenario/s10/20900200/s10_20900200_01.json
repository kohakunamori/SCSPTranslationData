[{"key":"SCENARIO_s10_20900200_01_0001","text":"Motion"},{"key":"SCENARIO_s10_20900200_01_0002","text":"Motion"},{"key":"SCENARIO_s10_20900200_01_0010","text":"感觉我也变成高中生了……！"},{"key":"SCENARIO_s10_20900200_01_0020","text":"真的呢……！"},{"key":"SCENARIO_s10_20900200_01_0030","text":"让我想起了当初发掘果穗的时候\n当时真以为你是高中生呢"},{"key":"SCENARIO_s10_20900200_01_0040","text":"那件衣服真的很适合你"},{"key":"SCENARIO_s10_20900200_01_0050","text":"嘿嘿……\n哇——！"},{"key":"SCENARIO_s10_20900200_01_0060","text":"（……嗯，看到这样的地方\n　就觉得很有果穗的风格呢）"},{"key":"SCENARIO_s10_20900200_01_0070","text":"（天真烂漫，活力满满……）"},{"key":"SCENARIO_s10_20900200_01_0080","text":"我去给大家看看！"},{"key":"SCENARIO_s10_20900200_01_0090","text":"哦，去吧\n走廊上不要跑哦……！"},{"key":"SCENARIO_s10_20900200_01_0100","text":"好的！"},{"key":"SCENARIO_s10_20900200_01_0101","text":"Motion"}]
