[{"key":"SCENARIO_s10_21500400_02_0000","text":"Motion"},{"key":"SCENARIO_s10_21500400_02_0010","text":"手机，架好……\n然后……"},{"key":"SCENARIO_s10_21500400_02_0020","text":"嘿……"},{"key":"SCENARIO_s10_21500400_02_0030","text":"……啊……\n画好了……！"},{"key":"SCENARIO_s10_21500400_02_0031","text":"Motion"},{"key":"SCENARIO_s10_21500400_02_0040","text":"诶嘿嘿……"},{"key":"SCENARIO_s10_21500400_02_0050","text":"（……是甜花发来的？）"},{"key":"SCENARIO_s10_21500400_02_0060","text":"……哦哦！\n画得不错嘛！"},{"key":"SCENARIO_s10_21500400_02_0070","text":"『练习辛苦了\n　画得很棒呢，花田和……』"},{"key":"SCENARIO_s10_21500400_02_0080","text":"『恶魔太郎』"},{"key":"SCENARIO_s10_21500400_02_0090","text":"……恶魔太郎……？"},{"key":"SCENARIO_s10_21500400_02_0100","text":"那个……\n是制作人，哦……"}]
