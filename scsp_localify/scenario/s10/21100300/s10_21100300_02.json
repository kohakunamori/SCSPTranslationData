[{"key":"SCENARIO_s10_21100300_02_0000","text":"Motion"},{"key":"SCENARIO_s10_21100300_02_0010","text":"哈哈……"},{"key":"SCENARIO_s10_21100300_02_0020","text":"笑眯眯的……在看什么呢？"},{"key":"SCENARIO_s10_21100300_02_0030","text":"之前拍的水枪照片啊\n树里也看看吗？"},{"key":"SCENARIO_s10_21100300_02_0040","text":"──哦，想看想看！"},{"key":"SCENARIO_s10_21100300_02_0041","text":"Motion"},{"key":"SCENARIO_s10_21100300_02_0042","text":"Motion"},{"key":"SCENARIO_s10_21100300_02_0050","text":"哦──……"},{"key":"SCENARIO_s10_21100300_02_0060","text":"看吧，大家都特别有活力对吧？"},{"key":"SCENARIO_s10_21100300_02_0070","text":"啊……！　这确实让人忍不住笑啊\n水花飞溅的样子也超有夏天的感觉！"},{"key":"SCENARIO_s10_21100300_02_0080","text":"────嗯\n那里跳过就行"},{"key":"SCENARIO_s10_21100300_02_0090","text":"诶，这可是树里的照片啊？\n你看，这个笑容什么的超可──……"},{"key":"SCENARIO_s10_21100300_02_0100","text":"啊—！\n好了好了！下一张下一张！"}]
