[{"key":"SCENARIO_s10_20301300_03_0000","text":"Motion"},{"key":"SCENARIO_s10_20301300_03_0010","text":"…………"},{"key":"SCENARIO_s10_20301300_03_0020","text":"……巡？\n你在意时间吗？"},{"key":"SCENARIO_s10_20301300_03_0030","text":"不是……！\n倒也不是说在意……"},{"key":"SCENARIO_s10_20301300_03_0040","text":"只是在想什么时候能开始训练\n好想早点活动活动身体……！"},{"key":"SCENARIO_s10_20301300_03_0050","text":"哈哈，干劲满满啊"},{"key":"SCENARIO_s10_20301300_03_0060","text":"嗯！\n下次的演唱会，不是要穿那套衣服上台吗？"},{"key":"SCENARIO_s10_20301300_03_0070","text":"能做的事情，我想趁现在\n全都做一遍！"},{"key":"SCENARIO_s10_20301300_03_0080","text":"你一直都很喜欢那套衣服嘛\n巡"},{"key":"SCENARIO_s10_20301300_03_0081","text":"Motion"},{"key":"SCENARIO_s10_20301300_03_0090","text":"既然你这么精力充沛，我去确认一下\n训练场能不能提前用"},{"key":"SCENARIO_s10_20301300_03_0100","text":"真的吗！？\n谢谢！"}]
