[{"key":"SCENARIO_s10_32000100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_32000100_01_0001","text":"服装师"},{"key":"SCENARIO_s10_32000100_01_0010","text":"────穿上感觉怎么样？\n嗯……腰部这边有点松吧……"},{"key":"SCENARIO_s10_32000100_01_0020","text":"嗯？\n啊——"},{"key":"SCENARIO_s10_32000100_01_0030","text":"抱歉，稍微收紧一些\n我先临时固定一下，请不要动哦"},{"key":"SCENARIO_s10_32000100_01_0040","text":"啊—\n嗯，但是……"},{"key":"SCENARIO_s10_32000100_01_0050","text":"……？\n有什么问题吗，透"},{"key":"SCENARIO_s10_32000100_01_0060","text":"没有\n也不是说有问题"},{"key":"SCENARIO_s10_32000100_01_0070","text":"就这样挺好的\n不用改了"},{"key":"SCENARIO_s10_32000100_01_0080","text":"诶？"},{"key":"SCENARIO_s10_32000100_01_0090","text":"呵呵"},{"key":"SCENARIO_s10_32000100_01_0100","text":"反正很快就会长大的"}]
