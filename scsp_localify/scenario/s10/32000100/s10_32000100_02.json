[{"key":"SCENARIO_s10_32000100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_32000100_02_0010","text":"透，换好衣服了吗—我进来了—"},{"key":"SCENARIO_s10_32000100_02_0020","text":"嗯——"},{"key":"SCENARIO_s10_32000100_02_0030","text":"哦哦……！　衣服做得挺好的嘛\n很合身不是吗"},{"key":"SCENARIO_s10_32000100_02_0040","text":"嗯\n呵呵"},{"key":"SCENARIO_s10_32000100_02_0050","text":"快看"},{"key":"SCENARIO_s10_32000100_02_0060","text":"诶？　嗯"},{"key":"SCENARIO_s10_32000100_02_0070","text":"快看"},{"key":"SCENARIO_s10_32000100_02_0080","text":"嗯？　哦……"},{"key":"SCENARIO_s10_32000100_02_0090","text":"这个，变成会伸缩的布了"},{"key":"SCENARIO_s10_32000100_02_0100","text":"可以长大了"}]
