[{"key":"SCENARIO_s10_32000100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_32000100_03_0010","text":"喂—，透—"},{"key":"SCENARIO_s10_32000100_03_0020","text":"我从餐饮那边拿了吃的过来……"},{"key":"SCENARIO_s10_32000100_03_0030","text":"诶，啊——"},{"key":"SCENARIO_s10_32000100_03_0040","text":"……哈哈，已经换好衣服了啊"},{"key":"SCENARIO_s10_32000100_03_0050","text":"那待会儿再说吧"},{"key":"SCENARIO_s10_32000100_03_0060","text":"不\n我要吃"},{"key":"SCENARIO_s10_32000100_03_0070","text":"是吗？"},{"key":"SCENARIO_s10_32000100_03_0080","text":"嗯\n好不容易能伸缩了"},{"key":"SCENARIO_s10_32000100_03_0090","text":"得长大才行"},{"key":"SCENARIO_s10_32000100_03_0100","text":"这朵花也是\n我也是"}]
