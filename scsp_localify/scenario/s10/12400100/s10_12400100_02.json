[{"key":"SCENARIO_s10_12400100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_12400100_02_0001","text":"摄影师"},{"key":"SCENARIO_s10_12400100_02_0010","text":"耶——！"},{"key":"SCENARIO_s10_12400100_02_0020","text":"哈哈，不错哦日花酱！\n那个姿势也来一个吧！"},{"key":"SCENARIO_s10_12400100_02_0021","text":"Motion"},{"key":"SCENARIO_s10_12400100_02_0022","text":"Motion"},{"key":"SCENARIO_s10_12400100_02_0023","text":"Motion"},{"key":"SCENARIO_s10_12400100_02_0024","text":"Motion"},{"key":"SCENARIO_s10_12400100_02_0030","text":"好！　谢谢～！"},{"key":"SCENARIO_s10_12400100_02_0040","text":"辛苦了，表情很好哦"},{"key":"SCENARIO_s10_12400100_02_0050","text":"……\n嘛……"},{"key":"SCENARIO_s10_12400100_02_0060","text":"虽然脸很糟糕\n但总不能顶着糟糕的表情拍吧"},{"key":"SCENARIO_s10_12400100_02_0070","text":"毕竟是工作嘛"},{"key":"SCENARIO_s10_12400100_02_0080","text":"……"},{"key":"SCENARIO_s10_12400100_02_0090","text":"嗯，那样也行"},{"key":"SCENARIO_s10_12400100_02_0100","text":"表情很好哦"}]
