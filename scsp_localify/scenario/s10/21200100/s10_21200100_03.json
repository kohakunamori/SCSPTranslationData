[{"key":"SCENARIO_s10_21200100_03_0000","text":"Motion"},{"key":"SCENARIO_s10_21200100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_21200100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_21200100_03_0003","text":"Motion"},{"key":"SCENARIO_s10_21200100_03_0006","text":"摄影师"},{"key":"SCENARIO_s10_21200100_03_0010","text":"好—，OK—\n凛世酱，辛苦啦—"},{"key":"SCENARIO_s10_21200100_03_0004","text":"Motion"},{"key":"SCENARIO_s10_21200100_03_0020","text":"辛苦了\n表现得很棒，很有气场"},{"key":"SCENARIO_s10_21200100_03_0030","text":"呵呵……\n都是托……制作人大人的福……"},{"key":"SCENARIO_s10_21200100_03_0040","text":"嗯，我吗……？"},{"key":"SCENARIO_s10_21200100_03_0050","text":"『慢慢来就好』……"},{"key":"SCENARIO_s10_21200100_03_0060","text":"……啊────\n哈哈，你还记得啊"},{"key":"SCENARIO_s10_21200100_03_0070","text":"……嗯……\n想起了……那日您说的话……"},{"key":"SCENARIO_s10_21200100_03_0080","text":"一次又一次……一次又一次……\n慢慢地……"},{"key":"SCENARIO_s10_21200100_03_0090","text":"与这身衣裳……亲近……"},{"key":"SCENARIO_s10_21200100_03_0100","text":"想着要……与它一同……\n积累时光……"},{"key":"SCENARIO_s10_21200100_03_0005","text":"Motion"}]
