[{"key":"SCENARIO_s10_20600200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_20600200_01_0010","text":"…………"},{"key":"SCENARIO_s10_20600200_01_0020","text":"请"},{"key":"SCENARIO_s10_20600200_01_0021","text":"Motion"},{"key":"SCENARIO_s10_20600200_01_0030","text":"辛苦了──\n哦，准备得很充分嘛？"},{"key":"SCENARIO_s10_20600200_01_0040","text":"呵呵，是啊"},{"key":"SCENARIO_s10_20600200_01_0050","text":"──哎呀\n你看起来可不太充分呢？"},{"key":"SCENARIO_s10_20600200_01_0060","text":"诶"},{"key":"SCENARIO_s10_20600200_01_0061","text":"Motion"},{"key":"SCENARIO_s10_20600200_01_0070","text":"失礼了\n袖口上沾了灰尘"},{"key":"SCENARIO_s10_20600200_01_0080","text":"哇，真的……！\n抱歉咲耶，谢谢"},{"key":"SCENARIO_s10_20600200_01_0090","text":"不客气"},{"key":"SCENARIO_s10_20600200_01_0100","text":"这样又恢复成平时的帅气模样了"}]
