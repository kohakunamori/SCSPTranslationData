[{"key":"SCENARIO_s10_22200300_02_0001","text":"Motion"},{"key":"SCENARIO_s10_22200300_02_0010","text":"1，2，3，4……"},{"key":"SCENARIO_s10_22200300_02_0011","text":"Motion"},{"key":"SCENARIO_s10_22200300_02_0020","text":"One、Two……\n────啊，不对……再、再来一次……！"},{"key":"SCENARIO_s10_22200300_02_0030","text":"One、Two……"},{"key":"SCENARIO_s10_22200300_02_0031","text":"Motion"},{"key":"SCENARIO_s10_22200300_02_0040","text":"啊……\n已、已经，到该出发的时间了……"},{"key":"SCENARIO_s10_22200300_02_0041","text":"Motion"},{"key":"SCENARIO_s10_22200300_02_0050","text":"小糸，差不多该……"},{"key":"SCENARIO_s10_22200300_02_0060","text":"啊，对、对不起……\n我、我这就出发……！"},{"key":"SCENARIO_s10_22200300_02_0070","text":"已经这么晚了，回去我送你吧"},{"key":"SCENARIO_s10_22200300_02_0080","text":"诶……可、可是……"},{"key":"SCENARIO_s10_22200300_02_0090","text":"啊，准备可以慢慢来\n────那我，在楼下等你"},{"key":"SCENARIO_s10_22200300_02_0091","text":"Motion"},{"key":"SCENARIO_s10_22200300_02_0100","text":"………………\n谢谢你，制作人……"}]
