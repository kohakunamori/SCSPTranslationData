[{"key":"SCENARIO_s10_22200300_01_0001","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0002","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0010","text":"辛、辛苦了……"},{"key":"SCENARIO_s10_22200300_01_0011","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0020","text":"没有人……\n啊，对了……趁现在……"},{"key":"SCENARIO_s10_22200300_01_0030","text":"得把作业做了……"},{"key":"SCENARIO_s10_22200300_01_0031","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0032","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0040","text":"………………"},{"key":"SCENARIO_s10_22200300_01_0041","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0050","text":"我回来啦——！"},{"key":"SCENARIO_s10_22200300_01_0051","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0060","text":"噼呀……！"},{"key":"SCENARIO_s10_22200300_01_0070","text":"啊，抱、抱歉\n吓到你了吧"},{"key":"SCENARIO_s10_22200300_01_0071","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0080","text":"不、不会……\n………………"},{"key":"SCENARIO_s10_22200300_01_0090","text":"……那是，课题什么的吗？\n小糸真的，总是在努力呢"},{"key":"SCENARIO_s10_22200300_01_0091","text":"Motion"},{"key":"SCENARIO_s10_22200300_01_0100","text":"……………\n这、这种程度，很、很正常啦……！"}]
