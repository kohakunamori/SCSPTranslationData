[{"key":"SCENARIO_s10_12400200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_12400200_01_0010","text":"…………"},{"key":"SCENARIO_s10_12400200_01_0020","text":"怎么样，穿上的感想是？"},{"key":"SCENARIO_s10_12400200_01_0030","text":"……\n这，真的是给我穿的吗～……"},{"key":"SCENARIO_s10_12400200_01_0040","text":"……为什么会这么想？"},{"key":"SCENARIO_s10_12400200_01_0050","text":"……"},{"key":"SCENARIO_s10_12400200_01_0060","text":"……也没什么，您说要穿的话我会穿的"},{"key":"SCENARIO_s10_12400200_01_0070","text":"…………"},{"key":"SCENARIO_s10_12400200_01_0080","text":"我会穿的"},{"key":"SCENARIO_s10_12400200_01_0090","text":"……总感觉不太对劲啊"},{"key":"SCENARIO_s10_12400200_01_0100","text":"日花……"}]
