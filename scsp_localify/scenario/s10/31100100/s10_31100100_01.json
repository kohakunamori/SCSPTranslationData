[{"key":"SCENARIO_s10_31100100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_31100100_01_0010","text":"……？\n这个球──"},{"key":"SCENARIO_s10_31100100_01_0019","text":"男孩子"},{"key":"SCENARIO_s10_31100100_01_0020","text":"不好意思——！那个，是我的！\n球，能扔过来一下吗——！"},{"key":"SCENARIO_s10_31100100_01_0030","text":"哦！\n接住啦——！"},{"key":"SCENARIO_s10_31100100_01_0040","text":"哈哈，接得好！"},{"key":"SCENARIO_s10_31100100_01_0045","text":"Motion"},{"key":"SCENARIO_s10_31100100_01_0050","text":"──还有，这附近车流量比较多\n要注意安全哦——！"},{"key":"SCENARIO_s10_31100100_01_0059","text":"男孩子"},{"key":"SCENARIO_s10_31100100_01_0060","text":"……！\n好的，谢谢您……！"},{"key":"SCENARIO_s10_31100100_01_0070","text":"…………"},{"key":"SCENARIO_s10_31100100_01_0080","text":"……？\n怎么了……"},{"key":"SCENARIO_s10_31100100_01_0090","text":"──不，哈哈……！"},{"key":"SCENARIO_s10_31100100_01_0100","text":"传得漂亮，树里"}]
