[{"key":"SCENARIO_s10_30500300_02_0000","text":"Motion"},{"key":"SCENARIO_s10_30500300_02_0001","text":"主持人"},{"key":"SCENARIO_s10_30500300_02_0010","text":"新年快乐！"},{"key":"SCENARIO_s10_30500300_02_0020","text":"好了好了，这个环节呢～\n我们将会报道各地神社的热闹景象！"},{"key":"SCENARIO_s10_30500300_02_0030","text":"首先是L'Antica的田中摩美美酱！\n穿得真漂亮呢，跟神社的氛围太搭了！"},{"key":"SCENARIO_s10_30500300_02_0031","text":"Motion"},{"key":"SCENARIO_s10_30500300_02_0040","text":"『谢谢——\n　毕竟是正月嘛——』"},{"key":"SCENARIO_s10_30500300_02_0041","text":"Motion"},{"key":"SCENARIO_s10_30500300_02_0050","text":"『那么——\n　就让我来为大家介绍神社的情况吧——』"},{"key":"SCENARIO_s10_30500300_02_0060","text":"好的，拜托啦！\n摩美美酱正月的时候，私下也会去参拜吗？"},{"key":"SCENARIO_s10_30500300_02_0070","text":"『嗯——要说的话——\n　我是边看电视边宅在家那派的吧——』"},{"key":"SCENARIO_s10_30500300_02_0080","text":"啊哈哈\n那平时你都是观众那边的人呢"},{"key":"SCENARIO_s10_30500300_02_0090","text":"『是啊——\n　所以，观众的心情我也很懂——』"},{"key":"SCENARIO_s10_30500300_02_0100","text":"『今天，那些“这里再多拍一点”的地方\n　我也会好好报道的，敬请期待——』"},{"key":"SCENARIO_s10_30500300_02_0101","text":"Motion"}]
