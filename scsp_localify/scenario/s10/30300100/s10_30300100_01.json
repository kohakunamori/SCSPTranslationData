[{"key":"SCENARIO_s10_30300100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_30300100_01_0010","text":"哇……！"},{"key":"SCENARIO_s10_30300100_01_0020","text":"哇，比我想象中还要燕尾服……！"},{"key":"SCENARIO_s10_30300100_01_0030","text":"哈哈，嗯\n跟平时穿的服装比起来，印象确实差很多吧"},{"key":"SCENARIO_s10_30300100_01_0040","text":"是吧——！"},{"key":"SCENARIO_s10_30300100_01_0050","text":"可能是因为颜色很简洁吧\n怎么说呢……该怎么说才好呢……"},{"key":"SCENARIO_s10_30300100_01_0060","text":"感觉必须打起精神来……！"},{"key":"SCENARIO_s10_30300100_01_0070","text":"啊……毕竟是燕尾服主题嘛\n想挺直腰板的心情我懂"},{"key":"SCENARIO_s10_30300100_01_0080","text":"对吧对吧！"},{"key":"SCENARIO_s10_30300100_01_0090","text":"哇——怎么办\n感觉不能像平时那样随便了！"},{"key":"SCENARIO_s10_30300100_01_0100","text":"我去学习一下！"}]
