[{"key":"SCENARIO_s10_31200400_02_0001","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0010","text":"………………"},{"key":"SCENARIO_s10_31200400_02_0011","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0012","text":"客人"},{"key":"SCENARIO_s10_31200400_02_0020","text":"——啊，两位—\n我预约了——"},{"key":"SCENARIO_s10_31200400_02_0030","text":"啊……\n…………"},{"key":"SCENARIO_s10_31200400_02_0031","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0040","text":"制作人阁下……"},{"key":"SCENARIO_s10_31200400_02_0041","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0050","text":"『抱歉，让你久等了』\n『可能还要再花一点时间』"},{"key":"SCENARIO_s10_31200400_02_0051","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0060","text":"『明白了。请您路上小心。』"},{"key":"SCENARIO_s10_31200400_02_0061","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0070","text":"──心是……万花筒……"},{"key":"SCENARIO_s10_31200400_02_0080","text":"旋转……摇曳……\n然后……"},{"key":"SCENARIO_s10_31200400_02_0081","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0082","text":"Motion"},{"key":"SCENARIO_s10_31200400_02_0090","text":"──抱歉凛世，让你久等了！\n我们赶紧开始碰头吧"},{"key":"SCENARIO_s10_31200400_02_0100","text":"嗯……"}]
