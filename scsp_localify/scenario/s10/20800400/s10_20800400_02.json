[{"key":"SCENARIO_s10_20800400_02_0001","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0010","text":"啊……\n制作人……"},{"key":"SCENARIO_s10_20800400_02_0011","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0020","text":"……………"},{"key":"SCENARIO_s10_20800400_02_0030","text":"睡着……了……？"},{"key":"SCENARIO_s10_20800400_02_0031","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0032","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0040","text":"那么……出发了哦……\n别忘了……系安全带……"},{"key":"SCENARIO_s10_20800400_02_0050","text":"出发……前进……\n嗡——嗯…………"},{"key":"SCENARIO_s10_20800400_02_0060","text":"哇，雾子……！\n抱歉，等你的过程中打了个盹……"},{"key":"SCENARIO_s10_20800400_02_0061","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0070","text":"啊……\n醒过来了……"},{"key":"SCENARIO_s10_20800400_02_0080","text":"本来想……开车送……\n制作人回去的……"},{"key":"SCENARIO_s10_20800400_02_0090","text":"诶……"},{"key":"SCENARIO_s10_20800400_02_0091","text":"Motion"},{"key":"SCENARIO_s10_20800400_02_0100","text":"欢迎……下次再来乘坐……♪"}]
