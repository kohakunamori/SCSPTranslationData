[{"key":"SCENARIO_s10_12200100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_12200100_02_0010","text":"制，制作人……！"},{"key":"SCENARIO_s10_12200100_02_0020","text":"哦，穿好了吗？\n小糸"},{"key":"SCENARIO_s10_12200100_02_0030","text":"是、是的……"},{"key":"SCENARIO_s10_12200100_02_0040","text":"那就出来吧！"},{"key":"SCENARIO_s10_12200100_02_0050","text":"等、等一下\n我还没做好心理准备……"},{"key":"SCENARIO_s10_12200100_02_0060","text":"是吗……？\n嗯，那就等小糸准备好了再说"},{"key":"SCENARIO_s10_12200100_02_0070","text":"好、好的……\n────呼……"},{"key":"SCENARIO_s10_12200100_02_0080","text":"我、我开始了……！"},{"key":"SCENARIO_s10_12200100_02_0090","text":"那、那个……\n制片人先生"},{"key":"SCENARIO_s10_12200100_02_0100","text":"怎、怎么样……"}]
