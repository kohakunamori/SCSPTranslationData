[{"key":"SCENARIO_s10_12500200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_12500200_02_0010","text":"……好的"},{"key":"SCENARIO_s10_12500200_02_0020","text":"…………？"},{"key":"SCENARIO_s10_12500200_02_0030","text":"这是怎么回事，这个\n制片人"},{"key":"SCENARIO_s10_12500200_02_0040","text":"是叶月小姐准备的点心哦"},{"key":"SCENARIO_s10_12500200_02_0050","text":"有多出来的\n不介意的话美琴，要吃吗？"},{"key":"SCENARIO_s10_12500200_02_0060","text":"……不用了\n接下来还有练习，就算了吧"},{"key":"SCENARIO_s10_12500200_02_0070","text":"如果有多出来的份\n制片人你吃吧"},{"key":"SCENARIO_s10_12500200_02_0080","text":"…………\n这样啊……"},{"key":"SCENARIO_s10_12500200_02_0090","text":"…………？"},{"key":"SCENARIO_s10_12500200_02_0100","text":"那，我去练习了"}]
