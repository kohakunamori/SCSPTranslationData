[{"key":"SCENARIO_s10_21500500_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21500500_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21500500_01_0010","text":"呼……"},{"key":"SCENARIO_s10_21500500_01_0011","text":"Motion"},{"key":"SCENARIO_s10_21500500_01_0020","text":"甜花，辛苦了\n我带慰问品来了"},{"key":"SCENARIO_s10_21500500_01_0030","text":"慰问品……！\n……只有水……吗？"},{"key":"SCENARIO_s10_21500500_01_0040","text":"不\n我还买了泡芙哦"},{"key":"SCENARIO_s10_21500500_01_0050","text":"太好了……！\n嘿嘿……谢谢……"},{"key":"SCENARIO_s10_21500500_01_0060","text":"那么，怎么样了？\n练习的进展"},{"key":"SCENARIO_s10_21500500_01_0070","text":"……那个，还……\n有一点点，站位……会偏……"},{"key":"SCENARIO_s10_21500500_01_0080","text":"撞到小奈她们……\n绝对不行……！所以……"},{"key":"SCENARIO_s10_21500500_01_0090","text":"……吃完之后，再稍微……\n努力一下……！"},{"key":"SCENARIO_s10_21500500_01_0100","text":"是吗，真了不起，甜花！\n我会一直陪到你练好为止的"},{"key":"SCENARIO_s10_21500500_01_0101","text":"Motion"}]
