[{"key":"SCENARIO_s10_31100200_02_0000","text":"Motion"},{"key":"SCENARIO_s10_31100200_02_0010","text":"？"},{"key":"SCENARIO_s10_31100200_02_0020","text":"哦，这只猫\n还挺亲近人的嘛"},{"key":"SCENARIO_s10_31100200_02_0030","text":"嗯，可能是习惯跟人打交道了吧"},{"key":"SCENARIO_s10_31100200_02_0031","text":"Motion"},{"key":"SCENARIO_s10_31100200_02_0040","text":"叫得挺勤啊……\n难道是肚子饿了？"},{"key":"SCENARIO_s10_31100200_02_0050","text":"话虽这么说\n我身上可什么都没带……"},{"key":"SCENARIO_s10_31100200_02_0060","text":"乖啦乖啦，过来\n……咦？"},{"key":"SCENARIO_s10_31100200_02_0061","text":"Motion"},{"key":"SCENARIO_s10_31100200_02_0070","text":"哈哈，它好像更喜欢\n树里那边"},{"key":"SCENARIO_s10_31100200_02_0080","text":"是……这样吗\n还真是少见呢"},{"key":"SCENARIO_s10_31100200_02_0081","text":"Motion"},{"key":"SCENARIO_s10_31100200_02_0090","text":"这不正说明，树里的温柔\n连猫都能感受到吗？"},{"key":"SCENARIO_s10_31100200_02_0100","text":"诶……\n不……哪有那种事……"}]
