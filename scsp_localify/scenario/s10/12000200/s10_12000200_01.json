[{"key":"SCENARIO_s10_12000200_01_0011","text":"Motion"},{"key":"SCENARIO_s10_12000200_01_0010","text":"……"},{"key":"SCENARIO_s10_12000200_01_0020","text":"……啊，透？"},{"key":"SCENARIO_s10_12000200_01_0030","text":"……诶？"},{"key":"SCENARIO_s10_12000200_01_0040","text":"往冰箱里放饮料的时候\n名字，拜托你写一下哦"},{"key":"SCENARIO_s10_12000200_01_0050","text":"诶，啊——……"},{"key":"SCENARIO_s10_12000200_01_0060","text":"……呵呵\n忘了"},{"key":"SCENARIO_s10_12000200_01_0070","text":"有的嘛，好多\n大家的份"},{"key":"SCENARIO_s10_12000200_01_0080","text":"哦\n光水就有不少──────"},{"key":"SCENARIO_s10_12000200_01_0081","text":"Motion"},{"key":"SCENARIO_s10_12000200_01_0090","text":"──────１、２、３、４、５、６…………"},{"key":"SCENARIO_s10_12000200_01_0100","text":"……哈哈／呵呵呵……"}]
