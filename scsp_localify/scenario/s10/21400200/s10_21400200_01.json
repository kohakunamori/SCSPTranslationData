[{"key":"SCENARIO_s10_21400200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21400200_01_0010","text":"～～！\n嘿嘿～"},{"key":"SCENARIO_s10_21400200_01_0020","text":"哦哦，感觉不错啊。\n穿着感怎么样，尺寸合适吗？"},{"key":"SCENARIO_s10_21400200_01_0030","text":"应该没问题，\n我稍微动一下看看～"},{"key":"SCENARIO_s10_21400200_01_0040","text":"嘿咻……\n——看招！"},{"key":"SCENARIO_s10_21400200_01_0041","text":"Motion"},{"key":"SCENARIO_s10_21400200_01_0050","text":"哈哈，真是经典动作啊。"},{"key":"SCENARIO_s10_21400200_01_0060","text":"是吧～！"},{"key":"SCENARIO_s10_21400200_01_0070","text":"……啊，对了……！"},{"key":"SCENARIO_s10_21400200_01_0080","text":"制作人制作人！"},{"key":"SCENARIO_s10_21400200_01_0090","text":"？"},{"key":"SCENARIO_s10_21400200_01_0100","text":"砰——！\n嘿嘿！"},{"key":"SCENARIO_s10_21400200_01_0101","text":"Motion"}]
