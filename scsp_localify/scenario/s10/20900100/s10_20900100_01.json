[{"key":"SCENARIO_s10_20900100_01_0010","text":"早上好──咦？"},{"key":"SCENARIO_s10_20900100_01_0020","text":"果穗！这边！\n３楼的仓库！"},{"key":"SCENARIO_s10_20900100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_20900100_01_0030","text":"制作人，早上好！"},{"key":"SCENARIO_s10_20900100_01_0040","text":"在做什么呢……？"},{"key":"SCENARIO_s10_20900100_01_0050","text":"早上好\n我有点东西想给大家看看"},{"key":"SCENARIO_s10_20900100_01_0060","text":"本来想先拿出来放好的……\n抱歉，能稍等一下吗？"},{"key":"SCENARIO_s10_20900100_01_0070","text":"马上就好"},{"key":"SCENARIO_s10_20900100_01_0080","text":"好的"},{"key":"SCENARIO_s10_20900100_01_0071","text":"Motion"},{"key":"SCENARIO_s10_20900100_01_0081","text":"Motion"},{"key":"SCENARIO_s10_20900100_01_0090","text":"这个……！\n是我的吗……！？"},{"key":"SCENARIO_s10_20900100_01_0100","text":"是啊\n是放课后的Climax Girls用的新服装"}]
