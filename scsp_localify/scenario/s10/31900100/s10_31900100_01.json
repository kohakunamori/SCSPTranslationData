[{"key":"SCENARIO_s10_31900100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_31900100_01_0010","text":"制作人\n圣诞快乐～"},{"key":"SCENARIO_s10_31900100_01_0020","text":"哦哦，是圣诞老人啊\n辛苦了！"},{"key":"SCENARIO_s10_31900100_01_0030","text":"可惜现在没有乖孩子们在\n只有我这个大人而已"},{"key":"SCENARIO_s10_31900100_01_0040","text":"啊哈哈，我是\n专门来找制作人的感觉～"},{"key":"SCENARIO_s10_31900100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_31900100_01_0050","text":"有什么想要的东西吗～？"},{"key":"SCENARIO_s10_31900100_01_0060","text":"哈哈，原来是直接问型的啊"},{"key":"SCENARIO_s10_31900100_01_0070","text":"……不过，要什么呢\n想不出来……"},{"key":"SCENARIO_s10_31900100_01_0080","text":"诶——肯定有什么的吧～"},{"key":"SCENARIO_s10_31900100_01_0090","text":"……\n对了！"},{"key":"SCENARIO_s10_31900100_01_0100","text":"跟我一起去寻找吧！\n制作人的礼物"}]
