[{"key":"SCENARIO_s10_10200200_02_0001","text":"Motion"},{"key":"SCENARIO_s10_10200200_02_0002","text":"Motion"},{"key":"SCENARIO_s10_10200200_02_0010","text":"干劲十足嘛"},{"key":"SCENARIO_s10_10200200_02_0020","text":"……好的"},{"key":"SCENARIO_s10_10200200_02_0030","text":"我不想让前来观看的各位\n留下遗憾"},{"key":"SCENARIO_s10_10200200_02_0040","text":"我会把现在自己能做到的全部……\n都发挥出来"},{"key":"SCENARIO_s10_10200200_02_0050","text":"嗯，是啊"},{"key":"SCENARIO_s10_10200200_02_0060","text":"而且……"},{"key":"SCENARIO_s10_10200200_02_0070","text":"嗯？"},{"key":"SCENARIO_s10_10200200_02_0080","text":"这件服装，不是和２８３的大家一起同款吗\n总觉得……心里就特别有底气呢"},{"key":"SCENARIO_s10_10200200_02_0090","text":"所以，就会模模糊糊地觉得自己“能做到”"},{"key":"SCENARIO_s10_10200200_02_0100","text":"虽然说起来有点奇怪就是了"}]
