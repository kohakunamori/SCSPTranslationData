[{"key":"SCENARIO_s10_12200200_01_0000","text":"Motion"},{"key":"SCENARIO_s10_12200200_01_0010","text":"哇…………！"},{"key":"SCENARIO_s10_12200200_01_0020","text":"怎么样？\n设计很棒吧"},{"key":"SCENARIO_s10_12200200_01_0030","text":"是、是的……！\n超、超可爱的……！"},{"key":"SCENARIO_s10_12200200_01_0040","text":"哈哈，对吧！"},{"key":"SCENARIO_s10_12200200_01_0041","text":"Motion"},{"key":"SCENARIO_s10_12200200_01_0050","text":"啊……\n不过…………"},{"key":"SCENARIO_s10_12200200_01_0060","text":"……？\n怎么了？"},{"key":"SCENARIO_s10_12200200_01_0070","text":"啊……不、不是……！\n没、没什么"},{"key":"SCENARIO_s10_12200200_01_0080","text":"我、我一定会好好驾驭它的……！\n请、请交给我吧……！"},{"key":"SCENARIO_s10_12200200_01_0090","text":"嗯\n那我就期待着了"},{"key":"SCENARIO_s10_12200200_01_0100","text":"……！\n好、好的……！"}]
