[{"key":"SCENARIO_s10_21101000_01_0000","text":"Motion"},{"key":"SCENARIO_s10_21101000_01_0010","text":"诶……"},{"key":"SCENARIO_s10_21101000_01_0020","text":"哦，树里\n喜欢吗？"},{"key":"SCENARIO_s10_21101000_01_0030","text":"啊哈哈\n我还没说任何话呢"},{"key":"SCENARIO_s10_21101000_01_0040","text":"嗯，我很喜欢\n有种“原来是这个路线啊”的感觉"},{"key":"SCENARIO_s10_21101000_01_0050","text":"哈哈\n你这么说我很开心"},{"key":"SCENARIO_s10_21101000_01_0060","text":"这套服装也做得很用心、很漂亮……"},{"key":"SCENARIO_s10_21101000_01_0070","text":"制作人你肯定想了很多、\n准备了很多吧"},{"key":"SCENARIO_s10_21101000_01_0080","text":"————啊啊"},{"key":"SCENARIO_s10_21101000_01_0090","text":"──我得拿出\n配得上这套服装的表演才行"},{"key":"SCENARIO_s10_21101000_01_0100","text":"──更有干劲了！\n谢啦，制作人"}]
