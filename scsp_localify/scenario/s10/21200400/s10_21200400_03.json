[{"key":"SCENARIO_s10_21200400_03_0000","text":"Motion"},{"key":"SCENARIO_s10_21200400_03_0010","text":"嗯……"},{"key":"SCENARIO_s10_21200400_03_0012","text":"Motion"},{"key":"SCENARIO_s10_21200400_03_0011","text":"Motion"},{"key":"SCENARIO_s10_21200400_03_0020","text":"凛世，辛苦了"},{"key":"SCENARIO_s10_21200400_03_0030","text":"抱歉拍摄前等待时间很长，\n再稍微等一会儿就好"},{"key":"SCENARIO_s10_21200400_03_0040","text":"好的……\n凛世的事……请不必挂心……"},{"key":"SCENARIO_s10_21200400_03_0050","text":"因为……带了不错的东西来……"},{"key":"SCENARIO_s10_21200400_03_0060","text":"哦，那是漫画吗？"},{"key":"SCENARIO_s10_21200400_03_0070","text":"嗯……"},{"key":"SCENARIO_s10_21200400_03_0080","text":"从遥远银河彼岸而来的青年……\n与他坠入爱河的……少女的故事……"},{"key":"SCENARIO_s10_21200400_03_0090","text":"哦\n感觉是个很感伤的故事呢"},{"key":"SCENARIO_s10_21200400_03_0091","text":"Motion"},{"key":"SCENARIO_s10_21200400_03_0100","text":"感伤又……酸甜的……\n恋爱故事……"},{"key":"SCENARIO_s10_21200400_03_0101","text":"Motion"}]
