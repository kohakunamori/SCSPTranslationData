[{"key":"SCENARIO_s10_20300900_03_0000","text":"Motion"},{"key":"SCENARIO_s10_20300900_03_0010","text":"…………"},{"key":"SCENARIO_s10_20300900_03_0020","text":"呼——……"},{"key":"SCENARIO_s10_20300900_03_0030","text":"辛苦了，巡\n今天的表演，真的很棒"},{"key":"SCENARIO_s10_20300900_03_0040","text":"真的！？"},{"key":"SCENARIO_s10_20300900_03_0050","text":"我也这么觉得……！\n感觉比平时动得更好了！"},{"key":"SCENARIO_s10_20300900_03_0060","text":"说不定……\n是一起在公园运动的效果呢"},{"key":"SCENARIO_s10_20300900_03_0070","text":"哈哈，怎么可能\n开玩笑────"},{"key":"SCENARIO_s10_20300900_03_0080","text":"那那，我们得再去公园运动才行呢！"},{"key":"SCENARIO_s10_20300900_03_0090","text":"……嗯！\n是啊，那再一起练吧"},{"key":"SCENARIO_s10_20300900_03_0100","text":"嗯！\n说好了哦！"}]
