[{"key":"SCENARIO_s10_20300900_02_0000","text":"Motion"},{"key":"SCENARIO_s10_20300900_02_0010","text":"制作人！\n要上了哦！"},{"key":"SCENARIO_s10_20300900_02_0020","text":"────接招！"},{"key":"SCENARIO_s10_20300900_02_0030","text":"哇……哎哟哟……！"},{"key":"SCENARIO_s10_20300900_02_0040","text":"嘿嘿\n我赢了♪"},{"key":"SCENARIO_s10_20300900_02_0050","text":"哈……哈……\n哈哈，果然巡很厉害啊！"},{"key":"SCENARIO_s10_20300900_02_0060","text":"因为我有在锻炼……！"},{"key":"SCENARIO_s10_20300900_02_0070","text":"……呐，制作人\n身体有没有稍微活动开一点呢……？"},{"key":"SCENARIO_s10_20300900_02_0080","text":"嗯，感觉清爽多了\n谢谢你拉我一起来！"},{"key":"SCENARIO_s10_20300900_02_0081","text":"Motion"},{"key":"SCENARIO_s10_20300900_02_0090","text":"好……下次我可不会输了！"},{"key":"SCENARIO_s10_20300900_02_0100","text":"……！\n嗯！"}]
