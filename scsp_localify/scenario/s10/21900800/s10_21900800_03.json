[{"key":"SCENARIO_s10_21900800_03_0000","text":"Motion"},{"key":"SCENARIO_s10_21900800_03_0001","text":"化妆师"},{"key":"SCENARIO_s10_21900800_03_0010","text":"最近有什么沉迷的东西吗～？"},{"key":"SCENARIO_s10_21900800_03_0020","text":"啊……嗯…………\n找茬…………之类的"},{"key":"SCENARIO_s10_21900800_03_0030","text":"啊～，找茬……？\n最近餐厅里也有放呢～"},{"key":"SCENARIO_s10_21900800_03_0040","text":"没想到和泉小姐也会玩那种游戏～\n有点意外！"},{"key":"SCENARIO_s10_21900800_03_0050","text":"……啊……\n抱歉，这话就我们之间说说"},{"key":"SCENARIO_s10_21900800_03_0060","text":"我懂的啦！\n不过玩找茬的和泉小姐啊……感觉还挺不错的"},{"key":"SCENARIO_s10_21900800_03_0070","text":"呵呵……\n这是我们才知道的“爱依大人”的秘密呢！"},{"key":"SCENARIO_s10_21900800_03_0080","text":"哈哈……\n您这么说的话"},{"key":"SCENARIO_s10_21900800_03_0090","text":"好，OK！\n今天的“爱依大人”也完美！一丝偏差都没有！"},{"key":"SCENARIO_s10_21900800_03_0100","text":"…………\n没有差错"}]
