[{"key":"SCENARIO_s10_31300800_02_0001","text":"Motion"},{"key":"SCENARIO_s10_31300800_02_0009","text":"摄影师"},{"key":"SCENARIO_s10_31300800_02_0010","text":"保持那个姿势别动…………──"},{"key":"SCENARIO_s10_31300800_02_0020","text":"（────哦，蝴蝶飞过来了……）"},{"key":"SCENARIO_s10_31300800_02_0029","text":"导演"},{"key":"SCENARIO_s10_31300800_02_0030","text":"……好，先休息一下吧！\n有栖川小姐也上来休息吧"},{"key":"SCENARIO_s10_31300800_02_0040","text":"好的！　谢谢您"},{"key":"SCENARIO_s10_31300800_02_0050","text":"呼…………"},{"key":"SCENARIO_s10_31300800_02_0060","text":"辛苦了，夏叶！\n这里有毛巾，你用吧"},{"key":"SCENARIO_s10_31300800_02_0070","text":"还有运动饮料\n出了那么多汗，最好补充一下水分"},{"key":"SCENARIO_s10_31300800_02_0080","text":"谢谢\n呵呵，放在保冷袋里，准备得真周全呢"},{"key":"SCENARIO_s10_31300800_02_0090","text":"不过，你自己才是满身大汗呢\n要不要去外面稍微休息一下……"},{"key":"SCENARIO_s10_31300800_02_0100","text":"不用担心啦\n我中间也有在补充水分"},{"key":"SCENARIO_s10_31300800_02_0110","text":"如果毛巾什么的还需要更多，就跟我说\n我再给你拿过来！"},{"key":"SCENARIO_s10_31300800_02_0120","text":"……？"},{"key":"SCENARIO_s10_31300800_02_0125","text":"Motion"},{"key":"SCENARIO_s10_31300800_02_0130","text":"——不好意思，我也给大家带了运动饮料过来，不介意的话——"},{"key":"SCENARIO_s10_31300800_02_0139","text":"工作人员"},{"key":"SCENARIO_s10_31300800_02_0140","text":"诶，可以吗２８３桑——好冰～……！\n谢谢您——"},{"key":"SCENARIO_s10_31300800_02_0150","text":"……呵呵呵"},{"key":"SCENARIO_s10_31300800_02_0155","text":"Motion"},{"key":"SCENARIO_s10_31300800_02_0160","text":"——真好喝"},{"key":"SCENARIO_s10_31300800_02_0170","text":"你们能这么精神、\n这么充满活力——"}]
