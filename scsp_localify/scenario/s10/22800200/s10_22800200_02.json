[{"key":"SCENARIO_s10_22800200_02_0011","text":"Motion"},{"key":"SCENARIO_s10_22800200_02_0010","text":"…………"},{"key":"SCENARIO_s10_22800200_02_0020","text":"阳希……\n紧张吗？"},{"key":"SCENARIO_s10_22800200_02_0030","text":"啊，对不起……！\n紧张是有点紧张……"},{"key":"SCENARIO_s10_22800200_02_0040","text":"但更多是在想，听歌的人\n能不能好好接收到我的心意——"},{"key":"SCENARIO_s10_22800200_02_0041","text":"Motion"},{"key":"SCENARIO_s10_22800200_02_0050","text":"心脏……\n跳得好快啊……"},{"key":"SCENARIO_s10_22800200_02_0060","text":"——干脆，把这心里的悸动\n也一并传达给大家好了……！"},{"key":"SCENARIO_s10_22800200_02_0070","text":"哦哦……\n哈哈，说不定不错"},{"key":"SCENARIO_s10_22800200_02_0080","text":"呵呵……想也想不明白，但总觉得\n不能对自己说谎"},{"key":"SCENARIO_s10_22800200_02_0090","text":"自己心里想的——……"},{"key":"SCENARIO_s10_22800200_02_0100","text":"——我出发了，制作人"}]
