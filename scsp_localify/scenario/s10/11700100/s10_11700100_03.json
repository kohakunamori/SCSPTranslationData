[{"key":"SCENARIO_s10_11700100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0003","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0010","text":"……哈……！"},{"key":"SCENARIO_s10_11700100_03_0011","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0020","text":"哦，朝日，跳得好高啊"},{"key":"SCENARIO_s10_11700100_03_0030","text":"Producer先生\n这件衣服，动起来特别方便！"},{"key":"SCENARIO_s10_11700100_03_0040","text":"感觉滞空时间比平时更长了！"},{"key":"SCENARIO_s10_11700100_03_0041","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0050","text":"……哈……！"},{"key":"SCENARIO_s10_11700100_03_0051","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0060","text":"哈哈，像弹簧一样元气满满啊"},{"key":"SCENARIO_s10_11700100_03_0070","text":"看着朝日，我也忍不住想蹦起来了"},{"key":"SCENARIO_s10_11700100_03_0080","text":"那Producer先生也跳跳看！"},{"key":"SCENARIO_s10_11700100_03_0090","text":"是吗，那我来了……！\n────嘿……！"},{"key":"SCENARIO_s10_11700100_03_0091","text":"Motion"},{"key":"SCENARIO_s10_11700100_03_0100","text":"啊哈哈\nProducer先生，还差得远呢"}]
