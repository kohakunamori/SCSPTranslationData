[{"key":"SCENARIO_s10_11400100_02_0000","text":"Motion"},{"key":"SCENARIO_s10_11400100_02_0010","text":"诶嘿嘿～"},{"key":"SCENARIO_s10_11400100_02_0020","text":"哦，怎么了吗？"},{"key":"SCENARIO_s10_11400100_02_0030","text":"天气超好的呢～"},{"key":"SCENARIO_s10_11400100_02_0040","text":"就像是天空也在\n为演唱会祈祷成功一样"},{"key":"SCENARIO_s10_11400100_02_0050","text":"是啊……"},{"key":"SCENARIO_s10_11400100_02_0060","text":"云彩也恰到好处地飘着"},{"key":"SCENARIO_s10_11400100_02_0070","text":"就像那件衣装一样呢～"},{"key":"SCENARIO_s10_11400100_02_0080","text":"好想快点让粉丝们\n看到啊"},{"key":"SCENARIO_s10_11400100_02_0090","text":"甘奈她们要创造的……"},{"key":"SCENARIO_s10_11400100_02_0091","text":"Motion"},{"key":"SCENARIO_s10_11400100_02_0100","text":"美丽的天空"}]
