[{"key":"SCENARIO_s10_21900100_03_0001","text":"Motion"},{"key":"SCENARIO_s10_21900100_03_0002","text":"Motion"},{"key":"SCENARIO_s10_21900100_03_0010","text":"……哈……"},{"key":"SCENARIO_s10_21900100_03_0020","text":"辛苦了\n舞台很棒哦"},{"key":"SCENARIO_s10_21900100_03_0021","text":"Motion"},{"key":"SCENARIO_s10_21900100_03_0030","text":"是吗\n那就好"},{"key":"SCENARIO_s10_21900100_03_0040","text":"爱依自己不这么觉得吗？"},{"key":"SCENARIO_s10_21900100_03_0041","text":"Motion"},{"key":"SCENARIO_s10_21900100_03_0050","text":"……\n因为太拼命了"},{"key":"SCENARIO_s10_21900100_03_0060","text":"有点\n不太清楚"},{"key":"SCENARIO_s10_21900100_03_0070","text":"……那个，以后会慢慢懂吗？\n那种感觉"},{"key":"SCENARIO_s10_21900100_03_0080","text":"嗯，一定会的\n积累经验之后，肯定会有余裕的"},{"key":"SCENARIO_s10_21900100_03_0081","text":"Motion"},{"key":"SCENARIO_s10_21900100_03_0090","text":"……是啊"},{"key":"SCENARIO_s10_21900100_03_0100","text":"我会加油的"}]
