[{"key":"SCENARIO_s10_21900100_01_0001","text":"Motion"},{"key":"SCENARIO_s10_21900100_01_0010","text":"今天能来\n谢谢你"},{"key":"SCENARIO_s10_21900100_01_0020","text":"『爱依酱——！』"},{"key":"SCENARIO_s10_21900100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_21900100_01_0030","text":"谢谢你们\n心意，收到了"},{"key":"SCENARIO_s10_21900100_01_0040","text":"“噢——！”"},{"key":"SCENARIO_s10_21900100_01_0041","text":"Motion"},{"key":"SCENARIO_s10_21900100_01_0050","text":"嗯\n真好"},{"key":"SCENARIO_s10_21900100_01_0060","text":"接下来\n也要继续嗨下去"},{"key":"SCENARIO_s10_21900100_01_0070","text":"大家\n跟上来"},{"key":"SCENARIO_s10_21900100_01_0071","text":"Motion"},{"key":"SCENARIO_s10_21900100_01_0080","text":"制作人\n怎么样？"},{"key":"SCENARIO_s10_21900100_01_0090","text":"我觉得感觉很好\n正式演出也能保持这个状态就好了"},{"key":"SCENARIO_s10_21900100_01_0100","text":"嗯。我会加油的"}]
