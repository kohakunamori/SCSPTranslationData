[{"key":"SCENARIO_s10_21900100_02_0001","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0010","text":"……呼……\n……哈……"},{"key":"SCENARIO_s10_21900100_02_0012","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0020","text":"爱依，能耽误一下吗？"},{"key":"SCENARIO_s10_21900100_02_0030","text":"……？\n怎么了？"},{"key":"SCENARIO_s10_21900100_02_0031","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0040","text":"这个，热可可\n据说有缓解紧张的效果"},{"key":"SCENARIO_s10_21900100_02_0050","text":"……这样啊"},{"key":"SCENARIO_s10_21900100_02_0051","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0060","text":"……谢谢\n那我喝了"},{"key":"SCENARIO_s10_21900100_02_0061","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0062","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0070","text":"……\n好喝"},{"key":"SCENARIO_s10_21900100_02_0080","text":"那就好\n稍微平静下来了吗？"},{"key":"SCENARIO_s10_21900100_02_0081","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0090","text":"嗯\n感觉，是那样"},{"key":"SCENARIO_s10_21900100_02_0091","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0092","text":"Motion"},{"key":"SCENARIO_s10_21900100_02_0100","text":"……呼……哈……\n…………。好"}]
