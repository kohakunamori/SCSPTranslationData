[{"key":"SCENARIO_s10_32400100_01_0000","text":"Motion"},{"key":"SCENARIO_s10_32400100_01_0001","text":"漫才师的声音１"},{"key":"SCENARIO_s10_32400100_01_0002","text":"漫才师的声音２"},{"key":"SCENARIO_s10_32400100_01_0010","text":"────那我现在来当偶像，\n你来当我的狂热粉丝吧"},{"key":"SCENARIO_s10_32400100_01_0002","text":"漫才师的声音２"},{"key":"SCENARIO_s10_32400100_01_0020","text":"偶像？\n那种事你做得来吗～？"},{"key":"SCENARIO_s10_32400100_01_0011","text":"Motion"},{"key":"SCENARIO_s10_32400100_01_0021","text":"Motion"},{"key":"SCENARIO_s10_32400100_01_0030","text":"哦，不看了吗？"},{"key":"SCENARIO_s10_32400100_01_0040","text":"……如果你想看的话，请便就是了"},{"key":"SCENARIO_s10_32400100_01_0050","text":"啊啊，不是……"},{"key":"SCENARIO_s10_32400100_01_0060","text":"不是那个意思"},{"key":"SCENARIO_s10_32400100_01_0070","text":"……"},{"key":"SCENARIO_s10_32400100_01_0080","text":"说得倒是轻巧呢，真是的"},{"key":"SCENARIO_s10_32400100_01_0090","text":"……"},{"key":"SCENARIO_s10_32400100_01_0100","text":"那我还要练习，先失陪了"},{"key":"SCENARIO_s10_32400100_01_0101","text":"Motion"}]
